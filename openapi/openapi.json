  "components": {
    "schemas": {
      "AddProjectMemberRequest": {
        "type": "object",
        "required": [
          "user_id",
          "role"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "user_id",
          "email",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "refresh_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        }
      },
      "BacklogResponse": {
        "type": "object",
        "required": [
          "sprint",
          "sprint_issues",
          "backlog_issues"
        ],
        "properties": {
          "backlog_issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueResponse"
            }
          },
          "sprint": {
            "$ref": "#/components/schemas/SprintResponse"
          },
          "sprint_issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueResponse"
            }
          }
        }
      },
      "BoardColumnResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "issue_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "issue_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
