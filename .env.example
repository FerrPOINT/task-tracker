# Task Tracker — environment template
# Copy to .env and replace [CHANGE_ME] values before production use.

# PostgreSQL
TASKTRACKER_DATABASE_HOST=localhost
TASKTRACKER_DATABASE_PORT=3457
TASKTRACKER_DATABASE_NAME=tasktracker
TASKTRACKER_DATABASE_USER=tasktracker
TASKTRACKER_DATABASE_PASSWORD=[CHANGE_ME]
TASKTRACKER_DATABASE_URL=postgres://tasktracker:[CHANGE_ME]@localhost:3457/tasktracker

# JWT
TASKTRACKER_JWT_SECRET=[CHANGE_ME]

# Server
TASKTRACKER_SERVER_ADDRESS=0.0.0.0
TASKTRACKER_SERVER_PORT=3456

# Redis (optional, used for sessions/cache)
TASKTRACKER_REDIS_URL=redis://localhost:6379

# Rust logging
RUST_LOG=info
