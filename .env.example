# Task Tracker — environment template
# Copy to .env and replace [CHANGE_ME] values before production use.
#
# Env var format: TASKTRACKER_SECTION__KEY (double underscore = nested key)
# Special: TASKTRACKER_JWT_SECRET (backwards-compat alias for auth.jwt_secret)

# PostgreSQL
TASKTRACKER_DATABASE__URL=postgres://tasktracker:[CHANGE_ME]@localhost:3457/tasktracker
TASKTRACKER_DATABASE__MAX_CONNECTIONS=20
TASKTRACKER_DATABASE__MIN_CONNECTIONS=5
TASKTRACKER_DATABASE__CONNECT_TIMEOUT_SECONDS=10
TASKTRACKER_DATABASE__IDLE_TIMEOUT_SECONDS=600

# JWT / Auth
TASKTRACKER_JWT_SECRET=[CHANGE_ME]
TASKTRACKER_AUTH__ACCESS_TOKEN_TTL_MINUTES=15
TASKTRACKER_AUTH__REFRESH_TOKEN_TTL_DAYS=7
TASKTRACKER_AUTH__REFRESH_COOKIE_NAME=refresh_token
TASKTRACKER_AUTH__REFRESH_COOKIE_SECURE=true
TASKTRACKER_AUTH__REFRESH_COOKIE_SAME_SITE=Lax
TASKTRACKER_AUTH__REFRESH_COOKIE_PATH=/api/v1/auth

# Server
TASKTRACKER_SERVER__ADDRESS=0.0.0.0
TASKTRACKER_SERVER__PORT=3456
TASKTRACKER_SERVER__CORS_ALLOWED_ORIGINS=http://localhost:19877,http://localhost:5173

# Storage (file uploads)
TASKTRACKER_STORAGE__DIR=/var/lib/tasktracker/uploads
TASKTRACKER_STORAGE__MAX_UPLOAD_BYTES=26214400

# Email / SMTP notifications (disabled by default)
TASKTRACKER_EMAIL__ENABLED=false
TASKTRACKER_EMAIL__HOST=[CHANGE_ME]
TASKTRACKER_EMAIL__PORT=587
TASKTRACKER_EMAIL__USERNAME=[CHANGE_ME]
TASKTRACKER_EMAIL__PASSWORD=[CHANGE_ME]
TASKTRACKER_EMAIL__FROM_ADDRESS=[CHANGE_ME]
TASKTRACKER_EMAIL__FROM_NAME=Task Tracker
TASKTRACKER_EMAIL__STARTTLS=true

# Rust logging
RUST_LOG=info