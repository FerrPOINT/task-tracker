# Task Tracker — environment template
# Copy to .env and replace [CHANGE_ME] values before production use.
#
# Env var format: TASKTRACKER__SECTION__KEY (double underscore = nested key)
# Special: TASKTRACKER_JWT_SECRET (backwards-compat alias for auth.jwt_secret)

# PostgreSQL
TASKTRACKER__DATABASE__URL=postgres://tasktracker:[CHANGE_ME]@localhost:3457/tasktracker
TASKTRACKER__DATABASE__MAX_CONNECTIONS=20
TASKTRACKER__DATABASE__MIN_CONNECTIONS=5
TASKTRACKER__DATABASE__CONNECT_TIMEOUT_SECONDS=10
TASKTRACKER__DATABASE__IDLE_TIMEOUT_SECONDS=600

# JWT / Auth
TASKTRACKER_JWT_SECRET=[CHANGE_ME]
TASKTRACKER__AUTH__ACCESS_TOKEN_TTL_MINUTES=15
TASKTRACKER__AUTH__REFRESH_TOKEN_TTL_DAYS=7
TASKTRACKER__AUTH__REFRESH_COOKIE_NAME=refresh_token
TASKTRACKER__AUTH__REFRESH_COOKIE_SECURE=true
TASKTRACKER__AUTH__REFRESH_COOKIE_SAME_SITE=Lax
TASKTRACKER__AUTH__REFRESH_COOKIE_PATH=/api/v1/auth

# Server
TASKTRACKER__SERVER__ADDRESS=0.0.0.0
TASKTRACKER__SERVER__PORT=3456
TASKTRACKER__SERVER__CORS_ALLOWED_ORIGINS=http://localhost:19877,http://localhost:5173

# Storage (file uploads)
TASKTRACKER__STORAGE__DIR=/var/lib/tasktracker/uploads
TASKTRACKER__STORAGE__MAX_UPLOAD_BYTES=26214400

# Email / SMTP notifications (disabled by default)
TASKTRACKER__EMAIL__ENABLED=false
TASKTRACKER__EMAIL__HOST=[CHANGE_ME]
TASKTRACKER__EMAIL__PORT=587
TASKTRACKER__EMAIL__USERNAME=[CHANGE_ME]
TASKTRACKER__EMAIL__PASSWORD=[CHANGE_ME]
TASKTRACKER__EMAIL__FROM_ADDRESS=[CHANGE_ME]
TASKTRACKER__EMAIL__FROM_NAME=Task Tracker
TASKTRACKER__EMAIL__STARTTLS=true

# Rust logging
RUST_LOG=info