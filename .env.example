# Task Tracker — environment template
# Copy to .env and replace [CHANGE_ME] values before production use.

# PostgreSQL
TASKTRACKER_DATABASE_HOST=localhost
TASKTRACKER_DATABASE_PORT=3457
TASKTRACKER_DATABASE_NAME=tasktracker
TASKTRACKER_DATABASE_USER=tasktracker
TASKTRACKER_DATABASE_PASSWORD=[CHANGE_ME]
TASKTRACKER_DATABASE__URL=postgres://tasktracker:[CHANGE_ME]@localhost:3457/tasktracker

# JWT
TASKTRACKER_JWT_SECRET=[CHANGE_ME]

# Server
TASKTRACKER_SERVER_ADDRESS=0.0.0.0
TASKTRACKER_SERVER_PORT=3456
TASKTRACKER_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:19877,http://localhost:5173

# Redis (optional, used for sessions/cache)
TASKTRACKER_REDIS_URL=redis://localhost:6379

# Rust logging
RUST_LOG=info

# Email / SMTP notifications (disabled by default)
# When TASKTRACKER_EMAIL__ENABLED=true, host, from_address are required,
# and username/password must be both set or both omitted.
TASKTRACKER_EMAIL__ENABLED=false
TASKTRACKER_EMAIL__HOST=[CHANGE_ME]
TASKTRACKER_EMAIL__PORT=587
TASKTRACKER_EMAIL__USERNAME=[CHANGE_ME]
TASKTRACKER_EMAIL__PASSWORD=[CHANGE_ME]
TASKTRACKER_EMAIL__FROM_ADDRESS=[CHANGE_ME]
TASKTRACKER_EMAIL__FROM_NAME=Task Tracker
TASKTRACKER_EMAIL__STARTTLS=true
