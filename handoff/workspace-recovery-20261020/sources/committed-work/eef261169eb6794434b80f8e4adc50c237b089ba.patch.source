diff --git a/frontend/src/features/issue-detail/ui/ActivityFeed.test.tsx b/frontend/src/features/issue-detail/ui/ActivityFeed.test.tsx
index e0fd35e..5c68738 100644
--- a/frontend/src/features/issue-detail/ui/ActivityFeed.test.tsx
