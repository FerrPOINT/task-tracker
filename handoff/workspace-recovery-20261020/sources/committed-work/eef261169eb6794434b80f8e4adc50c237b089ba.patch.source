@@ -54,4 +54,28 @@ describe('ActivityFeed', () => {
     render(wrapper(<ActivityFeed comments={[]} worklogs={[]} />))
     expect(screen.getByText(/no activity yet/i)).toBeInTheDocument()
   })
+
+  it('wraps release evidence and author names without losing text or newlines', () => {
+    const digest = `sha256:${'a'.repeat(64)}`
+    const body = `${'b'.repeat(40)}\n${digest}`
+    const authorName = 'ReleaseReviewer'.repeat(12)
+    const description = `https://forge.example.test/artifacts/${'c'.repeat(128)}`
+    render(
+      wrapper(
+        <ActivityFeed
+          comments={[{ ...comment, body, authorName }]}
+          worklogs={[{ ...worklog, comment: description, userDisplayName: authorName + '2' }]}
+        />,
+      ),
+    )
+
+    for (const text of [body, description]) {
+      const element = screen.getByText(text, { exact: true, normalizer: (value) => value })
+      expect(element.textContent).toBe(text)
+      expect(element).toHaveClass('whitespace-pre-wrap', '[overflow-wrap:anywhere]')
+    }
+    for (const text of [authorName, authorName + '2']) {
+      expect(screen.getByText(text)).toHaveClass('min-w-0', '[overflow-wrap:anywhere]')
+    }
+  })
 })
