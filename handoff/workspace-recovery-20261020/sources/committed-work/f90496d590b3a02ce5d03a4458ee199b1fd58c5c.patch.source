+        let (attachment, bytes) = self
+            .attachments
+            .download_artifact(self.artifact_config()?, actor, id, self.storage.as_ref())
+            .await?;
+        crate::attachment_artifacts::verify_bytes(&attachment, &bytes)?;
+        Ok((Self::to_dto(&attachment)?, bytes))
+    }
