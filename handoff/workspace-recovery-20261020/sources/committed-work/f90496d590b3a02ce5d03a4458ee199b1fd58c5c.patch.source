+        }
+        items.iter().map(Self::to_dto).collect()
     }
 
     async fn download(
@@ -196,6 +291,11 @@ impl crate::context::AttachmentService for AttachmentServiceImpl {
         requester: UserId,
     ) -> Result<(crate::context::AttachmentDto, Vec<u8>), AppError> {
