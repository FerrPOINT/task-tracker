@@ -1077,10 +1117,19 @@ impl FileStorage for InMemoryStorage {
         if bytes.is_empty() {
             return Err(AppError::invalid_input("file is empty"));
         }
-        self.files
-            .lock()
-            .unwrap()
-            .insert((issue_id.to_string(), key.to_string()), bytes);
