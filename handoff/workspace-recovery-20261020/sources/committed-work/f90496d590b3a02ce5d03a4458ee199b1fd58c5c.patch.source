+            "not-a-uuid",
+            "00000000-0000-0000-0000-000000000000",
+            "AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE",
+            "aaaaaaaabbbb4ccc8dddeeeeeeeeeeee",
+        ] {
+            assert_eq!(canonical_attachment_issue_id(identifier), None);
+        }
+    }
+}
