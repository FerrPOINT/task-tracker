+    POST.mockResolvedValue({ data: issue, response: { status: 200 } })
+    await expect(restoreIssue(id)).resolves.toEqual(issue)
+  })
+  it.each(['TT-0001', 'ABCDEFAB-CDEF-ABCD-EFAB-CDEFABCDEFAB'])(
+    'accepts the server-canonicalized identifier %s',
+    async (id) => {
+      const issue = { id: 'abcdefab-cdef-abcd-efab-cdefabcdefab', key: 'TT-1', project_key: 'TT' }
+      POST.mockResolvedValue({ data: issue, response: { status: 200 } })
+      await expect(restoreIssue(id)).resolves.toEqual(issue)
+    },
+  )
+})
