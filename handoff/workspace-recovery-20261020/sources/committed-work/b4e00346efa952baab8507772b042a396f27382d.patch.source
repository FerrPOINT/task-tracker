+    await expect(purgeIssue('i1')).resolves.toBeUndefined()
+  })
+  it.each([undefined, null, {}, { id: 'i1', key: 'TT-1' }])(
+    'does not infer restore success from malformed JSON',
+    async (data) => {
+      POST.mockResolvedValue({ data, response: { status: 200 } })
