+      expect(screen.getByRole('button', { name: 'Проверить состояние' })).toBeVisible(),
+    )
+    await user.click(screen.getByRole('button', { name: 'Проверить состояние' }))
+    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
+    expect(toast.success).not.toHaveBeenCalled()
+    expect(toast.info).toHaveBeenCalledOnce()
+    expect(mockPurge).toHaveBeenCalledOnce()
+    await waitFor(() => expect(screen.getByRole('region', { name: 'Корзина' })).toHaveFocus())
+  })
+
+  it('keeps an unknown restore blocked when readback fails', async () => {
+    mockRestore.mockRejectedValue(new ApiError(503, 'Private diagnostic'))
+    const refetch = vi
+      .fn()
+      .mockResolvedValue({ data: [trashIssue(1)], error: new ApiError(503, 'Readback failure') })
+    mockTrash.mockReturnValue({ data: [trashIssue(1)], isLoading: false, error: null, refetch })
+    render(wrapper(<ProjectTrashPage />))
+    const user = userEvent.setup()
+    await user.click(screen.getByRole('button', { name: 'Восстановить TT-1' }))
+    await waitFor(() =>
+      expect(screen.getByRole('button', { name: 'Проверить состояние' })).toBeVisible(),
+    )
+    await user.click(screen.getByRole('button', { name: 'Проверить состояние' }))
+    expect(screen.getByRole('button', { name: 'Восстановить TT-1' })).toBeDisabled()
+    expect(mockRestore).toHaveBeenCalledOnce()
+  })
+
+  it('guards the restore handler before the mutation hook can rerender', () => {
+    mockRestore.mockReturnValue(new Promise(() => {}))
+    render(wrapper(<ProjectTrashPage />))
+    const restore = screen.getByRole('button', { name: 'Восстановить TT-1' })
+    act(() => {
+      restore.click()
+      restore.click()
+    })
+    expect(mockRestore).toHaveBeenCalledOnce()
+  })
 })
