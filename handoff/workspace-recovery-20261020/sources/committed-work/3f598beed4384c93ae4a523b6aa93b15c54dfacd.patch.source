+FROM node:22.20.0-bookworm-slim@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e AS builder
 
 RUN corepack enable && corepack prepare pnpm@10.28.1 --activate
 
@@ -20,7 +21,9 @@ ARG VITE_AUTH_ISSUER="http://localhost:7701"
 ENV VITE_AUTH_ISSUER=${VITE_AUTH_ISSUER}
 RUN pnpm build
 
-FROM nginx:alpine
+FROM nginx:1.29.8-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de AS sdlc1
+FROM nginx:1.31.6-alpine@sha256:df221db836e1754089190208cee7eeda94f233197056426eda74a43ab1abeac2 AS sdlc2
+FROM ${SDLC_RUNTIME_FLAVOR} AS runtime
 COPY --from=builder /app/dist /usr/share/nginx/html
 COPY task-tracker/frontend/nginx.conf /etc/nginx/conf.d/default.conf
 EXPOSE 80
