diff --git a/scripts/restore.sh b/scripts/restore.sh
index 8bd0022..ea441d9 100755
--- a/scripts/restore.sh
+++ b/scripts/restore.sh
@@ -6,15 +6,37 @@ set -euo pipefail
 
 SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
-ENV_FILE="${PROJECT_DIR}/.env"
 
-if [ -f "$ENV_FILE" ]; then
-  # shellcheck disable=SC1090
-  set -a; . "$ENV_FILE"; set +a
-fi
+: "${SDLC_DOCKER_CONTEXT:?Select an explicit Docker context}"
+: "${SDLC_COMPOSE_PROJECT:?Select an explicit disposable Compose project}"
+: "${SDLC_COMPOSE_FILE:?Select the exact Compose manifest}"
+: "${SDLC_TASK:?Select the QA owner task}"
+: "${SDLC_PURPOSE:?Select the QA resource purpose}"
+: "${POSTGRES_USER:?Select the QA database user}"
+: "${POSTGRES_DB:?Select the QA database}"
+case "$SDLC_COMPOSE_PROJECT" in
+  sdlc-qa-*|sdlc-build-*) ;;
+  *) echo "Legacy product backup is QA-only. Use Base WORKSPACE_BACKUP for installed workspaces." >&2; exit 1 ;;
+esac
+BASE_DIR="${SDLC_BASE_DIR:-${PROJECT_DIR}/../services-base}"
+test -f "$BASE_DIR/scripts/compose_probe.py"
+DOCKER=(docker --context "$SDLC_DOCKER_CONTEXT")
+SDLC_COMPOSE_FILE="$(cd "$(dirname "$SDLC_COMPOSE_FILE")" && pwd)/$(basename "$SDLC_COMPOSE_FILE")"
+COMPOSE=("${DOCKER[@]}" compose --env-file /dev/null -p "$SDLC_COMPOSE_PROJECT" -f "$SDLC_COMPOSE_FILE")
 
-: "${POSTGRES_USER:=tasktracker}"
-: "${POSTGRES_DB:=tasktracker}"
+require_owned_service() {
+  local id owner task purpose
+  id="$("${COMPOSE[@]}" ps -q "$1")"
+  test -n "$id" || { echo "Required QA service is absent." >&2; exit 1; }
+  owner="$("${DOCKER[@]}" inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$id")"
+  task="$("${DOCKER[@]}" inspect --format '{{index .Config.Labels "sdlc.task"}}' "$id")"
+  purpose="$("${DOCKER[@]}" inspect --format '{{index .Config.Labels "sdlc.purpose"}}' "$id")"
+  test "$owner" = "$SDLC_COMPOSE_PROJECT" && test "$task" = "$SDLC_TASK" && test "$purpose" = "$SDLC_PURPOSE" || {
+    echo "Foreign or unowned QA service; operation refused." >&2; exit 1;
+  }
+}
+require_owned_service postgres
+require_owned_service "${SDLC_BACKEND_SERVICE:-task-backend}"
 
 if [ "$#" -ne 1 ]; then
   echo "Usage: $0 <backup.tar.gz>" >&2
@@ -30,30 +52,62 @@ if [ ! -f "$BACKUP_ARCHIVE" ]; then
   exit 1
 fi
 
+BACKUP_DIR="$(cd "$BACKUP_DIR" && pwd)"
+BACKUP_ARCHIVE="${BACKUP_DIR}/$(basename "$BACKUP_ARCHIVE")"
 cd "$PROJECT_DIR"
 
-echo "Extracting backup..."
-tar -xzf "$BACKUP_ARCHIVE" -C "$BACKUP_DIR"
-
-echo "Restoring database..."
-docker compose exec -T postgres pg_restore \
-  -U "${POSTGRES_USER}" \
-  -d "${POSTGRES_DB}" \
-  --clean --if-exists \
-  < "${BACKUP_DIR}/${BACKUP_NAME}.dump"
-
-echo "Restoring attachments..."
-# Resolve the actual volume name via compose (handles project-name prefixes).
-UPLOADS_VOLUME=$(docker compose config --volumes uploads 2>/dev/null || echo "task-tracker_uploads")
-if [ -f "${BACKUP_DIR}/${BACKUP_NAME}-attachments.tar.gz" ]; then
-  docker run --rm \
-    -v "${UPLOADS_VOLUME}":/var/lib/tasktracker/uploads \
-    -v "${BACKUP_DIR}":/backup:ro \
-    --entrypoint /bin/sh \
-    debian:bookworm-slim \
-    -c "cd /var/lib/tasktracker/uploads && tar -xzf \"/backup/${BACKUP_NAME}-attachments.tar.gz\" && chown -R 999:999 /var/lib/tasktracker/uploads"
-else
-  echo "WARNING: no attachments archive found in backup; skipping" >&2
-fi
+# Reject traversal, links, duplicate members and unexpected payload before writing.
+python3 - "$BACKUP_ARCHIVE" "$BACKUP_NAME" <<'PY'
+import sys, tarfile
+archive, name = sys.argv[1:]
+with tarfile.open(archive, 'r:gz') as stream:
+    members = stream.getmembers()
+    expected = {name + '.dump', name + '-attachments.tar.gz'}
+    if len(members) != 2 or {m.name for m in members} != expected or not all(m.isfile() for m in members):
+        raise SystemExit('Invalid legacy product archive')
+PY
+
+tables="$("${COMPOSE[@]}" exec -T postgres psql -X -qAt -v ON_ERROR_STOP=1 \
+  -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "SELECT count(*) FROM pg_tables WHERE schemaname NOT IN ('pg_catalog','information_schema')")"
+test "$tables" = 0 || { echo "Restore requires an empty disposable database." >&2; exit 1; }
+BACKEND_ID="$("${COMPOSE[@]}" ps -q "${SDLC_BACKEND_SERVICE:-task-backend}")"
+test -n "$BACKEND_ID"
+UPLOADS_VOLUME="$("${DOCKER[@]}" inspect --format '{{range .Mounts}}{{if eq .Destination "/var/lib/tasktracker/uploads"}}{{.Name}}{{end}}{{end}}' "$BACKEND_ID")"
+test -n "$UPLOADS_VOLUME"
+VOLUME_PROJECT="$("${DOCKER[@]}" volume inspect --format '{{index .Labels "com.docker.compose.project"}}' "$UPLOADS_VOLUME")"
+VOLUME_TASK="$("${DOCKER[@]}" volume inspect --format '{{index .Labels "sdlc.task"}}' "$UPLOADS_VOLUME")"
+VOLUME_PURPOSE="$("${DOCKER[@]}" volume inspect --format '{{index .Labels "sdlc.purpose"}}' "$UPLOADS_VOLUME")"
+test "$VOLUME_PROJECT" = "$SDLC_COMPOSE_PROJECT" && test "$VOLUME_TASK" = "$SDLC_TASK" && test "$VOLUME_PURPOSE" = "$SDLC_PURPOSE" || {
+  echo "Foreign or unowned attachment volume; operation refused." >&2; exit 1;
+}
+
+empty="$(python3 "$BASE_DIR/scripts/compose_probe.py" --context "$SDLC_DOCKER_CONTEXT" \
+  --task task-restore --purpose legacy-destination-preflight -- \
+  --volume "${UPLOADS_VOLUME}:/data:ro" --entrypoint /bin/sh debian:bookworm-slim \
+  -c 'find /data -mindepth 1 -print -quit')"
+test -z "$empty" || { echo "Restore requires empty attachments." >&2; exit 1; }
 
-echo "Restore complete."
\ No newline at end of file
+umask 077
+scratch="$(mktemp -d)"
+cleanup() { rm -f -- "$scratch/attachments.tar.gz"; rmdir -- "$scratch"; }
+trap cleanup EXIT
+tar -xOzf "$BACKUP_ARCHIVE" "$BACKUP_NAME-attachments.tar.gz" > "$scratch/attachments.tar.gz"
+# Inner attachment paths must also stay within the selected volume.
+python3 - "$scratch/attachments.tar.gz" <<'PY'
+import sys, tarfile
+from pathlib import PurePosixPath
+with tarfile.open(sys.argv[1], 'r:gz') as stream:
+    for member in stream:
+        path = PurePosixPath(member.name)
+        if path.is_absolute() or '..' in path.parts or not (member.isfile() or member.isdir()):
+            raise SystemExit('Unsafe attachment archive')
+PY
+tar -xOzf "$BACKUP_ARCHIVE" "$BACKUP_NAME.dump" | \
+  "${COMPOSE[@]}" exec -T postgres pg_restore -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
+    --single-transaction --exit-on-error --no-owner
+python3 "$BASE_DIR/scripts/compose_probe.py" --context "$SDLC_DOCKER_CONTEXT" \
+  --task task-restore --purpose legacy-attachments-restore -- \
+  --volume "${UPLOADS_VOLUME}:/var/lib/tasktracker/uploads" --volume "$scratch:/backup:ro" \
+  --entrypoint /bin/sh debian:bookworm-slim \
+  -c 'cd /var/lib/tasktracker/uploads && tar -xzf /backup/attachments.tar.gz && chown -R 999:999 .'
+echo "Restore complete."
