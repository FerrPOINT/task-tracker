diff --git a/backend/api/src/routes/health.rs b/backend/api/src/routes/health.rs
index 911a6a2..e425d3d 100644
--- a/backend/api/src/routes/health.rs
+++ b/backend/api/src/routes/health.rs
@@ -15,3 +15,19 @@ pub async fn catalog_health() -> &'static str {
 pub async fn health() -> &'static str {
     catalog_health().await
 }
+
+#[utoipa::path(get, path = "/api/v1/health/ready",
+    responses((status = 200, body = String), (status = 503, body = String)))]
+pub async fn readiness(
+    axum::extract::State(ctx): axum::extract::State<std::sync::Arc<app::AppContext>>,
+) -> Result<&'static str, (axum::http::StatusCode, &'static str)> {
+    match tokio::time::timeout(
+        std::time::Duration::from_secs(4),
+        ctx.repos.readiness.check(),
+    )
+    .await
+    {
+        Ok(Ok(())) => Ok("ready"),
+        _ => Err((axum::http::StatusCode::SERVICE_UNAVAILABLE, "not ready")),
+    }
+}
