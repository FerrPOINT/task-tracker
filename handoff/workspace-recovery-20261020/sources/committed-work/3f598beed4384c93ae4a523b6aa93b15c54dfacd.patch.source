diff --git a/backend/infra/src/repos.rs b/backend/infra/src/repos.rs
index 1d8ab5f..c1b9d63 100644
--- a/backend/infra/src/repos.rs
+++ b/backend/infra/src/repos.rs
@@ -29,6 +29,55 @@ use shared::{
 };
 use uuid::Uuid;
 
+struct ReadinessRepo {
+    db: Arc<DatabaseConnection>,
+}
+
+#[async_trait]
+impl domain::ReadinessRepository for ReadinessRepo {
+    async fn check(&self) -> Result<(), AppError> {
+        use migration::MigratorTrait;
+        use sea_orm::{DatabaseBackend, Statement};
+        use std::time::Duration;
+        let ledger = tokio::time::timeout(
+            Duration::from_secs(2),
+            self.db.query_all(Statement::from_string(
+                DatabaseBackend::Postgres,
+                "SELECT version FROM seaql_migrations",
+            )),
+        )
+        .await
+        .map_err(|_| AppError::database("readiness timeout"))?
+        .map_err(AppError::database)?;
+        let mut actual = ledger
+            .iter()
+            .map(|row| row.try_get::<String>("", "version"))
+            .collect::<Result<Vec<_>, _>>()
+            .map_err(AppError::database)?;
+        let mut expected = migration::Migrator::migrations()
+            .iter()
+            .map(|migration| migration.name().to_owned())
+            .collect::<Vec<_>>();
+        actual.sort();
+        expected.sort();
+        if actual != expected {
+            return Err(AppError::database("incompatible migration ledger"));
+        }
+        // Planning this read verifies required schema without reading user rows.
+        tokio::time::timeout(
+            Duration::from_secs(2),
+            self.db.query_all(Statement::from_string(
+                DatabaseBackend::Postgres,
+                "SELECT u.id, i.id, i.project_id FROM users u CROSS JOIN issues i LIMIT 0",
+            )),
+        )
+        .await
+        .map_err(|_| AppError::database("readiness timeout"))?
+        .map_err(AppError::database)?;
+        Ok(())
+    }
+}
+
 use crate::entities::{
     attachment, audit_log, board, comment, custom_field, issue, issue_custom_field_value,
     issue_label, issue_link, issue_status_history, issue_type, issue_vote, issue_watcher, label,
@@ -130,6 +179,7 @@ fn custom_field_value_active_model(
     }
 }
