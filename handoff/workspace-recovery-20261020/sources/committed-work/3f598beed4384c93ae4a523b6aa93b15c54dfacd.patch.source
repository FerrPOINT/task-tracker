+/// A read-only storage compatibility probe, independent of user permissions.
+#[async_trait]
+pub trait ReadinessRepository: Send + Sync {
+    async fn check(&self) -> Result<(), AppError>;
+}
+
+pub struct StubReadinessRepository;
+#[async_trait]
+impl ReadinessRepository for StubReadinessRepository {
+    async fn check(&self) -> Result<(), AppError> {
+        Err(AppError::database("readiness storage is not configured"))
+    }
+}
