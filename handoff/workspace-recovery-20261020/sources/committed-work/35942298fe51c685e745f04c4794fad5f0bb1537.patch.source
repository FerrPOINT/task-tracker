diff --git a/frontend/src/api/client-http.test.ts b/frontend/src/api/client-http.test.ts
new file mode 100644
index 0000000..8d4bf48
--- /dev/null
+++ b/frontend/src/api/client-http.test.ts
@@ -0,0 +1,99 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const logout = vi.hoisted(() => vi.fn())
+vi.mock('@/shared/auth/store', () => ({
+  useAuthStore: { getState: () => ({ token: 'synthetic-token', logout }) },
+}))
+
+describe('generated client HTTP errors', () => {
+  beforeEach(() => {
+    vi.resetModules()
+    vi.stubEnv('VITE_API_BASE_URL', 'https://task.example.invalid')
+    logout.mockClear()
+  })
+  afterEach(() => {
+    vi.unstubAllGlobals()
+    vi.unstubAllEnvs()
+  })
+
+  it.each([403, 404, 422, 503])(
+    'retains status, business code and header request ID for %s',
+    async (status) => {
+      const fetch = vi.fn().mockResolvedValue(
+        new Response(
+          JSON.stringify({
+            error: { code: 'SYNTHETIC', message: 'Synthetic failure', request_id: 'body-id' },
+          }),
+          { status, headers: { 'x-request-id': 'header-id' } },
+        ),
+      )
+      vi.stubGlobal('fetch', fetch)
+      const { api } = await import('./client')
+      await expect(api.GET('/api/v1/projects')).rejects.toMatchObject({
+        name: 'ApiError',
+        status,
+        code: 'SYNTHETIC',
+        requestId: 'header-id',
+        message: 'Synthetic failure',
+      })
+      expect(fetch).toHaveBeenCalledOnce()
+      expect(logout).not.toHaveBeenCalled()
+    },
+  )
+
+  it.each([null, '<html>proxy unavailable</html>'])(
+    'retains empty and non-JSON error status',
+    async (body) => {
+      vi.stubGlobal(
+        'fetch',
+        vi.fn().mockResolvedValue(
+          new Response(body, {
+            status: 503,
+            headers: { 'x-request-id': 'proxy-id' },
+          }),
+        ),
+      )
+      const { api } = await import('./client')
+      await expect(api.GET('/api/v1/projects')).rejects.toMatchObject({
+        name: 'ApiError',
+        status: 503,
+        requestId: 'proxy-id',
+      })
+    },
+  )
+
+  it('keeps issue 404 as null without swallowing denial or unavailable responses', async () => {
+    const fetch = vi
+      .fn()
+      .mockResolvedValueOnce(new Response(null, { status: 404 }))
+      .mockResolvedValueOnce(new Response(null, { status: 403 }))
+      .mockResolvedValueOnce(new Response(null, { status: 503 }))
+    vi.stubGlobal('fetch', fetch)
+    const { getIssue } = await import('./issue')
+    await expect(getIssue('00000000-0000-4000-8000-000000000001')).resolves.toBeNull()
+    await expect(getIssue('00000000-0000-4000-8000-000000000001')).rejects.toMatchObject({
+      status: 403,
+    })
+    await expect(getIssue('00000000-0000-4000-8000-000000000001')).rejects.toMatchObject({
+      status: 503,
+    })
+  })
+
+  it('preserves search validation handling, business code and correlation', async () => {
+    vi.stubGlobal(
+      'fetch',
+      vi.fn().mockResolvedValue(
+        new Response(
+          JSON.stringify({
+            error: { code: 'INVALID_JQL', message: 'Invalid expression', request_id: 'legacy-id' },
+          }),
+          { status: 400 },
+        ),
+      ),
+    )
+    const { searchIssues, SearchRequestError } = await import('./search')
+    const error = await searchIssues({ jql: 'synthetic-invalid' }).catch((error) => error)
+    expect(error).toBeInstanceOf(SearchRequestError)
+    expect(error).toMatchObject({ status: 400, code: 'INVALID_JQL', requestId: 'legacy-id' })
+  })
+})
