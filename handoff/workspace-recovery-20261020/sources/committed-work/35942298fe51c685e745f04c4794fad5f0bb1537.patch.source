diff --git a/frontend/src/api/search.ts b/frontend/src/api/search.ts
index 00eaa31..c3b0b2d 100644
--- a/frontend/src/api/search.ts
+++ b/frontend/src/api/search.ts
@@ -1,4 +1,5 @@
 import { api } from './client'
+import { ApiError } from '@sdlc/ui/lib'
 import type { components } from './generated'
 
 export type Issue = components['schemas']['IssueResponse']
@@ -16,31 +17,37 @@ export interface SearchFilters {
   offset?: number
 }
 
-export class SearchRequestError extends Error {
-  constructor(public readonly status: number) {
-    super('Failed to search')
+export class SearchRequestError extends ApiError {
+  constructor(status: number, original?: ApiError) {
+    super(status, original?.message ?? 'Failed to search', original?.body, original?.requestId)
   }
 }
 
 export async function searchIssues(filters: SearchFilters = {}): Promise<Issue[]> {
-  const { data, response } = await api.GET('/api/v1/search', {
-    params: {
-      query: Object.fromEntries(
-        Object.entries({
-          q: filters.q,
-          project_key: filters.project_key,
-          status: filters.status,
-          assignee_id: filters.assignee_id,
-          priority: filters.priority,
-          sort_by: filters.sort_by,
-          sort_order: filters.sort_order,
-          jql: filters.jql,
-          limit: filters.limit,
-          offset: filters.offset,
-        }).filter(([, v]) => v !== undefined && v !== ''),
-      ),
-    },
-  })
-  if (!data) throw new SearchRequestError(response.status)
-  return data.issues ?? []
+  try {
+    const { data, response } = await api.GET('/api/v1/search', {
+      params: {
+        query: Object.fromEntries(
+          Object.entries({
+            q: filters.q,
+            project_key: filters.project_key,
+            status: filters.status,
+            assignee_id: filters.assignee_id,
+            priority: filters.priority,
+            sort_by: filters.sort_by,
+            sort_order: filters.sort_order,
+            jql: filters.jql,
+            limit: filters.limit,
+            offset: filters.offset,
+          }).filter(([, v]) => v !== undefined && v !== ''),
+        ),
+      },
+    })
+    if (!data) throw new SearchRequestError(response.status)
+    return data.issues ?? []
+  } catch (error) {
+    if (error instanceof ApiError && !(error instanceof SearchRequestError))
+      throw new SearchRequestError(error.status, error)
+    throw error
+  }
 }
