diff --git a/frontend/src/api/read-states.test.ts b/frontend/src/api/read-states.test.ts
new file mode 100644
index 0000000..95f718c
--- /dev/null
+++ b/frontend/src/api/read-states.test.ts
@@ -0,0 +1,43 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { ApiError } from '@sdlc/ui/lib'
+import { getDashboard } from './dashboard'
+import { getIssue } from './issue'
+import { listProjects } from './project'
+
+const get = vi.hoisted(() => vi.fn())
+vi.mock('./client', () => ({ api: { GET: get } }))
+
+describe('read response states', () => {
+  beforeEach(() => {
+    get.mockReset()
+  })
+  for (const [name, read] of [
+    ['dashboard', getDashboard],
+    ['projects', listProjects],
+    ['issue', () => getIssue('missing')],
+  ] as const) {
+    it.each([403, 503])(
+      `preserves HTTP %s from ${name} for Base state handling`,
+      async (status) => {
+        const error = {
+          error: { code: status === 403 ? 'FORBIDDEN' : 'UNAVAILABLE', message: 'Rejected' },
+        }
+        get.mockResolvedValue({ data: undefined, error, response: new Response(null, { status }) })
+        await expect(read()).rejects.toBeInstanceOf(ApiError)
+        await expect(read()).rejects.toMatchObject({ status, body: error })
+      },
+    )
+  }
+  it('retains the existing null contract for an absent issue', async () => {
+    get.mockResolvedValue({
+      data: undefined,
+      error: {},
+      response: new Response(null, { status: 404 }),
+    })
+    await expect(getIssue('missing')).resolves.toBeNull()
+  })
+  it('does not swallow a network failure or substitute an empty project catalog', async () => {
+    get.mockRejectedValue(new Error('Network unavailable'))
+    await expect(listProjects()).rejects.toThrow('Network unavailable')
+  })
+})
