+  it.each([400, 403, 404])('does not offer automatic write retry after HTTP %s', async (status) => {
+    mockHooks()
+    const one = vi.fn().mockRejectedValue(new ApiError(status, 'Internal'))
+    useMarkNotificationRead.mockReturnValue({ mutateAsync: one })
+    renderPage()
+    fireEvent.click(screen.getByRole('button', { name: /Отметить прочитанным: Issue updated/ }))
+    await screen.findByText('Не удалось отметить уведомление прочитанным.')
+    expect(screen.queryByRole('button', { name: 'Повторить' })).not.toBeInTheDocument()
+    expect(screen.getByText('Issue updated')).toBeInTheDocument()
+  })
+
+  it('prevents overlapping one/all commands and restores focus after an unread row is removed', async () => {
+    mockHooks()
+    let resolve!: () => void
+    const one = vi.fn(
+      () =>
+        new Promise<void>((done) => {
+          resolve = done
+        }),
+    )
+    const all = vi.fn()
+    useMarkNotificationRead.mockReturnValue({ mutateAsync: one })
+    useMarkAllNotificationsRead.mockReturnValue({ mutateAsync: all })
+    const page = renderPage('/notifications?filter=unread')
+    const user = userEvent.setup()
+    await user.click(screen.getByRole('button', { name: /Отметить прочитанным: Issue updated/ }))
+    fireEvent.click(screen.getByRole('button', { name: 'Прочитать все' }))
+    expect(one).toHaveBeenCalledOnce()
+    expect(all).not.toHaveBeenCalled()
+    expect(screen.getByRole('tab', { name: 'Все' })).toBeDisabled()
+    useNotifications.mockReturnValue({ data: { notifications: [], unread_count: 0 }, error: null })
+    page.refresh()
+    await act(async () => resolve())
+    await waitFor(() => expect(screen.getByRole('region', { name: 'Уведомления' })).toHaveFocus())
+  })
+
+  it('does not navigate back after mark-all resolves on an unmounted page', async () => {
+    mockHooks()
+    let resolve!: () => void
+    const all = vi.fn(
+      () =>
+        new Promise<void>((done) => {
+          resolve = done
+        }),
+    )
+    useMarkAllNotificationsRead.mockReturnValue({ mutateAsync: all })
+    const page = renderPage('/notifications?page=2')
+    fireEvent.click(screen.getByRole('button', { name: 'Прочитать все' }))
+    await act(async () => {
+      await page.router.navigate('/issues/12')
+    })
+    await act(async () => resolve())
+    expect(page.router.state.location.pathname).toBe('/issues/12')
+    expect(screen.getByText('Issue destination')).toBeInTheDocument()
+  })
+
+  it('returns focus after cancelling the discard dialog and retains the draft', async () => {
+    mockHooks()
+    renderPage()
+    const user = userEvent.setup()
+    fireEvent.change(screen.getByRole('combobox'), { target: { value: 'hourly' } })
+    const cancel = screen.getByRole('button', { name: 'Отмена' })
+    await user.click(cancel)
+    await user.click(
+      within(screen.getByRole('alertdialog')).getByRole('button', { name: 'Отмена' }),
+    )
+    await waitFor(() => expect(cancel).toHaveFocus())
+    expect(screen.getByRole('combobox')).toHaveValue('hourly')
+    expect(screen.getByRole('button', { name: 'Сохранить' })).toBeEnabled()
+  })
 })
