+    await installTrackerMocks(page)
+    await page.setViewportSize({ width: 1920, height: 1080 })
+    let listStatus = 200
+    let settingsStatus = 200
+    let writes = 0
+    let release!: () => void
+    await page.route('**/api/v1/notifications**', (route) =>
+      routeJson(
+        route,
+        listStatus === 200
+          ? {
+              notifications: [
+                {
+                  id: 'safe-notification',
+                  title: 'Safe notification',
+                  body: 'Safe fixture',
+                  is_read: false,
+                  action_url: null,
+                  created_at: '2026-10-01T10:00:00Z',
+                },
+              ],
+              unread_count: 1,
+            }
+          : { error: { code: 'QA_FAILURE', message: 'Private diagnostic' } },
+        listStatus,
+      ),
+    )
+    await page.route('**/api/v1/notification-settings', async (route) => {
+      if (route.request().method() === 'PATCH') {
+        writes++
+        expect(route.request().postDataJSON()).toEqual({
+          email_frequency: 'hourly',
+          disabled_event_types: ['custom_event'],
+          notify_own_changes: false,
+        })
+        await new Promise<void>((resolve) => {
+          release = resolve
+        })
+        return routeJson(
+          route,
+          { error: { code: 'QA_FAILURE', message: 'Private diagnostic' } },
+          503,
+        )
+      }
+      return routeJson(
+        route,
+        settingsStatus === 200
+          ? {
+              email_frequency: 'daily',
+              disabled_event_types: ['custom_event'],
+              notify_own_changes: false,
+            }
+          : { error: { code: 'QA_FAILURE', message: 'Private diagnostic' } },
+        settingsStatus,
+      )
+    })
+    await page.goto(`${app}/notifications?page=2&source=qa#context`)
+    const frequency = page.getByRole('combobox', { name: 'Частота email' })
+    await frequency.selectOption('hourly')
+    await page.evaluate(() => {
+      const pushes: string[] = []
+      const original = history.pushState.bind(history)
+      history.pushState = (data, unused, url) => {
+        pushes.push(String(url))
+        original(data, unused, url)
+      }
+      Object.assign(window, { notificationFilterPushes: pushes })
+    })
+    await page.getByRole('tab', { name: 'Непрочитанные (1)' }).click()
+    await expect(frequency).toHaveValue('hourly')
+    await expect(page).toHaveURL(`${app}/notifications?source=qa&filter=unread#context`)
+    expect(await page.evaluate(() => Reflect.get(window, 'notificationFilterPushes'))).toEqual([
+      '/notifications?source=qa&filter=unread#context',
+    ])
+    await page.goBack()
+    await expect(frequency).toHaveValue('hourly')
+    await expect(page).toHaveURL(`${app}/notifications?page=2&source=qa#context`)
+    await page
+      .getByRole('navigation', { name: 'Основная навигация' })
+      .getByRole('link', { name: 'Проекты', exact: true })
+      .click()
+    await expect(page.getByRole('alertdialog')).toBeVisible()
+    await page.getByRole('alertdialog').getByRole('button', { name: 'Отмена', exact: true }).click()
+    await expect(frequency).toHaveValue('hourly')
+    const form = page.getByRole('form', { name: 'Настройки' })
+    await form.evaluate((element) => {
+      element.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }))
+      element.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }))
+    })
+    await expect.poll(() => writes).toBe(1)
+    await expect(frequency).toBeDisabled()
+    await expect(form).toHaveAttribute('aria-busy', 'true')
+    release()
+    await expect(
+      page.getByRole('status').filter({ hasText: 'Не удалось сохранить настройки.' }),
+    ).toBeVisible()
+    await expect(frequency).toHaveValue('hourly')
+    settingsStatus = 503
+    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
+    const preferences = page.getByRole('complementary', { name: 'Настройки' })
+    await expect(preferences.locator('[data-page-state="partial-error"]')).toBeVisible({
+      timeout: 45_000,
+    })
+    await expect(frequency).toBeDisabled()
+    await expect(page.getByText('Safe notification', { exact: true })).toBeVisible()
+    await expect(page.getByRole('button', { name: 'Прочитать все', exact: true })).toBeEnabled()
+    await page.screenshot({
+      path: testInfo.outputPath('notification-page-settings-partial-draft.png'),
+      fullPage: true,
+    })
+    settingsStatus = 200
+    await preferences.getByRole('button', { name: 'Повторить' }).click()
+    await expect(frequency).toBeEnabled()
+    await expect(frequency).toHaveValue('hourly')
+    listStatus = 503
+    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
+    const list = page.getByRole('region', { name: 'Уведомления', exact: true })
+    await expect(list.locator('[data-page-state="partial-error"]')).toBeVisible({ timeout: 45_000 })
+    await expect(
+      page.getByRole('button', { name: 'Отметить прочитанным: Safe notification' }),
+    ).toBeDisabled()
+    await expect(frequency).toBeEnabled()
+    await page.screenshot({
+      path: testInfo.outputPath('notification-page-list-partial.png'),
+      fullPage: true,
+    })
+    listStatus = 403
+    await list.getByRole('button', { name: 'Повторить' }).click()
+    await expect(list.locator('[data-page-state="permission-denied"]')).toBeVisible()
+    await expect(page.getByText('Safe notification', { exact: true })).toHaveCount(0)
+    await expect(list.getByRole('button', { name: 'Повторить' })).toHaveCount(0)
+    await expect(frequency).toHaveValue('hourly')
+    await page.screenshot({
+      path: testInfo.outputPath('notification-page-list-denied.png'),
+      fullPage: true,
+    })
+    const cancel = preferences.getByRole('button', { name: 'Отмена', exact: true })
+    await cancel.click()
+    await expect(page.getByRole('alertdialog')).toBeVisible()
+    await page.getByRole('alertdialog').getByRole('button', { name: 'Отмена', exact: true }).click()
+    await expect(cancel).toBeFocused()
+    await cancel.click()
+    await page.getByRole('button', { name: 'Отменить изменения', exact: true }).click()
+    await expect(frequency).toHaveValue('daily')
+    settingsStatus = 404
+    listStatus = 200
+    await page.reload()
+    await expect(preferences.locator('[data-page-state="not-found"]')).toBeVisible()
+    await expect(frequency).toHaveCount(0)
+    await expect(page.getByText('Safe notification', { exact: true })).toBeVisible()
+    await expect(preferences.getByRole('button', { name: 'Повторить' })).toHaveCount(0)
+    await page.screenshot({
+      path: testInfo.outputPath('notification-page-settings-not-found.png'),
+      fullPage: true,
+    })
+  })
