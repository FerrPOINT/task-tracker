diff --git a/backend/api/src/routes/sdlc_candidates.rs b/backend/api/src/routes/sdlc_candidates.rs
new file mode 100644
index 0000000..e623ae7
--- /dev/null
+++ b/backend/api/src/routes/sdlc_candidates.rs
@@ -0,0 +1,85 @@
+//! Parent mounts this handler on the existing SDLC-authenticated v1 router.
+use super::sdlc::service;
+use axum::{
+    Extension, Json,
+    extract::{Query, State},
+    http::{HeaderMap, HeaderValue, header},
+};
+use domain::{
+    sdlc::Principal,
+    sdlc_candidates::{DeliveryCandidates, DeliveryCandidatesQuery},
+};
+use shared::AppError;
+use std::sync::Arc;
+
+#[utoipa::path(get, path="/api/v1/sdlc/delivery-candidates", operation_id="read_single_task_delivery_candidates", tag="sdlc",
+    params(DeliveryCandidatesQuery), responses((status=200,body=DeliveryCandidates),(status=400),(status=401),
+        (status=403),(status=404),(status=409),(status=422),(status=503)), security(("bearer"=[])))]
+pub async fn delivery_candidates(
+    State(ctx): State<Arc<app::AppContext>>,
+    Extension(actor): Extension<Principal>,
+    Query(query): Query<DeliveryCandidatesQuery>,
+) -> Result<(HeaderMap, Json<DeliveryCandidates>), AppError> {
+    let result = service(&ctx)?.delivery_candidates(&actor, query).await?;
+    let mut headers = HeaderMap::new();
+    headers.insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    Ok((headers, Json(result)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use utoipa::OpenApi;
+
+    #[test]
+    fn candidate_handler_schema_is_bounded_authenticated_get_only() {
+        #[derive(utoipa::OpenApi)]
+        #[openapi(paths(delivery_candidates))]
+        struct Contract;
+        let schema = serde_json::to_value(Contract::openapi()).unwrap();
+        let path = &schema["paths"]["/api/v1/sdlc/delivery-candidates"];
+        assert!(path.get("post").is_none());
+        assert!(path["get"]["security"].is_array());
+        let parameters = path["get"]["parameters"].as_array().unwrap();
+        assert_eq!(parameters.len(), 3);
+        let limit = parameters.iter().find(|p| p["name"] == "limit").unwrap();
+        assert_eq!(limit["schema"]["default"], 50);
+        assert_eq!(limit["schema"]["minimum"], 1);
+        assert_eq!(limit["schema"]["maximum"], 100);
+        assert_eq!(limit["required"], false);
+    }
+
+    #[test]
+    fn actual_query_extractor_defaults_rejects_unknowns_and_validates_bounds() {
+        let project = uuid::Uuid::new_v4();
+        let uri = format!("/api/v1/sdlc/delivery-candidates?project_id={project}")
+            .parse()
+            .unwrap();
+        let Query(query) = Query::<DeliveryCandidatesQuery>::try_from_uri(&uri).unwrap();
+        assert_eq!(query.limit, 50);
+        query.validate().unwrap();
+        for suffix in [
+            "&limit=0",
+            "&limit=101",
+            "&after=00000000-0000-0000-0000-000000000000",
+        ] {
+            let uri = format!("/api/v1/sdlc/delivery-candidates?project_id={project}{suffix}")
+                .parse()
+                .unwrap();
+            let Query(query) = Query::<DeliveryCandidatesQuery>::try_from_uri(&uri).unwrap();
+            assert!(query.validate().is_err());
+        }
+        for suffix in [
+            "&claim=true",
+            "&limit=-1",
+            "&limit=abc",
+            "&after=invalid",
+            "&limit=1&limit=2",
+        ] {
+            let uri = format!("/api/v1/sdlc/delivery-candidates?project_id={project}{suffix}")
+                .parse()
+                .unwrap();
+            assert!(Query::<DeliveryCandidatesQuery>::try_from_uri(&uri).is_err());
+        }
+    }
+}
diff --git a/backend/app/src/sdlc_candidates.rs b/backend/app/src/sdlc_candidates.rs
new file mode 100644
index 0000000..8d309b4
--- /dev/null
+++ b/backend/app/src/sdlc_candidates.rs
@@ -0,0 +1,98 @@
+//! Discovery declares the existing next command; it never chooses roles or reserves capacity.
+use domain::sdlc::{DraftFlow, Principal, SdlcConfig, Stage, TaskState};
+use domain::sdlc_candidates::*;
+use domain::sdlc_lifecycle::{LifecycleReceipt, LifecycleStage, LifecycleStatus, RuntimeState};
+use shared::AppError;
+
+impl crate::sdlc::SdlcService {
+    pub async fn delivery_candidates(
+        &self,
+        actor: &Principal,
+        query: DeliveryCandidatesQuery,
+    ) -> Result<DeliveryCandidates, AppError> {
+        query.validate()?;
+        self.repository
+            .lifecycle_repository()
+            .ok_or_else(|| {
+                AppError::Unavailable("single-task lifecycle repository not configured".into())
+            })?
+            .delivery_candidates(actor, query)
+            .await
+    }
+}
+
+pub fn authorize(actor: &Principal, config: &SdlcConfig) -> Result<(), AppError> {
+    crate::sdlc_lifecycle::scheduler_read(actor, config)
+}
+
+/// Routing/revision/SQL owner predicates are checked by the repository in the same read.
+pub fn candidate(
+    state: &TaskState,
+    current: Option<&LifecycleReceipt>,
+    pm_completed: bool,
+) -> Result<Option<DeliveryCandidate>, AppError> {
+    if state.draft_flow()? != Some(DraftFlow::SingleTaskV1) {
+        return Ok(None);
+    }
+    state.require_root()?;
+    let Some(revision) = state.current_revision() else {
+        return Ok(None);
+    };
+    let (next_operation, task_version) = match current {
+        None if pm_completed && matches!(state.stage, Stage::Analysis | Stage::Architecture) => {
+            (CandidateOperation::EnsureQueued, None)
+        }
+        Some(receipt)
+            if receipt.task.status == LifecycleStatus::Ready
+                && receipt.task.runtime == RuntimeState::Queued
+                && receipt.assignment.is_none()
+                && receipt.task.stage.role().is_some()
+                && receipt.task.stage == LifecycleStage::from_legacy(state.stage) =>
+        {
+            (CandidateOperation::Reserve, Some(receipt.task.version))
+        }
+        _ => return Ok(None),
+    };
+    let candidate = DeliveryCandidate {
+        task_id: state.task_id,
+        root_task_id: state.root_task_id,
+        requirement_revision: revision,
+        next_operation,
+        task_version,
+    };
+    candidate.validate()?;
+    Ok(Some(candidate))
+}
+
+pub fn page(
+    query: &DeliveryCandidatesQuery,
+    mut items: Vec<DeliveryCandidate>,
+) -> Result<(Vec<DeliveryCandidate>, Option<uuid::Uuid>), AppError> {
+    query.validate()?;
+    let mut previous = query.after;
+    for item in &items {
+        item.validate()?;
+        if previous.is_some_and(|id| item.task_id <= id) {
+            return Err(AppError::conflict(
+                "delivery candidate UUID order is inconsistent",
+            ));
+        }
+        previous = Some(item.task_id);
+    }
+    if items.len() > usize::from(query.limit) + 1 {
+        return Err(AppError::conflict(
+            "delivery candidate query exceeded its bound",
+        ));
+    }
+    let next_cursor = if items.len() > usize::from(query.limit) {
+        items.truncate(usize::from(query.limit));
+        items.last().map(|item| item.task_id)
+    } else {
+        None
+    };
+    Ok((items, next_cursor))
+}
+
+#[cfg(test)]
+#[path = "sdlc_candidates_tests.rs"]
+mod tests;
diff --git a/backend/app/src/sdlc_candidates_tests.rs b/backend/app/src/sdlc_candidates_tests.rs
new file mode 100644
index 0000000..c7570dc
--- /dev/null
+++ b/backend/app/src/sdlc_candidates_tests.rs
@@ -0,0 +1,249 @@
+//! Synthetic policy fixtures only; no native execution or artifact acceptance claim.
+use super::*;
+use domain::sdlc_lifecycle::{LifecycleTask, RuntimeState};
+use domain::sdlc_routing::{RoleRoutes, RoutingPolicy, RoutingVerification, TaskRoutingSnapshot};
+use serde_json::json;
+use uuid::Uuid;
+
+fn config() -> SdlcConfig {
+    SdlcConfig {
+        instance_id: "candidates-test".into(),
+        orchestrator_subject: "pm".into(),
+        verifier_subject: "verifier".into(),
+        reservation_scheduler_subject: "scheduler".into(),
+        single_task_project_ids: Default::default(),
+    }
+}
+
+#[test]
+fn only_configured_scheduler_with_read_only_scope_can_discover() {
+    let actor = Principal {
+        subject: "scheduler".into(),
+        human_session: false,
+        trusted_human: false,
+        scopes: ["task-tracker:read".into()].into_iter().collect(),
+    };
+    authorize(&actor, &config()).unwrap();
+    for scopes in [
+        vec![],
+        vec!["task-tracker:write"],
+        vec!["task-tracker:read", "task-tracker:write"],
+        vec!["task-tracker:read", "task-tracker:sdlc:delivery:foreign"],
+    ] {
+        let mut wrong = actor.clone();
+        wrong.scopes = scopes.into_iter().map(str::to_owned).collect();
+        assert!(matches!(
+            authorize(&wrong, &config()),
+            Err(AppError::Forbidden)
+        ));
+    }
+    for subject in ["owner", "pm", "verifier", "another-scheduler"] {
+        let mut wrong = actor.clone();
+        wrong.subject = subject.into();
+        assert!(matches!(
+            authorize(&wrong, &config()),
+            Err(AppError::Forbidden)
+        ));
+    }
+    let mut human = actor.clone();
+    human.human_session = true;
+    assert!(matches!(
+        authorize(&human, &config()),
+        Err(AppError::Forbidden)
+    ));
+    let mut missing = config();
+    missing.reservation_scheduler_subject.clear();
+    assert!(matches!(
+        authorize(&actor, &missing),
+        Err(AppError::Unavailable(_))
+    ));
+}
+
+fn fixture() -> (TaskState, LifecycleReceipt) {
+    let task = Uuid::new_v4();
+    let project = Uuid::new_v4();
+    let mut routes = json!({});
+    for (i, role) in [
+        "project_manager",
+        "analyst",
+        "architect",
+        "developer",
+        "reviewer",
+        "tester",
+        "devops",
+    ]
+    .iter()
+    .enumerate()
+    {
+        let suffix = role.replace('_', "-");
+        routes[*role] = json!({"agent_id":Uuid::new_v4(),"fleet_config_revision":1,
+            "instruction_profile":"single-task-v1","instruction_manifest_sha256":"a".repeat(64),
+            "namespace_id":(i+1).to_string(),"namespace_name":format!("single-task-{suffix}"),
+            "workflow_id":(i+11).to_string(),"workflow_key":format!("single-task-v1:{role}"),
+            "profile":format!("single-task-v1-{suffix}"),"workflow_catalog_version":1,"workflow_catalog_sha256":"b".repeat(64)});
+    }
+    let routes: RoleRoutes = serde_json::from_value(routes).unwrap();
+    let policy = RoutingPolicy {
+        contract_version: 2,
+        tracker_instance_id: "candidates-test".into(),
+        project_id: project,
+        version: 1,
+        routing_hash: crate::sdlc::canonical_hash(&routes).unwrap(),
+        routes,
+        verification: RoutingVerification::Declared,
+        native_ready: false,
+        dispatch_allowed: false,
+        author_subject: "owner".into(),
+        created_at: chrono::Utc::now(),
+    };
+    let snapshot = TaskRoutingSnapshot {
+        contract_version: 2,
+        snapshot_id: Uuid::new_v4(),
+        tracker_instance_id: "candidates-test".into(),
+        project_id: project,
+        task_id: task,
+        root_task_id: task,
+        confirmation_id: Uuid::new_v4(),
+        requirement_revision: 1,
+        content_hash: "c".repeat(64),
+        policy,
+        created_at: chrono::Utc::now(),
+    };
+    let state: TaskState = serde_json::from_value(json!({"tracker_instance_id":"candidates-test",
+        "project_id":project,"task_id":task,"root_task_id":task,"owner_subject":"owner","stage":"Analysis",
+        "flow":"single-task-v1","confirmation_revision":1,"assignment":null,"questions":[],"confirmations":[],"evidence":[],
+        "revisions":[{"revision":1,"content_hash":"c".repeat(64),"goal":"fixture","scope":[],"exclusions":[],
+        "scenarios":[],"acceptance_criteria":[],"constraints":[],"dependencies":[],"assumptions":[],"checklist":[],
+        "prerequisites":[],"author_subject":"pm","created_at":chrono::Utc::now()}]})).unwrap();
+    let receipt = LifecycleReceipt {
+        task: LifecycleTask {
+            task_id: task,
+            owner_subject: "owner".into(),
+            version: 7,
+            stage: LifecycleStage::Analysis,
+            status: LifecycleStatus::Ready,
+            cycle: 0,
+            transient_retries: 0,
+            waiting_reason: Some("queued_for_assignment".into()),
+            runtime: RuntimeState::Queued,
+            routing: snapshot,
+            previous_result_id: None,
+            resume_chat_id: None,
+        },
+        assignment: None,
+        lease: None,
+        binding: None,
+        result: None,
+    };
+    (state, receipt)
+}
+
+#[test]
+fn consent_alone_never_discovers_analyst_before_actual_pm_completion() {
+    let (state, _) = fixture();
+    assert!(candidate(&state, None, false).unwrap().is_none());
+    let ready = candidate(&state, None, true).unwrap().unwrap();
+    assert_eq!(ready.next_operation, CandidateOperation::EnsureQueued);
+    assert_eq!(ready.task_version, None);
+    let mut legacy = state.clone();
+    legacy.retained_fields.remove("flow");
+    assert!(candidate(&legacy, None, true).unwrap().is_none());
+    for stage in [
+        Stage::Draft,
+        Stage::Backlog,
+        Stage::Development,
+        Stage::Deployment,
+    ] {
+        let mut early = state.clone();
+        early.stage = stage;
+        assert!(candidate(&early, None, true).unwrap().is_none());
+    }
+}
+
+#[test]
+fn only_ready_queued_unassigned_heads_produce_reserve_with_actual_cas() {
+    let (state, head) = fixture();
+    let ready = candidate(&state, Some(&head), false).unwrap().unwrap();
+    assert_eq!(ready.next_operation, CandidateOperation::Reserve);
+    assert_eq!(ready.task_version, Some(7));
+    for runtime in [
+        RuntimeState::Reserved,
+        RuntimeState::Running,
+        RuntimeState::Unknown,
+        RuntimeState::Terminal,
+    ] {
+        let mut wrong = head.clone();
+        wrong.task.runtime = runtime;
+        assert!(candidate(&state, Some(&wrong), true).unwrap().is_none());
+    }
+    for status in [LifecycleStatus::InProgress, LifecycleStatus::Completed] {
+        let mut wrong = head.clone();
+        wrong.task.status = status;
+        assert!(candidate(&state, Some(&wrong), true).unwrap().is_none());
+    }
+    let mut wrong = head.clone();
+    wrong.task.version = 0;
+    assert!(candidate(&state, Some(&wrong), true).is_err());
+    let mut assigned = head.clone();
+    assigned.assignment = Some(serde_json::from_value(json!({"assignment_id":Uuid::new_v4(),
+        "execution_id":Uuid::new_v4(),"task_id":state.task_id,"owner_subject":"owner","role":"analyst",
+        "stage":"Analysis","cycle":0,"attempt":1,"agent_id":head.task.routing.policy.routes.analyst.agent_id,
+        "routing":head.task.routing,"previous_result_id":null,"fencing_token":1,"lease_id":Uuid::new_v4(),
+        "assignment_hash":"a".repeat(64)})).unwrap());
+    assert!(candidate(&state, Some(&assigned), true).unwrap().is_none());
+    let mut wrong = state.clone();
+    wrong.root_task_id = Uuid::new_v4();
+    assert!(candidate(&wrong, Some(&head), true).is_err());
+    for stage in [
+        Stage::Analysis,
+        Stage::Architecture,
+        Stage::Development,
+        Stage::Review,
+        Stage::Testing,
+        Stage::Rework,
+        Stage::Deployment,
+    ] {
+        let mut state = state.clone();
+        let mut head = head.clone();
+        state.stage = stage;
+        head.task.stage = LifecycleStage::from_legacy(stage);
+        assert_eq!(
+            candidate(&state, Some(&head), true)
+                .unwrap()
+                .unwrap()
+                .next_operation,
+            CandidateOperation::Reserve
+        );
+    }
+}
+
+#[test]
+fn uuid_keyset_uses_last_returned_not_lookahead_and_empty_pages_have_null_cursor() {
+    let query = DeliveryCandidatesQuery {
+        project_id: Uuid::new_v4(),
+        after: None,
+        limit: 2,
+    };
+    let item = |n| DeliveryCandidate {
+        task_id: Uuid::from_u128(n),
+        root_task_id: Uuid::from_u128(n),
+        requirement_revision: 1,
+        next_operation: CandidateOperation::Reserve,
+        task_version: Some(7),
+    };
+    let (first, cursor) = page(&query, vec![item(2), item(7), item(99)]).unwrap();
+    assert_eq!(first.len(), 2);
+    assert_eq!(cursor, Some(Uuid::from_u128(7)));
+    let second = DeliveryCandidatesQuery {
+        after: cursor,
+        ..query.clone()
+    };
+    let (last, cursor) = page(&second, vec![item(99)]).unwrap();
+    assert_eq!(last.len(), 1);
+    assert_eq!(cursor, None);
+    assert_eq!(page(&query, vec![]).unwrap(), (vec![], None));
+    assert!(page(&second, vec![item(7)]).is_err());
+    assert!(page(&query, vec![item(7), item(2)]).is_err());
+    assert!(page(&query, vec![item(2), item(2)]).is_err());
+    assert!(page(&query, vec![item(1), item(2), item(3), item(4)]).is_err());
+}
diff --git a/backend/domain/src/sdlc_candidates.rs b/backend/domain/src/sdlc_candidates.rs
new file mode 100644
index 0000000..fd3609f
--- /dev/null
+++ b/backend/domain/src/sdlc_candidates.rs
@@ -0,0 +1,224 @@
+//! Read-only discovery of existing single-task lifecycle work, never a reservation.
+use crate::sdlc::{MAX_SAFE_VERSION, safe_optional_version, safe_version};
+use chrono::{DateTime, Utc};
+use serde::{Deserialize, Serialize};
+use shared::AppError;
+use uuid::Uuid;
+
+pub const DEFAULT_LIMIT: u16 = 50;
+pub const MAX_LIMIT: u16 = 100;
+
+fn default_limit() -> u16 {
+    DEFAULT_LIMIT
+}
+
+#[derive(Clone, Debug, Deserialize, utoipa::IntoParams)]
+#[serde(deny_unknown_fields)]
+pub struct DeliveryCandidatesQuery {
+    pub project_id: Uuid,
+    pub after: Option<Uuid>,
+    #[serde(default = "default_limit")]
+    #[param(value_type = Option<u16>, minimum = 1, maximum = 100, default = 50)]
+    pub limit: u16,
+}
+
+impl DeliveryCandidatesQuery {
+    pub fn validate(&self) -> Result<(), AppError> {
+        if self.project_id.is_nil()
+            || self.after.is_some_and(|id| id.is_nil())
+            || !(1..=MAX_LIMIT).contains(&self.limit)
+        {
+            return Err(AppError::validation("invalid delivery candidates query"));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy, Debug, Serialize, Deserialize, PartialEq, Eq, utoipa::ToSchema)]
+#[serde(rename_all = "snake_case")]
+pub enum CandidateOperation {
+    EnsureQueued,
+    Reserve,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq, utoipa::ToSchema)]
+#[serde(deny_unknown_fields)]
+pub struct DeliveryCandidate {
+    pub task_id: Uuid,
+    pub root_task_id: Uuid,
+    #[serde(deserialize_with = "safe_version")]
+    #[schema(minimum = 1, maximum = 9007199254740991i64)]
+    pub requirement_revision: i64,
+    pub next_operation: CandidateOperation,
+    #[serde(deserialize_with = "safe_optional_version")]
+    #[schema(
+        required = true,
+        nullable = true,
+        minimum = 1,
+        maximum = 9007199254740991i64
+    )]
+    pub task_version: Option<i64>,
+}
+
+impl DeliveryCandidate {
+    pub fn validate(&self) -> Result<(), AppError> {
+        if self.task_id.is_nil()
+            || self.root_task_id != self.task_id
+            || !(1..=MAX_SAFE_VERSION).contains(&self.requirement_revision)
+            || match (self.next_operation, self.task_version) {
+                (CandidateOperation::EnsureQueued, None) => false,
+                (CandidateOperation::Reserve, Some(version)) => {
+                    !(1..=MAX_SAFE_VERSION).contains(&version)
+                }
+                _ => true,
+            }
+        {
+            return Err(AppError::conflict(
+                "invalid delivery candidate identity/version",
+            ));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, utoipa::ToSchema)]
+#[serde(deny_unknown_fields)]
+pub struct DeliveryCandidates {
+    #[schema(minimum = 1, maximum = 1)]
+    pub contract_version: u8,
+    pub tracker_instance_id: String,
+    pub project_id: Uuid,
+    #[serde(serialize_with = "crate::sdlc_execution_lease::utc_nanos")]
+    pub observed_at: DateTime<Utc>,
+    pub items: Vec<DeliveryCandidate>,
+    #[schema(required = true, nullable = true)]
+    pub next_cursor: Option<Uuid>,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn query_defaults_bounds_and_closed_shape() {
+        let project = Uuid::new_v4();
+        let query: DeliveryCandidatesQuery =
+            serde_json::from_value(json!({"project_id":project})).unwrap();
+        assert_eq!(query.limit, DEFAULT_LIMIT);
+        query.validate().unwrap();
+        for limit in [0, 101, u16::MAX] {
+            assert!(
+                DeliveryCandidatesQuery {
+                    limit,
+                    ..query.clone()
+                }
+                .validate()
+                .is_err()
+            );
+        }
+        for limit in [1, MAX_LIMIT] {
+            DeliveryCandidatesQuery {
+                limit,
+                ..query.clone()
+            }
+            .validate()
+            .unwrap();
+        }
+        assert!(
+            DeliveryCandidatesQuery {
+                project_id: Uuid::nil(),
+                ..query.clone()
+            }
+            .validate()
+            .is_err()
+        );
+        assert!(
+            DeliveryCandidatesQuery {
+                after: Some(Uuid::nil()),
+                ..query
+            }
+            .validate()
+            .is_err()
+        );
+        assert!(
+            serde_json::from_value::<DeliveryCandidatesQuery>(
+                json!({"project_id":project,"claim":true})
+            )
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn wire_is_closed_nullable_and_never_claims_an_assignment() {
+        let task = Uuid::new_v4();
+        let item = DeliveryCandidate {
+            task_id: task,
+            root_task_id: task,
+            requirement_revision: 1,
+            next_operation: CandidateOperation::EnsureQueued,
+            task_version: None,
+        };
+        let value = serde_json::to_value(&item).unwrap();
+        assert_eq!(
+            value,
+            json!({"task_id":task,"root_task_id":task,"requirement_revision":1,
+            "next_operation":"ensure_queued","task_version":null})
+        );
+        item.validate().unwrap();
+        for (operation, version) in [
+            (CandidateOperation::EnsureQueued, Some(1)),
+            (CandidateOperation::Reserve, None),
+            (CandidateOperation::Reserve, Some(0)),
+        ] {
+            assert!(
+                DeliveryCandidate {
+                    next_operation: operation,
+                    task_version: version,
+                    ..item.clone()
+                }
+                .validate()
+                .is_err()
+            );
+        }
+        assert!(
+            DeliveryCandidate {
+                root_task_id: Uuid::new_v4(),
+                ..item.clone()
+            }
+            .validate()
+            .is_err()
+        );
+        let mut unknown = value.clone();
+        unknown["assignment_id"] = json!(Uuid::new_v4());
+        assert!(serde_json::from_value::<DeliveryCandidate>(unknown).is_err());
+        let mut missing = value;
+        missing.as_object_mut().unwrap().remove("task_version");
+        assert!(serde_json::from_value::<DeliveryCandidate>(missing).is_err());
+        let page = DeliveryCandidates {
+            contract_version: 1,
+            tracker_instance_id: "fixture".into(),
+            project_id: Uuid::new_v4(),
+            observed_at: Utc::now(),
+            items: vec![item],
+            next_cursor: None,
+        };
+        let wire = serde_json::to_value(page).unwrap();
+        assert_eq!(wire.as_object().unwrap().len(), 6);
+        assert!(wire["next_cursor"].is_null());
+        assert!(wire["observed_at"].as_str().unwrap().ends_with('Z'));
+        assert_eq!(
+            wire["observed_at"]
+                .as_str()
+                .unwrap()
+                .split('.')
+                .last()
+                .unwrap()
+                .len(),
+            10
+        );
+        let mut unknown = wire;
+        unknown["dispatch_allowed"] = json!(true);
+        assert!(serde_json::from_value::<DeliveryCandidates>(unknown).is_err());
+    }
+}
