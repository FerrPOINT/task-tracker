+    view.update({ error: new Error('Save failed') })
+    expect(screen.getByRole('alert')).toHaveTextContent('Save failed')
+    expect(screen.getByDisplayValue('Draft')).not.toBeDisabled()
+  })
+
+  it('preserves a draft in read-only refresh-error mode without locking cancellation', async () => {
+    const view = renderForm({ project })
+    changeName('Draft')
+    view.update({ readOnly: true, error: new Error('Catalog unavailable') })
+    expect(screen.getByDisplayValue('Draft')).toBeDisabled()
+    expect(screen.getByRole('button', { name: 'Save' })).toBeDisabled()
+    expect(screen.getByRole('button', { name: 'Cancel' })).not.toBeDisabled()
+    fireEvent.submit(screen.getByDisplayValue('Draft').closest('form')!)
+    await act(async () => {})
+    expect(view.props.onSubmit).not.toHaveBeenCalled()
+    cancel()
+    expect(await screen.findByRole('alertdialog')).toBeInTheDocument()
+  })
+
+  it('reinitializes from current server values only for a newly opened session', () => {
+    const view = renderForm({ project })
+    changeName('Draft')
+    view.update({ open: false })
+    view.update({ open: true, project: { ...project, name: 'Latest server name' } })
+    expect(screen.getByDisplayValue('Latest server name')).toBeInTheDocument()
+    expect(screen.queryByDisplayValue('Draft')).not.toBeInTheDocument()
   })
 })
