+
+  it('locks async submission and closing, then retains failed values and error', async () => {
+    let reject!: (error: Error) => void
+    const pending = new Promise<void>((_, fail) => {
+      reject = fail
+    })
+    const onSubmit = vi.fn(() => pending)
+    const view = renderForm({ project, onSubmit })
