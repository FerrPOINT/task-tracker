 test.describe('smoke', () => {
+  test('distinguishes cached catalog refresh failures from revoked access without losing a retained draft', async ({
+    page,
+    baseURL,
+  }, testInfo) => {
+    test.setTimeout(120_000)
+    const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
+    await installTrackerMocks(page)
+    await page.setViewportSize({ width: 1920, height: 1080 })
+    await page.goto(`${app}/projects`)
+    const trigger = page.getByRole('button', { name: `Действия с проектом ${mockUser.name}` })
+    await trigger.click()
+    await page.getByRole('menuitem', { name: 'Изменить', exact: true }).click()
+    const dialog = page.getByRole('dialog')
+    const name = dialog.locator('#project-form-name')
+    await name.fill('Retained draft during refresh')
+    let status = 503
+    await page.route('**/api/v1/projects', (route) =>
+      routeJson(
+        route,
+        { error: { code: 'QA_CATALOG_FAILURE', message: 'Controlled catalog failure' } },
+        status,
+      ),
+    )
+    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
+    await expect(page.locator('[data-page-state="partial-error"]')).toBeVisible({ timeout: 45_000 })
+    await expect(name).toHaveValue('Retained draft during refresh')
+    await expect(name).toBeDisabled()
+    await expect(dialog.getByRole('button', { name: 'Сохранить', exact: true })).toBeDisabled()
+    await expect(dialog.getByRole('button', { name: 'Отмена', exact: true })).toBeEnabled()
+    await page.screenshot({
+      path: testInfo.outputPath('project-refresh-partial-draft.png'),
+      fullPage: true,
+    })
+    await dialog.getByRole('button', { name: 'Отмена', exact: true }).click()
+    await page
+      .getByRole('alertdialog')
+      .getByRole('button', { name: 'Подтвердить', exact: true })
+      .click()
+    await expect(dialog).toBeHidden()
+    await expect(trigger).toBeDisabled()
+    await expect(
+      page.locator('main').getByRole('link', { name: new RegExp(mockUser.name) }),
+    ).toBeVisible()
+    await expect(page.getByRole('button', { name: 'Создать проект', exact: true })).toHaveCount(0)
+    status = 403
+    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
+    await expect(page.locator('[data-page-state="permission-denied"]')).toBeVisible()
+    await expect(
+      page.locator('main').getByRole('link', { name: new RegExp(mockUser.name) }),
+    ).toHaveCount(0)
+    await expect(page.getByRole('button', { name: 'Создать проект', exact: true })).toHaveCount(0)
+    await expect(page.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(0)
+    await page.screenshot({
+      path: testInfo.outputPath('project-cached-access-revoked.png'),
+      fullPage: true,
+    })
+    status = 404
+    await page.reload()
+    await expect(page.locator('[data-page-state="not-found"]')).toBeVisible()
+    await expect(page.getByRole('button', { name: 'Создать проект', exact: true })).toHaveCount(0)
+    await expect(page.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(0)
+    await page.screenshot({
+      path: testInfo.outputPath('project-cold-not-found.png'),
+      fullPage: true,
+    })
+  })
+
+  test('preserves project URL history, dirty drafts, pending focus and successful creation', async ({
+    page,
+    baseURL,
+  }, testInfo) => {
+    test.setTimeout(120_000)
+    const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
+    await installTrackerMocks(page)
+    await page.setViewportSize({ width: 1920, height: 1080 })
+    await page.goto(`${app}/projects?q=DEMO&page=4&view=compact#context`)
+    const search = page.getByRole('textbox', { name: 'Поиск проектов...' })
+    await expect(search).toHaveValue('DEMO')
+    await search.fill('No matching project')
+    await page.getByRole('button', { name: 'Поиск проектов...' }).click()
+    await expect(page.getByText('По вашему запросу проекты не найдены.')).toBeVisible()
+    expect(new URL(page.url()).searchParams.has('page')).toBe(false)
+    expect(new URL(page.url()).searchParams.get('view')).toBe('compact')
+    expect(new URL(page.url()).hash).toBe('#context')
+    await page.reload()
+    await expect(search).toHaveValue('No matching project')
+    await page.goBack()
+    await expect(search).toHaveValue('DEMO')
+    const trigger = page.getByRole('button', { name: 'Создать проект', exact: true })
+    await trigger.click()
+    const dialog = page.getByRole('dialog')
+    const key = dialog.locator('#project-form-key')
+    const name = dialog.locator('#project-form-name')
+    await key.fill('qa-2026')
+    await name.fill('Safe isolated project draft')
+    await name.focus()
+    await page.keyboard.press('Escape')
+    const discard = page.getByRole('alertdialog')
+    await expect(discard).toBeVisible()
+    await discard.getByRole('button', { name: 'Отмена', exact: true }).click()
+    await expect(name).toHaveValue('Safe isolated project draft')
+    await expect(name).toBeFocused()
+    let submissions = 0
+    let release!: () => void
+    const pending = new Promise<void>((resolve) => {
+      release = resolve
+    })
+    await page.route('**/api/v1/projects', async (route) => {
+      if (route.request().method() !== 'POST') return route.fallback()
+      submissions++
+      await pending
+      return routeJson(
+        route,
+        { error: { code: 'UNAVAILABLE', message: 'Controlled create failure' } },
+        503,
+      )
+    })
+    await dialog.getByRole('button', { name: 'Создать проект', exact: true }).click()
+    await expect(dialog.getByRole('button', { name: 'Отмена', exact: true })).toBeDisabled()
+    await expect(dialog.getByRole('button', { name: 'Закрыть', exact: true })).toBeDisabled()
+    await name.evaluate((element) => element.closest('form')!.requestSubmit())
+    await page.keyboard.press('Escape')
+    expect(submissions).toBe(1)
+    await expect(dialog).toBeVisible()
+    release()
+    await expect(dialog.getByRole('alert')).toBeVisible()
+    await expect(name).toHaveValue('Safe isolated project draft')
+    await expect(key).toHaveValue('QA-2026')
+    await page.screenshot({
+      path: testInfo.outputPath('project-create-failure.png'),
+      fullPage: true,
+    })
+    await page.route('**/api/v1/projects', (route) => {
+      if (route.request().method() !== 'POST') return route.fallback()
+      submissions++
+      return routeJson(
+        route,
+        {
+          id: 'created-project',
+          key: 'DEMO',
+          name: 'Safe isolated project draft',
+          owner_id: mockUser.id,
+          todo_count: 0,
+          in_progress_count: 0,
+          done_count: 0,
+        },
+        201,
+      )
+    })
+    await dialog.getByRole('button', { name: 'Создать проект', exact: true }).click()
+    await expect(page).toHaveURL(`${app}/projects/DEMO/board`)
+    await expect(discard).toBeHidden()
+    expect(submissions).toBe(2)
+    await expect(page.getByText('Smoke issue').first()).toBeVisible()
+  })
+
+  test('keeps the project edit draft and modal controls usable across themes and breakpoints', async ({
+    page,
+    baseURL,
+  }, testInfo) => {
+    test.setTimeout(180_000)
+    const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
+    await installTrackerMocks(page)
+    await page.goto(`${app}/projects`)
+    const trigger = page.getByRole('button', { name: `Действия с проектом ${mockUser.name}` })
+    for (const theme of ['gray', 'dark', 'light']) {
+      await page.evaluate((value) => localStorage.setItem('theme', value), theme)
+      await page.reload()
+      await page.setViewportSize({ width: 1920, height: 1080 })
+      await trigger.click()
+      await page.getByRole('menuitem', { name: 'Изменить', exact: true }).click()
+      const dialog = page.getByRole('dialog')
+      const name = dialog.locator('#project-form-name')
+      const draft = `Draft ${'LongProjectName'.repeat(15)}`
+      await name.fill(draft)
+      for (const width of [375, 767, 768, 1023, 1024, 1279, 1280, 1440, 1920, 2560]) {
+        await page.setViewportSize({ width, height: 1080 })
+        await expect(name).toHaveValue(draft)
+        await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
+        const geometry = await dialog.evaluate(
+          (element, minimum) => {
+            const rect = element.getBoundingClientRect()
+            const targets = [...element.querySelectorAll('button,input,textarea')]
+              .map((control) => control.getBoundingClientRect())
+              .filter((control) => control.width > 0 && control.height > 0)
+            return {
+              fits: document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+              within: rect.left >= 0 && rect.right <= innerWidth,
+              targets: targets.every((control) => control.height + 0.5 >= minimum),
+            }
+          },
+          width < 768 ? 44 : 40,
+        )
+        expect(geometry).toEqual({ fits: true, within: true, targets: true })
+        await page.screenshot({
+          path: testInfo.outputPath(`project-edit-${theme}-${width}.png`),
+          fullPage: true,
+        })
+      }
+      await page.setViewportSize({ width: 1920, height: 1080 })
+      await dialog.getByRole('button', { name: 'Отмена', exact: true }).click()
+      await page
+        .getByRole('alertdialog')
+        .getByRole('button', { name: 'Подтвердить', exact: true })
+        .click()
+      await expect(dialog).toBeHidden()
+      await expect(trigger).toBeFocused()
+    }
+  })
+
