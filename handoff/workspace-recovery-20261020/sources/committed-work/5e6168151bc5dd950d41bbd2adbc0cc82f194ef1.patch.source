+
+  it('asks before closing a draft and retains it if discard is cancelled', async () => {
+    const view = renderForm({ project })
+    changeName('Draft')
+    cancel()
+    const confirmation = await screen.findByRole('alertdialog')
+    fireEvent.click(within(confirmation).getByRole('button', { name: 'Cancel' }))
