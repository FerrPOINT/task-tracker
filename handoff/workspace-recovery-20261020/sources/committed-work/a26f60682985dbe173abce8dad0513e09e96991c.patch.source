diff --git a/docs/plans/2026-10-05-base-notifications.md b/docs/plans/2026-10-05-base-notifications.md
new file mode 100644
index 0000000..acee1b1
--- /dev/null
+++ b/docs/plans/2026-10-05-base-notifications.md
@@ -0,0 +1,30 @@
+# Task Tracker: Base Notifications
+
+## Scope
+
+Parent: `2d1323b337b4ec912c33da7e56e2d8630ec5500e`.
+Base: `d22ca2205f5068eba976745ed5fad93c6daacfa1`.
+
+Use one `Toaster` from `@sdlc/ui/notifications` inside the existing ThemeProvider.
+Remove AppToaster and its top-center/theme overrides. Keep product Sonner
+callbacks, queries, API, auth, database and draft behavior unchanged.
+Sonner 2.0.8 must be the same physical peer for product callbacks and Base.
+Other locked dependency versions must remain unchanged.
+
+## Isolation
+
+The selected Task checkout contains 12 foreign files, including sprint work and
+documentation. This candidate is a detached clean worktree of the same parent:
+`../task-tracker-notifications`. It does not include or revert that overlay.
+Integration must preserve the foreign bytes and reconcile overlapping documents
+explicitly. Do not claim candidate tests cover the combined dirty checkout.
+
+## Acceptance
+
+- Test actual bootstrap, single notification host, all themes and focus retention.
+- Exercise the existing board move success only after a confirmed API response;
+  check pending/no premature success, dimensions, keyboard dismissal and overflow.
+- Run frozen install, component tests, typecheck/lint/format/build, UI/docs gates.
+- Keep mocked source/browser evidence distinct from actual images, persistence,
+  live SSO, role matrices, README captures and release acceptance.
+- Source integration and runtime promotion remain open until their gates pass.
diff --git a/frontend/e2e/smoke.spec.ts b/frontend/e2e/smoke.spec.ts
index e3d855d..5bb5903 100644
--- a/frontend/e2e/smoke.spec.ts
+++ b/frontend/e2e/smoke.spec.ts
@@ -100,6 +100,111 @@ async function installBoardFixtures(page: Page, count = 20, projectKey = 'DEMO')
   return control
 }
 
+test.describe('Base notifications', () => {
+  for (const theme of ['dark', 'gray', 'light'] as const) {
+    for (const width of [375, 1440, 1920, 2560]) {
+      test(`confirmed board move host in ${theme} at ${width}`, async ({
+        page,
+        baseURL,
+      }, testInfo) => {
+        await page.setViewportSize({ width, height: 1080 })
+        await page.addInitScript((value) => localStorage.setItem('theme', value), theme)
+        const fixture = await installBoardFixtures(page, 1)
+        let acknowledge!: () => void
+        fixture.writeBarrier = new Promise<void>((resolve) => {
+          acknowledge = resolve
+        })
+        const errors: string[] = []
+        page.on('pageerror', (error) => errors.push(error.message))
+        page.on('console', (message) => {
+          if (message.type() === 'error') errors.push(message.text())
+        })
+        const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
+        const target = `${app}/projects/DEMO/board?source=notification#context`
+        await page.goto(target)
+        await expect(page.locator('main article')).toHaveCount(1)
+        await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
+        await page.reload()
+        await expect(page).toHaveURL(target)
+        await expect(page.locator('[data-page-layout]')).toHaveAttribute('data-page-layout', 'wide')
+        const host = page.getByRole('region', { name: 'Уведомления', exact: true })
+        await expect(host).toHaveCount(1)
+        await page.getByRole('button', { name: 'Изменить статус DEMO-1', exact: true }).click()
+        await page.getByRole('menuitem', { name: 'Переместить: Готово', exact: true }).click()
+        await expect.poll(() => fixture.writes).toBe(1)
+        await expect(host.locator('[data-sonner-toast]')).toHaveCount(0)
+        acknowledge()
+        const notification = host.locator('[data-sonner-toast]')
+        await expect(notification).toHaveCount(1)
+        await expect(notification).toContainText('Статус задачи изменён')
+        await expect(notification).toHaveAttribute('data-type', 'success')
+        const focusRemainsInPage = await page.evaluate(() =>
+          Boolean(document.activeElement?.closest('main')),
+        )
+        expect(focusRemainsInPage).toBe(true)
+        expect(fixture.rows[0].status_id).toBe('done')
+        if (width < 768) {
+          await page
+            .getByRole('combobox', { name: 'Статус задач', exact: true })
+            .selectOption('done')
+          const selected = new URL(target)
+          selected.searchParams.set('status', 'done')
+          await expect(page).toHaveURL(selected.toString())
+        }
+        await expect(
+          page.getByRole('region', { name: 'Готово', exact: true }).locator('article'),
+        ).toHaveCount(1)
+        await expect(host.locator('[data-sonner-toaster]')).toHaveClass(/base-toaster/)
+        await expect(host.locator('[data-sonner-toaster]')).toHaveAttribute(
+          'data-x-position',
+          'right',
+        )
+        await expect(host.locator('[data-sonner-toaster]')).toHaveAttribute(
+          'data-y-position',
+          'bottom',
+        )
+        const close = host.getByRole('button', { name: 'Закрыть уведомление', exact: true })
+        const bounds = await close.boundingBox()
+        expect(bounds).not.toBeNull()
+        const minimum = width < 768 ? 44 : 40
+        expect(bounds!.width).toBeGreaterThanOrEqual(minimum)
+        expect(bounds!.height).toBeGreaterThanOrEqual(minimum)
+        expect(
+          await page.evaluate(
+            () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+          ),
+        ).toBe(true)
+        expect((await new AxeBuilder({ page }).analyze()).violations).toEqual([])
+        await page.screenshot({
+          path: testInfo.outputPath('base-notification.png'),
+          fullPage: true,
+        })
+        await close.focus()
+        await expect(close).toBeFocused()
+        await page.keyboard.press('Enter')
+        await expect(notification).toHaveCount(0)
+        expect(errors).toEqual([])
+        await testInfo.attach('base-notification-scope.json', {
+          body: JSON.stringify({
+            theme,
+            viewport: { width, height: 1080 },
+            route: '/projects/DEMO/board',
+            writes: fixture.writes,
+            prematureSuccess: false,
+            focusRemainsInPage,
+            keyboardDismiss: true,
+            target: bounds,
+            fixtureOnly: true,
+            actualImages: false,
+            releaseAcceptance: false,
+          }),
+          contentType: 'application/json',
+        })
+      })
+    }
+  }
+})
+
