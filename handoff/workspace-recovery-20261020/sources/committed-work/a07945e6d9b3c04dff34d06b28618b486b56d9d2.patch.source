diff --git a/backend/scripts/run_postgres_tests.py b/backend/scripts/run_postgres_tests.py
new file mode 100644
index 0000000..36a98c7
--- /dev/null
+++ b/backend/scripts/run_postgres_tests.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""Run PostgreSQL tests with disposable Compose storage, never an existing DB."""
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import signal
+import subprocess
+import sys
+import uuid
+
+
+ROOT = Path(__file__).resolve().parents[2]
+LABELS = {'sdlc.task': 'task-tracker-tests', 'sdlc.purpose': 'postgres-integration'}
+
+
+def endpoint(helpers, command, service, port):
+    address = helpers.checked(command + ['port', service, str(port)], text=True).strip()
+    if not re.fullmatch(r'127\.0\.0\.1:[0-9]+', address):
+        raise RuntimeError('Unexpected disposable test endpoint')
+    return address
+
+
+def assert_owned_storage(helpers, helper, volume):
+    """Check storage before Compose down, which also removes owned networks."""
+    if helpers.checked(helper.docker + ['info', '--format', '{{.ID}}'], text=True).strip() != helper.identity:
+        raise RuntimeError('Daemon changed; automatic cleanup refused')
+    for kind in ('network', 'volume'):
+        names = helpers.checked(helper.docker + [kind, 'ls', '--format', '{{.Name}}',
+            '--filter', 'label=com.docker.compose.project=' + helper.project], text=True).splitlines()
+        for name in names:
+            data = json.loads(helpers.checked(helper.docker + [kind, 'inspect', name], text=True))[0]
+            labels = data.get('Labels') or {}
+            expected = helper.project + '_test' if kind == 'network' else volume
+            if name != expected or labels.get('com.docker.compose.project') != helper.project or any(
+                    labels.get(key) != value for key, value in LABELS.items()):
+                raise RuntimeError('Foreign test storage; automatic cleanup refused')
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--docker-context', required=True)
+    parser.add_argument('--base-directory', type=Path)
+    parser.add_argument('command', nargs=argparse.REMAINDER)
+    args = parser.parse_args(argv)
+    command = args.command[1:] if args.command[:1] == ['--'] else args.command
+    if not command:
+        parser.error('An explicit test command is required after --')
+    base = (args.base_directory or ROOT.parent / 'services-base').resolve()
+    pin = (ROOT / '.base-revision').read_text(encoding='utf-8').strip()
+    revision = subprocess.check_output(['git', '-C', str(base), 'rev-parse', 'HEAD'], text=True).strip()
+    if not re.fullmatch(r'[a-f0-9]{40}', pin) or revision != pin:
+        raise RuntimeError('Base checkout differs from the pinned revision')
+    spec = importlib.util.spec_from_file_location('owned_compose', base / 'scripts/compose_helpers.py')
+    helpers = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(helpers)
+    project = 'sdlc-qa-task-postgres-' + uuid.uuid4().hex[:12]
+    docker = ['docker', '--context', args.docker_context]
+    for image in ('postgres:17.6-alpine', 'redis:7-alpine'):
+        cached = subprocess.run(docker + ['image', 'inspect', image], capture_output=True)
+        if cached.returncode:
+            helpers.checked(docker + ['pull', image], timeout=300)
+    helper = helpers.ComposeHelper(project=project, task=LABELS['sdlc.task'],
+        purpose=LABELS['sdlc.purpose'], docker=docker, directory=ROOT / '.local' / project)
+    volume = project + '_postgres-data'
+    password = secrets.token_hex(24)
+    created = False
+    failed = True
+
+    def interrupted(*_):
+        raise KeyboardInterrupt
+
+    previous = {sig: signal.signal(sig, interrupted) for sig in (signal.SIGINT, signal.SIGTERM)}
+    try:
+        if volume in helpers.checked(docker + ['volume', 'ls', '--format', '{{.Name}}'], text=True).splitlines():
+            raise RuntimeError('Disposable storage already exists; refusing reuse')
+        networks = helpers.disposable_subnets(docker, {'test': {'labels': LABELS}})
+        helper.write({
+            'postgres-test': {'image': 'postgres:17.6-alpine', 'networks': ['test'],
+                'environment': {'POSTGRES_USER': 'tasktracker', 'POSTGRES_PASSWORD': password,
+                                'POSTGRES_DB': 'tasktracker_test'},
+                'ports': [{'target': 5432, 'published': '0', 'host_ip': '127.0.0.1'}],
+                'volumes': [{'type': 'volume', 'source': 'postgres-data', 'target': '/var/lib/postgresql/data'}],
+                'healthcheck': {'test': ['CMD', 'pg_isready', '-h', '127.0.0.1', '-U', 'tasktracker', '-d', 'tasktracker_test'],
+                    'interval': '1s', 'timeout': '3s', 'retries': 30}},
+            'redis-test': {'image': 'redis:7-alpine', 'networks': ['test'],
+                'tmpfs': ['/data'],
+                'ports': [{'target': 6379, 'published': '0', 'host_ip': '127.0.0.1'}],
+                'healthcheck': {'test': ['CMD', 'redis-cli', 'ping'], 'interval': '1s', 'timeout': '3s', 'retries': 30}},
+        }, volumes={'postgres-data': {'labels': LABELS}}, networks=networks)
+        created = True
+        helper.run('postgres-test')
+        startup_log = helper.directory / 'startup.private.log'
+        try:
+            startup = subprocess.run(helper.command + ['up', '-d', '--wait', '--wait-timeout', '60'],
+                stdin=subprocess.DEVNULL, capture_output=True, timeout=90)
+        except subprocess.TimeoutExpired as error:
+            startup_log.write_bytes((error.stdout or b'') + (error.stderr or b''))
+            helpers.restrict(startup_log)
+            raise RuntimeError('Disposable test startup timed out; inspect the protected startup log') from error
+        startup_log.write_bytes(startup.stdout + startup.stderr)
+        helpers.restrict(startup_log)
+        if startup.returncode:
+            raise RuntimeError('Disposable test startup failed; inspect the protected startup log')
+        version = helpers.checked(helper.command + ['exec', '-T', 'postgres-test', 'psql', '-XqAt',
+            '-v', 'ON_ERROR_STOP=1', '-U', 'tasktracker', '-d', 'postgres', '-c', 'SHOW server_version'], text=True)
+        if not re.match(r'^17\.6(?:\s|$)', version.strip()):
+            raise RuntimeError('Unexpected PostgreSQL test version')
+        helpers.checked(helper.command + ['exec', '-T', 'postgres-test', 'createdb', '-U', 'tasktracker',
+                                         'tasktracker_infra_test'])
+        pg = endpoint(helpers, helper.command, 'postgres-test', 5432)
+        redis = endpoint(helpers, helper.command, 'redis-test', 6379)
+        environment = dict(os.environ,
+            TASKTRACKER_DATABASE_URL=f'postgres://tasktracker:{password}@{pg}/tasktracker_test',
+            TT_TEST_DATABASE_URL=f'postgres://tasktracker:{password}@{pg}/tasktracker_infra_test',
+            TASKTRACKER_REDIS_URL='redis://' + redis,
+            SDLC_TEST_COMPOSE_PROJECT=project,
+            CARGO_BUILD_JOBS=os.environ.get('CARGO_BUILD_JOBS', '1'), RUST_LOG=os.environ.get('RUST_LOG', 'warn'))
+        result = subprocess.run(command, cwd=ROOT / 'backend', env=environment)
+        failed = result.returncode != 0
+        return result.returncode
+    finally:
+        try:
+            assert_owned_storage(helpers, helper, volume)
+            helper.close()
+            if created and volume in helpers.checked(docker + ['volume', 'ls', '--format', '{{.Name}}'], text=True).splitlines():
+                helpers.checked(docker + ['volume', 'rm', volume])
+        except Exception:
+            helper.record('cleanup-required')
+            if not failed:
+                raise
+            print('Test cleanup requires reconciliation; protected journal retained', file=sys.stderr)
+        finally:
+            for sig, handler in previous.items():
+                signal.signal(sig, handler)
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
