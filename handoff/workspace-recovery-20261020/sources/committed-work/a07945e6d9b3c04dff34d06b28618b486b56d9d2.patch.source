diff --git a/scripts/tests/test_postgres_harness.py b/scripts/tests/test_postgres_harness.py
new file mode 100644
index 0000000..e0bf4ca
--- /dev/null
+++ b/scripts/tests/test_postgres_harness.py
@@ -0,0 +1,67 @@
+"""Database tests must never adopt an existing local stack or foreign storage."""
+import importlib.util
+import json
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+SPEC = importlib.util.spec_from_file_location('task_postgres_harness', ROOT / 'backend/scripts/run_postgres_tests.py')
+harness = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(harness)
+
+
+class PostgresHarnessTests(unittest.TestCase):
+    def test_context_and_command_are_required_before_docker(self):
+        with patch.object(harness.subprocess, 'run') as run, patch.object(harness.subprocess, 'check_output') as output:
+            for args in ([], ['--docker-context', 'selected']):
+                with self.assertRaises(SystemExit) as result:
+                    harness.main(args)
+                self.assertEqual(result.exception.code, 2)
+            run.assert_not_called()
+            output.assert_not_called()
+
+    def test_incompatible_base_is_rejected_before_docker(self):
+        with patch.object(harness.subprocess, 'check_output', return_value='0' * 40), \
+                patch.object(harness.subprocess, 'run') as run:
+            with self.assertRaisesRegex(RuntimeError, 'pinned revision'):
+                harness.main(['--docker-context', 'selected', '--base-directory', str(ROOT), '--', 'test-command'])
+            run.assert_not_called()
+
+    def test_endpoint_never_falls_back_to_host_or_default_database(self):
+        for address in ('0.0.0.0:5432', '127.0.0.1:5432\n127.0.0.1:5433', 'localhost:5432', ''):
+            helper = SimpleNamespace(checked=lambda *a, **kw: address)
+            with self.assertRaisesRegex(RuntimeError, 'endpoint'):
+                harness.endpoint(helper, ['owned-compose'], 'postgres-test', 5432)
+        helper = SimpleNamespace(checked=lambda *a, **kw: '127.0.0.1:49152\n')
+        self.assertEqual(harness.endpoint(helper, ['owned-compose'], 'postgres-test', 5432), '127.0.0.1:49152')
+
+    def test_foreign_storage_and_wrong_daemon_are_refused_read_only(self):
+        project = 'sdlc-qa-task-postgres-123456abcdef'
+        owner = SimpleNamespace(project=project, identity='daemon', docker=['docker', '--context', 'selected'])
+        volume = project + '_postgres-data'
+        for kind, foreign in (('network', 'foreign-owner'), ('volume', 'foreign-owner'), ('network', None)):
+            calls = []
+
+            def checked(command, **_):
+                calls.append(command)
+                if command[3] == 'info':
+                    return 'other-daemon' if foreign is None else 'daemon'
+                resource = command[3]
+                name = project + '_test' if resource == 'network' else volume
+                if command[4] == 'ls':
+                    return name
+                labels = dict(harness.LABELS, **{'com.docker.compose.project': project})
+                if resource == kind:
+                    labels['sdlc.task'] = foreign
+                return json.dumps([{'Labels': labels}])
+
+            with self.assertRaisesRegex(RuntimeError, 'Foreign|Daemon'):
+                harness.assert_owned_storage(SimpleNamespace(checked=checked), owner, volume)
+            self.assertTrue(all(command[3] in ('info', 'network', 'volume') for command in calls))
+            self.assertFalse(any('rm' in command or 'down' in command for command in calls))
+
+
+if __name__ == '__main__':
+    unittest.main()
