@@ -31,9 +31,78 @@ function show(data: (typeof comment)[] | undefined, error: unknown = null, isLoa
 }
 beforeEach(() => {
   vi.clearAllMocks()
+  mocks.update.mockReset()
   i18n.addResource('ru', 'translation', 'common.retry', 'Повторить')
 })
 
+describe('CommentsPanel editor identity', () => {
+  const second = { ...comment, id: 'c2', body: 'Second comment' }
+  const field = () => screen.getByRole('textbox', { name: /комментарий/i })
+  const edit = (index: number) => {
+    const button = screen.getAllByRole('button', { name: /изменить/i })[index]
+    if (!button) throw new Error('Comment edit action is missing')
+    fireEvent.click(button)
+  }
+
+  it('loads the selected comment instead of reusing the create draft', () => {
+    show([comment, second])
+    fireEvent.change(field(), { target: { value: 'Unsubmitted create draft' } })
+    edit(0)
+    expect(field()).toHaveValue(comment.body)
+  })
+
+  it('loads the newly selected comment instead of the previous editor values', () => {
+    show([comment, second])
+    edit(0)
+    edit(1)
+    expect(field()).toHaveValue(second.body)
+    fireEvent.click(screen.getByRole('button', { name: /отмен/i }))
+    expect(field()).toHaveValue('')
+  })
+
+  it.each([false, true])(
+    'a late ACK cannot close a newer editor (same comment: %s)',
+    async (same) => {
+      let resolve!: () => void
+      mocks.update.mockImplementation(
+        () =>
+          new Promise<void>((done) => {
+            resolve = done
+          }),
+      )
+      show([comment, second])
+      edit(0)
+      fireEvent.change(field(), { target: { value: 'First submitted edit' } })
+      fireEvent.submit(field().closest('form')!)
+      await waitFor(() =>
+        expect(mocks.update).toHaveBeenCalledWith({
+          id: comment.id,
+          input: { body: 'First submitted edit' },
+        }),
+      )
+      edit(1)
+      if (same) edit(0)
+      fireEvent.change(field(), { target: { value: 'Newer unsaved edit' } })
+      await act(async () => resolve())
+      expect(field()).toHaveValue('Newer unsaved edit')
+      expect(screen.getByRole('button', { name: /отмен/i })).toBeVisible()
+    },
+  )
+
+  it('closes the same editor after a successful ACK', async () => {
+    mocks.update.mockResolvedValue(undefined)
+    show([comment])
+    edit(0)
+    fireEvent.change(field(), { target: { value: 'Saved edit' } })
+    fireEvent.submit(field().closest('form')!)
+    await waitFor(() => expect(mocks.update).toHaveBeenCalledOnce())
+    await waitFor(() =>
+      expect(screen.queryByRole('button', { name: /отмен/i })).not.toBeInTheDocument(),
+    )
+    expect(field()).toHaveValue('')
+  })
+})
+
