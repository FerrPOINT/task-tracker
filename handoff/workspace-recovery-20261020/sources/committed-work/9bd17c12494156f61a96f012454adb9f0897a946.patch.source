diff --git a/CHANGELOG.md b/CHANGELOG.md
index 819bd13..b8a23cd 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -6,6 +6,12 @@
 
 ## [Unreleased]
 
+- Переключение create/edit и разных комментариев открывает форму с правильным
+  исходным текстом. Подтверждение сохранения закрывает только тот сеанс editor,
+  который отправил запрос; поздний ACK не закрывает более новый editor даже
+  при повторном открытии того же комментария. После успешного редактирования
+  новая create-форма пустая. Общая navigation/SSO draft safety остаётся отдельной.
+
 - Форма комментария использует Base PendingForm/FormField: во время сохранения
   блокируются поле и отмена, повторная отправка защищена общим handler lock.
   Required/error связаны с уникальным control ID, ввод из одних пробелов не
diff --git a/frontend/e2e/smoke.spec.ts b/frontend/e2e/smoke.spec.ts
index 832e43a..e115ce1 100644
--- a/frontend/e2e/smoke.spec.ts
+++ b/frontend/e2e/smoke.spec.ts
@@ -2191,6 +2191,77 @@ test.describe('Base worklog resource states', () => {
 })
 
 for (const theme of ['dark', 'gray', 'light']) {
+  test(`comment editor identity survives a late ACK in ${theme}`, async ({ page }, testInfo) => {
+    await page.setViewportSize({ width: 1920, height: 1080 })
+    await page.addInitScript((value) => localStorage.setItem('theme', value), theme)
+    await installTrackerMocks(page)
+    const comments = ['first', 'second'].map((id) => ({
+      id: `identity-${id}`,
+      issue_id: mockUser.issueId,
+      author_id: mockUser.id,
+      author_name: 'Demo User',
+      body: `Safe ${id} comment`,
+      created_at: '2026-09-01T10:00:00Z',
+      updated_at: '2026-09-01T10:00:00Z',
+    }))
+    const errors: string[] = []
+    page.on('pageerror', (error) => errors.push(error.message))
+    page.on('console', (message) => {
+      if (message.type() === 'error') errors.push(message.text())
+    })
+    await page.route(`**/api/v1/issues/${mockUser.issueId}/comments**`, (route) =>
+      routeJson(route, { comments }),
+    )
+    let writes = 0
+    let release!: () => void
+    const barrier = new Promise<void>((resolve) => {
+      release = resolve
+    })
+    await page.route('**/api/v1/comments/identity-first', async (route) => {
+      expect(route.request().method()).toBe('PATCH')
+      writes++
+      await barrier
+      comments[0] = { ...comments[0]!, body: 'Submitted first edit' }
+      return routeJson(route, comments[0])
+    })
+    try {
+      await page.goto(`/issues/${mockUser.issueId}?tab=comments`)
+      const panel = page.getByRole('tabpanel')
+      const field = panel.getByRole('textbox', { name: 'Комментарий', exact: true })
+      const edit = panel.getByRole('button', { name: 'Изменить', exact: true })
+      await field.fill('Safe create draft')
+      await edit.nth(0).click()
+      await expect(field).toHaveValue('Safe first comment')
+      await field.fill('Submitted first edit')
+      await panel.getByRole('button', { name: 'Сохранить', exact: true }).click()
+      await expect.poll(() => writes).toBe(1)
+      await edit.nth(1).click()
+      await expect(field).toHaveValue('Safe second comment')
+      await edit.nth(0).click()
+      await field.fill('Safe newer unsaved edit')
+      const ack = page.waitForResponse(
+        (response) =>
+          response.url().endsWith('/api/v1/comments/identity-first') &&
+          response.request().method() === 'PATCH',
+      )
+      release()
+      await ack
+      await expect(panel.getByText('Submitted first edit', { exact: true })).toBeVisible()
+      await expect(field).toHaveValue('Safe newer unsaved edit')
+      await expect(panel.getByRole('button', { name: 'Отмена', exact: true })).toBeEnabled()
+      await page.screenshot({
+        path: testInfo.outputPath(`comment-editor-identity-${theme}-1920.png`),
+        fullPage: true,
+        animations: 'disabled',
+      })
+      await panel.getByRole('button', { name: 'Отмена', exact: true }).click()
+      await expect(field).toHaveValue('')
+      expect(errors).toEqual([])
+    } finally {
+      release()
+    }
+  })
+
   test(`comment form uses Base pending and field semantics in ${theme}`, async ({
     page,
   }, testInfo) => {
