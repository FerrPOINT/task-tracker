diff --git a/backend/infra/src/sdlc_lifecycle_pg_tests.rs b/backend/infra/src/sdlc_lifecycle_pg_tests.rs
index d634540..f6a1f49 100644
--- a/backend/infra/src/sdlc_lifecycle_pg_tests.rs
+++ b/backend/infra/src/sdlc_lifecycle_pg_tests.rs
@@ -6,6 +6,9 @@ use domain::sdlc_routing::{RoleRoutes, SetRoutingPolicy};
