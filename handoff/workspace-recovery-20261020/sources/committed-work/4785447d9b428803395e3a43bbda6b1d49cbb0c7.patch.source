+    await waitFor(() => expect(screen.getByRole('button', { name: /^создать$/i })).toBeDisabled())
+    await user.selectOptions(screen.getByLabelText(/Исполнитель/), '')
+    expect(screen.getByRole('button', { name: /^создать$/i })).toBeEnabled()
+  })
+
+  it('allows an explicit unassigned save during a directory outage without discarding other fields', async () => {
+    const qc = new QueryClient({ defaultOptions: { queries: { retry: false } } })
