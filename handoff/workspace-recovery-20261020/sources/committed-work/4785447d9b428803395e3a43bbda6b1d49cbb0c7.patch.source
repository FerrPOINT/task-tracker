+    await user.type(await screen.findByLabelText(/Required text/), 'ready')
+    await user.type(screen.getByLabelText(/Заголовок/), 'Draft')
+    await user.selectOptions(screen.getByLabelText(/Исполнитель/), 'u2')
+    listUsers.mockRejectedValueOnce(new ApiError(503, 'controlled failure'))
