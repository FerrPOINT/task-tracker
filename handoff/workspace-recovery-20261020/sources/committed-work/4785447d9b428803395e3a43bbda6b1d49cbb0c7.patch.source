+      )
+      expect(view.container.querySelector('form')).not.toBeInTheDocument()
+      expect(screen.queryByRole('button', { name: /^создать$/i })).not.toBeInTheDocument()
+      expect(screen.queryByRole('button', { name: /повторить/i })).not.toBeInTheDocument()
+      expect(screen.queryByText('diagnostic must stay hidden')).not.toBeInTheDocument()
+      await act(() => qc.invalidateQueries({ queryKey: ['custom-fields', 'TT'] }))
+      expect(await screen.findByLabelText(/Required text/)).toHaveValue('private draft')
+      expect(screen.getByLabelText(/Заголовок/)).toHaveValue('Draft')
+    },
+  )
+
+  it.each([400, 422])(
+    'does not offer automatic retry for required-data HTTP %s',
+    async (status) => {
+      listCustomFields.mockRejectedValueOnce(new ApiError(status, 'diagnostic'))
+      render(wrapper(<IssueCreatePage />))
+      await screen.findByText('Не удалось загрузить поля проекта. Повторите попытку.')
+      expect(screen.queryByRole('button', { name: /повторить/i })).not.toBeInTheDocument()
+      expect(screen.getByRole('button', { name: /^создать$/i })).toBeDisabled()
+    },
+  )
+
+  it('disables submission while required fields refresh without resetting editable input', async () => {
+    const qc = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+    const user = userEvent.setup()
+    render(wrapper(<IssueCreatePage />, '/issues/create?project_key=TT', qc))
+    await user.type(await screen.findByLabelText(/Required text/), 'ready')
+    await user.type(screen.getByLabelText(/Заголовок/), 'Draft')
+    const existing = qc.getQueryData(['custom-fields', 'TT']) as Awaited<
+      ReturnType<typeof listCustomFields>
+    >
+    let resolve!: (value: typeof existing) => void
+    listCustomFields.mockImplementationOnce(
+      () =>
+        new Promise((done) => {
+          resolve = done
+        }),
+    )
+    act(() => {
+      void qc.invalidateQueries({ queryKey: ['custom-fields', 'TT'] })
+    })
+    await screen.findByText('Обновление данных формы...')
+    expect(screen.getByRole('button', { name: /^создать$/i })).toBeDisabled()
+    await user.type(screen.getByLabelText(/Заголовок/), ' updated')
+    await act(async () => resolve(existing))
+    await waitFor(() => expect(screen.getByRole('button', { name: /^создать$/i })).toBeEnabled())
+    expect(screen.getByLabelText(/Заголовок/)).toHaveValue('Draft updated')
+    expect(screen.getByLabelText(/Required text/)).toHaveValue('ready')
+  })
+
+  it('uses Base pending lock to prevent repeated submissions before React updates', async () => {
+    let resolve!: (value: Awaited<ReturnType<typeof createIssue>>) => void
+    createIssue.mockImplementationOnce(
+      () =>
+        new Promise((done) => {
+          resolve = done
+        }),
+    )
+    const user = userEvent.setup()
+    const view = render(wrapper(<IssueCreatePage />))
+    await user.type(await screen.findByLabelText(/Required text/), 'ready')
+    await user.type(screen.getByLabelText(/Заголовок/), 'Draft')
+    const form = view.container.querySelector('form')!
+    act(() => {
+      fireEvent.submit(form)
+      fireEvent.submit(form)
+    })
+    await waitFor(() => expect(createIssue).toHaveBeenCalledTimes(1))
+    expect(screen.getByLabelText(/Заголовок/)).toBeDisabled()
+    await act(async () => resolve({ id: 'new', project_key: 'TT' }))
+    await screen.findByText('Backlog')
+  })
+
+  it('guards navigation, keeps the draft on Escape and returns focus to the initiating action', async () => {
+    const user = userEvent.setup()
+    render(wrapper(<IssueCreatePage />))
+    await user.type(await screen.findByLabelText(/Заголовок/), 'Draft')
+    const leave = screen.getByRole('button', { name: 'Leave form' })
+    await user.click(leave)
+    expect(screen.getByRole('alertdialog')).toBeInTheDocument()
+    await user.keyboard('{Escape}')
+    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
+    expect(screen.getByLabelText(/Заголовок/)).toHaveValue('Draft')
+    expect(leave).toHaveFocus()
+    await user.click(leave)
+    await user.click(screen.getByRole('button', { name: 'Подтвердить' }))
+    await screen.findByText('Projects')
+  })
+
+  it('blocks unload only while unsaved values exist', async () => {
+    const user = userEvent.setup()
+    render(wrapper(<IssueCreatePage />))
+    const clean = new Event('beforeunload', { cancelable: true })
+    window.dispatchEvent(clean)
+    expect(clean.defaultPrevented).toBe(false)
+    await user.type(screen.getByLabelText(/Заголовок/), 'Draft')
+    const dirty = new Event('beforeunload', { cancelable: true })
+    window.dispatchEvent(dirty)
+    expect(dirty.defaultPrevented).toBe(true)
+  })
+
+  it('links custom-field validation to its input and keeps the entered value', async () => {
+    const user = userEvent.setup()
+    const view = render(wrapper(<IssueCreatePage />))
+    await user.type(await screen.findByLabelText(/Required text/), '   ')
+    await user.type(screen.getByLabelText(/Заголовок/), 'Draft')
+    fireEvent.submit(view.container.querySelector('form')!)
+    await waitFor(() =>
+      expect(screen.getByLabelText(/Required text/)).toHaveAttribute('aria-invalid', 'true'),
+    )
+    expect(screen.getByLabelText(/Required text/)).toHaveAttribute(
+      'aria-describedby',
+      'issue-field-f1-error',
+    )
+    expect(screen.getByLabelText(/Required text/)).toHaveValue('   ')
+    expect(createIssue).not.toHaveBeenCalled()
+  })
+
+  it('matches the server 500-character summary bound using Unicode code points', async () => {
+    const user = userEvent.setup()
+    render(wrapper(<IssueCreatePage />))
+    await user.type(await screen.findByLabelText(/Required text/), 'ready')
+    fireEvent.change(screen.getByLabelText(/Заголовок/), {
+      target: { value: String.fromCodePoint(0x1f4a1).repeat(500) },
+    })
+    expect(screen.getByRole('button', { name: /^создать$/i })).toBeEnabled()
+    fireEvent.change(screen.getByLabelText(/Заголовок/), { target: { value: 'a'.repeat(501) } })
+    expect(screen.getByLabelText(/Заголовок/)).toHaveAttribute('aria-invalid', 'true')
+    expect(screen.getByRole('button', { name: /^создать$/i })).toBeDisabled()
+  })
 })
