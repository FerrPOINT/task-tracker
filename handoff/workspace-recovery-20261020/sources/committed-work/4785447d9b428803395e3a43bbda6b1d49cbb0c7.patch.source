+    expect(createIssue.mock.calls[0]?.[0]).toMatchObject({ assignee_id: null })
+  })
+
+  it.each([403, 404])(
+    'hides CRUD after required-field HTTP %s while preserving a recoverable draft',
+    async (status) => {
+      const qc = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+      const user = userEvent.setup()
+      const view = render(wrapper(<IssueCreatePage />, '/issues/create?project_key=TT', qc))
+      await user.type(await screen.findByLabelText(/Required text/), 'private draft')
+      await user.type(screen.getByLabelText(/Заголовок/), 'Draft')
+      listCustomFields.mockRejectedValueOnce(new ApiError(status, 'diagnostic must stay hidden'))
+      await act(() => qc.invalidateQueries({ queryKey: ['custom-fields', 'TT'] }))
+      await waitFor(() =>
+        expect(
