+              </Select>
+            )}
+          </FormField>
+          <FormField id="issue-assignee" label={t('issueCreate.assignee')}>
+            {(attrs) => (
+              <Select
+                {...attrs}
+                value={assignee_id}
+                onChange={(e) =>
+                  setAssignees((previous) => ({ ...previous, [project_key]: e.target.value }))
+                }
+                disabled={!assigneesReady}
+              >
+                <option value="">{t('issueCreate.unassigned')}</option>
+                {assignee_id && !assigneeAvailable && (
+                  <option value={assignee_id}>{t('issueCreate.assigneeUnavailable')}</option>
+                )}
+                {assignableUsers.map((u) => (
+                  <option key={u.id} value={u.id}>
+                    {u.display_name || u.username}
+                  </option>
+                ))}
+              </Select>
+            )}
+          </FormField>
         </div>
 
+        {assignee_id && assigneesReady && !assigneeAvailable && (
+          <p role="alert" className="text-sm text-danger">
+            {t('issueCreate.assigneeUnavailable')}
+          </p>
+        )}
         {customFields.length > 0 && (
-          <fieldset disabled={isPending} className="space-y-3 border-t border-border pt-4">
-            <h2 className="text-sm font-semibold">{t('customFields.title')}</h2>
+          <fieldset className="space-y-3 border-t border-border pt-4">
+            <legend className="text-sm font-semibold">{t('customFields.title')}</legend>
             <div className="grid gap-4 sm:grid-cols-2">
               {customFields.map((field) => (
-                <label
-                  key={field.id}
-                  className="space-y-2 text-sm font-medium [&_input]:min-h-11 [&_select]:min-h-11 sm:[&_input]:min-h-10 sm:[&_select]:min-h-10"
+                <FormField
+                  key={`${project_key}:${field.id}`}
+                  id={`issue-field-${field.id}`}
+                  label={field.name}
+                  required={field.is_required}
+                  error={
+                    validationField === field.id
+                      ? t('customFields.requiredMissing', { name: field.name })
+                      : undefined
+                  }
                 >
-                  <span>
-                    {field.name}
-                    {field.is_required ? ' *' : ''}
-                  </span>
-                  <CustomFieldValueInput
-                    field={field}
-                    value={customFieldValues[field.id]}
-                    onSave={(value) => {
-                      setCustomFieldValues((prev) => ({ ...prev, [field.id]: value }))
-                      setValidationError(null)
-                    }}
-                    commit="change"
-                  />
-                </label>
+                  {(attrs) => (
+                    <CustomFieldValueInput
+                      field={field}
+                      inputProps={attrs}
+                      value={customFieldValues[field.id]}
+                      onSave={(value) => {
+                        setProjectFieldValues((previous) => ({
+                          ...previous,
+                          [project_key]: { ...previous[project_key], [field.id]: value },
+                        }))
+                        setValidationField(null)
+                      }}
+                      commit="change"
+                    />
+                  )}
+                </FormField>
               ))}
             </div>
           </fieldset>
         )}
-
-        <div className="flex gap-2 pt-2">
-          <Button type="submit" disabled={!canSubmit} className="min-h-11 gap-1 sm:min-h-10">
-            <Plus className="h-4 w-4" />
-            {isPending ? t('common.creating') : t('issueCreate.submit')}
-          </Button>
-          <Button
-            type="button"
-            variant="outline"
-            className="min-h-11 sm:min-h-10"
-            disabled={isPending}
-            onClick={() => navigate(-1)}
-          >
-            {t('common.cancel')}
-          </Button>
-        </div>
-      </form>
+      </FormPage>
     </div>
   )
 }
