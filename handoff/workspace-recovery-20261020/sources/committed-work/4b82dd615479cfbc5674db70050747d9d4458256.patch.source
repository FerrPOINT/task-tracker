diff --git a/backend/Cargo.toml b/backend/Cargo.toml
index 0fc217d..174b06b 100644
--- a/backend/Cargo.toml
+++ b/backend/Cargo.toml
@@ -58,7 +58,7 @@ http = "1.3"
