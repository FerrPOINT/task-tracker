diff --git a/backend/migration/src/single_task_lifecycle.sql b/backend/migration/src/single_task_lifecycle.sql
index 8ac5b0b..994962d 100644
--- a/backend/migration/src/single_task_lifecycle.sql
+++ b/backend/migration/src/single_task_lifecycle.sql
@@ -1,4 +1,48 @@
 -- Parent owns migration version/order/registration and legacy stage projection.
+ALTER TABLE sdlc_tasks ADD CONSTRAINT sdlc_draft_flow_shape CHECK (
+    NOT state ? 'flow' OR (state->'flow'='"single-task-v1"'::jsonb
+        AND root_task_id=task_id AND state->>'root_task_id'=task_id::text) IS TRUE
+);
+
+CREATE FUNCTION sdlc_draft_flow_gate() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF OLD.state->'flow' IS DISTINCT FROM NEW.state->'flow' THEN
+        RAISE EXCEPTION 'SDLC Draft flow marker is immutable; no legacy retrofit' USING ERRCODE='23514';
+    END IF;
+    IF NOT OLD.state ? 'lifecycle' AND NEW.state ? 'lifecycle' AND NOT NEW.state ? 'flow' THEN
+        RAISE EXCEPTION 'SDLC single_task_draft_marker_required' USING ERRCODE='23514';
+    END IF;
+    IF NEW.state ? 'flow' AND NEW.state->>'stage' NOT IN ('Draft','Clarification')
+        AND NOT EXISTS(SELECT 1 FROM sdlc_task_routing_snapshots s JOIN sdlc_confirmations c
+            ON c.task_id=s.task_id AND c.id=s.confirmation_id
+            WHERE s.task_id=NEW.task_id AND s.project_id=NEW.project_id
+                AND s.requirement_revision=(NEW.state->'revisions'->-1->>'revision')::bigint
+                AND s.content_hash=NEW.state->'revisions'->-1->>'content_hash'
+                AND c.payload->>'owner_subject'=NEW.owner_subject
+                AND s.payload->'contract_version'='2'::jsonb
+                AND s.payload->'policy'->'contract_version'='2'::jsonb) THEN
+        RAISE EXCEPTION 'marked Draft confirmation requires exact v2 routing snapshot' USING ERRCODE='23514';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER sdlc_draft_flow_gate BEFORE UPDATE ON sdlc_tasks
+FOR EACH ROW EXECUTE FUNCTION sdlc_draft_flow_gate();
+
+-- Deferred because the immutable creation ledger is inserted after its task row.
+CREATE FUNCTION sdlc_draft_flow_origin_gate() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF NEW.state ? 'flow' AND ((NEW.state->>'stage'='Draft' AND NEW.state->>'status'='Ready'
+        AND NEW.state->>'draft_submode'='brainstorming') IS NOT TRUE OR NOT EXISTS(
+            SELECT 1 FROM sdlc_draft_creations c WHERE c.task_id=NEW.task_id
+                AND c.project_id=NEW.project_id AND c.actor_subject=NEW.owner_subject
+                AND c.input_snapshot_ref IS NOT NULL)) THEN
+        RAISE EXCEPTION 'SDLC marked Draft requires original creation ledger' USING ERRCODE='23514';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE CONSTRAINT TRIGGER sdlc_draft_flow_origin_gate AFTER INSERT ON sdlc_tasks
+DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION sdlc_draft_flow_origin_gate();
+
 CREATE OR REPLACE FUNCTION sdlc_routing_snapshot_gate() RETURNS trigger LANGUAGE plpgsql AS $$
 BEGIN
     IF NOT EXISTS (SELECT 1 FROM sdlc_tasks t JOIN sdlc_confirmations c ON c.task_id=t.task_id
@@ -96,6 +140,17 @@ CREATE TABLE sdlc_delivery_assignments (
 );
 CREATE INDEX sdlc_delivery_assignment_task ON sdlc_delivery_assignments(task_id);
 
+CREATE FUNCTION sdlc_delivery_draft_flow_gate() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF NOT EXISTS(SELECT 1 FROM sdlc_tasks t WHERE t.task_id=NEW.task_id
+        AND t.state->'flow'='"single-task-v1"'::jsonb) THEN
+        RAISE EXCEPTION 'SDLC single_task_draft_marker_required' USING ERRCODE='23514';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER sdlc_delivery_draft_flow_gate BEFORE INSERT ON sdlc_delivery_assignments
+FOR EACH ROW EXECUTE FUNCTION sdlc_delivery_draft_flow_gate();
+
 CREATE TABLE sdlc_delivery_holds (
     assignment_id uuid PRIMARY KEY,
     task_id uuid NOT NULL UNIQUE,
diff --git a/docs/API.md b/docs/API.md
index 04f04b0..e7e44c1 100644
--- a/docs/API.md
+++ b/docs/API.md
@@ -1,5 +1,31 @@
 # API v1 Specification — Task Tracker
 
+## Explicit New Draft Flow
+
+The existing Draft creation request adds optional `flow:"single-task-v1"`.
+Omission keeps legacy JSON/hash and creation behavior, even in an enabled project.
+Explicit null, booleans and other values are invalid; no default flow is inferred.
+`CreatedDraft` and Context wire are unchanged. Only new marked creations receive
+Ready/brainstorming; legacy bindings/reservations are never retrofitted.
+
+For new marked effects, Tracker requires project opt-in and a present, valid,
+authoritative seven-role policy v2. Missing policy is 404, incompatible policy is
+409, disabled project is 503. Fleet's existing Draft saga must check actual PM
+readiness through its existing SDK before mutation; declared routing is not runtime
+proof, and no caller-ready flag or force-config is introduced. Fresh ACL precedes
+original creation replay; current policy/rollout checks follow replay. Changed
+payload/flow with the same key is 409. Existing operation GET reconstructs the
+original command/hash using immutable input plus the retained flow marker.
+
+Exact owner confirmation of a marked task always freezes the current v2 policy in
+the existing transaction, even if `expected_routing_policy_version` is omitted.
+When supplied, that version remains an additional CAS. No command field is added
+or mutated server-side for hashing. Confirmation, frozen seven-role snapshot,
+route-derived Analysis intent, canonical issue projection, operation and outbox
+commit together or roll back. Replay keeps its original consent/snapshot after
+policy changes or disable. Existing PM assignment is not rebound. Unmarked legacy
+confirmation retains its original explicit-version snapshot semantics.
+
 Новый opt-in single-task пакет добавляет lifecycle/readback, agent proposals
 и PM feedback в существующий strict SDLC router. Registered paths, DTO,
 статус квалификации и открытые gates:
diff --git a/docs/ARCHITECTURE.md b/docs/ARCHITECTURE.md
index ab0ce2a..1d82b6e 100644
--- a/docs/ARCHITECTURE.md
+++ b/docs/ARCHITECTURE.md
@@ -1,5 +1,22 @@
 # Архитектура Task Tracker
 
+New single-task enrollment is explicit at Draft creation, not inferred from a
+project flag or an existing PM reservation. The immutable `flow:"single-task-v1"`
+marker stays in canonical TaskState's retained JSON; Context/CreatedDraft do not
+grow new fields. Creation checks current declared v2 policy under the existing
+project lock only after original replay. Actual PM readiness belongs to Fleet's
+existing Draft SDK path, outside Tracker's transaction; Tracker never forces
+configuration or treats policy declarations as actual readiness.
+
+Owner confirmation freezes current project routing under the same project lock
+as consent/persistence. Optional caller version is an extra CAS, not the opt-in
+switch. The original confirmation command hash is unchanged when it is omitted;
+the selected policy is retained in the immutable snapshot, never retroactively
+substituted on replay. SQL protects marker shape/origin/immutability and requires
+the exact v2 snapshot before a marked task leaves Draft. Existing initial delivery
+projection and new assignment inserts reject absent marker without rewriting
+historical executions or interfering with their terminal/readback paths.
+
 Новая opt-in вертикаль одной задачи сохраняет цепочку controller/service/repository.
 Agent proposal не равен stage completion: Fleet после actual terminal передаёт
 guarded Complete, а Tracker владеет переходом и capacity. Второй планировщик
