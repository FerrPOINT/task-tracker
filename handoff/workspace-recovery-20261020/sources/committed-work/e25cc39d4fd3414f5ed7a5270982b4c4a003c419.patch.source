diff --git a/frontend/src/api/board.test.ts b/frontend/src/api/board.test.ts
new file mode 100644
index 0000000..65c4719
--- /dev/null
+++ b/frontend/src/api/board.test.ts
@@ -0,0 +1,84 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { getBoard, moveIssue } from './board'
+import { listTransitions } from './workflow'
+
+const GET = vi.hoisted(() => vi.fn())
+const POST = vi.hoisted(() => vi.fn())
+vi.mock('./client', () => ({ api: { GET, POST } }))
+
+const board = {
+  project_key: 'TT',
+  columns: [{ id: 'todo', name: 'To Do', issue_ids: [] }],
+  issues: [],
+  sprint: { name: 'Sprint 1' },
+  backlog_total: 0,
+}
+
+describe('board transport contracts', () => {
+  beforeEach(() => {
+    GET.mockReset()
+    POST.mockReset()
+  })
+
+  it.each([403, 404, 422, 503])('preserves HTTP status %s for reads and moves', async (status) => {
+    const failure = { error: { message: 'Private diagnostic' }, response: { status } }
+    GET.mockResolvedValue(failure)
+    POST.mockResolvedValue(failure)
+    await expect(getBoard('TT')).rejects.toMatchObject({ status })
+    await expect(moveIssue('TT', { issue_id: 'i1', status_id: 'done' })).rejects.toMatchObject({
+      status,
+    })
+  })
+
+  it.each([
+    undefined,
+    {},
+    { ...board, columns: null },
+    { ...board, issues: 'bad' },
+    { ...board, columns: [null] },
+    { ...board, columns: [{ id: 'todo', name: 'To Do' }] },
+    { ...board, issues: [null] },
+    { ...board, issues: [{ id: 'i1' }] },
+  ])('does not infer successful loading or moving from malformed response', async (data) => {
+    GET.mockResolvedValue({ data, response: { status: 200 } })
+    POST.mockResolvedValue({ data, response: { status: 200 } })
+    await expect(getBoard('TT')).rejects.toMatchObject({ name: 'InvalidResponseError' })
+    await expect(moveIssue('TT', { issue_id: 'i1', status_id: 'done' })).rejects.toMatchObject({
+      name: 'InvalidResponseError',
+    })
+  })
+
+  it('keeps project paths and the domain payload unchanged', async () => {
+    GET.mockResolvedValue({ data: board, response: { status: 200 } })
+    POST.mockResolvedValue({ data: board, response: { status: 200 } })
+    await expect(getBoard('tt')).resolves.toEqual(board)
+    const input = { issue_id: 'i1', status_id: 'done' }
+    await expect(moveIssue('tt', input)).resolves.toEqual(board)
+    expect(GET).toHaveBeenCalledWith('/api/v1/projects/{project_key}/board', {
+      params: { path: { project_key: 'tt' } },
+    })
+    expect(POST).toHaveBeenCalledWith('/api/v1/projects/{project_key}/board/move', {
+      params: { path: { project_key: 'tt' } },
+      body: input,
+    })
+  })
+})
+
+describe('workflow transition transport', () => {
+  beforeEach(() => GET.mockReset())
+  it.each([403, 404, 422, 503])('preserves transition failure status %s', async (status) => {
+    GET.mockResolvedValue({ error: {}, response: { status } })
+    await expect(listTransitions()).rejects.toMatchObject({ status })
+  })
+  it.each([undefined, {}, 'invalid', [null], [{ from_status_id: 'todo' }]])(
+    'rejects missing or malformed rules',
+    async (data) => {
+      GET.mockResolvedValue({ data, response: { status: 200 } })
+      await expect(listTransitions()).rejects.toMatchObject({ name: 'InvalidResponseError' })
+    },
+  )
+  it('distinguishes an actual empty set of rules from a load failure', async () => {
+    GET.mockResolvedValue({ data: [], response: { status: 200 } })
+    await expect(listTransitions()).resolves.toEqual([])
+  })
+})
diff --git a/frontend/src/api/board.ts b/frontend/src/api/board.ts
index 9410d8b..d209449 100644
--- a/frontend/src/api/board.ts
