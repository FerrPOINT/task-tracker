@@ -1,16 +1,46 @@
 import { api } from './client'
+import { ApiError, InvalidResponseError } from '@sdlc/ui/lib'
 import type { components } from './generated'
 
 export type MoveIssueInput = components['schemas']['MoveIssueRequest']
 export type Board = components['schemas']['BoardResponse']
 export type Backlog = components['schemas']['BacklogResponse']
 
+function requireBoard(data: Board | undefined, status: number | undefined): Board {
+  if (
+    !data ||
+    typeof data.project_key !== 'string' ||
+    !data.project_key ||
+    !Array.isArray(data.columns) ||
+    !Array.isArray(data.issues) ||
+    !data.columns.every(
+      (column) =>
+        column &&
+        typeof column.id === 'string' &&
+        typeof column.name === 'string' &&
+        Array.isArray(column.issue_ids) &&
+        column.issue_ids.every((id) => typeof id === 'string'),
+    ) ||
+    !data.issues.every(
+      (issue) =>
+        issue &&
+        ['id', 'key', 'summary', 'priority', 'issue_type', 'status_id'].every(
+          (field) => typeof issue[field as keyof typeof issue] === 'string',
+        ),
+    )
+  )
+    throw new InvalidResponseError(status ?? 0)
+  return data
+}
+
 export async function getBoard(projectKey: string): Promise<Board> {
-  const { data, error } = await api.GET('/api/v1/projects/{project_key}/board', {
+  const { data, error, response } = await api.GET('/api/v1/projects/{project_key}/board', {
     params: { path: { project_key: projectKey } },
   })
-  if (error || !data) throw new Error('Failed to load board')
-  return data
+  const status = response?.status
+  if (error || (status !== undefined && status >= 400))
+    throw new ApiError(status, 'Failed to load board', error)
+  return requireBoard(data, status)
 }
 
 const BACKLOG_PAGE_SIZE = 100
@@ -31,10 +61,12 @@ export async function getBacklog(
 }
 
 export async function moveIssue(projectKey: string, input: MoveIssueInput): Promise<Board> {
-  const { data, error } = await api.POST('/api/v1/projects/{project_key}/board/move', {
+  const { data, error, response } = await api.POST('/api/v1/projects/{project_key}/board/move', {
     params: { path: { project_key: projectKey } },
     body: input,
   })
-  if (error || !data) throw new Error('Failed to move issue')
-  return data
+  const status = response?.status
+  if (error || (status !== undefined && status >= 400))
+    throw new ApiError(status, 'Failed to move issue', error)
+  return requireBoard(data, status)
 }
