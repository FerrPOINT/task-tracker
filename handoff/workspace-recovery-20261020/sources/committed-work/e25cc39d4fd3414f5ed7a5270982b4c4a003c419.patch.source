 }
 
 export async function listTransitions(): Promise<Transition[]> {
-  const { data, error } = await api.GET('/api/v1/transitions')
-  if (error || !data) throw new Error('Failed to load transitions')
+  const { data, error, response } = await api.GET('/api/v1/transitions')
+  const status = response?.status
+  if (error || (status !== undefined && status >= 400))
+    throw new ApiError(status, 'Failed to load transitions', error)
+  if (
+    !Array.isArray(data) ||
+    !data.every(
+      (rule) =>
+        rule && typeof rule.from_status_id === 'string' && typeof rule.to_status_id === 'string',
+    )
+  )
+    throw new InvalidResponseError(status ?? 0)
   return data
 }
 
