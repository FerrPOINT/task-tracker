diff --cc frontend/src/features/comments/ui/CommentsPanel.test.tsx
index 0000000,0000000..4f49681
new file mode 100644
--- /dev/null
+++ b/frontend/src/features/comments/ui/CommentsPanel.test.tsx
@@@ -1,0 -1,0 +1,100 @@@
++import { beforeEach, describe, expect, it, vi } from 'vitest'
++import { fireEvent, render, screen } from '@testing-library/react'
++import { I18nextProvider } from 'react-i18next'
++import i18n from '@/shared/i18n/test-config'
++import { CommentsPanel } from './CommentList'
++
++const mocks = vi.hoisted(() => ({ query: vi.fn(), refetch: vi.fn() }))
++vi.mock('../model/use-comments', () => ({
++  useComments: mocks.query,
++  useCreateComment: () => ({ mutateAsync: vi.fn(), isPending: false }),
++  useUpdateComment: () => ({ mutateAsync: vi.fn(), isPending: false }),
++  useDeleteComment: () => ({ mutate: vi.fn(), isPending: false }),
++}))
++
++const comment = {
++  id: 'c1',
++  issueId: 'i1',
++  authorId: 'u1',
++  authorName: 'Fixture User',
++  body: 'Private comment',
++  createdAt: '2026-07-30T10:00:00Z',
++  updatedAt: '2026-07-30T10:00:00Z',
++}
++function show(data: (typeof comment)[] | undefined, error: unknown = null, isLoading = false) {
++  mocks.query.mockReturnValue({ data, error, isLoading, refetch: mocks.refetch })
++  return render(
++    <I18nextProvider i18n={i18n}>
++      <CommentsPanel issueId="i1" currentUserId="u1" />
++    </I18nextProvider>,
++  )
++}
++beforeEach(() => {
++  vi.clearAllMocks()
++  i18n.addResource('ru', 'translation', 'common.retry', 'Повторить')
++})
++
++describe('CommentsPanel Base freshness states', () => {
++  for (const cached of [false, true]) {
++    for (const status of [403, 404, 422, 503]) {
++      it(`${cached ? 'cached' : 'cold'} HTTP ${status} respects privacy and retry policy`, () => {
++        const { container } = show(cached ? [comment] : undefined, { status })
++        const retained = cached && status === 503
++        const retry = screen.queryByRole('button', { name: /повторить/i })
++        if (status === 403 || status === 404) {
++          expect(
++            container.querySelector(
++              `[data-page-state="${status === 403 ? 'permission-denied' : 'not-found'}"]`,
++            ),
++          ).toBeVisible()
++        } else if (retained) {
++          expect(container.querySelector('[data-page-state="partial-error"]')).toBeVisible()
++        } else {
++          expect(screen.getByRole('alert')).toBeVisible()
++        }
++        if (retained) {
++          expect(screen.getByText(comment.body)).toBeVisible()
++          expect(screen.getByRole('textbox', { name: /комментарий/i })).toBeVisible()
++        } else {
++          expect(screen.queryByText(comment.body)).not.toBeInTheDocument()
++          expect(screen.queryByRole('textbox')).not.toBeInTheDocument()
++          expect(
++            screen.queryByRole('button', { name: /изменить|удалить/i }),
++          ).not.toBeInTheDocument()
++        }
++        if (status === 503) {
++          expect(retry).toBeVisible()
++          fireEvent.click(retry!)
++          expect(mocks.refetch).toHaveBeenCalledOnce()
++        } else {
++          expect(retry).not.toBeInTheDocument()
++        }
++      })
++    }
++  }
++  it.each([0, 408, 429])('cached HTTP %s retains comments as partial failure', (status) => {
++    const { container } = show([comment], { status })
++    expect(container.querySelector('[data-page-state="partial-error"]')).toBeVisible()
++    expect(screen.getByText(comment.body)).toBeVisible()
++    expect(screen.getByRole('button', { name: /повторить/i })).toBeVisible()
++  })
++  it('cancelled refresh does not expose cached comments or offer retry', () => {
++    show([comment], { name: 'AbortError' })
++    expect(screen.getByRole('alert')).toBeVisible()
++    expect(screen.queryByText(comment.body)).not.toBeInTheDocument()
++    expect(screen.queryByRole('textbox')).not.toBeInTheDocument()
++    expect(screen.queryByRole('button', { name: /повторить/i })).not.toBeInTheDocument()
++  })
++  it('distinguishes unavailable data from a confirmed empty comment list', () => {
++    show(undefined)
++    expect(screen.getByRole('alert')).toBeVisible()
++    expect(screen.queryByText(/пока нет комментариев/i)).not.toBeInTheDocument()
++    expect(screen.queryByRole('textbox')).not.toBeInTheDocument()
++  })
++  it('keeps comment creation available for a successfully loaded empty list', () => {
++    show([])
++    expect(screen.getByText(/пока нет комментариев/i)).toBeVisible()
++    expect(screen.getByRole('textbox', { name: /комментарий/i })).toBeVisible()
++    expect(screen.queryByRole('alert')).not.toBeInTheDocument()
++  })
++})
