 +    test(`does not acknowledge an unknown create from a matching name in ${theme}`, async ({
 +      page,
 +      baseURL,
 +    }, testInfo) => {
 +      test.setTimeout(180_000)
 +      await installTrackerMocks(page)
 +      await page.addInitScript((value) => localStorage.setItem('theme', value), theme)
 +      let writes = 0
 +      let reads = 0
 +      await page.route('**/api/v1/projects/DEMO/sprints', (route) => {
 +        if (route.request().method() === 'POST') {
 +          writes++
 +          return routeJson(route, { error: { message: 'Isolated lost acknowledgement' } }, 503)
 +        }
 +        reads++
 +        return routeJson(route, {
 +          sprints: [
 +            {
 +              id: 'ambiguous-existing',
 +              name: 'Same safe name',
 +              goal: '',
 +              state: 'future',
 +              issue_ids: [],
