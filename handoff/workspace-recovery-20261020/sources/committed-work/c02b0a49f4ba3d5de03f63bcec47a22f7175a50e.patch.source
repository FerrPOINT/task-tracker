 +test.describe('Base sprint lifecycle', () => {
 +  for (const theme of ['light', 'gray', 'dark'] as const) {
 +    test(`keeps a rejected draft and pending controls in ${theme}`, async ({
 +      page,
 +      baseURL,
 +    }, testInfo) => {
 +      test.setTimeout(180_000)
 +      await installTrackerMocks(page)
 +      await page.addInitScript((value) => localStorage.setItem('theme', value), theme)
 +      let release!: () => void
 +      let barrier = new Promise<void>((resolve) => {
 +        release = resolve
 +      })
 +      let writes = 0
 +      await page.route('**/api/v1/projects/DEMO/sprints', async (route) => {
 +        if (route.request().method() !== 'POST') return route.fallback()
 +        writes++
 +        await barrier
 +        return routeJson(route, { error: { message: 'Private validation fixture' } }, 422)
 +      })
 +      const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
 +      const target = `${app}/projects/DEMO/backlog?source=sprint#context`
 +      await page.goto(target)
 +      const create = page.getByRole('button', { name: 'Создать спринт', exact: true })
 +      await expect(create).toBeVisible()
 +      for (const width of [375, 1920]) {
 +        await page.setViewportSize({ width, height: 1080 })
 +        await create.click()
