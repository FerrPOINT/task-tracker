 +      await create.click()
 +      const dialog = page.getByRole('dialog', { name: 'Новый спринт', exact: true })
 +      const name = dialog.getByLabel('Название', { exact: false })
 +      await name.fill('Same safe name')
 +      await dialog.getByRole('button', { name: 'Создать спринт', exact: true }).click()
 +      await expect(dialog.getByRole('alert')).toContainText('Результат сохранения неизвестен')
 +      const before = reads
 +      await dialog.getByRole('button', { name: 'Проверить на сервере', exact: true }).click()
 +      await expect.poll(() => reads).toBeGreaterThan(before)
 +      await expect(
 +        dialog.getByRole('button', { name: 'Проверить на сервере', exact: true }),
 +      ).toBeEnabled()
 +      await expect(
 +        dialog.getByRole('button', { name: 'Создать спринт', exact: true }),
 +      ).toBeDisabled()
