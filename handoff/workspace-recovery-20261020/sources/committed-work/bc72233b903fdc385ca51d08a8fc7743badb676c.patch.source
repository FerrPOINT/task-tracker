diff --git a/CHANGELOG.md b/CHANGELOG.md
index d75eac8..cedacc4 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -6,6 +6,16 @@
 
 ## [Unreleased]
 
+- Browser QA records event-stream cancellation only during explicit navigation
+  and keeps all other transport failures; regression tests cover the distinction.
+  Toast geometry checks retain strict CSS targets with 0.001 px rendering tolerance.
+  Notification captures use the normal hover pause before keyboard dismissal.
+
+- Sprint and issue metadata captions use Base labels; sprint goal uses Base Textarea.
+  Mutation lifecycle and draft safety remain a separate audited follow-up.
+- Base 7e27713 унифицирует подписи полей (12 px) и SSR-значения (14 px).
+  Геометрия shell, API и принятый runtime не меняются.
+
 - HTML pattern ключа проекта компилируется в Unicode-set режиме браузера;
   дефис экранирован, допустимые API-значения и границы 1–10 не меняются.
 
diff --git a/frontend/e2e/navigation-observations.ts b/frontend/e2e/navigation-observations.ts
new file mode 100644
index 0000000..d92801c
--- /dev/null
+++ b/frontend/e2e/navigation-observations.ts
@@ -0,0 +1,49 @@
+import type { Page } from '@playwright/test'
+
+export interface FailedRequestObservation {
+  method: string
+  url: string
+  errorText: string | undefined
+  duringNavigation: boolean
+}
+
+export function isNavigationStreamAbort(observation: FailedRequestObservation, origin: string) {
+  const url = new URL(observation.url)
+  return (
+    observation.duringNavigation &&
+    observation.method === 'GET' &&
+    url.origin === origin &&
+    url.pathname === '/api/v1/events' &&
+    observation.errorText === 'net::ERR_ABORTED'
+  )
+}
+
+export function observeNavigationRequests(page: Page, app: string, failures: string[]) {
+  let navigating = false
+  const streamAborts: FailedRequestObservation[] = []
+  page.on('requestfailed', (request) => {
+    const observation = {
+      method: request.method(),
+      url: request.url(),
+      errorText: request.failure()?.errorText,
+      duringNavigation: navigating,
+    }
+    if (isNavigationStreamAbort(observation, new URL(app).origin)) streamAborts.push(observation)
+    else
+      failures.push(
+        `${observation.method} ${observation.url}: ${observation.errorText ?? 'unknown failure'}`,
+      )
+  })
+  return {
+    streamAborts,
+    async navigate(url?: string) {
+      navigating = true
+      try {
+        if (url) await page.goto(url)
+        else await page.reload()
+      } finally {
+        navigating = false
+      }
+    },
+  }
+}
