diff --git a/frontend/src/test/navigation-observations.test.ts b/frontend/src/test/navigation-observations.test.ts
new file mode 100644
index 0000000..f2d730c
--- /dev/null
+++ b/frontend/src/test/navigation-observations.test.ts
@@ -0,0 +1,29 @@
+import { describe, expect, it } from 'vitest'
+import { isNavigationStreamAbort } from '../../e2e/navigation-observations'
+
+const origin = 'http://localhost:4173'
+const expected = {
+  method: 'GET',
+  url: `${origin}/api/v1/events`,
+  errorText: 'net::ERR_ABORTED',
+  duringNavigation: true,
+}
+
+describe('navigation network evidence', () => {
+  it('recognizes only an intentionally interrupted same-origin event stream', () => {
+    expect(isNavigationStreamAbort(expected, origin)).toBe(true)
+  })
+
+  it.each([
+    { duringNavigation: false },
+    { method: 'POST' },
+    { errorText: 'net::ERR_CONNECTION_RESET' },
+    { errorText: undefined },
+    { url: `${origin}/api/v1/events-unexpected` },
+    { url: `${origin}/assets/index.js` },
+    { url: `${origin}/api/v1/search` },
+    { url: 'http://other-host:4173/api/v1/events' },
+  ])('retains a real or unclassified failure: %j', (override) => {
+    expect(isNavigationStreamAbort({ ...expected, ...override }, origin)).toBe(false)
+  })
+})
