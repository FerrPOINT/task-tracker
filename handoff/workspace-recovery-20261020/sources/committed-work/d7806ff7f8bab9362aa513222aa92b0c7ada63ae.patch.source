     let (held, _) = Box::pin(f.repo.submit_critical_blocker_with_storage(
         r.task,
         &r.producer,
@@ -151,6 +155,11 @@ async fn actual_current_pm_blocker_read_requires_saved_review_fresh_acl_and_curr
         assignment.execution_id
     );
