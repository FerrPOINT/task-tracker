diff --git a/backend/api/src/middleware/attachment_pm_review_tests.rs b/backend/api/src/middleware/attachment_pm_review_tests.rs
new file mode 100644
index 0000000..2a12c8d
--- /dev/null
+++ b/backend/api/src/middleware/attachment_pm_review_tests.rs
@@ -0,0 +1,18 @@
+use super::*;
+use axum::{
+    http::{StatusCode, header},
+    response::IntoResponse,
+};
+
+#[test]
+fn pm_download_success_and_denials_never_cache() {
+    for result in [
+        Ok(StatusCode::OK.into_response()),
+        Err(AppError::Forbidden),
+        Err(AppError::conflict("synthetic changed scope")),
+        Err(AppError::Unavailable("synthetic disabled".into())),
+    ] {
+        let response = pm_no_store(result);
+        assert_eq!(response.headers()[header::CACHE_CONTROL], "no-store");
+    }
+}
diff --git a/backend/app/src/attachment_pm_review.rs b/backend/app/src/attachment_pm_review.rs
new file mode 100644
index 0000000..7a44a9c
--- /dev/null
+++ b/backend/app/src/attachment_pm_review.rs
@@ -0,0 +1,45 @@
+//! PM single-download shape and exact saved evidence only; never general attachment authority.
+use domain::attachment_artifact::Seal;
+use domain::sdlc::Principal;
+use domain::sdlc_critical_blockers::{CriticalBlockerReceipt, CriticalBlockerState};
+use shared::AppError;
+
+pub fn route(actor: &Principal, method: &str, path: &str) -> Result<bool, AppError> {
+    let Some(_) = crate::sdlc::pm_grant_task(actor)? else {
+        return Ok(false);
+    };
+    if !actor.scopes.contains("task-tracker:read")
+        || crate::sdlc_lifecycle::has_delivery_grant(&actor.scopes)
+        || method != "GET"
+        || !crate::attachment_artifacts::is_download_path(path)
+    {
+        return Err(AppError::Forbidden);
+    }
+    Ok(true)
+}
+
+/// Caller first loads the current saved review with fresh PM/owner/project/lease authority.
+pub fn evidence(
+    blocker: &CriticalBlockerReceipt,
+    attachment: &domain::Attachment,
+    seal: &Seal,
+) -> Result<(), AppError> {
+    seal.validate_attachment(attachment)?;
+    if blocker.state != CriticalBlockerState::InPmReview
+        || attachment.storage_key.as_ref() != seal.key()
+        || blocker.task_id != blocker.root_task_id
+        || attachment.issue_id.as_uuid() != blocker.task_id
+        || seal.binding.assignment_id != blocker.proposal.fence.assignment_id
+        || seal.binding.execution_id != blocker.proposal.fence.execution_id
+        || seal.binding.role != blocker.role
+        || seal.run_id != blocker.run_id
+        || !blocker.proposal.evidence.contains(&seal.artifact())
+    {
+        return Err(AppError::Forbidden);
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+#[path = "attachment_pm_review_tests.rs"]
+mod tests;
diff --git a/backend/app/src/attachment_pm_review_tests.rs b/backend/app/src/attachment_pm_review_tests.rs
new file mode 100644
index 0000000..311c488
--- /dev/null
+++ b/backend/app/src/attachment_pm_review_tests.rs
@@ -0,0 +1,164 @@
+use super::*;
+use domain::attachment_artifact::ArtifactBinding;
+use domain::sdlc::PmAssignment;
+use domain::sdlc_lifecycle::DeliveryRole;
+use serde_json::json;
+use uuid::Uuid;
+
+fn actor(task: Uuid) -> Principal {
+    let assignment = PmAssignment {
+        assignment_id: Uuid::new_v4(),
+        execution_id: Uuid::new_v4(),
+        agent_id: Uuid::new_v4(),
+        version: 18,
+        machine_subject: "synthetic-pm".into(),
+    };
+    Principal {
+        subject: assignment.machine_subject.clone(),
+        human_session: false,
+        trusted_human: false,
+        scopes: ["task-tracker:read".into(), assignment.scope(task)].into(),
+    }
+}
+
+fn fixture(role: DeliveryRole) -> (CriticalBlockerReceipt, domain::Attachment, Seal, Vec<u8>) {
+    let task = Uuid::new_v4();
+    let bytes = b"{ \"critical\": true }\n".to_vec();
+    let seal = Seal::new(
+        task,
+        ArtifactBinding {
+            assignment_id: Uuid::new_v4(),
+            execution_id: Uuid::new_v4(),
+            role,
+        },
+        Uuid::new_v4(),
+        "critical.json",
+        "application/json",
+        crate::attachment_artifacts::raw_sha256(&bytes),
+    )
+    .unwrap();
+    let item = domain::Attachment {
+        id: shared::AttachmentId::from_uuid(seal.artifact_id),
+        issue_id: shared::IssueId::from_uuid(task),
+        author_id: shared::UserId::new(),
+        file_name: "critical.json".into(),
+        content_type: "application/json".into(),
+        size_bytes: bytes.len() as i64,
+        storage_key: seal.key().into(),
+        created_at: shared::now(),
+    };
+    let proposal = json!({"fence":{"assignment_id":seal.binding.assignment_id,"execution_id":seal.binding.execution_id,
+            "lease_id":Uuid::new_v4(),"fencing_token":5,"expected_lease_version":3},
+        "requirement_revision":4,"content_hash":"a".repeat(64),"kind":"requirements_contradiction",
+        "question":"Which rule is authoritative?","rationale":"The approved rules conflict.",
+        "options":[],"recommendation":null,"idempotency_key":"original-question","evidence":[seal.artifact()]});
+    let mut blocker:CriticalBlockerReceipt = serde_json::from_value(json!({
+        "blocker_id":Uuid::new_v4(),"version":3,"tracker_instance_id":"synthetic-tracker","project_id":Uuid::new_v4(),
+        "task_id":task,"root_task_id":task,"owner_subject":"synthetic-owner","producer_subject":"synthetic-role",
+        "agent_id":Uuid::new_v4(),"role":role,"assignment_hash":"b".repeat(64),"chat_id":Uuid::new_v4(),
+        "run_id":seal.run_id,"routing_snapshot_id":Uuid::new_v4(),"routing_generation":1,
+        "blocker_sha256":crate::sdlc::canonical_hash(&proposal).unwrap(),"proposal":proposal,
+        "state":"in_pm_review","pm_review":{"assignment_id":Uuid::new_v4(),"execution_id":Uuid::new_v4()},
+        "resolution":null,"technical_terminal":null,"created_at":chrono::Utc::now()
+    })).unwrap();
+    blocker.technical_terminal = Some(domain::sdlc_lifecycle::RuntimeTerminalObservation {
+        assignment_hash: blocker.assignment_hash.clone(),
+        chat_id: blocker.chat_id,
+        run_id: blocker.run_id,
+        state: domain::sdlc_lifecycle::RuntimeTerminalState::Cancelled,
+        receipt: domain::sdlc_lifecycle::ArtifactReceipt {
+            reference: "fixture://synthetic-terminal-not-live-proof".into(),
+            sha256: "e".repeat(64),
+        },
+    });
+    blocker.proposal.validate(role).unwrap();
+    (blocker, item, seal, bytes)
+}
+
+#[test]
+fn pm_route_is_only_single_canonical_get_never_ordinary_list_upload_or_delete() {
+    let task = Uuid::new_v4();
+    let mut pm = actor(task);
+    let id = Uuid::from_u128(0xabcdef);
+    let path = format!("/api/v1/attachments/{id}/download");
+    assert!(route(&pm, "GET", &path).unwrap());
+    for method in ["HEAD", "POST", "PUT", "PATCH", "DELETE"] {
+        assert!(route(&pm, method, &path).is_err());
+    }
+    for path in [
+        format!("/api/v1/issues/{task}/attachments"),
+        format!("/api/v1/attachments/{id}"),
+        format!("{path}/"),
+        format!(
+            "/api/v1/attachments/{}/download",
+            id.to_string().to_uppercase()
+        ),
+        "/api/v1/attachments/not-uuid/download".into(),
+        "/api/v1/attachments/00000000-0000-0000-0000-000000000000/download".into(),
+    ] {
+        assert!(route(&pm, "GET", &path).is_err());
+    }
+    pm.scopes.remove("task-tracker:read");
+    assert!(route(&pm, "GET", &path).is_err());
+    pm = actor(task);
+    pm.human_session = true;
+    assert!(route(&pm, "GET", &path).is_err());
+    pm = actor(task);
+    pm.scopes.extend(actor(Uuid::new_v4()).scopes);
+    assert!(route(&pm, "GET", &path).is_err());
+    pm = actor(task);
+    pm.scopes = ["task-tracker:read".into()].into();
+    assert!(!route(&pm, "GET", &path).unwrap());
+}
+
+#[test]
+fn all_six_saved_technical_roles_accept_only_exact_ref_hash_binding_run_and_raw_bytes() {
+    for role in [
+        DeliveryRole::Analyst,
+        DeliveryRole::Architect,
+        DeliveryRole::Developer,
+        DeliveryRole::Reviewer,
+        DeliveryRole::Tester,
+        DeliveryRole::DevOps,
+    ] {
+        let (blocker, item, seal, bytes) = fixture(role);
+        evidence(&blocker, &item, &seal).unwrap();
+        crate::attachment_artifacts::verify_bytes(&item, &bytes).unwrap();
+        assert!(crate::attachment_artifacts::verify_bytes(&item, b"{\"critical\":true}").is_err());
+        for mismatch in 0..9 {
+            let mut bad = blocker.clone();
+            match mismatch {
+                0 => bad.task_id = Uuid::new_v4(),
+                1 => bad.proposal.evidence.clear(),
+                2 => bad.proposal.evidence[0].receipt.sha256 = "f".repeat(64),
+                3 => {
+                    bad.proposal.evidence[0].receipt.reference =
+                        format!("tracker-attachment:{}", Uuid::new_v4())
+                }
+                4 => bad.proposal.evidence[0].binding.execution_id = Uuid::new_v4(),
+                5 => bad.proposal.fence.assignment_id = Uuid::new_v4(),
+                6 => bad.run_id = Uuid::new_v4(),
+                7 => bad.state = CriticalBlockerState::AwaitingPmReview,
+                _ => {
+                    bad.role = if role == DeliveryRole::Developer {
+                        DeliveryRole::Reviewer
+                    } else {
+                        DeliveryRole::Developer
+                    }
+                }
+            }
+            assert!(evidence(&bad, &item, &seal).is_err());
+        }
+        let mut ordinary = item.clone();
+        ordinary.storage_key = "ordinary-attachment".into();
+        assert!(
+            Seal::parse(ordinary.storage_key.as_ref())
+                .unwrap()
+                .is_none()
+        );
+        assert!(evidence(&blocker, &ordinary, &seal).is_err());
+        let mut foreign = item.clone();
+        foreign.issue_id = shared::IssueId::new();
+        assert!(evidence(&blocker, &foreign, &seal).is_err());
+    }
+}
diff --git a/backend/infra/src/attachment_pm_review.rs b/backend/infra/src/attachment_pm_review.rs
new file mode 100644
index 0000000..53b6d40
--- /dev/null
+++ b/backend/infra/src/attachment_pm_review.rs
@@ -0,0 +1,105 @@
+//! Child of critical_blockers: the same current-PM read guard on both sides of blob I/O.
+use super::*;
+use shared::AttachmentId;
+
+struct Snapshot {
+    blocker: CriticalBlockerReceipt,
+    item: domain::Attachment,
+    seal: Seal,
+}
+
+async fn snapshot(
+    repo: &PostgresSdlcRepository,
+    actor: &Principal,
+    id: AttachmentId,
+) -> Result<Snapshot, AppError> {
+    let task = app::sdlc::pm_grant_task(actor)?.ok_or(AppError::Forbidden)?;
+    let tx = repo.db.begin().await.map_err(map_db)?;
+    let state = repo.load_read(&tx, task, actor).await?;
+    owner_access(&tx, &state).await?;
+    if !repo
+        .config
+        .single_task_project_ids
+        .contains(&state.project_id)
+    {
+        return Err(AppError::Unavailable(
+            "single-task artifact policy disabled".into(),
+        ));
+    }
+    let row = tx
+        .query_one(statement(
+            "SELECT v.after_blocker AS payload FROM sdlc_critical_blocker_heads h
+         JOIN sdlc_critical_pm_reviews v ON v.task_id=h.task_id AND v.blocker_id=h.blocker_id
+         WHERE h.task_id=$1",
+            vec![task.into()],
+        ))
+        .await
+        .map_err(map_db)?
+        .ok_or(AppError::Forbidden)?;
+    let blocker: CriticalBlockerReceipt = decode(&row, "payload")?;
+    scope(&state, &blocker)?;
+    let model = attachment::Entity::find_by_id(id.as_uuid())
+        .one(&tx)
+        .await
+        .map_err(map_db)?
+        .ok_or(AppError::Forbidden)?;
+    let item = crate::repos::map_attachment(model);
+    let seal = Seal::parse(item.storage_key.as_ref())?.ok_or(AppError::Forbidden)?;
+    app::attachment_pm_review::evidence(&blocker, &item, &seal)?;
+    let (origin, binding) =
+        crate::sdlc::attachment_artifacts::provenance(&tx, &item, &seal).await?;
+    if origin.agent_id != blocker.agent_id
+        || origin.owner_subject != blocker.owner_subject
+        || origin.assignment_hash != blocker.assignment_hash
+        || binding.machine_subject != blocker.producer_subject
+        || binding.chat_id != blocker.chat_id
+        || binding.run_id != blocker.run_id
+    {
+        return Err(AppError::conflict(
+            "critical evidence origin differs from saved blocker",
+        ));
+    }
+    // The actual lease clock is read last, after metadata and retained provenance reads.
+    current_pm_reader(&tx, &state, actor, &blocker).await?;
+    tx.commit().await.map_err(map_db)?;
+    Ok(Snapshot {
+        blocker,
+        item,
+        seal,
+    })
+}
+
+pub(crate) async fn download(
+    db: &DatabaseConnection,
+    config: &SdlcConfig,
+    actor: &Principal,
+    id: AttachmentId,
+    storage: &dyn domain::FileStorage,
+) -> Result<(domain::Attachment, Vec<u8>), AppError> {
+    // Reuse the existing pool/config without connect(), writes, new credentials or a new port.
+    let repo = PostgresSdlcRepository {
+        db: db.clone(),
+        config: config.clone(),
+        file_storage: None,
+    };
+    let before = snapshot(&repo, actor, id).await?;
+    // No authorization/task/lease locks across storage I/O: revocation can commit meanwhile.
+    let bytes = storage
+        .get(
+            &before.item.issue_id.to_string(),
+            before.item.storage_key.as_ref(),
+        )
+        .await?;
+    app::attachment_artifacts::verify_bytes(&before.item, &bytes)?;
+    let after = snapshot(&repo, actor, id).await?;
+    if before.blocker != after.blocker
+        || before.seal != after.seal
+        || app::sdlc::canonical_hash(&before.item)? != app::sdlc::canonical_hash(&after.item)?
+    {
+        return Err(AppError::conflict(
+            "critical evidence read scope changed during storage read",
+        ));
+    }
+    app::attachment_artifacts::verify_bytes(&after.item, &bytes)?;
+    Ok((after.item, bytes))
+}
diff --git a/backend/infra/src/attachment_pm_review_pg_tests.rs b/backend/infra/src/attachment_pm_review_pg_tests.rs
new file mode 100644
index 0000000..95dfd1d
--- /dev/null
+++ b/backend/infra/src/attachment_pm_review_pg_tests.rs
@@ -0,0 +1,216 @@
+//! Invoked by the existing ignored current-PM fixture, after the real claim (known producer dependency).
+use super::*;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+pub(super) async fn unlisted(
+    f: &Fixture,
+    r: &Running,
+    storage: &dyn domain::FileStorage,
+) -> shared::AttachmentId {
+    crate::sdlc::attachment_artifacts::publish(
+        &f.db,
+        &f.repo.config,
+        &r.producer,
+        shared::IssueId::from_uuid(r.task),
+        domain::attachment_artifact::ArtifactUpload {
+            file_name: "unlisted-evidence.json".into(),
+            content_type: "application/json".into(),
+            bytes: b"{\"synthetic\":\"not in saved blocker\"}".to_vec(),
+        },
+        storage,
+    )
+    .await
+    .unwrap()
+    .id
+}
+
+#[derive(Clone, Copy)]
+enum DuringIo {
+    None,
+    OwnerRevoked,
+    ProjectRevoked,
+    CorruptBytes,
+}
+
+struct ObservedStorage<'a> {
+    storage: &'a dyn domain::FileStorage,
+    f: &'a Fixture,
+    action: DuringIo,
+    calls: AtomicUsize,
+}
+
+#[async_trait::async_trait]
+impl domain::FileStorage for ObservedStorage<'_> {
+    async fn put(&self, _: &str, _: &str, _: Vec<u8>) -> Result<(), AppError> {
+        Err(AppError::Forbidden)
+    }
+    async fn delete(&self, _: &str, _: &str) -> Result<(), AppError> {
+        Err(AppError::Forbidden)
+    }
+    async fn get(&self, issue: &str, key: &str) -> Result<Vec<u8>, AppError> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        let mut bytes = self.storage.get(issue, key).await?;
+        let write = async {
+            match self.action {
+                DuringIo::OwnerRevoked => {
+                    exec(
+                        &self.f.db,
+                        "UPDATE users SET is_active=false WHERE central_sub='owner'",
+                        vec![],
+                    )
+                    .await?
+                }
+                DuringIo::ProjectRevoked => {
+                    exec(
+                        &self.f.db,
+                        "DELETE FROM project_members WHERE project_id=$1
+                    AND user_id=(SELECT id FROM users WHERE central_sub='pm')",
+                        vec![self.f.project.into()],
+                    )
+                    .await?
+                }
+                DuringIo::CorruptBytes => bytes.push(b' '),
+                DuringIo::None => {}
+            }
+            Ok::<(), AppError>(())
+        };
+        // This also proves the reader did not retain ACL/task locks across FileStorage I/O.
+        tokio::time::timeout(std::time::Duration::from_secs(5), write)
+            .await
+            .expect("synthetic revocation must not wait for reader locks")?;
+        Ok(bytes)
+    }
+}
+
+pub(super) async fn check(
+    f: &Fixture,
+    r: &Running,
+    pm: &Principal,
+    old_pm: &Principal,
+    unlisted: shared::AttachmentId,
+    storage: &dyn domain::FileStorage,
+) {
+    let id: shared::AttachmentId = r
+        .evidence
+        .receipt
+        .reference
+        .strip_prefix("tracker-attachment:")
+        .unwrap()
+        .parse()
+        .unwrap();
+    let observed = ObservedStorage {
+        storage,
+        f,
+        action: DuringIo::None,
+        calls: AtomicUsize::new(0),
+    };
+    let before = read_snapshot(f, r.task).await;
+    let (item, bytes) =
+        crate::sdlc::attachment_artifacts::download(&f.db, &f.repo.config, pm, id, &observed)
+            .await
+            .unwrap();
+    assert_eq!(observed.calls.load(Ordering::SeqCst), 1);
+    assert!(
+        crate::sdlc::attachment_artifacts::download(&f.db, &f.repo.config, pm, unlisted, &observed)
+            .await
+            .is_err()
+    );
+    assert_eq!(observed.calls.load(Ordering::SeqCst), 1);
+    assert_eq!(
+        Seal::parse(item.storage_key.as_ref())
+            .unwrap()
+            .unwrap()
+            .artifact(),
+        r.evidence
+    );
+    app::attachment_artifacts::verify_bytes(&item, &bytes).unwrap();
+    assert_eq!(read_snapshot(f, r.task).await, before);
+    for denied in [old_pm, &f.reader] {
+        assert!(
+            crate::sdlc::critical_blockers::pm_evidence::download(
+                &f.db,
+                &f.repo.config,
+                denied,
+                id,
+                &observed
+            )
+            .await
+            .is_err()
+        );
+        assert_eq!(observed.calls.load(Ordering::SeqCst), 1);
+    }
+    assert!(
+        crate::sdlc::attachment_artifacts::download(
+            &f.db,
+            &f.repo.config,
+            pm,
+            shared::AttachmentId::new(),
+            &observed
+        )
+        .await
+        .is_err()
+    );
+    assert_eq!(observed.calls.load(Ordering::SeqCst), 1);
+
+    let ordinary = Uuid::new_v4();
+    exec(&f.db,"INSERT INTO attachments(id,issue_id,author_id,file_name,content_type,size_bytes,storage_key,created_at)
+        SELECT $1,issue_id,author_id,'ordinary.txt','text/plain',1,'ordinary-private-file',created_at FROM attachments WHERE id=$2",
+        vec![ordinary.into(),id.as_uuid().into()]).await.unwrap();
+    assert!(
+        crate::sdlc::attachment_artifacts::download(
+            &f.db,
+            &f.repo.config,
+            pm,
+            shared::AttachmentId::from_uuid(ordinary),
+            &observed
+        )
+        .await
+        .is_err()
+    );
+    assert_eq!(observed.calls.load(Ordering::SeqCst), 1);
+    exec(
+        &f.db,
+        "DELETE FROM attachments WHERE id=$1",
+        vec![ordinary.into()],
+    )
+    .await
+    .unwrap();
+
+    for action in [
+        DuringIo::OwnerRevoked,
+        DuringIo::ProjectRevoked,
+        DuringIo::CorruptBytes,
+    ] {
+        let observed = ObservedStorage {
+            storage,
+            f,
+            action,
+            calls: AtomicUsize::new(0),
+        };
+        assert!(
+            crate::sdlc::attachment_artifacts::download(&f.db, &f.repo.config, pm, id, &observed)
+                .await
+                .is_err()
+        );
+        assert_eq!(observed.calls.load(Ordering::SeqCst), 1);
+        match observed.action {
+            DuringIo::OwnerRevoked => exec(
+                &f.db,
+                "UPDATE users SET is_active=true WHERE central_sub='owner'",
+                vec![],
+            )
+            .await
+            .unwrap(),
+            DuringIo::ProjectRevoked => exec(
+                &f.db,
+                "INSERT INTO project_members(project_id,user_id,role)
+                SELECT $1,id,'developer' FROM users WHERE central_sub='pm'",
+                vec![f.project.into()],
+            )
+            .await
+            .unwrap(),
+            _ => {}
+        }
+        assert_eq!(read_snapshot(f, r.task).await, before);
+    }
+}
