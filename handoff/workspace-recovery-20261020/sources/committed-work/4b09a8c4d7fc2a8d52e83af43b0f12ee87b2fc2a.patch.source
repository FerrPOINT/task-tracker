diff --git a/frontend/src/features/comments/model/use-comments.test.tsx b/frontend/src/features/comments/model/use-comments.test.tsx
new file mode 100644
index 0000000..ad1a48a
--- /dev/null
+++ b/frontend/src/features/comments/model/use-comments.test.tsx
@@ -0,0 +1,84 @@
+import { act, renderHook, waitFor } from '@testing-library/react'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { describe, expect, it, vi } from 'vitest'
+import { useComments, useDeleteComment } from './use-comments'
+import type { Comment } from '@/entities/comment/model'
+
+const api = vi.hoisted(() => ({ list: vi.fn(), remove: vi.fn() }))
+vi.mock('@/api/comment', () => ({
+  listComments: api.list,
+  deleteComment: api.remove,
+  createComment: vi.fn(),
+  updateComment: vi.fn(),
+}))
+
+const comment: Comment = {
+  id: 'c1',
+  issueId: 'i1',
+  authorId: 'u1',
+  body: 'Safe fixture',
+  createdAt: '2026-10-20T00:00:00Z',
+  updatedAt: '2026-10-20T00:00:00Z',
+}
+
+describe('confirmed comment deletion', () => {
+  it('removes only the acknowledged row and stays pending through the active refresh', async () => {
+    const client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+    client.setQueryData(['comments', 'i1'], [comment, { ...comment, id: 'c2' }])
+    let resolve!: (comments: Comment[]) => void
+    api.list.mockImplementation(
+      () =>
+        new Promise<Comment[]>((done) => {
+          resolve = done
+        }),
+    )
+    api.remove.mockResolvedValue(undefined)
+    const { result, unmount } = renderHook(
+      () => ({
+        query: useComments('i1'),
+        mutation: useDeleteComment('i1'),
+      }),
+      {
+        wrapper: ({ children }) => (
+          <QueryClientProvider client={client}>{children}</QueryClientProvider>
+        ),
+      },
+    )
+    await waitFor(() => expect(api.list).toHaveBeenCalled())
+    let settled = false
+    let write!: Promise<unknown>
+    act(() => {
+      write = result.current.mutation.mutateAsync('c1').then(() => {
+        settled = true
+      })
+    })
+    await waitFor(() => expect(result.current.query.data?.map((item) => item.id)).toEqual(['c2']))
+    expect(result.current.mutation.isPending).toBe(true)
+    expect(settled).toBe(false)
+    await act(async () => {
+      resolve([{ ...comment, id: 'c2' }])
+      await write
+    })
+    await waitFor(() => expect(result.current.mutation.isPending).toBe(false))
+    expect(settled).toBe(true)
+    unmount()
+    client.clear()
+  })
+
+  it('does not remove cached rows before a delete acknowledgement', async () => {
+    const client = new QueryClient()
+    client.setQueryData(['comments', 'i1'], [comment])
+    api.remove.mockRejectedValue(new Error('Controlled rejection'))
+    const { result, unmount } = renderHook(() => useDeleteComment('i1'), {
+      wrapper: ({ children }) => (
+        <QueryClientProvider client={client}>{children}</QueryClientProvider>
+      ),
+    })
+    await act(async () => {
+      await expect(result.current.mutateAsync('c1')).rejects.toThrow('Controlled rejection')
+    })
+    expect(client.getQueryData(['comments', 'i1'])).toEqual([comment])
+    unmount()
+    client.clear()
+  })
+})
diff --git a/frontend/src/features/comments/model/use-comments.ts b/frontend/src/features/comments/model/use-comments.ts
index 3e549c0..c295a1d 100644
--- a/frontend/src/features/comments/model/use-comments.ts
+++ b/frontend/src/features/comments/model/use-comments.ts
@@ -35,8 +35,11 @@ export function useDeleteComment(issueId: string) {
   const queryClient = useQueryClient()
   return useMutation({
     mutationFn: (id: string) => deleteComment(id),
-    onSuccess: () => {
-      queryClient.invalidateQueries({ queryKey: ['comments', issueId] })
+    onSuccess: async (_, id) => {
+      queryClient.setQueryData<Comment[]>(['comments', issueId], (comments) =>
+        comments?.filter((comment) => comment.id !== id),
+      )
+      await queryClient.invalidateQueries({ queryKey: ['comments', issueId] })
     },
   })
 }
