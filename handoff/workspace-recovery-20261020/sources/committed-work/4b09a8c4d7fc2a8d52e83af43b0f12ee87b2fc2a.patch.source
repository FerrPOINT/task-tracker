+  it('uses one navigation guard for simultaneous description and comment drafts and permits a repeated tab attempt', async () => {
+    const user = userEvent.setup()
+    const warn = vi.spyOn(console, 'warn')
+    render(wrapper(<IssueDetailPage />, '/issues/i1?tab=comments'))
+    fireEvent.click(screen.getByText('Test issue description'))
+    fireEvent.change(screen.getByDisplayValue('Test issue summary'), {
+      target: { value: 'Retained summary' },
+    })
+    const field = screen.getByRole('textbox', { name: /комментарий|comment/i })
+    fireEvent.change(field, { target: { value: 'Retained comment' } })
+    const tab = screen.getByRole('tab', { name: /активность|activity/i })
+    await user.click(tab)
+    let dialog = await screen.findByRole('alertdialog')
+    await user.keyboard('{Escape}')
+    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
+    expect(field).toHaveValue('Retained comment')
+    expect(screen.getByDisplayValue('Retained summary')).toBeInTheDocument()
+    expect(document.activeElement).not.toBe(document.body)
+    fireEvent.keyDown(tab, { key: 'Enter' })
+    dialog = await screen.findByRole('alertdialog')
+    fireEvent.click(within(dialog).getByRole('button', { name: /подтвердить|confirm/i }))
+    await waitFor(() =>
+      expect(screen.getByLabelText('current location')).toHaveTextContent('/issues/i1'),
+    )
+    expect(screen.getByLabelText('current location')).not.toHaveTextContent('tab=comments')
+    expect(screen.getByDisplayValue('Retained summary')).toBeInTheDocument()
+    expect(warn.mock.calls.flat().join(' ')).not.toMatch(/one blocker|single blocker/i)
+    warn.mockRestore()
+  })
+
+  it('blocks navigation and reload during comment submission and cancels stale navigation after ACK', async () => {
+    const user = userEvent.setup()
+    let resolve!: () => void
+    mockCreateComment.mockImplementation(
+      () =>
+        new Promise<void>((done) => {
+          resolve = done
+        }),
+    )
+    render(wrapper(<IssueDetailPage />, '/issues/i1?tab=comments'))
+    const field = screen.getByRole('textbox', { name: /комментарий|comment/i })
+    fireEvent.change(field, { target: { value: 'Submitted draft' } })
+    fireEvent.submit(field.closest('form')!)
+    await waitFor(() => expect(mockCreateComment).toHaveBeenCalledOnce())
+    const unload = new Event('beforeunload', { cancelable: true })
+    window.dispatchEvent(unload)
+    expect(unload.defaultPrevented).toBe(true)
+    await user.click(screen.getByRole('tab', { name: /активность|activity/i }))
+    const dialog = await screen.findByRole('alertdialog')
+    expect(within(dialog).getByRole('button', { name: /подтвердить|confirm/i })).toBeDisabled()
+    await act(async () => resolve())
+    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
+    expect(screen.getByLabelText('current location')).toHaveTextContent('tab=comments')
+    expect(field).toHaveValue('')
+    const cleanUnload = new Event('beforeunload', { cancelable: true })
+    window.dispatchEvent(cleanUnload)
+    expect(cleanUnload.defaultPrevented).toBe(false)
+  })
+
+  it('focuses tabs without navigating until keyboard activation', async () => {
+    const user = userEvent.setup()
+    render(wrapper(<IssueDetailPage />, '/issues/i1?tab=comments'))
+    const field = screen.getByRole('textbox', { name: /комментарий|comment/i })
+    fireEvent.change(field, { target: { value: 'Keyboard draft' } })
+    act(() => screen.getByRole('tab', { name: /комментарии|comments/i }).focus())
+    await user.keyboard('{ArrowLeft}')
+    await waitFor(() =>
+      expect(screen.getByRole('tab', { name: /активность|activity/i })).toHaveFocus(),
+    )
+    expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument()
+    expect(screen.getByLabelText('current location')).toHaveTextContent('tab=comments')
+    const unload = new Event('beforeunload', { cancelable: true })
+    window.dispatchEvent(unload)
+    expect(unload.defaultPrevented).toBe(true)
+    fireEvent.keyDown(screen.getByRole('tab', { name: /активность|activity/i }), { key: 'Enter' })
+    expect(await screen.findByRole('alertdialog')).toBeVisible()
+    await user.keyboard('{Escape}')
+    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
+    expect(field).toHaveValue('Keyboard draft')
+  })
+
   it('renders loading state while the issue itself loads', () => {
     mockUseIssue.mockReturnValue({ data: undefined, isLoading: true, error: null })
     render(wrapper(<IssueDetailPage />))
