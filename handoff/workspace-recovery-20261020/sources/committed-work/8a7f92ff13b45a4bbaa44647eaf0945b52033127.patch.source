diff --git a/frontend/src/api/sprint.test.ts b/frontend/src/api/sprint.test.ts
new file mode 100644
index 0000000..ff799d0
--- /dev/null
+++ b/frontend/src/api/sprint.test.ts
@@ -0,0 +1,110 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { ApiError } from '@sdlc/ui/lib'
+import {
+  createSprint,
+  getSprint,
+  matchesSprintWrite,
+  SprintWriteUncertainError,
+  updateSprint,
+  type Sprint,
+} from './sprint'
+
+const GET = vi.hoisted(() => vi.fn())
+const POST = vi.hoisted(() => vi.fn())
+const PATCH = vi.hoisted(() => vi.fn())
+vi.mock('./client', () => ({ api: { GET, POST, PATCH } }))
+const sprint: Sprint = {
+  id: 'sp1',
+  name: 'Safe fixture',
+  goal: '',
+  issue_ids: [],
+  state: 'future',
+  velocity: 0,
+  start_date: null,
+  end_date: null,
+}
+describe('sprint write acknowledgement', () => {
+  beforeEach(() => {
+    GET.mockReset()
+    POST.mockReset()
+    PATCH.mockReset()
+  })
+  it('requires the domain status, record ID and submitted values', async () => {
+    POST.mockResolvedValue({ data: sprint, response: new Response(null, { status: 201 }) })
+    PATCH.mockResolvedValue({ data: sprint, response: new Response(null, { status: 200 }) })
+    await expect(createSprint('DEMO', { name: sprint.name })).resolves.toEqual(sprint)
+    await expect(
+      updateSprint('DEMO', sprint.id, { goal: null, start_date: null, end_date: null }),
+    ).resolves.toEqual(sprint)
+    expect(POST).toHaveBeenCalledTimes(1)
+    expect(PATCH).toHaveBeenCalledTimes(1)
+  })
+  it.each([400, 401, 403, 404, 409, 422])(
+    'keeps a known %s rejection distinct from an unknown write',
+    async (status) => {
+      const result = {
+        error: { message: 'Private diagnostic' },
+        response: new Response(null, { status }),
+      }
+      POST.mockResolvedValue(result)
+      PATCH.mockResolvedValue(result)
+      await expect(createSprint('DEMO', { name: sprint.name })).rejects.toBeInstanceOf(ApiError)
+      await expect(updateSprint('DEMO', sprint.id, { name: sprint.name })).rejects.toMatchObject({
+        status,
+      })
+    },
+  )
+  it.each([408, 429, 500, 503])('does not replay or acknowledge HTTP %s', async (status) => {
+    POST.mockResolvedValue({ error: {}, response: new Response(null, { status }) })
+    await expect(createSprint('DEMO', { name: sprint.name })).rejects.toBeInstanceOf(
+      SprintWriteUncertainError,
+    )
+    expect(POST).toHaveBeenCalledTimes(1)
+  })
+  it.each([
+    undefined,
+    {},
+    { ...sprint, name: 'Other' },
+    { ...sprint, id: '' },
+    { ...sprint, issue_ids: null },
+  ])('rejects malformed or mismatched acknowledgements', async (data) => {
+    POST.mockResolvedValue({ data, response: new Response(null, { status: 201 }) })
+    await expect(createSprint('DEMO', { name: sprint.name })).rejects.toBeInstanceOf(
+      SprintWriteUncertainError,
+    )
+  })
+  it('never reconciles an edit using an ID returned for another object', async () => {
+    PATCH.mockResolvedValue({
+      data: { ...sprint, id: 'other' },
+      response: new Response(null, { status: 200 }),
+    })
+    await expect(updateSprint('DEMO', sprint.id, { name: sprint.name })).rejects.toMatchObject({
+      sprintId: sprint.id,
+    })
+  })
+  it('reads the exact scoped record and rejects mismatched identity', async () => {
+    GET.mockResolvedValue({ data: sprint, response: new Response(null, { status: 200 }) })
+    await expect(getSprint('DEMO', 'sp1')).resolves.toEqual(sprint)
+    expect(GET).toHaveBeenCalledWith('/api/v1/projects/{project_key}/sprints/{sprint_id}', {
+      params: { path: { project_key: 'DEMO', sprint_id: 'sp1' } },
+    })
+    GET.mockResolvedValue({
+      data: { ...sprint, id: 'other' },
+      response: new Response(null, { status: 200 }),
+    })
+    await expect(getSprint('DEMO', 'sp1')).rejects.toBeInstanceOf(ApiError)
+  })
+  it('compares equivalent date instants while preserving explicit clears', () => {
+    expect(
+      matchesSprintWrite(
+        { ...sprint, start_date: '2026-10-06T03:00:00+03:00' },
+        { start_date: '2026-10-06T00:00:00Z' },
+      ),
+    ).toBe(true)
+    expect(
+      matchesSprintWrite({ ...sprint, start_date: '2026-10-06T00:00:00Z' }, { start_date: null }),
+    ).toBe(false)
+    expect(matchesSprintWrite(sprint, { goal: null })).toBe(true)
+    expect(matchesSprintWrite({ ...sprint, goal: 'Other' }, { goal: null })).toBe(false)
+  })
+})
diff --git a/frontend/src/api/sprint.ts b/frontend/src/api/sprint.ts
index 7d6acc9..43f2c59 100644
--- a/frontend/src/api/sprint.ts
+++ b/frontend/src/api/sprint.ts
@@ -1,4 +1,5 @@
 import { api } from './client'
+import { ApiError } from '@sdlc/ui/lib'
 import type { components } from './generated'
 
 export type Sprint = components['schemas']['SprintResponse']
@@ -7,6 +8,83 @@ export type CreateSprintRequest = components['schemas']['CreateSprintRequest']
 export type UpdateSprintRequest = components['schemas']['UpdateSprintRequest']
 export type MoveIssueToSprintRequest = components['schemas']['MoveIssueToSprintRequest']
 
+export class SprintWriteUncertainError extends Error {
+  constructor(public readonly sprintId?: string) {
+    super('Sprint write outcome requires an authoritative read')
+  }
+}
+
+export function matchesSprintWrite(
+  sprint: Sprint,
+  input: CreateSprintRequest | UpdateSprintRequest,
+) {
+  if (input.name !== undefined && input.name !== null && sprint.name !== input.name) return false
+  if (input.goal !== undefined && sprint.goal !== (input.goal ?? '')) return false
+  for (const key of ['start_date', 'end_date'] as const) {
+    if (input[key] === undefined) continue
+    const expected = input[key]
+    const actual = sprint[key]
+    if (expected === null) {
+      if (actual !== null && actual !== undefined) return false
+    } else if (!actual || Date.parse(actual) !== Date.parse(expected)) return false
+  }
+  return true
+}
+
+function isSprint(value: unknown): value is Sprint {
+  if (!value || typeof value !== 'object') return false
+  const record = value as Partial<Sprint>
+  return (
+    typeof record.id === 'string' &&
+    record.id.length > 0 &&
+    typeof record.name === 'string' &&
+    typeof record.goal === 'string' &&
+    typeof record.state === 'string' &&
+    Array.isArray(record.issue_ids) &&
+    record.issue_ids.every((id) => typeof id === 'string') &&
+    typeof record.velocity === 'number'
+  )
+}
+
+function acknowledgeSprint(
+  data: unknown,
+  error: unknown,
+  response: Response,
+  input: CreateSprintRequest | UpdateSprintRequest,
+  status: number,
+  sprintId?: string,
+): Sprint {
+  if (error || !response.ok) {
+    if ([400, 401, 403, 404, 409, 422].includes(response.status)) {
+      throw new ApiError(response.status, 'Sprint write rejected', error)
+    }
+    throw new SprintWriteUncertainError(sprintId)
+  }
+  if (
+    response.status !== status ||
+    !isSprint(data) ||
+    (sprintId !== undefined && data.id !== sprintId) ||
+    !matchesSprintWrite(data, input)
+  ) {
+    // Never use a mismatched object's ID as evidence for another edit.
+    throw new SprintWriteUncertainError(sprintId ?? (isSprint(data) ? data.id : undefined))
+  }
+  return data
+}
+
+export async function getSprint(projectKey: string, sprintId: string): Promise<Sprint> {
+  const { data, error, response } = await api.GET(
+    '/api/v1/projects/{project_key}/sprints/{sprint_id}',
+    {
+      params: { path: { project_key: projectKey, sprint_id: sprintId } },
+    },
+  )
+  if (error || !response.ok || !isSprint(data) || data.id !== sprintId) {
+    throw new ApiError(response.status, 'Sprint read could not be verified', error)
+  }
+  return data
+}
+
 export async function listSprints(projectKey: string): Promise<Sprint[]> {
   const { data, error } = await api.GET('/api/v1/projects/{project_key}/sprints', {
     params: { path: { project_key: projectKey } },
@@ -16,12 +94,11 @@ export async function listSprints(projectKey: string): Promise<Sprint[]> {
 }
 
 export async function createSprint(projectKey: string, req: CreateSprintRequest): Promise<Sprint> {
-  const { data, error } = await api.POST('/api/v1/projects/{project_key}/sprints', {
+  const { data, error, response } = await api.POST('/api/v1/projects/{project_key}/sprints', {
     params: { path: { project_key: projectKey } },
     body: req,
   })
-  if (error || !data) throw new Error('failed to create sprint')
-  return data
+  return acknowledgeSprint(data, error, response, req, 201)
 }
 
 export async function updateSprint(
@@ -29,12 +106,14 @@ export async function updateSprint(
   sprintId: string,
   req: UpdateSprintRequest,
 ): Promise<Sprint> {
-  const { data, error } = await api.PATCH('/api/v1/projects/{project_key}/sprints/{sprint_id}', {
-    params: { path: { project_key: projectKey, sprint_id: sprintId } },
-    body: req,
-  })
-  if (error || !data) throw new Error('failed to update sprint')
-  return data
+  const { data, error, response } = await api.PATCH(
+    '/api/v1/projects/{project_key}/sprints/{sprint_id}',
+    {
+      params: { path: { project_key: projectKey, sprint_id: sprintId } },
+      body: req,
+    },
+  )
+  return acknowledgeSprint(data, error, response, req, 200, sprintId)
 }
 
