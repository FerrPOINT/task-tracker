+    const props = { open: true, sprint, onSubmit: vi.fn(), onOpenChange: vi.fn(), isPending: false }
+    const view = render(<SprintFormDialog {...props} />, { wrapper: Wrapper })
+    fireEvent.change(screen.getByDisplayValue('Original'), { target: { value: 'Draft' } })
+    view.rerender(
+      <SprintFormDialog {...props} sprint={{ ...sprint, name: 'Background version' }} />,
+    )
+    expect(screen.getByDisplayValue('Draft')).toBeInTheDocument()
+    fireEvent.click(screen.getByRole('button', { name: 'Cancel' }))
+    const confirm = await screen.findByRole('alertdialog')
+    fireEvent.click(within(confirm).getByRole('button', { name: 'Cancel' }))
+    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
+    expect(screen.getByDisplayValue('Draft')).toBeInTheDocument()
+    expect(props.onOpenChange).not.toHaveBeenCalled()
+  })
+
+  it('does not unlock or replay an unknown create on close/reopen or an inconclusive GET', async () => {
+    const onSubmit = vi.fn().mockRejectedValue(new SprintWriteUncertainError())
+    const onReconcile = vi.fn().mockResolvedValue(false)
+    const props = { open: true, onSubmit, onReconcile, onOpenChange: vi.fn(), isPending: false }
+    const view = render(<SprintFormDialog {...props} />, { wrapper: Wrapper })
+    const name = screen.getByPlaceholderText(/Sprint 1/i)
+    fireEvent.change(name, { target: { value: 'Unknown draft' } })
+    await act(async () => fireEvent.submit(name.closest('form')!))
+    expect(screen.getByRole('button', { name: 'Create sprint' })).toBeDisabled()
+    fireEvent.submit(name.closest('form')!)
+    expect(onSubmit).toHaveBeenCalledTimes(1)
+    view.rerender(<SprintFormDialog {...props} open={false} />)
+    view.rerender(<SprintFormDialog {...props} open />)
+    expect(screen.getByDisplayValue('Unknown draft')).toBeDisabled()
+    await act(async () =>
+      fireEvent.click(screen.getByRole('button', { name: 'Check server state' })),
+    )
+    expect(onReconcile).toHaveBeenCalledTimes(1)
+    expect(onSubmit).toHaveBeenCalledTimes(1)
+    expect(screen.getByRole('button', { name: 'Create sprint' })).toBeDisabled()
+    expect(props.onOpenChange).not.toHaveBeenCalled()
+  })
+
+  it('accepts a verified readback without a second write', async () => {
+    const onSubmit = vi.fn().mockRejectedValue(new SprintWriteUncertainError('sp1'))
+    const onReconcile = vi.fn().mockResolvedValue(true)
+    const props = { open: true, onSubmit, onReconcile, onOpenChange: vi.fn(), isPending: false }
+    render(<SprintFormDialog {...props} />, { wrapper: Wrapper })
+    const name = screen.getByPlaceholderText(/Sprint 1/i)
+    fireEvent.change(name, { target: { value: 'Verified' } })
+    await act(async () => fireEvent.submit(name.closest('form')!))
+    await act(async () =>
+      fireEvent.click(screen.getByRole('button', { name: 'Check server state' })),
+    )
+    expect(onSubmit).toHaveBeenCalledTimes(1)
+    expect(props.onOpenChange).toHaveBeenCalledExactlyOnceWith(false)
+  })
+
+  it('does not reuse an unknown create in another project context', async () => {
+    const props = {
+      open: true,
+      contextKey: 'ONE',
+      onSubmit: vi.fn().mockRejectedValue(new SprintWriteUncertainError()),
+      onOpenChange: vi.fn(),
+      isPending: false,
+    }
+    const view = render(<SprintFormDialog {...props} />, { wrapper: Wrapper })
+    const name = screen.getByPlaceholderText(/Sprint 1/i)
+    fireEvent.change(name, { target: { value: 'One draft' } })
+    await act(async () => fireEvent.submit(name.closest('form')!))
+    view.rerender(<SprintFormDialog {...props} contextKey="TWO" />)
+    expect(screen.getByPlaceholderText(/Sprint 1/i)).toHaveValue('')
+    expect(screen.getByPlaceholderText(/Sprint 1/i)).toBeEnabled()
+    view.rerender(<SprintFormDialog {...props} contextKey="ONE" />)
+    expect(screen.getByDisplayValue('One draft')).toBeDisabled()
+  })
