+    await act(async () => reject(new ApiError(422, 'Private validation diagnostic')))
+    await waitFor(() => expect(name).toBeEnabled())
+    expect(name).toHaveValue('Draft')
+    expect(screen.getByRole('alert')).toHaveTextContent('Your entered values are retained')
+    expect(screen.getByRole('alert')).not.toHaveTextContent('Private validation diagnostic')
