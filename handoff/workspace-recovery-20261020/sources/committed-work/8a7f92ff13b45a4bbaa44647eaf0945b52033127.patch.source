+test.describe('Base sprint lifecycle', () => {
+  for (const theme of ['light', 'gray', 'dark'] as const) {
+    test(`keeps a rejected draft and pending controls in ${theme}`, async ({
+      page,
+      baseURL,
+    }, testInfo) => {
+      test.setTimeout(180_000)
+      await installTrackerMocks(page)
+      await page.addInitScript((value) => localStorage.setItem('theme', value), theme)
+      let release!: () => void
+      let barrier = new Promise<void>((resolve) => {
+        release = resolve
+      })
+      let writes = 0
+      await page.route('**/api/v1/projects/DEMO/sprints', async (route) => {
+        if (route.request().method() !== 'POST') return route.fallback()
+        writes++
+        await barrier
+        return routeJson(route, { error: { message: 'Private validation fixture' } }, 422)
+      })
+      const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
+      const target = `${app}/projects/DEMO/backlog?source=sprint#context`
+      await page.goto(target)
+      const create = page.getByRole('button', { name: 'Создать спринт', exact: true })
+      await expect(create).toBeVisible()
+      for (const width of [375, 1920]) {
+        await page.setViewportSize({ width, height: 1080 })
+        await create.click()
+        const dialog = page.getByRole('dialog', { name: 'Новый спринт', exact: true })
+        const name = dialog.getByLabel('Название', { exact: false })
+        await name.fill(`Safe draft ${width}`)
+        await dialog.getByLabel('Цель', { exact: true }).fill('Retained safe goal')
+        const before = writes
+        await dialog.getByRole('button', { name: 'Создать спринт', exact: true }).click()
+        await expect.poll(() => writes).toBe(before + 1)
+        await expect(name).toBeDisabled()
+        await expect(dialog.getByRole('button', { name: 'Отмена', exact: true })).toBeDisabled()
+        await dialog
+          .locator('form')
+          .evaluate((form) =>
+            form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true })),
+          )
+        await page.keyboard.press('Escape')
+        await expect(dialog).toBeVisible()
+        expect(writes).toBe(before + 1)
+        release()
+        await expect(name).toBeEnabled()
+        await expect(name).toHaveValue(`Safe draft ${width}`)
+        await expect(dialog.getByLabel('Цель', { exact: true })).toHaveValue('Retained safe goal')
+        await expect(dialog.getByRole('alert')).toContainText('Введённые значения сохранены')
+        await expect(dialog.getByRole('alert')).not.toContainText('Private validation fixture')
+        expect(
+          await page.evaluate(
+            () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+          ),
+        ).toBe(true)
+        expect((await new AxeBuilder({ page }).analyze()).violations).toEqual([])
+        await page.screenshot({
+          path: testInfo.outputPath(`sprint-known-error-${theme}-${width}.png`),
+          fullPage: true,
+        })
+        await dialog.getByRole('button', { name: 'Отмена', exact: true }).click()
+        const confirm = page.getByRole('alertdialog')
+        await expect(confirm).toBeVisible()
+        await confirm.getByRole('button', { name: 'Подтвердить', exact: true }).click()
+        await expect(dialog).toBeHidden()
+        await expect(page).toHaveURL(target)
+        barrier = new Promise<void>((resolve) => {
+          release = resolve
+        })
+      }
+    })
+
+    test(`does not acknowledge an unknown create from a matching name in ${theme}`, async ({
+      page,
+      baseURL,
+    }, testInfo) => {
+      test.setTimeout(180_000)
+      await installTrackerMocks(page)
+      await page.addInitScript((value) => localStorage.setItem('theme', value), theme)
+      let writes = 0
+      let reads = 0
+      await page.route('**/api/v1/projects/DEMO/sprints', (route) => {
+        if (route.request().method() === 'POST') {
+          writes++
+          return routeJson(route, { error: { message: 'Isolated lost acknowledgement' } }, 503)
+        }
+        reads++
+        return routeJson(route, {
+          sprints: [
+            {
+              id: 'ambiguous-existing',
+              name: 'Same safe name',
+              goal: '',
+              state: 'future',
+              issue_ids: [],
+              velocity: 0,
+              start_date: null,
+              end_date: null,
+            },
+          ],
+        })
+      })
+      const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
+      await page.goto(`${app}/projects/DEMO/backlog?source=unknown#context`)
+      const create = page.getByRole('button', { name: 'Создать спринт', exact: true })
+      await expect(create).toBeVisible()
+      await create.click()
+      const dialog = page.getByRole('dialog', { name: 'Новый спринт', exact: true })
+      const name = dialog.getByLabel('Название', { exact: false })
+      await name.fill('Same safe name')
+      await dialog.getByRole('button', { name: 'Создать спринт', exact: true }).click()
+      await expect(dialog.getByRole('alert')).toContainText('Результат сохранения неизвестен')
+      const before = reads
+      await dialog.getByRole('button', { name: 'Проверить на сервере', exact: true }).click()
+      await expect.poll(() => reads).toBeGreaterThan(before)
