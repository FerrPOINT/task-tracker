+      expect(writes).toBe(1)
+      for (const width of [375, 1920]) {
+        await page.setViewportSize({ width, height: 1080 })
+        await expect(name).toHaveValue('Same safe name')
+        await expect(name).toBeDisabled()
+        await page.screenshot({
+          path: testInfo.outputPath(`sprint-unknown-${theme}-${width}.png`),
+          fullPage: true,
+        })
+      }
+      await dialog.getByRole('button', { name: 'Отмена', exact: true }).click()
+      await page
+        .getByRole('alertdialog')
+        .getByRole('button', { name: 'Подтвердить', exact: true })
+        .click()
+      await expect(dialog).toBeHidden()
+      await create.click()
+      await expect(name).toHaveValue('Same safe name')
+      await expect(
+        dialog.getByRole('button', { name: 'Создать спринт', exact: true }),
+      ).toBeDisabled()
+      expect(writes).toBe(1)
+      await testInfo.attach('unknown-create-proof', {
+        body: JSON.stringify({ writes, reads, authoritativeId: null, nameMatchAccepted: false }),
+        contentType: 'application/json',
+      })
+    })
+  }
+})
