@@ -318,6 +319,224 @@ async function installTrackerMocks(page: Page) {
 }
 
 test.describe('smoke', () => {
+  test('keeps notification menu geometry and keyboard navigation across themes and breakpoints', async ({
+    page,
+    baseURL,
+  }, testInfo) => {
+    test.setTimeout(180_000)
+    const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
+    await installTrackerMocks(page)
+    const notifications = Array.from({ length: 10 }, (_, index) => ({
+      id: `notification-${index}`,
+      event_type: 'issue_updated',
+      entity_type: 'issue',
+      entity_id: mockUser.issueId,
+      actor_id: null,
+      title: `Notification ${index}: ${'LongUnbrokenTitle'.repeat(14)}`,
+      body: `Details ${'LongUnbrokenBody'.repeat(18)}`,
+      is_read: false,
+      action_url: `/issues/${mockUser.issueId}`,
+      metadata: null,
+      created_at: '2026-10-01T10:00:00Z',
+    }))
+    await page.route('**/api/v1/notifications**', (route) =>
+      routeJson(route, { notifications, unread_count: 123456 }),
+    )
+    const failures: string[] = []
+    page.on('pageerror', (error) => failures.push(error.message))
+    page.on('console', (message) => {
+      if (message.type() === 'error') failures.push(message.text())
+    })
+    page.on('response', (response) => {
+      if (response.status() >= 400) failures.push(`${response.status()} ${response.url()}`)
+    })
+    for (const theme of ['gray', 'dark', 'light']) {
+      await page.goto(`${app}/projects`)
+      await page.evaluate((value) => localStorage.setItem('theme', value), theme)
+      await page.reload()
+      for (const width of [375, 767, 768, 1023, 1024, 1279, 1280, 1440, 1920, 2560]) {
+        await page.setViewportSize({ width, height: width === 375 ? 812 : 1080 })
+        const trigger = page.getByTestId('notification-trigger')
+        await expect(trigger).toHaveText('99+')
+        await trigger.focus()
+        await page.keyboard.press('Enter')
+        const menu = page.getByRole('menu')
+        await expect(menu).toBeVisible()
+        await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
+        await expect(menu).toBeInViewport({ ratio: 1 })
+        const geometry = await menu.evaluate(
+          (element, minimum) => {
+            const rect = element.getBoundingClientRect()
+            const targets = [...element.querySelectorAll('[role="menuitem"]')].map((item) =>
+              item.getBoundingClientRect(),
+            )
+            return {
+              documentFits:
+                document.documentElement.scrollWidth <= document.documentElement.clientWidth,
+              compact: rect.height <= 512,
+              within:
+                rect.left >= 0 &&
+                rect.right <= innerWidth &&
+                rect.top >= 0 &&
+                rect.bottom <= innerHeight,
+              targets: targets.every((target) => target.height + 0.5 >= minimum),
+              localFits: element.scrollWidth <= element.clientWidth,
+              footerVisible: (() => {
+                const footer = targets.at(-1)
+                return footer && footer.top >= rect.top && footer.bottom <= rect.bottom
+              })(),
+            }
+          },
+          width < 768 ? 44 : 40,
+        )
+        expect(geometry).toEqual({
+          documentFits: true,
+          compact: true,
+          within: true,
+          targets: true,
+          localFits: true,
+          footerVisible: true,
+        })
+        if (width === 1920) {
+          const accessibility = await new AxeBuilder({ page }).include('[role="menu"]').analyze()
+          expect(
+            accessibility.violations.map(({ id, nodes }) => ({
+              id,
+              elements: nodes.map(({ html }) => html),
+            })),
+          ).toEqual([])
+        }
+        await page.keyboard.press('End')
+        await expect(
+          menu.getByRole('menuitem', { name: 'Все уведомления', exact: true }),
+        ).toBeFocused()
+        await page.keyboard.press('ArrowUp')
+        const lastRead = menu.getByRole('menuitem', {
+          name: `Отметить прочитанным: ${notifications[9].title}`,
+          exact: true,
+        })
+        await expect(lastRead).toBeFocused()
+        await expect(lastRead).toBeInViewport({ ratio: 1 })
+        await page.keyboard.press('End')
+        await page.screenshot({
+          path: testInfo.outputPath(`notifications-menu-${theme}-${width}.png`),
+          fullPage: true,
+        })
+        await page.keyboard.press('Escape')
+        await expect(trigger).toBeFocused()
+        await expect(menu).toBeHidden()
+      }
+    }
+    expect(failures).toEqual([])
+  })
+
+  test('handles notification menu pending, failed read, focus removal and independent read failures', async ({
+    page,
+    baseURL,
+  }, testInfo) => {
+    test.setTimeout(180_000)
+    const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
+    await installTrackerMocks(page)
+    await page.setViewportSize({ width: 1920, height: 1080 })
+    const notification = {
+      id: 'notification-1',
+      title: 'Safe notification',
+      body: 'Safe fixture',
+      is_read: false,
+      action_url: null,
+      created_at: '2026-10-01T10:00:00Z',
+    }
+    let status = 200
+    let notifications = [notification]
+    let reads = 0
+    let release!: () => void
+    let failRead = true
+    await page.route('**/api/v1/notifications**', async (route) => {
+      if (route.request().method() === 'PATCH') {
+        reads++
+        await new Promise<void>((resolve) => {
+          release = resolve
+        })
+        if (failRead)
+          return routeJson(
+            route,
+            { error: { code: 'QA_REJECTED', message: 'Diagnostic detail' } },
+            503,
+          )
+        notifications = []
+        return route.fulfill({ status: 204, body: '' })
+      }
+      return routeJson(
+        route,
+        status === 200
+          ? { notifications, unread_count: notifications.length }
+          : { error: { code: 'QA_READ_FAILURE', message: 'Diagnostic detail' } },
+        status,
+      )
+    })
+    await page.goto(`${app}/projects`)
+    const trigger = page.getByTestId('notification-trigger')
+    await trigger.click()
+    const menu = page.getByRole('menu')
+    const read = menu.getByRole('menuitem', {
+      name: 'Отметить прочитанным: Safe notification',
+      exact: true,
+    })
+    await read.focus()
+    await page.keyboard.press('Enter')
+    await expect.poll(() => reads).toBe(1)
+    await expect(read).toBeDisabled()
+    await page.keyboard.press('Enter')
+    expect(reads).toBe(1)
+    await expect(menu.getByRole('menuitem', { name: 'Прочитать все' })).toBeDisabled()
+    release()
+    await expect(menu.getByRole('alert')).toHaveText('Не удалось отметить уведомление прочитанным.')
+    const retry = menu.getByRole('menuitem', { name: 'Повторить' })
+    await retry.focus()
+    failRead = false
+    await page.keyboard.press('Enter')
+    await expect.poll(() => reads).toBe(2)
+    release()
+    await expect(read).toHaveCount(0)
+    await expect(menu.getByRole('menuitem', { name: 'Все уведомления', exact: true })).toBeFocused()
+    await page.keyboard.press('Escape')
+    await expect(trigger).toBeFocused()
+    notifications = [notification]
+    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
+    await expect(trigger).toHaveText('1')
+    await trigger.click()
+    status = 503
+    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
+    await expect(menu.locator('[data-page-state="partial-error"]')).toBeVisible({ timeout: 45_000 })
+    await expect(read).toBeDisabled()
+    await page.screenshot({
+      path: testInfo.outputPath('notifications-menu-cached-partial.png'),
+      fullPage: true,
+    })
+    status = 403
+    await menu.getByRole('menuitem', { name: 'Повторить' }).click()
+    await expect(menu.locator('[data-page-state="permission-denied"]')).toBeVisible({
+      timeout: 45_000,
+    })
+    await expect(read).toHaveCount(0)
+    await expect(menu.getByRole('menuitem', { name: 'Повторить' })).toHaveCount(0)
+    await expect(trigger).toHaveText('')
+    await expect(page.locator('main').getByText(mockUser.name)).toBeVisible()
+    await page.screenshot({
+      path: testInfo.outputPath('notifications-menu-cached-denied.png'),
+      fullPage: true,
+    })
+    status = 404
+    await page.reload()
+    await trigger.click()
+    await expect(menu.locator('[data-page-state="not-found"]')).toBeVisible({ timeout: 45_000 })
+    await expect(menu.getByRole('menuitem', { name: 'Повторить' })).toHaveCount(0)
+    await page.screenshot({
+      path: testInfo.outputPath('notifications-menu-cold-not-found.png'),
+      fullPage: true,
+    })
+  })
+
   test('distinguishes cached catalog refresh failures from revoked access without losing a retained draft', async ({
     page,
     baseURL,
diff --git a/frontend/src/api/notifications.test.ts b/frontend/src/api/notifications.test.ts
