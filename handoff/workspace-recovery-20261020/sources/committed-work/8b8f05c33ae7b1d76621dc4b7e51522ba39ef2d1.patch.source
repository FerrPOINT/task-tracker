diff --git a/frontend/src/widgets/notification-menu.test.tsx b/frontend/src/widgets/notification-menu.test.tsx
new file mode 100644
index 0000000..702ac0b
--- /dev/null
+++ b/frontend/src/widgets/notification-menu.test.tsx
@@ -0,0 +1,278 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { act, render, screen, waitFor } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { MemoryRouter } from 'react-router'
+import { ApiError } from '@sdlc/ui/lib'
+import { NotificationMenu } from './notification-menu'
+
+const { useNotifications, useMarkNotificationRead, useMarkAllNotificationsRead } = vi.hoisted(
+  () => ({
+    useNotifications: vi.fn(),
+    useMarkNotificationRead: vi.fn(),
+    useMarkAllNotificationsRead: vi.fn(),
+  }),
+)
+vi.mock('@/shared/api/hooks', () => ({
+  useNotifications,
+  useMarkNotificationRead,
+  useMarkAllNotificationsRead,
+}))
+
+const notification = {
+  id: 'notification-1',
+  title: 'Issue updated',
+  body: 'Safe notification body',
+  is_read: false,
+  action_url: '/issues/12',
+  created_at: '2026-10-01T10:00:00Z',
+}
+const list = { notifications: [notification], unread_count: 1 }
+const refetch = vi.fn()
+const markRead = vi.fn()
+const markAll = vi.fn()
+function menu() {
+  return (
+    <MemoryRouter>
+      <NotificationMenu />
+    </MemoryRouter>
+  )
+}
+async function open() {
+  const user = userEvent.setup()
+  await user.click(screen.getByTestId('notification-trigger'))
+  return user
+}
+
+describe('notification menu resource and interaction contracts', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    refetch.mockResolvedValue(undefined)
+    markRead.mockReset().mockResolvedValue(undefined)
+    markAll.mockReset().mockResolvedValue(undefined)
+    useNotifications.mockReturnValue({ data: list, isLoading: false, error: null, refetch })
+    useMarkNotificationRead.mockReturnValue({ mutateAsync: markRead, isPending: false })
+    useMarkAllNotificationsRead.mockReturnValue({ mutateAsync: markAll, isPending: false })
+  })
+
+  it('does not present pending data as an empty list or zero unread count', async () => {
+    useNotifications.mockReturnValue({ isLoading: true, refetch })
+    render(menu())
+    await open()
+    expect(screen.getByRole('status')).toHaveTextContent('Загрузка уведомлений')
+    expect(screen.getByRole('group', { name: 'Уведомления' })).toHaveAttribute('tabindex', '0')
+    expect(screen.queryByText('Нет уведомлений.')).not.toBeInTheDocument()
+    expect(screen.getByTestId('notification-trigger')).not.toHaveTextContent('0')
+    expect(screen.getByRole('menuitem', { name: 'Прочитать все' })).toHaveAttribute('data-disabled')
+  })
+
+  it.each([403, 404])(
+    'hides cached notifications and count after HTTP %s without retry',
+    async (status) => {
+      useNotifications.mockReturnValue({
+        data: list,
+        error: new ApiError(status, 'Diagnostic detail'),
+        refetch,
+      })
+      const { container } = render(menu())
+      await open()
+      expect(
+        document.querySelector(
+          `[data-page-state="${status === 403 ? 'permission-denied' : 'not-found'}"]`,
+        ),
+      ).toBeInTheDocument()
+      expect(screen.queryByText(notification.title)).not.toBeInTheDocument()
+      expect(container.querySelector('.notification-count')).not.toBeInTheDocument()
+      expect(screen.queryByRole('menuitem', { name: 'Повторить' })).not.toBeInTheDocument()
+      expect(screen.queryByText('Diagnostic detail')).not.toBeInTheDocument()
+      expect(screen.getByRole('menuitem', { name: 'Все уведомления' })).toHaveAttribute(
+        'href',
+        '/notifications',
+      )
+    },
+  )
+
+  it('keeps cached content read-only after a retryable refresh failure', async () => {
+    useNotifications.mockReturnValue({
+      data: list,
+      error: new ApiError(503, 'Unavailable'),
+      refetch,
+    })
+    render(menu())
+    const user = await open()
+    expect(document.querySelector('[data-page-state="partial-error"]')).toBeInTheDocument()
+    expect(screen.getByText(notification.title)).toBeInTheDocument()
+    expect(
+      screen.getByRole('menuitem', { name: 'Отметить прочитанным: Issue updated' }),
+    ).toHaveAttribute('data-disabled')
+    expect(screen.getByRole('menuitem', { name: 'Прочитать все' })).toHaveAttribute('data-disabled')
+    await user.click(screen.getByRole('menuitem', { name: 'Повторить' }))
+    expect(refetch).toHaveBeenCalledTimes(1)
+    expect(screen.getByRole('menu')).toBeInTheDocument()
+    expect(markRead).not.toHaveBeenCalled()
+    expect(markAll).not.toHaveBeenCalled()
+  })
+
+  it('offers a keyboard menu retry for cold errors without an empty state', async () => {
+    useNotifications.mockReturnValue({ error: new TypeError('Network unavailable'), refetch })
+    render(menu())
+    const user = await open()
+    expect(screen.getByRole('alert')).toHaveTextContent('Не удалось загрузить уведомления.')
+    const retry = screen.getByRole('menuitem', { name: 'Повторить' })
+    retry.focus()
+    await user.keyboard('{Enter}')
+    expect(refetch).toHaveBeenCalledTimes(1)
+    expect(screen.getByRole('menu')).toBeInTheDocument()
+    expect(screen.queryByText('Нет уведомлений.')).not.toBeInTheDocument()
+  })
+
+  it('caps the visual count while retaining the actual accessible count', () => {
+    useNotifications.mockReturnValue({ data: { ...list, unread_count: 123456 }, refetch })
+    render(menu())
+    expect(screen.getByTestId('notification-trigger')).toHaveTextContent('99+')
+    expect(screen.getByLabelText('Непрочитанные (123456)')).toBeInTheDocument()
+  })
+
+  it('keeps the menu open and prevents duplicate one/all requests while pending', async () => {
+    let release!: () => void
+    markRead.mockImplementation(
+      () =>
+        new Promise<void>((resolve) => {
+          release = resolve
+        }),
+    )
+    render(menu())
+    const user = await open()
+    const action = screen.getByRole('menuitem', { name: 'Отметить прочитанным: Issue updated' })
+    await user.dblClick(action)
+    expect(markRead).toHaveBeenCalledTimes(1)
+    expect(markRead).toHaveBeenCalledWith(notification.id)
+    expect(action).toHaveAttribute('data-disabled')
+    expect(screen.getByRole('menuitem', { name: 'Прочитать все' })).toHaveAttribute('data-disabled')
+    expect(screen.getByRole('status')).toHaveTextContent('Отмечаем')
+    await act(async () => release())
+    await waitFor(() => expect(action).not.toHaveAttribute('data-disabled'))
+    await user.click(screen.getByRole('menuitem', { name: 'Прочитать все' }))
+    expect(markAll).toHaveBeenCalledTimes(1)
+    expect(screen.getByRole('menu')).toBeInTheDocument()
+  })
+
+  it('retains a failed command and retries only that notification', async () => {
+    markRead.mockRejectedValueOnce(new ApiError(503, 'Diagnostic detail'))
+    render(menu())
+    const user = await open()
+    await user.click(screen.getByRole('menuitem', { name: 'Отметить прочитанным: Issue updated' }))
+    expect(await screen.findByRole('alert')).toHaveTextContent('Не удалось')
+    expect(screen.queryByText('Diagnostic detail')).not.toBeInTheDocument()
+    await user.click(screen.getByRole('menuitem', { name: 'Повторить' }))
+    expect(markRead).toHaveBeenNthCalledWith(2, notification.id)
+    expect(markAll).not.toHaveBeenCalled()
+  })
+
+  it.each([403, 404, 400])('does not offer retry for terminal mutation HTTP %s', async (status) => {
+    markAll.mockRejectedValue(new ApiError(status, 'Diagnostic detail'))
+    render(menu())
+    const user = await open()
+    await user.click(screen.getByRole('menuitem', { name: 'Прочитать все' }))
+    await waitFor(() =>
+      expect(
+        screen.getByText('Не удалось отметить все уведомления прочитанными.'),
+      ).toBeInTheDocument(),
+    )
+    expect(screen.queryByRole('menuitem', { name: 'Повторить' })).not.toBeInTheDocument()
+  })
+
+  it('offers only source recovery when a failed read command is followed by a refresh failure', async () => {
+    markRead.mockRejectedValueOnce(new ApiError(503, 'Read unavailable'))
+    const view = render(menu())
+    const user = await open()
+    await user.click(screen.getByRole('menuitem', { name: 'Отметить прочитанным: Issue updated' }))
+    await screen.findByRole('alert')
+    useNotifications.mockReturnValue({
+      data: list,
+      error: new ApiError(503, 'List unavailable'),
+      refetch,
+    })
+    view.rerender(menu())
+    expect(screen.getAllByRole('menuitem', { name: 'Повторить' })).toHaveLength(1)
+    await user.click(screen.getByRole('menuitem', { name: 'Повторить' }))
+    expect(refetch).toHaveBeenCalledTimes(1)
+    expect(markRead).toHaveBeenCalledTimes(1)
+  })
+
+  it('returns Escape focus to the trigger and does not steal it when a pending action finishes', async () => {
+    let release!: () => void
+    markRead.mockImplementation(
+      () =>
+        new Promise<void>((resolve) => {
+          release = resolve
+        }),
+    )
+    render(menu())
+    const user = await open()
+    await user.click(screen.getByRole('menuitem', { name: 'Отметить прочитанным: Issue updated' }))
+    await user.keyboard('{Escape}')
+    expect(screen.getByTestId('notification-trigger')).toHaveFocus()
+    await act(async () => release())
+    await waitFor(() => expect(screen.getByTestId('notification-trigger')).toHaveFocus())
+    expect(screen.queryByRole('menu')).not.toBeInTheDocument()
+  })
+
+  it('moves focus to the surviving footer when invalidation removes the selected unread item', async () => {
+    let release!: () => void
+    markRead.mockImplementation(
+      () =>
+        new Promise<void>((resolve) => {
+          release = resolve
+        }),
+    )
+    const view = render(menu())
+    const user = await open()
+    const action = screen.getByRole('menuitem', { name: 'Отметить прочитанным: Issue updated' })
+    action.focus()
+    await user.keyboard('{Enter}')
+    useNotifications.mockReturnValue({ data: { notifications: [], unread_count: 0 }, refetch })
+    view.rerender(menu())
+    await act(async () => release())
+    await waitFor(() =>
+      expect(screen.getByRole('menuitem', { name: 'Все уведомления' })).toHaveFocus(),
+    )
+  })
+
+  it('does not overwrite a deliberate focus move when invalidation removes the original item', async () => {
+    let release!: () => void
+    markRead.mockImplementation(
+      () =>
+        new Promise<void>((resolve) => {
+          release = resolve
+        }),
+    )
+    const second = {
+      ...notification,
+      id: 'notification-2',
+      title: 'Another issue',
+      action_url: '/issues/13',
+    }
+    useNotifications.mockReturnValue({
+      data: { notifications: [notification, second], unread_count: 2 },
+      refetch,
+    })
+    const view = render(menu())
+    const user = await open()
+    const action = screen.getByRole('menuitem', { name: 'Отметить прочитанным: Issue updated' })
+    action.focus()
+    await user.keyboard('{Enter}')
+    const next = screen.getByRole('menuitem', { name: /^Another issue/ }).closest('a')!
+    next.focus()
+    useNotifications.mockReturnValue({
+      data: { notifications: [second], unread_count: 1 },
+      refetch,
+    })
+    view.rerender(menu())
+    await act(async () => release())
+    await waitFor(() => expect(next).toHaveFocus())
+    await act(async () => {
+      await new Promise((resolve) => requestAnimationFrame(resolve))
+    })
+    expect(next).toHaveFocus()
+  })
+})
