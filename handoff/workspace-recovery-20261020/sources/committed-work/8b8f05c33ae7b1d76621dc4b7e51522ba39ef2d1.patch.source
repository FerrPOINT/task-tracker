+function withoutRetry(state: ResourceState): ResourceState {
+  return 'onRetry' in state ? { ...state, onRetry: undefined } : state
+}
+
 export function NotificationMenu() {
   const { t } = useTranslation()
-  const { data: list } = useNotifications()
+  const { data: list, isLoading, error, refetch } = useNotifications()
   const markRead = useMarkNotificationRead()
   const markAll = useMarkAllNotificationsRead()
-  const notifications = list?.notifications ?? []
-  const unreadCount = list?.unread_count ?? 0
+  const locked = useRef(false)
+  const contentRef = useRef<HTMLDivElement>(null)
+  const viewAllRef = useRef<HTMLAnchorElement>(null)
+  const [pending, setPending] = useState(false)
+  const [lastAction, setLastAction] = useState<string | null | undefined>()
+  const [actionError, setActionError] = useState<unknown>(null)
+  const listState: ResourceState = error
+    ? resourceErrorState(error, () => void refetch(), {
+        hasData: list !== undefined,
+        message: t('notifications.loadError'),
+      })
+    : isLoading || !list
+      ? { kind: 'loading', message: t('notifications.loading') }
+      : list.notifications.length === 0
+        ? { kind: 'empty', message: t('notifications.empty') }
+        : { kind: 'ready' }
+  const showData = listState.kind === 'ready' || listState.kind === 'partial-error'
+  const notifications = showData ? (list?.notifications ?? []) : []
+  const unreadCount = showData ? list?.unread_count : undefined
+  const busy = pending || markRead.isPending || markAll.isPending
+  const canRead = (listState.kind === 'ready' || listState.kind === 'empty') && !busy
+  const readErrorState = actionError
+    ? resourceErrorState(
+        actionError,
+        () => {
+          if (lastAction !== undefined) void read(lastAction)
+        },
+        {
+          message: t(
+            lastAction === null ? 'notifications.markAllError' : 'notifications.markReadError',
+          ),
+        },
+      )
+    : undefined
+
+  async function read(id: string | null, restoreFocus = true) {
+    if (locked.current || !canRead) return
+    locked.current = true
+    const initiator = restoreFocus ? document.activeElement : null
+    setLastAction(id)
+    setActionError(null)
+    setPending(true)
+    try {
+      if (id === null) await markAll.mutateAsync()
+      else await markRead.mutateAsync(id)
+    } catch (failure) {
+      setActionError(failure)
+    } finally {
+      locked.current = false
+      setPending(false)
+      // Invalidation can remove the unread item; do not reopen a closed menu.
+      requestAnimationFrame(() => {
+        if (
+          initiator instanceof HTMLElement &&
+          !initiator.isConnected &&
+          viewAllRef.current?.isConnected &&
+          (document.activeElement === document.body ||
+            document.activeElement === contentRef.current)
+        )
+          viewAllRef.current.focus()
+      })
+    }
+  }
   return (
     <DropdownMenu>
       <DropdownMenuTrigger asChild>
