-  if (error) throw new Error(JSON.stringify(error))
+  if (error || !response.ok)
+    throw new ApiError(response.status, 'Failed to mark notification as read', error)
 }
 
 export async function markAllNotificationsRead(): Promise<void> {
-  const { error } = await api.POST('/api/v1/notifications/read-all')
-  if (error) throw new Error(JSON.stringify(error))
+  const { error, response } = await api.POST('/api/v1/notifications/read-all')
+  if (error || !response.ok)
+    throw new ApiError(response.status, 'Failed to mark all notifications as read', error)
 }
 
 export async function getNotificationSettings(): Promise<NotificationSettings> {
-  const { data, error } = await api.GET('/api/v1/notification-settings')
-  if (!data) throw new Error(error ? JSON.stringify(error) : 'Failed to get notification settings')
+  const { data, error, response } = await api.GET('/api/v1/notification-settings')
+  const status = response.status
+  if (error || !data) throw new ApiError(status, 'Failed to get notification settings', error)
   return data
 }
 
 export async function updateNotificationSettings(
   input: UpdateNotificationSettingsInput,
 ): Promise<NotificationSettings> {
-  const { data, error } = await api.PATCH('/api/v1/notification-settings', { body: input })
-  if (!data)
-    throw new Error(error ? JSON.stringify(error) : 'Failed to update notification settings')
+  const { data, error, response } = await api.PATCH('/api/v1/notification-settings', {
+    body: input,
+  })
+  if (error || !data)
+    throw new ApiError(response.status, 'Failed to update notification settings', error)
   return data
 }
