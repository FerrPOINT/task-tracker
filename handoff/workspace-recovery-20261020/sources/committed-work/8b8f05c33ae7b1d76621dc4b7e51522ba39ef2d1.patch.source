-vi.mock('./client', () => ({ api: { GET } }))
+vi.mock('./client', () => ({ api: { GET, PATCH, POST } }))
+
+const settings = {
+  email_frequency: 'daily',
+  disabled_event_types: ['issue_updated'],
+  notify_own_changes: false,
+}
 
 describe('notification API wrapper', () => {
   beforeEach(() => {
     GET.mockReset()
+    PATCH.mockReset()
+    POST.mockReset()
   })
 
   it('passes list query options and preserves unread_count', async () => {
@@ -29,7 +44,7 @@ describe('notification API wrapper', () => {
       ],
       unread_count: 12,
     }
-    GET.mockResolvedValueOnce({ data: response })
+    GET.mockResolvedValueOnce({ data: response, response: new Response() })
 
     await expect(listNotifications({ includeRead: true, limit: 50, offset: 10 })).resolves.toEqual(
       response,
@@ -38,4 +53,56 @@ describe('notification API wrapper', () => {
       params: { query: { include_read: true, limit: 50, offset: 10 } },
     })
   })
+
+  for (const [name, method, call] of [
+    ['list', GET, () => listNotifications()],
+    ['settings', GET, () => getNotificationSettings()],
+    ['update settings', PATCH, () => updateNotificationSettings(settings)],
+    ['mark one', PATCH, () => markNotificationRead('notification-1')],
+    ['mark all', POST, () => markAllNotificationsRead()],
+  ] as const) {
+    it.each([400, 401, 403, 404, 408, 429, 503])(
+      `preserves HTTP %s for ${name}`,
+      async (status) => {
+        const body = { error: { code: 'QA_FAILURE', message: 'Diagnostic detail' } }
+        method.mockResolvedValue({ error: body, response: new Response(null, { status }) })
+        await expect(call()).rejects.toBeInstanceOf(ApiError)
+        await expect(call()).rejects.toMatchObject({ status, code: 'QA_FAILURE', body })
+        await expect(call()).rejects.not.toThrow('Diagnostic detail')
+      },
+    )
+
+    it(`does not replace a network failure with empty ${name} data`, async () => {
+      const error = new TypeError('Network unavailable')
+      method.mockRejectedValue(error)
+      await expect(call()).rejects.toBe(error)
+    })
+  }
+
+  it('preserves successful settings and the submitted payload', async () => {
+    GET.mockResolvedValue({ data: settings, response: new Response() })
+    PATCH.mockResolvedValue({ data: settings, response: new Response() })
+    await expect(getNotificationSettings()).resolves.toEqual(settings)
+    await expect(updateNotificationSettings(settings)).resolves.toEqual(settings)
+    expect(PATCH).toHaveBeenCalledWith('/api/v1/notification-settings', { body: settings })
+  })
+
+  it('accepts successful empty mark-read responses', async () => {
+    PATCH.mockResolvedValue({ response: new Response(null, { status: 204 }) })
+    POST.mockResolvedValue({ response: new Response(null, { status: 204 }) })
+    await expect(markNotificationRead('notification-1')).resolves.toBeUndefined()
+    await expect(markAllNotificationsRead()).resolves.toBeUndefined()
+    expect(PATCH).toHaveBeenCalledWith('/api/v1/notifications/{id}/read', {
+      params: { path: { id: 'notification-1' } },
+    })
+    expect(POST).toHaveBeenCalledWith('/api/v1/notifications/read-all')
+  })
+
+  it.each(['one', 'all'])('rejects a failed empty mark-read response: %s', async (action) => {
+    PATCH.mockResolvedValue({ response: new Response(null, { status: 503 }) })
+    POST.mockResolvedValue({ response: new Response(null, { status: 503 }) })
+    await expect(
+      action === 'one' ? markNotificationRead('notification-1') : markAllNotificationsRead(),
+    ).rejects.toMatchObject({ status: 503 })
+  })
 })
