--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -6,6 +6,11 @@
 
 ## [Unreleased]
 
+- API 401 delegates sign-in navigation to the existing Base route guard,
+  retaining pathname/query/hash without replaying a failed write.
+  Draft recovery through reauthentication remains a separate acceptance item.
+  Browser evidence distinguishes reload bootstrap SSO from the subsequent 401 challenge.
+
 - HTML pattern ключа проекта компилируется в Unicode-set режиме браузера;
   дефис экранирован, допустимые API-значения и границы 1–10 не меняются.
 
diff --git a/frontend/e2e/smoke.spec.ts b/frontend/e2e/smoke.spec.ts
index 5bb5903..e918632 100644
--- a/frontend/e2e/smoke.spec.ts
+++ b/frontend/e2e/smoke.spec.ts
@@ -1576,6 +1576,81 @@ test.describe('Base project trash', () => {
   })
 })
 
+test.describe('Expired central session', () => {
+  for (const method of ['GET', 'POST'] as const) {
+    test(`preserves project URL after ${method} 401 without replaying the write`, async ({
+      page,
+      baseURL,
+    }, testInfo) => {
+      await installTrackerMocks(page)
+      const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
+      const target = `${app}/projects/DEMO/backlog?offset=100&source=board#sprint-context`
+      await page.goto(target)
+      const create = page.getByRole('button', { name: 'Создать спринт', exact: true })
+      await expect(create).toBeVisible()
+      await expect(page).toHaveURL(target)
+      let rejected = 0
+      const authorizations: Array<{ clientId: string | null; redirect: string | null }> = []
+      page.on('request', (request) => {
+        const url = new URL(request.url())
+        if (url.pathname === '/oidc/authorize')
+          authorizations.push({
+            clientId: url.searchParams.get('client_id'),
+            redirect: url.searchParams.get('redirect_uri'),
+          })
+      })
+      const path =
+        method === 'GET' ? '**/api/v1/projects/DEMO/backlog**' : '**/api/v1/projects/DEMO/sprints'
+      await page.route(path, (route) => {
+        if (route.request().method() !== method || rejected > 0) return route.fallback()
+        rejected++
+        return routeJson(route, { error: { message: 'Isolated expired session fixture' } }, 401)
+      })
+      let writes = 0
+      page.on('request', (request) => {
+        if (
+          request.method() === 'POST' &&
+          new URL(request.url()).pathname === '/api/v1/projects/DEMO/sprints'
+        )
+          writes++
+      })
+      if (method === 'GET') await page.reload()
+      else {
+        await create.click()
+        const dialog = page.getByRole('dialog', { name: 'Новый спринт', exact: true })
+        await dialog.getByLabel('Название', { exact: false }).fill('Safe expired-session fixture')
+        await dialog.getByRole('button', { name: 'Создать спринт', exact: true }).click()
+      }
+      await expect.poll(() => rejected).toBe(1)
+      // Reload loses the in-memory token: one bootstrap SSO precedes the rejected GET.
+      const expectedAuthorizations = method === 'GET' ? 2 : 1
+      await expect.poll(() => authorizations.length).toBe(expectedAuthorizations)
+      await expect(page).toHaveURL(target)
+      await expect(create).toBeVisible()
+      expect(authorizations).toEqual(
+        Array.from({ length: expectedAuthorizations }, () => ({
+          clientId: 'task-tracker',
+          redirect: `${app}/sso/callback`,
+        })),
+      )
+      expect(writes).toBe(method === 'POST' ? 1 : 0)
+      await expect(page.getByRole('dialog', { name: 'Новый спринт', exact: true })).toHaveCount(0)
+      await testInfo.attach('expired-session-context', {
+        body: JSON.stringify({
+          method,
+          target,
+          rejected,
+          writes,
+          authorizations,
+          bootstrapSsoAfterReload: method === 'GET',
+          draftSafetyVerified: false,
+        }),
+        contentType: 'application/json',
+      })
+    })
+  }
+})
+
 function routeJson(route: Route, body: unknown, status = 200) {
   return route.fulfill({
     status,
