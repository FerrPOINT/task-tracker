diff --git a/frontend/src/shared/auth/expired-session.test.tsx b/frontend/src/shared/auth/expired-session.test.tsx
new file mode 100644
index 0000000..ec15697
--- /dev/null
+++ b/frontend/src/shared/auth/expired-session.test.tsx
@@ -0,0 +1,91 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { createMemoryRouter, RouterProvider } from 'react-router'
+import { ThemeProvider } from '@sdlc/ui/lib'
+import { RequireAuth } from './require-auth'
+import { useAuthStore } from './store'
+import { LoginPage } from '@/pages/login'
+import { api } from '@/api/client'
+
+const beginSso = vi.hoisted(() => vi.fn<(...args: unknown[]) => Promise<void>>())
+vi.mock('@sdlc/ui/sso', async (original) => ({
+  ...(await original<typeof import('@sdlc/ui/sso')>()),
+  beginSso,
+}))
+
+describe('expired central session context', () => {
+  beforeEach(() => {
+    beginSso.mockReset().mockImplementation(() => new Promise<void>(() => {}))
+    useAuthStore.getState().setAuth({
+      token: 'isolated-test-token',
+      userId: 'safe-test-user',
+      email: 'safe@example.test',
+    })
+  })
+  afterEach(() => useAuthStore.getState().logout())
+
+  it.each(['GET', 'POST'] as const)(
+    'keeps the full address after %s 401 without replay',
+    async (method) => {
+      const transport = vi.fn(async () => new Response(null, { status: 401 }))
+      const address = '/projects/DEMO/backlog?offset=100&source=board#sprint-context'
+      const router = createMemoryRouter(
+        [
+          {
+            element: <RequireAuth />,
+            children: [
+              {
+                path: '/projects/:projectKey/backlog',
+                element: (
+                  <button
+                    onClick={() => {
+                      if (method === 'GET')
+                        void api.GET('/api/v1/dashboard', {
+                          fetch: transport,
+                          baseUrl: 'http://localhost:4173',
+                        })
+                      else
+                        void api.POST('/api/v1/projects/{project_key}/sprints', {
+                          params: { path: { project_key: 'DEMO' } },
+                          body: { name: 'Safe fixture sprint' },
+                          fetch: transport,
+                          baseUrl: 'http://localhost:4173',
+                        })
+                    }}
+                  >
+                    Request
+                  </button>
+                ),
+              },
+            ],
+          },
+          { path: '/login', element: <LoginPage /> },
+        ],
+        { initialEntries: [address] },
+      )
+      render(
+        <ThemeProvider>
+          <RouterProvider router={router} />
+        </ThemeProvider>,
+      )
+      await act(async () => {
+        fireEvent.click(screen.getByRole('button', { name: 'Request' }))
+      })
+      await waitFor(() =>
+        expect(beginSso).toHaveBeenCalledExactlyOnceWith(
+          expect.objectContaining({ clientId: 'task-tracker' }),
+          address,
+        ),
+      )
+      expect(router.state.location.pathname).toBe('/login')
+      expect(router.state.location.state.from).toMatchObject({
+        pathname: '/projects/DEMO/backlog',
+        search: '?offset=100&source=board',
+        hash: '#sprint-context',
+      })
+      expect(transport).toHaveBeenCalledTimes(1)
+      expect(useAuthStore.getState().token).toBeNull()
+      expect(localStorage.getItem('task-tracker-auth')).not.toContain('isolated-test-token')
+    },
+  )
+})
