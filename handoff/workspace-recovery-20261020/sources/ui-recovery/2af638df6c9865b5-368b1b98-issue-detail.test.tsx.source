  it('blocks a browser POP while the delete modal is pending and discards it after confirmed deletion', async () => {
    const previousUrl = window.location.href
    const previousState = window.history.state
    window.history.replaceState({ idx: 0 }, '', '/issues/i1')
    const { useDeleteIssue } =
