      await waitFor(() => expect(window.location.search).toBe('?tab=comments'))
      expect(window.history.state.idx).toBe(1)
      await user.type(screen.getByLabelText(/^Комментарий$|^Comment$/i), 'Retained delete draft')
      await user.click(screen.getByRole('button', { name: /Действия|Actions/i }))
