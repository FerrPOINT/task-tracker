  it('stops the timer on accepted same-issue navigation without saving and does not restart it on reopen', async () => {
    const intervals = vi.spyOn(globalThis, 'setInterval')
    const clear = vi.spyOn(globalThis, 'clearInterval')
    render(wrapper(<IssueDetailPage />, '/issues/i1?tab=worklog'))
    fireEvent.click(screen.getByRole('button', { name: /Записать время|Log work/i }))
    fireEvent.click(screen.getByRole('button', { name: /Запустить таймер|Start timer/i }))
    const timer = intervals.mock.results.at(-1)!.value
    fireEvent.click(screen.getByRole('button', { name: 'Go to issue comments', hidden: true }))
    fireEvent.click(
      within(await screen.findByRole('alertdialog')).getByRole('button', {
        name: /Отмена|Cancel/i,
      }),
    )
    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
    expect(screen.getByRole('timer')).toBeInTheDocument()
    fireEvent.click(screen.getByRole('button', { name: 'Go to issue comments', hidden: true }))
    fireEvent.click(
      within(await screen.findByRole('alertdialog')).getByRole('button', {
        name: /Подтвердить|Confirm/i,
      }),
    )
    await waitFor(() => expect(screen.queryByRole('dialog')).not.toBeInTheDocument())
    expect(clear).toHaveBeenCalledWith(timer)
    fireEvent.click(screen.getByRole('button', { name: /Записать время|Log work/i }))
    expect(screen.queryByRole('timer')).not.toBeInTheDocument()
    expect(screen.getByLabelText(/Затрачено времени|Time spent/i)).toHaveValue('')
    expect(mockWorklogCreate.mutateAsync).not.toHaveBeenCalled()
    intervals.mockRestore()
    clear.mockRestore()
  })

  it('keeps an accepted browser POP on comments after the focused timer dialog closes', async () => {
    const previousUrl = window.location.href
    const previousState = window.history.state
    window.history.replaceState({ idx: 0 }, '', '/issues/i1?tab=comments')
    const qc = new QueryClient({
      defaultOptions: { queries: { retry: false }, mutations: { retry: false } },
    })
    const router = createBrowserRouter([{ path: '/issues/:id', element: <IssueDetailPage /> }])
    const view = render(
      <ThemeProvider>
        <QueryClientProvider client={qc}>
          <RouterProvider router={router} />
        </QueryClientProvider>
      </ThemeProvider>,
    )
    try {
      const user = userEvent.setup()
      const historyLength = window.history.length
      const worklogTab = screen.getByRole('tab', { name: /Журнал работ|Worklog/i })
      act(() => {
        fireEvent.mouseDown(worklogTab, { button: 0, ctrlKey: false })
        fireEvent.focus(worklogTab)
      })
      await waitFor(() => expect(window.location.search).toBe('?tab=worklog'))
      expect(window.history.length).toBe(historyLength + 1)
      await user.click(screen.getByRole('button', { name: /Записать время|Log work/i }))
      await user.type(screen.getByLabelText(/Затрачено времени|Time spent/i), '1m 31s')
      await user.type(
        within(screen.getByRole('dialog')).getByLabelText(/^Комментарий$|^Comment$/i),
        'Browser POP draft',
      )
      await user.click(screen.getByRole('button', { name: /Запустить таймер|Start timer/i }))
      await act(async () => {
        await router.navigate(-1)
      })
      await user.click(
        within(await screen.findByRole('alertdialog')).getByRole('button', {
          name: /Отмена|Cancel/i,
        }),
      )
      await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
      expect(window.location.search).toBe('?tab=worklog')
      expect(screen.getByRole('timer')).toBeInTheDocument()
      await act(async () => {
        await router.navigate(-1)
      })
      await user.click(
        within(await screen.findByRole('alertdialog')).getByRole('button', {
          name: /Подтвердить|Confirm/i,
        }),
      )
      await waitFor(() => {
        expect(window.location.search).toBe('?tab=comments')
        expect(screen.queryByRole('dialog')).not.toBeInTheDocument()
        expect(screen.getByRole('tab', { name: /Комментарии|Comments/i })).toHaveAttribute(
          'data-state',
          'active',
        )
      })
      expect(mockWorklogCreate.mutateAsync).not.toHaveBeenCalled()
      const commentsTab = screen.getByRole('tab', { name: /Комментарии|Comments/i })
      commentsTab.focus()
      await user.keyboard('{ArrowRight}')
      await waitFor(() =>
        expect(document.activeElement).toBe(
          screen.getByRole('tab', { name: /Журнал работ|Worklog/i }),
        ),
      )
      expect(window.location.search).toBe('?tab=comments')
      await user.keyboard('{Enter}')
      await waitFor(() => expect(window.location.search).toBe('?tab=worklog'))
      await user.click(screen.getByRole('button', { name: /Записать время|Log work/i }))
      expect(screen.getByLabelText(/Затрачено времени|Time spent/i)).toHaveValue('')
      expect(screen.queryByRole('timer')).not.toBeInTheDocument()
    } finally {
      view.unmount()
      router.dispose()
      qc.clear()
      window.history.replaceState(previousState, '', previousUrl)
    }
  })

