    fireEvent.change(screen.getByLabelText(/^Название метки$|^Label name$/i), {
      target: { value: 'QA label' },
    })
    await user.click(screen.getByTestId('label-submit'))
    await waitFor(() => expect(mockLabelAttach).toHaveBeenCalledOnce())
    expect(screen.getByLabelText(/^Название метки$|^Label name$/i)).toBeDisabled()
    await user.click(screen.getByRole('tab', { name: /Журнал работ|Worklog/i }))
    const guard = await screen.findByRole('alertdialog')
    expect(within(guard).getByRole('button', { name: /Подтвердить|Confirm/i })).toBeDisabled()
    expect(within(guard).getByRole('button', { name: /Отмена|Cancel/i })).toBeDisabled()
    await act(async () => finish())
    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
    await waitFor(() => expect(screen.getByRole('region', { name: 'TT-1' })).toHaveFocus())
    expect(screen.getByRole('status', { name: 'current location' })).not.toHaveTextContent('tab=')
    expect(mockLabelCreate).toHaveBeenCalledOnce()
    expect(mockLabelAttach).toHaveBeenCalledOnce()
  })

  it('protects direct attachment pending even without a form draft or connected input', async () => {
    let finish!: () => void
    mockProjectLabels.mockReturnValue({
      data: [{ id: 'l1', project_id: 'p1', name: 'QA label', color: '#6b7280' }],
      isLoading: false,
    })
    mockLabelAttach.mockImplementationOnce(
      () =>
        new Promise<void>((resolve) => {
          finish = resolve
        }),
    )
    render(wrapper(<IssueDetailPage />))
    const user = userEvent.setup()
    await user.click(
      screen.getByRole('button', { name: /^Прикрепить метку QA label$|^Attach label QA label$/i }),
    )
    await waitFor(() => expect(mockLabelAttach).toHaveBeenCalledOnce())
    const unload = new Event('beforeunload', { cancelable: true })
    window.dispatchEvent(unload)
    expect(unload.defaultPrevented).toBe(true)
    await user.click(screen.getByRole('tab', { name: /Журнал работ|Worklog/i }))
    expect(
      within(await screen.findByRole('alertdialog')).getByRole('button', {
        name: /Подтвердить|Confirm/i,
      }),
    ).toBeDisabled()
    await act(async () => finish())
    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
    await waitFor(() => expect(screen.getByRole('region', { name: 'TT-1' })).toHaveFocus())
    expect(screen.getByRole('status', { name: 'current location' })).not.toHaveTextContent('tab=')
  })
})
