      expect(mockIssueDeleteApi).toHaveBeenCalledOnce()
      expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument()
    } finally {
      view.unmount()
      router.dispose()
      qc.clear()
      window.history.replaceState(previousState, '', previousUrl)
    }
  })

