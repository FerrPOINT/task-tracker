import { beforeEach, describe, expect, it, vi } from 'vitest'
import { act, renderHook } from '@testing-library/react'
import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
import { useCreateCustomField, useDeleteCustomField, useSetIssueCustomFieldValue } from './hooks'
import type { CustomField } from '@/api/custom-fields'

const mocks = vi.hoisted(() => ({ create: vi.fn(), remove: vi.fn(), set: vi.fn() }))
vi.mock('@/api/custom-fields', () => ({
  createCustomField: mocks.create,
  deleteCustomField: mocks.remove,
  setIssueCustomFieldValue: mocks.set,
  listCustomFields: vi.fn(),
  listIssueCustomFieldValues: vi.fn(),
}))
const field: CustomField = {
  id: 'f1',
  project_id: 'p1',
  name: 'Estimate',
  field_type: 'number',
  options: [],
  is_required: false,
  created_at: '2026-10-04T00:00:00Z',
}
beforeEach(() => {
  mocks.create.mockReset().mockResolvedValue(field)
  mocks.remove.mockReset().mockResolvedValue(undefined)
  mocks.set.mockReset().mockResolvedValue(undefined)
})
function setup() {
  const client = new QueryClient({ defaultOptions: { mutations: { retry: false } } })
  const wrapper = ({ children }: { children: React.ReactNode }) => (
    <QueryClientProvider client={client}>{children}</QueryClientProvider>
  )
  return { client, wrapper }
}
describe('confirmed custom field caches', () => {
  it('adds confirmed creation only to a loaded directory and deduplicates', async () => {
    const { client, wrapper } = setup()
    client.setQueryData(['custom-fields', 'TT'], [])
    const hook = renderHook(() => useCreateCustomField('TT'), { wrapper })
    await act(async () => {
      await hook.result.current.mutateAsync(field)
      await hook.result.current.mutateAsync(field)
    })
    expect(client.getQueryData(['custom-fields', 'TT'])).toEqual([field])
    expect(client.getQueryData(['custom-fields', 'OTHER'])).toBeUndefined()
    hook.unmount()
    client.clear()
  })
  it.each([0, -1.5, null, ' ', []])(
    'updates or clears only the loaded association for %j',
    async (value) => {
      const { client, wrapper } = setup()
      const other = { field_id: 'f2', value: 'keep' }
      client.setQueryData(['issue-custom-fields', 'i1'], [{ field_id: 'f1', value: 8 }, other])
      client.setQueryData(['issue-custom-fields', 'i2'], [{ field_id: 'f1', value: 9 }])
      const hook = renderHook(() => useSetIssueCustomFieldValue('i1'), { wrapper })
      await act(async () => {
        await hook.result.current.mutateAsync({ fieldId: 'f1', value })
      })
      const expected = value === 0 || value === -1.5 ? [other, { field_id: 'f1', value }] : [other]
      expect(client.getQueryData(['issue-custom-fields', 'i1'])).toEqual(expected)
      expect(client.getQueryData(['issue-custom-fields', 'i2'])).toEqual([
        { field_id: 'f1', value: 9 },
      ])
      expect(client.getQueryData(['issue-custom-fields', 'unloaded'])).toBeUndefined()
      hook.unmount()
      client.clear()
    },
  )
  it('retains cache on failed PUT and does not manufacture an unloaded query', async () => {
    const { client, wrapper } = setup()
    client.setQueryData(['issue-custom-fields', 'i1'], [{ field_id: 'f1', value: 8 }])
    mocks.set.mockRejectedValueOnce(new Error('failure'))
    const hook = renderHook(() => useSetIssueCustomFieldValue('i1'), { wrapper })
    await act(async () => {
      await expect(hook.result.current.mutateAsync({ fieldId: 'f1', value: 0 })).rejects.toThrow()
    })
    expect(client.getQueryData(['issue-custom-fields', 'i1'])).toEqual([
      { field_id: 'f1', value: 8 },
    ])
    hook.unmount()
    const unloaded = renderHook(() => useSetIssueCustomFieldValue('unloaded'), { wrapper })
    await act(async () => {
      await unloaded.result.current.mutateAsync({ fieldId: 'f1', value: 0 })
    })
    expect(client.getQueryData(['issue-custom-fields', 'unloaded'])).toBeUndefined()
    unloaded.unmount()
    client.clear()
  })
  it('cascades confirmed deletion across loaded issues but retains other fields and projects', async () => {
    const { client, wrapper } = setup()
    const other = { ...field, id: 'f2' }
    client.setQueryData(['custom-fields', 'TT'], [field, other])
    client.setQueryData(['custom-fields', 'OTHER'], [other])
    for (const issue of ['i1', 'i2'])
      client.setQueryData(
        ['issue-custom-fields', issue],
        [
          { field_id: 'f1', value: 8 },
          { field_id: 'f2', value: 'keep' },
        ],
      )
    const hook = renderHook(() => useDeleteCustomField('TT'), { wrapper })
    mocks.remove.mockRejectedValueOnce(new Error('failure'))
    await act(async () => {
      await expect(hook.result.current.mutateAsync('f1')).rejects.toThrow()
    })
    expect(client.getQueryData(['custom-fields', 'TT'])).toEqual([field, other])
    expect(client.getQueryData(['issue-custom-fields', 'i1'])).toHaveLength(2)
    await act(async () => {
      await hook.result.current.mutateAsync('f1')
    })
    expect(client.getQueryData(['custom-fields', 'TT'])).toEqual([other])
    expect(client.getQueryData(['custom-fields', 'OTHER'])).toEqual([other])
    for (const issue of ['i1', 'i2'])
      expect(client.getQueryData(['issue-custom-fields', issue])).toEqual([
        { field_id: 'f2', value: 'keep' },
      ])
    expect(client.getQueryData(['issue-custom-fields', 'unloaded'])).toBeUndefined()
    hook.unmount()
    client.clear()
  })
})
