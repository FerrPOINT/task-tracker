import { api } from './client'
import type { components } from './generated'

export type CustomFieldType = 'text' | 'number' | 'select' | 'multi-select' | 'date'
export type CustomField = components['schemas']['CustomFieldResponse']
export type CustomFieldInput = Required<components['schemas']['CreateCustomFieldRequest']>
export type CustomFieldValue = components['schemas']['CustomFieldValueResponse']

export class CustomFieldMutationError extends Error {
  readonly outcome: 'rejected' | 'unknown'

  constructor(readonly status?: number) {
    super('Custom field mutation could not be confirmed')
    this.name = 'CustomFieldMutationError'
    this.outcome =
      status !== undefined && [400, 401, 403, 404, 409, 422, 429].includes(status)
        ? 'rejected'
        : 'unknown'
  }
}

export async function listCustomFields(projectKey: string): Promise<CustomField[]> {
  const { data, error, response } = await api.GET('/api/v1/projects/{project_key}/custom-fields', {
    params: { path: { project_key: projectKey } },
  })
  if (error || !data || !response.ok) throw new Error('Failed to load custom fields')
  return data.fields
}
export async function createCustomField(
  projectKey: string,
  input: CustomFieldInput,
): Promise<CustomField> {
  try {
    const { data, error, response } = await api.POST(
      '/api/v1/projects/{project_key}/custom-fields',
      {
        params: { path: { project_key: projectKey } },
        body: input,
      },
    )
    if (error || !data || !response.ok) throw new CustomFieldMutationError(response.status)
    return data
  } catch (error) {
    if (error instanceof CustomFieldMutationError) throw error
    throw new CustomFieldMutationError()
  }
}
export async function updateCustomField(id: string, input: CustomFieldInput): Promise<CustomField> {
  try {
    const { data, error, response } = await api.PUT('/api/v1/custom-fields/{id}', {
      params: { path: { id } },
      body: input,
    })
    if (error || !data || !response.ok) throw new CustomFieldMutationError(response.status)
    return data
  } catch (error) {
    if (error instanceof CustomFieldMutationError) throw error
    throw new CustomFieldMutationError()
  }
}
export async function deleteCustomField(id: string): Promise<void> {
  try {
    const { error, response } = await api.DELETE('/api/v1/custom-fields/{id}', {
      params: { path: { id } },
    })
    if (error || !response.ok) throw new CustomFieldMutationError(response.status)
  } catch (error) {
    if (error instanceof CustomFieldMutationError) throw error
    throw new CustomFieldMutationError()
  }
}
export async function listIssueCustomFieldValues(issueId: string): Promise<CustomFieldValue[]> {
  const { data, error, response } = await api.GET('/api/v1/issues/{issue_id}/custom-fields', {
    params: { path: { issue_id: issueId } },
  })
  if (error || !data || !response.ok) throw new Error('Failed to load custom field values')
  return data.values
}
export async function setIssueCustomFieldValue(
  issueId: string,
  fieldId: string,
  value: unknown,
): Promise<void> {
  try {
    const { error, response } = await api.PUT(
      '/api/v1/issues/{issue_id}/custom-fields/{field_id}/value',
      {
        params: { path: { issue_id: issueId, field_id: fieldId } },
        body: { value },
      },
    )
    if (error || !response.ok) throw new CustomFieldMutationError(response.status)
  } catch (error) {
    if (error instanceof CustomFieldMutationError) throw error
    throw new CustomFieldMutationError()
  }
}
