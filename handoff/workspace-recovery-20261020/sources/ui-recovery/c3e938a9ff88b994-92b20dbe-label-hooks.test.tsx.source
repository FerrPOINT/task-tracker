import { beforeEach, describe, expect, it, vi } from 'vitest'
import { act, renderHook } from '@testing-library/react'
import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
import { useAttachLabel, useCreateLabel, useDetachLabel } from './hooks'
import type { Label } from '@/api/label'

const mocks = vi.hoisted(() => ({ create: vi.fn(), attach: vi.fn(), detach: vi.fn() }))
vi.mock('@/api/label', () => ({
  createLabel: mocks.create,
  attachLabel: mocks.attach,
  detachLabel: mocks.detach,
  listProjectLabels: vi.fn(),
  listIssueLabels: vi.fn(),
}))
const label: Label = { id: 'l1', name: 'bug', color: '#ef4444', project_id: 'p1' }
beforeEach(() => {
  mocks.create.mockReset().mockResolvedValue(label)
  mocks.attach.mockReset().mockResolvedValue(undefined)
  mocks.detach.mockReset().mockResolvedValue(undefined)
})
const setup = () => {
  const client = new QueryClient({ defaultOptions: { mutations: { retry: false } } })
  const wrapper = ({ children }: { children: React.ReactNode }) => (
    <QueryClientProvider client={client}>{children}</QueryClientProvider>
  )
  return { client, wrapper }
}

describe('confirmed label caches', () => {
  it('stores acknowledged creation in a loaded project without manufacturing another directory', async () => {
    const { client, wrapper } = setup()
    client.setQueryData(['labels', 'TT'], [])
    const hook = renderHook(() => useCreateLabel('TT'), { wrapper })
    await act(async () => {
      await hook.result.current.mutateAsync({ name: 'bug', color: '#ef4444' })
    })
    expect(client.getQueryData(['labels', 'TT'])).toEqual([label])
    expect(client.getQueryData(['labels', 'OTHER'])).toBeUndefined()
    hook.unmount()
    client.clear()
  })
  it('adds a known attached label only to the loaded issue and deduplicates it', async () => {
    const { client, wrapper } = setup()
    client.setQueryData(['labels', 'TT'], [label])
    client.setQueryData(['issue-labels', 'i1'], [])
    const hook = renderHook(() => useAttachLabel('i1', 'TT'), { wrapper })
    await act(async () => {
      await hook.result.current.mutateAsync('l1')
      await hook.result.current.mutateAsync('l1')
    })
    expect(client.getQueryData(['issue-labels', 'i1'])).toEqual([label])
    expect(client.getQueryData(['issue-labels', 'i2'])).toBeUndefined()
    hook.unmount()
    client.clear()
  })
  it('does not invent an unknown label after attachment', async () => {
    const { client, wrapper } = setup()
    client.setQueryData(['issue-labels', 'i1'], [])
    const hook = renderHook(() => useAttachLabel('i1', 'TT'), { wrapper })
    await act(async () => {
      await hook.result.current.mutateAsync('l1')
    })
    expect(client.getQueryData(['issue-labels', 'i1'])).toEqual([])
    hook.unmount()
    client.clear()
  })
  it('retains the row on failure and removes only the confirmed detached association', async () => {
    const { client, wrapper } = setup()
    const other = { ...label, id: 'l2' }
    client.setQueryData(['labels', 'TT'], [label, other])
    client.setQueryData(['issue-labels', 'i1'], [label, other])
    client.setQueryData(['issue-labels', 'i2'], [label])
    mocks.detach.mockRejectedValueOnce(new Error('server failure'))
    const hook = renderHook(() => useDetachLabel('i1', 'TT'), { wrapper })
    await act(async () => {
      await expect(hook.result.current.mutateAsync('l1')).rejects.toThrow()
    })
    expect(client.getQueryData(['issue-labels', 'i1'])).toEqual([label, other])
    await act(async () => {
      await hook.result.current.mutateAsync('l1')
    })
    expect(client.getQueryData(['issue-labels', 'i1'])).toEqual([other])
    expect(client.getQueryData(['issue-labels', 'i2'])).toEqual([label])
    expect(client.getQueryData(['labels', 'TT'])).toEqual([label, other])
    hook.unmount()
    client.clear()
  })
})
