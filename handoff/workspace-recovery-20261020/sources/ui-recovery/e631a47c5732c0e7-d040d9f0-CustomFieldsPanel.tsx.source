import { useEffect, useId, useMemo, useRef, useState, type FormEvent, type RefObject } from 'react'
import { useTranslation } from 'react-i18next'
import { useForm, Controller } from 'react-hook-form'
import { zodResolver } from '@hookform/resolvers/zod'
import { z } from 'zod'
import { Pencil, Check, X, RefreshCw } from 'lucide-react'
import { Button, ConfirmDialog, ErrorState, Label, LoadingState } from '@sdlc/ui/ui'
import {
  useIssueCustomFieldValues,
  useProjectCustomFields,
  useSetIssueCustomFieldValue,
} from '@/shared/api/hooks'
import {
  CustomFieldMutationError,
  type CustomField,
  type CustomFieldValue,
} from '@/api/custom-fields'
import { toast } from 'sonner'

export function customFieldDateInputValue(value: unknown) {
  if (typeof value !== 'string') return ''
  if (/^\d{4}-\d{2}-\d{2}(?:$|T)/.test(value)) return value.slice(0, 10)
  return ''
}

export function isEmptyCustomFieldValue(value: unknown) {
  return (
    value == null ||
    (typeof value === 'string' && value.trim() === '') ||
    (Array.isArray(value) && value.length === 0)
  )
}

function customFieldInputValue(field: CustomField, value: unknown) {
  if (field.field_type === 'date') return customFieldDateInputValue(value)
  if (typeof value === 'number') return String(value)
  if (typeof value === 'string') return value
  return ''
}

function customFieldValueFromInput(field: CustomField, value: string) {
  if (field.field_type === 'number' && value !== '') return Number(value)
  return value
}

export function CustomFieldValueInput({
  field,
  value,
  onSave,
  commit = 'blur',
  id,
  invalid,
  describedBy,
  disabled = false,
  inputRef,
}: {
  field: CustomField
  value: unknown
  onSave: (value: unknown) => void
  commit?: 'blur' | 'change' | 'submit'
  id?: string
  invalid?: boolean
  describedBy?: string
  disabled?: boolean
  inputRef?: RefObject<HTMLElement | null>
}) {
  const { t } = useTranslation()
  const current = customFieldInputValue(field, value)
  const [draft, setDraft] = useState(current)

  useEffect(() => {
    setDraft(current)
  }, [current])
  const props = {
    id,
    disabled,
    'aria-invalid': invalid,
    'aria-describedby': describedBy,
    'aria-required': field.is_required,
    className:
      'min-h-11 w-full min-w-0 rounded-md border border-border-strong bg-background p-2 text-sm text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus disabled:cursor-not-allowed sm:min-h-10',
    ref: (element: HTMLInputElement | HTMLSelectElement | null) => {
      if (inputRef) inputRef.current = element
    },
  }

  if (field.field_type === 'select') {
    return (
      <select {...props} value={current} onChange={(e) => onSave(e.target.value)}>
        <option value="">{t('customFields.selectPlaceholder')}</option>
        {current && !field.options.includes(current) && <option value={current}>{current}</option>}
        {field.options.map((option) => (
          <option key={option} value={option}>
            {option}
          </option>
        ))}
      </select>
    )
  }
  if (field.field_type === 'multi-select') {
    const selected = Array.isArray(value) ? value.map(String) : []
    return (
      <select
        {...props}
        multiple
        size={Math.min(5, Math.max(2, field.options.length))}
        value={selected}
        onChange={(e) => onSave(Array.from(e.target.selectedOptions, (o) => o.value))}
      >
        {[...new Set([...field.options, ...selected])].map((option) => (
          <option key={option} value={option}>
            {option}
          </option>
        ))}
      </select>
    )
  }
  const type =
    field.field_type === 'number' && commit !== 'submit'
      ? 'number'
      : field.field_type === 'date'
        ? 'date'
        : 'text'
  if (commit !== 'blur') {
    return (
      <input
        {...props}
        type={type}
        inputMode={field.field_type === 'number' ? 'decimal' : undefined}
        step={type === 'number' ? 'any' : undefined}
        value={current}
        onChange={(e) =>
          onSave(
            commit === 'submit' ? e.target.value : customFieldValueFromInput(field, e.target.value),
          )
        }
      />
    )
  }
  return (
    <input
      {...props}
      type={type}
      step={type === 'number' ? 'any' : undefined}
      value={draft}
      onChange={(e) => setDraft(e.target.value)}
      onBlur={() => onSave(customFieldValueFromInput(field, draft))}
    />
  )
}

export function CustomFieldsPanel({
  issueId,
  projectKey,
  onProtectionChange,
  inputRef,
}: {
  issueId: string
  projectKey: string
  onProtectionChange?: (state: { dirty: boolean; pending: boolean }) => void
  inputRef?: RefObject<HTMLElement | null>
}) {
  const { t } = useTranslation()
  const fields = useProjectCustomFields(projectKey)
  const values = useIssueCustomFieldValues(issueId)
  const [active, setActive] = useState<{ field: CustomField; value: unknown } | null>(null)
  const [protection, setProtection] = useState({ dirty: false, pending: false })
  const regionRef = useRef<HTMLDivElement>(null)
  const initiator = useRef<HTMLButtonElement | null>(null)
  const byField = useMemo(
    () => new Map((values.data ?? []).map((v) => [v.field_id, v.value])),
    [values.data],
  )
  const unavailable =
    fields.isLoading ||
    values.isLoading ||
    Boolean(fields.error || values.error) ||
    !fields.data ||
    !values.data
  useEffect(() => {
    onProtectionChange?.(protection)
  }, [protection, onProtectionChange])
  useEffect(
    () => () => onProtectionChange?.({ dirty: false, pending: false }),
    [onProtectionChange],
  )
  const finish = () => {
    setActive(null)
    queueMicrotask(() => {
      if (initiator.current?.isConnected && !initiator.current.disabled) initiator.current.focus()
      else regionRef.current?.focus()
    })
  }
  return (
    <div
      ref={regionRef}
      role="region"
      aria-label={t('customFields.title')}
      tabIndex={-1}
      className="min-w-0 space-y-3"
      data-testid="custom-fields-panel"
    >
      <div className="flex justify-end">
        <Button
          type="button"
          variant="ghost"
          size="icon"
          aria-label={t('customFields.refresh')}
          title={t('customFields.refresh')}
          className="min-h-11 min-w-11 sm:min-h-10 sm:min-w-10"
          disabled={protection.pending || fields.isFetching || values.isFetching}
          onClick={() => {
            if (!protection.pending) {
              void fields.refetch()
              void values.refetch()
            }
          }}
        >
          <RefreshCw className="h-4 w-4" aria-hidden />
        </Button>
      </div>
      {(fields.isLoading || values.isLoading) && (
        <LoadingState message={t('customFields.loading')} />
      )}
      {fields.error && (
        <ErrorState
          message={t('customFields.loadError')}
          onRetry={() => {
            if (!protection.pending) void fields.refetch()
          }}
        />
      )}
      {values.error && (
        <ErrorState
          message={t('customFields.valuesLoadError')}
          onRetry={() => {
            if (!protection.pending) void values.refetch()
          }}
        />
      )}
      {!unavailable && !fields.data?.length && (
        <p className="text-sm text-text-muted">{t('customFields.noFields')}</p>
      )}
      <ul className="divide-y divide-border">
        {(fields.data ?? []).map((field) => (
          <li
            key={field.id}
            className="flex min-w-0 items-start justify-between gap-2 py-2"
            data-custom-field={field.id}
          >
            <dl className="min-w-0 flex-1">
              <dt className="text-sm font-medium text-text-secondary [overflow-wrap:anywhere]">
                {field.name}
                {field.is_required ? ' *' : ''}
              </dt>
              <dd className="text-sm text-text-primary [overflow-wrap:anywhere]">
                {values.data
                  ? formatCustomFieldValue(field, byField.get(field.id), t('customFields.notSet'))
                  : t('customFields.valueUnavailable')}
                {!supportedCustomField(field) && (
                  <p className="text-sm text-text-muted">{t('customFields.unsupportedType')}</p>
                )}
              </dd>
            </dl>
            <Button
              type="button"
              size="icon"
              variant="ghost"
              aria-label={t('customFields.editValue', { name: field.name })}
              title={t('customFields.editValue', { name: field.name })}
              className="min-h-11 min-w-11 shrink-0 sm:min-h-10 sm:min-w-10"
              disabled={unavailable || active !== null || !supportedCustomField(field)}
              onClick={(event) => {
                initiator.current = event.currentTarget
                setActive({ field, value: byField.get(field.id) })
              }}
            >
              <Pencil className="h-4 w-4" aria-hidden />
            </Button>
          </li>
        ))}
      </ul>
      {active && (
        <CustomFieldValueEditor
          key={active.field.id}
          issueId={issueId}
          field={active.field}
          value={active.value}
          currentField={fields.data?.find((field) => field.id === active.field.id)}
          unavailable={unavailable}
          verifyValues={values.refetch}
          verifyFields={fields.refetch}
          onProtectionChange={setProtection}
          inputRef={inputRef}
          onFinish={finish}
          fallbackFocusRef={regionRef}
        />
      )}
    </div>
  )
}

function supportedCustomField(field: CustomField) {
  return ['text', 'number', 'select', 'multi-select', 'date'].includes(field.field_type)
}

export function formatCustomFieldValue(field: CustomField, value: unknown, empty: string) {
  if (isEmptyCustomFieldValue(value)) return empty
  if (field.field_type === 'date') return customFieldDateInputValue(value) || String(value)
  if (Array.isArray(value)) return value.map(String).join(', ')
  return typeof value === 'object' ? JSON.stringify(value) : String(value)
}

export function normalizeCustomFieldDraft(field: CustomField, value: unknown): unknown {
  if (isEmptyCustomFieldValue(value)) return null
  if (field.field_type === 'number')
    return typeof value === 'string' || typeof value === 'number' ? Number(value) : NaN
  if (field.field_type === 'date') return customFieldDateInputValue(value)
  return value
}

function sameValue(left: unknown, right: unknown) {
  if (isEmptyCustomFieldValue(right)) return isEmptyCustomFieldValue(left)
  if (Array.isArray(left) && Array.isArray(right))
    return JSON.stringify([...left].sort()) === JSON.stringify([...right].sort())
  return Object.is(left, right)
}

function CustomFieldValueEditor({
  issueId,
  field,
  currentField,
  value,
  unavailable,
  verifyValues,
  verifyFields,
  onProtectionChange,
  onFinish,
  inputRef,
  fallbackFocusRef,
}: {
  issueId: string
  field: CustomField
  currentField?: CustomField
  value: unknown
  unavailable: boolean
  verifyValues: () => Promise<{ data?: CustomFieldValue[]; error?: unknown }>
  verifyFields: () => Promise<{ data?: CustomField[]; error?: unknown }>
  onProtectionChange: (state: { dirty: boolean; pending: boolean }) => void
  onFinish: () => void
  inputRef?: RefObject<HTMLElement | null>
  fallbackFocusRef: RefObject<HTMLElement | null>
}) {
  const { t } = useTranslation()
  const save = useSetIssueCustomFieldValue(issueId)
  const [submitting, setSubmitting] = useState(false)
  const lock = useRef(false)
  const [error, setError] = useState<string | null>(null)
  const [unknown, setUnknown] = useState<{ value: unknown } | null>(null)
  const [discardOpen, setDiscardOpen] = useState(false)
  const [invalidNative, setInvalidNative] = useState(false)
  const localInputRef = useRef<HTMLElement>(null)
  const controlRef = inputRef ?? localInputRef
  const id = useId()
  const definitionChanged =
    !currentField ||
    currentField.field_type !== field.field_type ||
    currentField.is_required !== field.is_required ||
    JSON.stringify(currentField.options) !== JSON.stringify(field.options)
  const form = useForm<{ value?: unknown }>({
    defaultValues: {
      value:
        field.field_type === 'date' && typeof value === 'string'
          ? customFieldDateInputValue(value) || value
          : (value ?? (field.field_type === 'multi-select' ? [] : '')),
    },
    resolver: zodResolver(
      z.object({
        value: z.unknown().superRefine((draft, context) => {
          if (isEmptyCustomFieldValue(draft)) {
            if (field.is_required)
              context.addIssue({
                code: 'custom',
                message: t('customFields.requiredMissing', { name: field.name }),
              })
            return
          }
          const normalized = normalizeCustomFieldDraft(field, draft)
          let valid = true
          if (field.field_type === 'text') valid = typeof draft === 'string'
          if (field.field_type === 'number')
            valid = typeof normalized === 'number' && Number.isFinite(normalized)
          if (field.field_type === 'date') {
            const date = typeof normalized === 'string' ? new Date(normalized) : new Date(NaN)
            valid =
              typeof normalized === 'string' &&
              /^\d{4}-\d{2}-\d{2}$/.test(normalized) &&
              Number.isFinite(date.getTime()) &&
              date.toISOString().slice(0, 10) === normalized
          }
          if (field.field_type === 'select')
            valid = typeof draft === 'string' && field.options.includes(draft)
          if (field.field_type === 'multi-select')
            valid =
              Array.isArray(draft) &&
              draft.every((option) => typeof option === 'string' && field.options.includes(option))
          if (!valid) context.addIssue({ code: 'custom', message: t('customFields.invalidValue') })
        }),
      }),
    ),
  })
  const busy = submitting || save.isPending
  const dirty = form.formState.isDirty || unknown !== null || invalidNative
  useEffect(() => {
    onProtectionChange({ dirty, pending: busy })
  }, [dirty, busy, onProtectionChange])
  useEffect(() => () => onProtectionChange({ dirty: false, pending: false }), [onProtectionChange])
  useEffect(() => {
    controlRef.current?.focus()
  }, [controlRef])
  const finish = () => {
    setUnknown(null)
    onFinish()
    toast.success(t('common.saved'))
  }
  const submit = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault()
    if (busy || lock.current) return
    lock.current = true
    setSubmitting(true)
    setError(null)
    try {
      if (unknown) {
        const directory = await verifyFields()
        if (directory.error || !directory.data) {
          setError(t('customFields.verifyError'))
          return
        }
        const confirmedField = directory.data.find((item) => item.id === field.id)
        if (!confirmedField) {
          setError(t('customFields.definitionMissing'))
          return
        }
        if (
          confirmedField.field_type !== field.field_type ||
          confirmedField.is_required !== field.is_required ||
          JSON.stringify(confirmedField.options) !== JSON.stringify(field.options)
        ) {
          setError(t('customFields.definitionChanged'))
          return
        }
        const result = await verifyValues()
        if (result.error || !result.data) {
          setError(t('customFields.verifyError'))
          return
        }
        if (sameValue(result.data.find((item) => item.field_id === field.id)?.value, unknown.value))
          finish()
        else {
          setUnknown(null)
          setError(t('customFields.notSaved'))
        }
      } else {
        if (unavailable || definitionChanged) return
        if (
          invalidNative ||
          (controlRef.current instanceof HTMLInputElement && controlRef.current.validity.badInput)
        ) {
          form.setError('value', { message: t('customFields.invalidValue') })
          return
        }
        await form.handleSubmit(async (data) => {
          const payload = normalizeCustomFieldDraft(field, data.value)
          try {
            await save.mutateAsync({ fieldId: field.id, value: payload })
            finish()
          } catch (cause) {
            if (!(cause instanceof CustomFieldMutationError) || cause.outcome === 'unknown') {
              setUnknown({ value: payload })
              setError(t('customFields.unknownSave'))
            } else setError(t('customFields.saveError'))
          }
        })(event)
      }
    } catch {
      setError(t('customFields.verifyError'))
    } finally {
      lock.current = false
      setSubmitting(false)
    }
  }
  return (
    <form
      onSubmit={(event) => void submit(event)}
      noValidate
      aria-busy={busy}
      className="min-w-0 space-y-2 border-t border-border pt-3"
      data-testid="custom-field-value-form"
      onInput={() =>
        setInvalidNative(
          controlRef.current instanceof HTMLInputElement && controlRef.current.validity.badInput,
        )
      }
    >
      <Label htmlFor={id} className="[overflow-wrap:anywhere]">
        {field.name}
        {field.is_required ? ' *' : ''}
      </Label>
      <Controller
        name="value"
        control={form.control}
        render={({ field: input }) => (
          <CustomFieldValueInput
            field={field}
            value={input.value}
            onSave={input.onChange}
            commit="submit"
            id={id}
            inputRef={controlRef}
            disabled={busy || unknown !== null}
            invalid={Boolean(form.formState.errors.value)}
            describedBy={form.formState.errors.value ? `${id}-error` : undefined}
          />
        )}
      />
      {form.formState.errors.value && (
        <p id={`${id}-error`} role="alert" className="text-sm text-danger [overflow-wrap:anywhere]">
          {form.formState.errors.value.message}
        </p>
      )}
      {definitionChanged && (
        <p role="alert" className="text-sm text-danger">
          {t(currentField ? 'customFields.definitionChanged' : 'customFields.definitionMissing')}
        </p>
      )}
      {error && (
        <p role="alert" className="text-sm text-danger">
          {error}
        </p>
      )}
      <div className="flex flex-wrap gap-2">
        <Button
          type="submit"
          disabled={busy || (!unknown && (unavailable || definitionChanged))}
          className="min-h-11 sm:min-h-10"
        >
          <Check className="h-4 w-4" aria-hidden />
          {busy ? t('common.saving') : unknown ? t('customFields.verify') : t('common.save')}
        </Button>
        <Button
          type="button"
          variant="outline"
          disabled={busy}
          className="min-h-11 sm:min-h-10"
          onClick={() => {
            if (lock.current) return
            if (dirty) setDiscardOpen(true)
            else onFinish()
          }}
        >
          <X className="h-4 w-4" aria-hidden />
          {t('common.cancel')}
        </Button>
      </div>
      <ConfirmDialog
        open={discardOpen}
        onOpenChange={setDiscardOpen}
        title={t('customFields.discardTitle')}
        description={t('customFields.discardDescription')}
        isPending={busy}
        returnFocusRef={{
          get current() {
            return controlRef.current?.isConnected ? controlRef.current : fallbackFocusRef.current
          },
        }}
        fallbackFocusRef={fallbackFocusRef}
        onConfirm={() => {
          if (!busy && !lock.current) onFinish()
        }}
      />
    </form>
  )
}
