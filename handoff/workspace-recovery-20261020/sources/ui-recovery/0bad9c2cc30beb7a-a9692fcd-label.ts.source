import { api } from './client'
import type { components } from './generated'

export type Label = components['schemas']['LabelResponse']

export class LabelMutationError extends Error {
  readonly outcome: 'rejected' | 'unknown'

  constructor(readonly status?: number) {
    super('Label mutation could not be confirmed')
    this.name = 'LabelMutationError'
    this.outcome =
      status !== undefined && [400, 401, 403, 404, 409, 422, 429].includes(status)
        ? 'rejected'
        : 'unknown'
  }
}

export async function listProjectLabels(projectKey: string): Promise<Label[]> {
  const { data, error, response } = await api.GET('/api/v1/projects/{project_key}/labels', {
    params: { path: { project_key: projectKey } },
  })
  if (error || !data || !response.ok) throw new Error('Failed to load labels')
  return data.labels
}

export async function createLabel(projectKey: string, name: string, color: string): Promise<Label> {
  try {
    const { data, error, response } = await api.POST('/api/v1/projects/{project_key}/labels', {
      params: { path: { project_key: projectKey } },
      body: { name, color },
    })
    if (error || !data || !response.ok) throw new LabelMutationError(response.status)
    return data
  } catch (error) {
    if (error instanceof LabelMutationError) throw error
    throw new LabelMutationError()
  }
}

export async function listIssueLabels(issueId: string): Promise<Label[]> {
  const { data, error, response } = await api.GET('/api/v1/issues/{issue_id}/labels', {
    params: { path: { issue_id: issueId } },
  })
  if (error || !data || !response.ok) throw new Error('Failed to load issue labels')
  return data.labels
}

export async function attachLabel(issueId: string, labelId: string): Promise<void> {
  try {
    const { error, response } = await api.POST('/api/v1/issues/{issue_id}/labels', {
      params: { path: { issue_id: issueId } },
      body: { label_id: labelId },
    })
    if (error || !response.ok) throw new LabelMutationError(response.status)
  } catch (error) {
    if (error instanceof LabelMutationError) throw error
    throw new LabelMutationError()
  }
}

export async function detachLabel(issueId: string, labelId: string): Promise<void> {
  try {
    const { error, response } = await api.DELETE('/api/v1/issues/{issue_id}/labels/{label_id}', {
      params: { path: { issue_id: issueId, label_id: labelId } },
    })
    if (error || !response.ok) throw new LabelMutationError(response.status)
  } catch (error) {
    if (error instanceof LabelMutationError) throw error
    throw new LabelMutationError()
  }
}
