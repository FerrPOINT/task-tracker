    await expect(actions).toBeFocused()
    await page.getByRole('button', { name: 'Изменить', exact: true }).click()
    const summary = page.getByRole('textbox', { name: 'Заголовок', exact: true })
    const draft = `Draft ${'long-value-'.repeat(30)}`
    await summary.fill(draft)
    for (const width of [375, 1023, 1024, 1279, 1280, 1920, 2560]) {
      await page.setViewportSize({ width, height: 1080 })
      await expect(summary).toHaveValue(draft)
      expect(
        await page.evaluate(
          () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
        ),
      ).toBe(true)
    }
    await page.getByRole('tab', { name: 'Комментарии', exact: true }).click()
    await expect(page).toHaveURL(new RegExp(`/issues/${mockUser.issueId}\\?tab=comments$`))
    await expect(summary).toHaveValue(draft)
    await page.goBack()
    await expect(page.getByRole('tab', { name: 'Активность', exact: true })).toHaveAttribute(
      'data-state',
      'active',
    )
    await expect(summary).toHaveValue(draft)
    await page
      .getByRole('navigation', { name: 'Основная навигация' })
      .getByRole('link', { name: 'Проекты', exact: true })
      .click()
    await expect(page.getByRole('alertdialog')).toBeVisible()
    await page.getByRole('button', { name: 'Отмена', exact: true }).click()
    await expect(summary).toHaveValue(draft)
    let submissions = 0
    await page.route(`**/api/v1/issues/${mockUser.issueId}`, async (route) => {
      if (route.request().method() !== 'PATCH') return route.fallback()
      submissions++
      return routeJson(route, { error: { code: 'UNAVAILABLE', message: 'Save unavailable' } }, 503)
    })
    await page.getByRole('button', { name: 'Сохранить', exact: true }).click()
    await expect(
      page.getByRole('alert').filter({ hasText: 'Failed to update issue' }),
    ).toBeVisible()
    await expect(summary).toHaveValue(draft)
    expect(submissions).toBe(1)
    await page.screenshot({ path: testInfo.outputPath('draft-save-failure.png'), fullPage: true })
  })

  test('login then navigate through dashboard, projects, board and create issue', async ({
    page,
    baseURL,
  }, testInfo) => {
    test.setTimeout(360_000)
    const appBaseURL = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
    await installTrackerMocks(page)

    await page.goto(`${appBaseURL}/`)
    await expect(page).toHaveURL(`${appBaseURL}/`, { timeout: 15_000 })
    await expect(
      page.getByRole('heading', { name: /dashboard|team dashboard|мои задачи|командный дашборд/i }),
    ).toBeVisible()

    await page.goto(`${appBaseURL}/projects`)
    await expect(page.getByText(mockUser.name)).toBeVisible()

    await page.goto(`${appBaseURL}/projects/${mockUser.key}/board`)
    await expect(page.getByText('Smoke issue').first()).toBeVisible()

    await page.goto(`${appBaseURL}/projects/${mockUser.key}/backlog`)
    await expect(page.getByRole('heading', { name: /backlog|бэклог/i })).toBeVisible()
    const createLinks = page.locator('main a[href^="/issues/create"]')
    await expect(createLinks).toHaveCount(2)
    await createLinks.last().click()
    await expect(page).toHaveURL(`${appBaseURL}/issues/create?project_key=${mockUser.key}`)
    await expect(page.locator('#issue-project')).toHaveValue(mockUser.key)

    await page.goto(`${appBaseURL}/projects/${mockUser.key}/board`)
    await expect(page.getByText('Smoke issue').first()).toBeVisible()
    await page.goto(`${appBaseURL}/issues/${mockUser.issueId}`)
    await expect(page.getByText('Issue detail smoke description')).toBeVisible()
    await expect(page.getByRole('button', { name: /vote|голос/i })).toBeVisible()
    await expect(
      page.getByRole('button', { name: /stop watching|перестать следить/i }),
    ).toBeVisible()
    await expect(page.getByText(/1 total|всего 1/i)).toBeVisible()

    for (const theme of ['gray', 'dark', 'light']) {
      await page.evaluate((value) => localStorage.setItem('theme', value), theme)
      for (const viewport of [
        { width: 375, height: 812 },
        { width: 767, height: 1080 },
        { width: 768, height: 1080 },
        { width: 1023, height: 1080 },
        { width: 1024, height: 1080 },
        { width: 1279, height: 1080 },
        { width: 1280, height: 1080 },
        { width: 1440, height: 900 },
        { width: 1920, height: 1080 },
        { width: 2560, height: 1440 },
      ]) {
        await page.setViewportSize(viewport)

        for (const [path, mode] of [
          ['/', 'wide'],
          ['/projects', 'wide'],
          [`/issues/create?project_key=${mockUser.key}`, 'reading'],
          [`/issues/${mockUser.issueId}`, 'detail-with-aside'],
        ] as const) {
          await page.goto(`${appBaseURL}${path}`)
          if (mode === 'wide' && path !== '/')
            await expect(page.getByText(mockUser.name).first()).toBeVisible()
          if (path === '/') await expect(page.getByRole('heading', { level: 1 })).toBeVisible()
          await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
          if (mode === 'reading') {
            await expect(
              page.getByRole('heading', { name: /create issue|создать задачу/i }),
            ).toBeVisible()
          }
          if (mode === 'detail-with-aside') {
            await expect(page.getByText('Issue detail smoke description')).toBeVisible()
          }

          const layout = page.locator('[data-page-layout]')
          await expect(layout).toHaveAttribute('data-page-layout', mode)
          const geometry = await layout.evaluate((element) => {
            const frame = element.parentElement
            const frameStyle = frame ? getComputedStyle(frame) : null
            return {
              documentFits:
                document.documentElement.scrollWidth <= document.documentElement.clientWidth,
              layoutWidth: element.getBoundingClientRect().width,
              availableWidth:
                (frame?.getBoundingClientRect().width ?? 0) -
                Number.parseFloat(frameStyle?.paddingLeft ?? '0') -
                Number.parseFloat(frameStyle?.paddingRight ?? '0'),
            }
          })

          expect(geometry.documentFits).toBe(true)
          const smallControls = await page
            .locator(
              'main button, main select, main textarea, main input:not([type="hidden"]):not([type="file"]):not([type="checkbox"]):not([type="radio"])',
            )
            .evaluateAll(
              (elements, minimum) =>
                elements.flatMap((element) => {
                  const rect = element.getBoundingClientRect()
                  if (rect.width <= 0 || rect.height <= 0) return []
                  return rect.height + 0.5 < minimum
                    ? [
                        {
                          tag: element.tagName,
                          name:
                            element.getAttribute('aria-label') ?? element.id ?? element.textContent,
                          height: rect.height,
                        },
                      ]
                    : []
                }),
              viewport.width < 768 ? 44 : 40,
            )
          expect(smallControls).toEqual([])
          await expect(page.locator('[data-base-shell]')).toHaveCount(1)
          await expect(page.locator('[data-platform-header]')).toHaveCount(1)
          const header = page.locator('[data-platform-header]')
          expect((await header.boundingBox())?.height).toBe(60)
          const sidebar = page.locator('.base-shell-sidebar')
          if (viewport.width >= 768) {
            await expect(sidebar).toBeVisible()
            expect((await sidebar.boundingBox())?.width).toBe(viewport.width >= 1280 ? 264 : 72)
          } else await expect(sidebar).toBeHidden()
          const slots = await header
            .locator('[data-platform-header-slot]')
            .evaluateAll((elements) =>
              elements
                .map((element) => {
                  const rect = element.getBoundingClientRect()
                  return { left: rect.left, right: rect.right, width: rect.width }
                })
                .filter((rect) => rect.width > 0),
            )
          for (let index = 1; index < slots.length; index++)
            expect(slots[index].left).toBeGreaterThanOrEqual(slots[index - 1].right)
          if (mode === 'reading') {
            expect(geometry.layoutWidth).toBeLessThanOrEqual(761)
          } else {
            expect(Math.abs(geometry.layoutWidth - geometry.availableWidth)).toBeLessThanOrEqual(1)
          }
          if (mode === 'detail-with-aside') {
            const split = page.locator('.page-split')
            const columns = await split.evaluate((element) =>
              getComputedStyle(element).gridTemplateColumns.split(' ').map(Number.parseFloat),
            )
            expect(columns).toHaveLength(viewport.width < 1024 ? 1 : 2)
            if (viewport.width >= 1024) expect(columns[1]).toBe(320)
          }
          const testOutputPath = testInfo.outputPath(
            `shell-${theme}-${viewport.width}-${mode}-${path === '/' ? 'dashboard' : 'page'}.png`,
          )
          await page.screenshot({
            path: testOutputPath,
            fullPage: true,
          })
        }
      }
    }
  })
})
