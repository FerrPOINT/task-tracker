test.describe('smoke', () => {
  test('keeps notification page Base detail geometry and accessible controls across themes and breakpoints', async ({
    page,
    baseURL,
  }, testInfo) => {
    test.setTimeout(180_000)
    const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
    await installTrackerMocks(page)
    const notifications = Array.from({ length: 21 }, (_, index) => ({
      id: `notification-${index}`,
      title: `Notification ${index}: ${'LongUnbrokenTitle'.repeat(8)}`,
      body: `Details ${'LongUnbrokenBody'.repeat(10)}`,
      is_read: false,
      action_url: null,
      created_at: '2026-10-01T10:00:00Z',
    }))
    await page.route('**/api/v1/notifications**', (route) =>
      routeJson(route, { notifications, unread_count: 123456 }),
    )
    await page.route('**/api/v1/notification-settings', (route) =>
      routeJson(route, {
        email_frequency: 'daily',
        disabled_event_types: ['custom_event'],
        notify_own_changes: false,
      }),
    )
    const failures: string[] = []
    page.on('pageerror', (error) => failures.push(error.message))
    page.on('console', (message) => {
      if (message.type() === 'error') failures.push(message.text())
    })
    page.on('response', (response) => {
      if (response.status() >= 400) failures.push(`${response.status()} ${response.url()}`)
    })
    for (const theme of ['gray', 'dark', 'light']) {
      await page.goto(`${app}/notifications?source=qa#context`)
      await page.evaluate((value) => localStorage.setItem('theme', value), theme)
      await page.reload()
      for (const width of [375, 767, 768, 1023, 1024, 1279, 1280, 1440, 1920, 2560]) {
        await page.setViewportSize({ width, height: 1080 })
        await expect(
          page.getByRole('heading', { level: 1, name: 'Уведомления', exact: true }),
        ).toBeVisible()
        await expect(page.locator('[data-page-layout]')).toHaveAttribute(
          'data-page-layout',
          'detail-with-aside',
        )
        await expect(page.locator('main li')).toHaveCount(20)
        await expect(page.getByRole('combobox', { name: 'Частота email' })).toHaveValue('daily')
        await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
        const geometry = await page.locator('.page-split').evaluate((element) => ({
          columns: getComputedStyle(element).gridTemplateColumns.split(' ').map(Number.parseFloat),
          gap: Number.parseFloat(getComputedStyle(element).columnGap),
          documentFits:
            document.documentElement.scrollWidth <= document.documentElement.clientWidth,
          localFits: element.scrollWidth <= element.clientWidth,
        }))
        expect(geometry.documentFits).toBe(true)
        expect(geometry.localFits).toBe(true)
        expect(geometry.columns).toHaveLength(width < 1024 ? 1 : 2)
        if (width >= 1024) expect(geometry.columns[1]).toBe(320)
        expect(geometry.gap).toBe(20)
        const undersized = await page
          .locator('main button, main select, main label:has(input[type="checkbox"])')
          .evaluateAll(
            (elements, minimum) =>
              elements.flatMap((element) => {
                const rect = element.getBoundingClientRect()
                return rect.width > 0 && rect.height > 0 && rect.height + 0.5 < minimum
                  ? [{ html: element.outerHTML, height: rect.height }]
                  : []
              }),
            width < 768 ? 44 : 40,
          )
        expect(undersized).toEqual([])
        if (width === 1920 || width === 375) {
          const result = await new AxeBuilder({ page }).include('main').analyze()
          expect(
            result.violations.map(({ id, nodes }) => ({
              id,
              elements: nodes.map(({ html }) => html),
            })),
          ).toEqual([])
        }
        await page.screenshot({
          path: testInfo.outputPath(`notification-page-${theme}-${width}.png`),
          fullPage: true,
        })
      }
    }
    const all = page.getByRole('tab', { name: 'Все', exact: true })
    await all.focus()
    await page.keyboard.press('ArrowRight')
    await expect(
      page.getByRole('tab', { name: 'Непрочитанные (123456)', exact: true }),
    ).toBeFocused()
    await expect(page).toHaveURL(`${app}/notifications?source=qa&filter=unread#context`)
    await page.reload()
    await expect(
      page.getByRole('tab', { name: 'Непрочитанные (123456)', exact: true }),
    ).toHaveAttribute('aria-selected', 'true')
    expect(failures).toEqual([])
  })

  test('protects notification preferences drafts and independent partial/terminal states', async ({
    page,
    baseURL,
  }, testInfo) => {
    test.setTimeout(180_000)
    const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
    await installTrackerMocks(page)
    await page.setViewportSize({ width: 1920, height: 1080 })
    let listStatus = 200
    let settingsStatus = 200
    let writes = 0
    let release!: () => void
    await page.route('**/api/v1/notifications**', (route) =>
      routeJson(
        route,
        listStatus === 200
          ? {
              notifications: [
                {
                  id: 'safe-notification',
                  title: 'Safe notification',
                  body: 'Safe fixture',
                  is_read: false,
                  action_url: null,
                  created_at: '2026-10-01T10:00:00Z',
                },
              ],
              unread_count: 1,
            }
          : { error: { code: 'QA_FAILURE', message: 'Private diagnostic' } },
        listStatus,
      ),
    )
    await page.route('**/api/v1/notification-settings', async (route) => {
      if (route.request().method() === 'PATCH') {
        writes++
        expect(route.request().postDataJSON()).toEqual({
          email_frequency: 'hourly',
          disabled_event_types: ['custom_event'],
          notify_own_changes: false,
        })
        await new Promise<void>((resolve) => {
          release = resolve
        })
        return routeJson(
          route,
          { error: { code: 'QA_FAILURE', message: 'Private diagnostic' } },
          503,
        )
      }
      return routeJson(
        route,
        settingsStatus === 200
          ? {
              email_frequency: 'daily',
              disabled_event_types: ['custom_event'],
              notify_own_changes: false,
            }
          : { error: { code: 'QA_FAILURE', message: 'Private diagnostic' } },
        settingsStatus,
      )
    })
    await page.goto(`${app}/notifications?page=2&source=qa#context`)
    const frequency = page.getByRole('combobox', { name: 'Частота email' })
    await frequency.selectOption('hourly')
    await page.evaluate(() => {
      const pushes: string[] = []
      const original = history.pushState.bind(history)
      history.pushState = (data, unused, url) => {
        pushes.push(String(url))
        original(data, unused, url)
      }
      Object.assign(window, { notificationFilterPushes: pushes })
    })
    await page.getByRole('tab', { name: 'Непрочитанные (1)' }).click()
    await expect(frequency).toHaveValue('hourly')
    await expect(page).toHaveURL(`${app}/notifications?source=qa&filter=unread#context`)
    expect(await page.evaluate(() => Reflect.get(window, 'notificationFilterPushes'))).toEqual([
      '/notifications?source=qa&filter=unread#context',
    ])
    await page.goBack()
    await expect(frequency).toHaveValue('hourly')
    await expect(page).toHaveURL(`${app}/notifications?page=2&source=qa#context`)
    await page
      .getByRole('navigation', { name: 'Основная навигация' })
      .getByRole('link', { name: 'Проекты', exact: true })
      .click()
    await expect(page.getByRole('alertdialog')).toBeVisible()
    await page.getByRole('alertdialog').getByRole('button', { name: 'Отмена', exact: true }).click()
    await expect(frequency).toHaveValue('hourly')
    const form = page.getByRole('form', { name: 'Настройки' })
    await form.evaluate((element) => {
      element.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }))
      element.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }))
    })
    await expect.poll(() => writes).toBe(1)
    await expect(frequency).toBeDisabled()
    await expect(form).toHaveAttribute('aria-busy', 'true')
    release()
    await expect(
      page.getByRole('status').filter({ hasText: 'Не удалось сохранить настройки.' }),
    ).toBeVisible()
    await expect(frequency).toHaveValue('hourly')
    settingsStatus = 503
    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
    const preferences = page.getByRole('complementary', { name: 'Настройки' })
    await expect(preferences.locator('[data-page-state="partial-error"]')).toBeVisible({
      timeout: 45_000,
    })
    await expect(frequency).toBeDisabled()
    await expect(page.getByText('Safe notification', { exact: true })).toBeVisible()
    await expect(page.getByRole('button', { name: 'Прочитать все', exact: true })).toBeEnabled()
    await page.screenshot({
      path: testInfo.outputPath('notification-page-settings-partial-draft.png'),
      fullPage: true,
    })
    settingsStatus = 200
    await preferences.getByRole('button', { name: 'Повторить' }).click()
    await expect(frequency).toBeEnabled()
    await expect(frequency).toHaveValue('hourly')
    listStatus = 503
    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
    const list = page.getByRole('region', { name: 'Уведомления', exact: true })
    await expect(list.locator('[data-page-state="partial-error"]')).toBeVisible({ timeout: 45_000 })
    await expect(
      page.getByRole('button', { name: 'Отметить прочитанным: Safe notification' }),
    ).toBeDisabled()
    await expect(frequency).toBeEnabled()
    await page.screenshot({
      path: testInfo.outputPath('notification-page-list-partial.png'),
      fullPage: true,
    })
    listStatus = 403
    await list.getByRole('button', { name: 'Повторить' }).click()
    await expect(list.locator('[data-page-state="permission-denied"]')).toBeVisible()
    await expect(page.getByText('Safe notification', { exact: true })).toHaveCount(0)
    await expect(list.getByRole('button', { name: 'Повторить' })).toHaveCount(0)
    await expect(frequency).toHaveValue('hourly')
    await page.screenshot({
      path: testInfo.outputPath('notification-page-list-denied.png'),
      fullPage: true,
    })
    const cancel = preferences.getByRole('button', { name: 'Отмена', exact: true })
    await cancel.click()
    await expect(page.getByRole('alertdialog')).toBeVisible()
    await page.getByRole('alertdialog').getByRole('button', { name: 'Отмена', exact: true }).click()
    await expect(cancel).toBeFocused()
    await cancel.click()
    await page.getByRole('button', { name: 'Отменить изменения', exact: true }).click()
    await expect(frequency).toHaveValue('daily')
    settingsStatus = 404
    listStatus = 200
    await page.reload()
    await expect(preferences.locator('[data-page-state="not-found"]')).toBeVisible()
    await expect(frequency).toHaveCount(0)
    await expect(page.getByText('Safe notification', { exact: true })).toBeVisible()
    await expect(preferences.getByRole('button', { name: 'Повторить' })).toHaveCount(0)
    await page.screenshot({
      path: testInfo.outputPath('notification-page-settings-not-found.png'),
      fullPage: true,
    })
  })

  test('keeps notification menu geometry and keyboard navigation across themes and breakpoints', async ({
    page,
    baseURL,
  }, testInfo) => {
    test.setTimeout(180_000)
    const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
    await installTrackerMocks(page)
    const notifications = Array.from({ length: 10 }, (_, index) => ({
      id: `notification-${index}`,
      event_type: 'issue_updated',
      entity_type: 'issue',
      entity_id: mockUser.issueId,
      actor_id: null,
      title: `Notification ${index}: ${'LongUnbrokenTitle'.repeat(14)}`,
      body: `Details ${'LongUnbrokenBody'.repeat(18)}`,
      is_read: false,
      action_url: `/issues/${mockUser.issueId}`,
      metadata: null,
      created_at: '2026-10-01T10:00:00Z',
    }))
    await page.route('**/api/v1/notifications**', (route) =>
      routeJson(route, { notifications, unread_count: 123456 }),
    )
    const failures: string[] = []
    page.on('pageerror', (error) => failures.push(error.message))
    page.on('console', (message) => {
      if (message.type() === 'error') failures.push(message.text())
    })
    page.on('response', (response) => {
      if (response.status() >= 400) failures.push(`${response.status()} ${response.url()}`)
    })
    for (const theme of ['gray', 'dark', 'light']) {
      await page.goto(`${app}/projects`)
      await page.evaluate((value) => localStorage.setItem('theme', value), theme)
      await page.reload()
      for (const width of [375, 767, 768, 1023, 1024, 1279, 1280, 1440, 1920, 2560]) {
        await page.setViewportSize({ width, height: width === 375 ? 812 : 1080 })
        const trigger = page.getByTestId('notification-trigger')
        await expect(trigger).toHaveText('99+')
        await trigger.focus()
        await page.keyboard.press('Enter')
        const menu = page.getByRole('menu')
        await expect(menu).toBeVisible()
        await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
        await expect(menu).toBeInViewport({ ratio: 1 })
        const geometry = await menu.evaluate(
          (element, minimum) => {
            const rect = element.getBoundingClientRect()
            const targets = [...element.querySelectorAll('[role="menuitem"]')].map((item) =>
              item.getBoundingClientRect(),
            )
            return {
              documentFits:
                document.documentElement.scrollWidth <= document.documentElement.clientWidth,
              compact: rect.height <= 512,
              within:
                rect.left >= 0 &&
                rect.right <= innerWidth &&
                rect.top >= 0 &&
                rect.bottom <= innerHeight,
              targets: targets.every((target) => target.height + 0.5 >= minimum),
              localFits: element.scrollWidth <= element.clientWidth,
              footerVisible: (() => {
                const footer = targets.at(-1)
                return footer && footer.top >= rect.top && footer.bottom <= rect.bottom
              })(),
            }
          },
          width < 768 ? 44 : 40,
        )
        expect(geometry).toEqual({
          documentFits: true,
          compact: true,
          within: true,
          targets: true,
          localFits: true,
          footerVisible: true,
        })
        if (width === 1920) {
          const accessibility = await new AxeBuilder({ page }).include('[role="menu"]').analyze()
          expect(
            accessibility.violations.map(({ id, nodes }) => ({
              id,
              elements: nodes.map(({ html }) => html),
            })),
          ).toEqual([])
        }
        await page.keyboard.press('End')
        await expect(
          menu.getByRole('menuitem', { name: 'Все уведомления', exact: true }),
        ).toBeFocused()
        await page.keyboard.press('ArrowUp')
        const lastRead = menu.getByRole('menuitem', {
          name: `Отметить прочитанным: ${notifications[9].title}`,
          exact: true,
        })
        await expect(lastRead).toBeFocused()
        await expect(lastRead).toBeInViewport({ ratio: 1 })
        await page.keyboard.press('End')
        await page.screenshot({
          path: testInfo.outputPath(`notifications-menu-${theme}-${width}.png`),
          fullPage: true,
        })
        await page.keyboard.press('Escape')
        await expect(trigger).toBeFocused()
        await expect(menu).toBeHidden()
      }
    }
    expect(failures).toEqual([])
  })

  test('handles notification menu pending, failed read, focus removal and independent read failures', async ({
    page,
    baseURL,
  }, testInfo) => {
    test.setTimeout(180_000)
    const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
    await installTrackerMocks(page)
    await page.setViewportSize({ width: 1920, height: 1080 })
    const notification = {
      id: 'notification-1',
      title: 'Safe notification',
      body: 'Safe fixture',
      is_read: false,
      action_url: null,
      created_at: '2026-10-01T10:00:00Z',
    }
    let status = 200
    let notifications = [notification]
    let reads = 0
    let release!: () => void
    let failRead = true
    await page.route('**/api/v1/notifications**', async (route) => {
      if (route.request().method() === 'PATCH') {
        reads++
        await new Promise<void>((resolve) => {
          release = resolve
        })
        if (failRead)
          return routeJson(
            route,
            { error: { code: 'QA_REJECTED', message: 'Diagnostic detail' } },
            503,
          )
        notifications = []
        return route.fulfill({ status: 204, body: '' })
      }
      return routeJson(
        route,
        status === 200
          ? { notifications, unread_count: notifications.length }
          : { error: { code: 'QA_READ_FAILURE', message: 'Diagnostic detail' } },
        status,
      )
    })
    await page.goto(`${app}/projects`)
    const trigger = page.getByTestId('notification-trigger')
    await trigger.click()
    const menu = page.getByRole('menu')
    const read = menu.getByRole('menuitem', {
      name: 'Отметить прочитанным: Safe notification',
      exact: true,
    })
    await read.focus()
    await page.keyboard.press('Enter')
    await expect.poll(() => reads).toBe(1)
    await expect(read).toBeDisabled()
    await page.keyboard.press('Enter')
    expect(reads).toBe(1)
    await expect(menu.getByRole('menuitem', { name: 'Прочитать все' })).toBeDisabled()
    release()
    await expect(menu.getByRole('alert')).toHaveText('Не удалось отметить уведомление прочитанным.')
    const retry = menu.getByRole('menuitem', { name: 'Повторить' })
    await retry.focus()
    failRead = false
    await page.keyboard.press('Enter')
    await expect.poll(() => reads).toBe(2)
    release()
    await expect(read).toHaveCount(0)
    await expect(menu.getByRole('menuitem', { name: 'Все уведомления', exact: true })).toBeFocused()
    await page.keyboard.press('Escape')
    await expect(trigger).toBeFocused()
    notifications = [notification]
    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
    await expect(trigger).toHaveText('1')
    await trigger.click()
    status = 503
    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
    await expect(menu.locator('[data-page-state="partial-error"]')).toBeVisible({ timeout: 45_000 })
    await expect(read).toBeDisabled()
    await page.screenshot({
      path: testInfo.outputPath('notifications-menu-cached-partial.png'),
      fullPage: true,
    })
    status = 403
    await menu.getByRole('menuitem', { name: 'Повторить' }).click()
    await expect(menu.locator('[data-page-state="permission-denied"]')).toBeVisible({
      timeout: 45_000,
    })
    await expect(read).toHaveCount(0)
    await expect(menu.getByRole('menuitem', { name: 'Повторить' })).toHaveCount(0)
    await expect(trigger).toHaveText('')
    await expect(page.locator('main').getByText(mockUser.name)).toBeVisible()
    await page.screenshot({
      path: testInfo.outputPath('notifications-menu-cached-denied.png'),
      fullPage: true,
    })
    status = 404
    await page.reload()
    await trigger.click()
    await expect(menu.locator('[data-page-state="not-found"]')).toBeVisible({ timeout: 45_000 })
    await expect(menu.getByRole('menuitem', { name: 'Повторить' })).toHaveCount(0)
    await page.screenshot({
      path: testInfo.outputPath('notifications-menu-cold-not-found.png'),
      fullPage: true,
    })
  })

  test('distinguishes cached catalog refresh failures from revoked access without losing a retained draft', async ({
    page,
    baseURL,
  }, testInfo) => {
    test.setTimeout(120_000)
    const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
    await installTrackerMocks(page)
    await page.setViewportSize({ width: 1920, height: 1080 })
    await page.goto(`${app}/projects`)
    const trigger = page.getByRole('button', { name: `Действия с проектом ${mockUser.name}` })
    await trigger.click()
    await page.getByRole('menuitem', { name: 'Изменить', exact: true }).click()
    const dialog = page.getByRole('dialog')
    const name = dialog.locator('#project-form-name')
    await name.fill('Retained draft during refresh')
    let status = 503
    await page.route('**/api/v1/projects', (route) =>
      routeJson(
        route,
        { error: { code: 'QA_CATALOG_FAILURE', message: 'Controlled catalog failure' } },
        status,
      ),
    )
    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
    await expect(page.locator('[data-page-state="partial-error"]')).toBeVisible({ timeout: 45_000 })
    await expect(name).toHaveValue('Retained draft during refresh')
    await expect(name).toBeDisabled()
    await expect(dialog.getByRole('button', { name: 'Сохранить', exact: true })).toBeDisabled()
    await expect(dialog.getByRole('button', { name: 'Отмена', exact: true })).toBeEnabled()
    await page.screenshot({
      path: testInfo.outputPath('project-refresh-partial-draft.png'),
      fullPage: true,
    })
    await dialog.getByRole('button', { name: 'Отмена', exact: true }).click()
    await page
      .getByRole('alertdialog')
      .getByRole('button', { name: 'Подтвердить', exact: true })
      .click()
    await expect(dialog).toBeHidden()
    await expect(trigger).toBeDisabled()
    await expect(
      page.locator('main').getByRole('link', { name: new RegExp(mockUser.name) }),
    ).toBeVisible()
    await expect(page.getByRole('button', { name: 'Создать проект', exact: true })).toHaveCount(0)
    status = 403
    await page.evaluate(() => window.dispatchEvent(new Event('visibilitychange')))
    await expect(page.locator('[data-page-state="permission-denied"]')).toBeVisible()
    await expect(
      page.locator('main').getByRole('link', { name: new RegExp(mockUser.name) }),
    ).toHaveCount(0)
    await expect(page.getByRole('button', { name: 'Создать проект', exact: true })).toHaveCount(0)
    await expect(page.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(0)
    await page.screenshot({
      path: testInfo.outputPath('project-cached-access-revoked.png'),
      fullPage: true,
    })
    status = 404
    await page.reload()
    await expect(page.locator('[data-page-state="not-found"]')).toBeVisible()
    await expect(page.getByRole('button', { name: 'Создать проект', exact: true })).toHaveCount(0)
    await expect(page.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(0)
    await page.screenshot({
      path: testInfo.outputPath('project-cold-not-found.png'),
      fullPage: true,
    })
  })

  test('preserves project URL history, dirty drafts, pending focus and successful creation', async ({
    page,
    baseURL,
  }, testInfo) => {
    test.setTimeout(120_000)
    const app = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
    await installTrackerMocks(page)
    await page.setViewportSize({ width: 1920, height: 1080 })
    await page.goto(`${app}/projects?q=DEMO&page=4&view=compact#context`)
    const search = page.getByRole('textbox', { name: 'Поиск проектов...' })
    await expect(search).toHaveValue('DEMO')
    await search.fill('No matching project')
    await page.getByRole('button', { name: 'Поиск проектов...' }).click()
    await expect(page.getByText('По вашему запросу проекты не найдены.')).toBeVisible()
    expect(new URL(page.url()).searchParams.has('page')).toBe(false)
    expect(new URL(page.url()).searchParams.get('view')).toBe('compact')
    expect(new URL(page.url()).hash).toBe('#context')
    await page.reload()
    await expect(search).toHaveValue('No matching project')
    await page.goBack()
    await expect(search).toHaveValue('DEMO')
    const trigger = page.getByRole('button', { name: 'Создать проект', exact: true })
    await trigger.click()
    const dialog = page.getByRole('dialog')
    const key = dialog.locator('#project-form-key')
    const name = dialog.locator('#project-form-name')
    await key.fill('qa-2026')
    await name.fill('Safe isolated project draft')
    await name.focus()
    await page.keyboard.press('Escape')
    const discard = page.getByRole('alertdialog')
    await expect(discard).toBeVisible()
    await discard.getByRole('button', { name: 'Отмена', exact: true }).click()
    await expect(name).toHaveValue('Safe isolated project draft')
    await expect(name).toBeFocused()
    let submissions = 0
    let release!: () => void
    const pending = new Promise<void>((resolve) => {
      release = resolve
    })
    await page.route('**/api/v1/projects', async (route) => {
      if (route.request().method() !== 'POST') return route.fallback()
      submissions++
      await pending
      return routeJson(
        route,
        { error: { code: 'UNAVAILABLE', message: 'Controlled create failure' } },
        503,
      )
    })
    await dialog.getByRole('button', { name: 'Создать проект', exact: true }).click()
    await expect(dialog.getByRole('button', { name: 'Отмена', exact: true })).toBeDisabled()
    await expect(dialog.getByRole('button', { name: 'Закрыть', exact: true })).toBeDisabled()
    await name.evaluate((element) => element.closest('form')!.requestSubmit())
    await page.keyboard.press('Escape')
    expect(submissions).toBe(1)
    await expect(dialog).toBeVisible()
    release()
    await expect(dialog.getByRole('alert')).toBeVisible()
    await expect(name).toHaveValue('Safe isolated project draft')
    await expect(key).toHaveValue('QA-2026')
    await page.screenshot({
      path: testInfo.outputPath('project-create-failure.png'),
      fullPage: true,
    })
    await page.route('**/api/v1/projects', (route) => {
      if (route.request().method() !== 'POST') return route.fallback()
      submissions++
      return routeJson(
        route,
        {
          id: 'created-project',
          key: 'DEMO',
          name: 'Safe isolated project draft',
          owner_id: mockUser.id,
          todo_count: 0,
          in_progress_count: 0,
          done_count: 0,
        },
        201,
      )
    })
    await dialog.getByRole('button', { name: 'Создать проект', exact: true }).click()
    await expect(page).toHaveURL(`${app}/projects/DEMO/board`)
    await expect(discard).toBeHidden()
    expect(submissions).toBe(2)
    await expect(page.getByText('Smoke issue').first()).toBeVisible()
  })

  test('keeps the project edit draft and modal controls usable across themes and breakpoints', async ({
    page,
    baseURL,
