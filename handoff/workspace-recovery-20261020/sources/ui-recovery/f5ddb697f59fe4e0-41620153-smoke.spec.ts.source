  test('keeps a dirty issue draft across tabs and breakpoints and restores delete-menu focus', async ({
    page,
    baseURL,
  }, testInfo) => {
    test.setTimeout(90_000)
    const appBaseURL = (baseURL ?? 'http://localhost:4173').replace('127.0.0.1', 'localhost')
    await installTrackerMocks(page)
    await page.setViewportSize({ width: 1920, height: 1080 })
    await page.goto(`${appBaseURL}/issues/${mockUser.issueId}`)
    const actions = page.getByRole('button', { name: 'Действия', exact: true })
    await actions.click()
    await page.getByRole('menuitem', { name: 'Удалить', exact: true }).click()
