export function reportFormatters(locale: string, unavailable: string) {
  // Report buckets use UTC; browser timezone must not shift a bucket to another day.
  const compactDate = new Intl.DateTimeFormat(locale, { dateStyle: 'short', timeZone: 'UTC' })
  const fullDate = new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeZone: 'UTC' })
  const eventDate = new Intl.DateTimeFormat(locale, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'UTC',
    timeZoneName: 'short',
  })
  const numbers = new Intl.NumberFormat(locale, { maximumFractionDigits: 2 })
  const date = (formatter: Intl.DateTimeFormat, value: unknown) => {
    const parsed = typeof value === 'string' ? new Date(value) : new Date(NaN)
    return Number.isNaN(parsed.getTime()) ? unavailable : formatter.format(parsed)
  }
  return {
    compactDate: (value: unknown) => date(compactDate, value),
    date: (value: unknown) => date(fullDate, value),
    eventDate: (value: unknown) => date(eventDate, value),
    number: (value: number) => (Number.isFinite(value) ? numbers.format(value) : unavailable),
  }
}
