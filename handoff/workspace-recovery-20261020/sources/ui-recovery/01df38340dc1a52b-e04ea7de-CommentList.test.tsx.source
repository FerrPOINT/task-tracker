import { describe, it, expect, vi, beforeEach } from 'vitest'
import { act, render, screen, fireEvent, waitFor, within } from '@testing-library/react'
import { createMemoryRouter, RouterProvider, Link } from 'react-router'
import { I18nextProvider } from 'react-i18next'
import i18n from '@/shared/i18n/config'
import { CommentList, CommentForm, CommentItem, CommentsPanel } from './CommentList'
import type { Comment } from '@/entities/comment/model'

const commentsQuery = vi.hoisted(() => ({
  data: [] as Comment[],
  isLoading: false,
  error: null as Error | null,
  refetch: vi.fn(),
}))
const create = vi.hoisted(() => ({ mutateAsync: vi.fn(), isPending: false }))
const update = vi.hoisted(() => ({ mutateAsync: vi.fn(), isPending: false }))
const remove = vi.hoisted(() => ({ mutateAsync: vi.fn(), isPending: false }))
vi.mock('../model/use-comments', () => ({
  useComments: () => commentsQuery,
  useCreateComment: () => create,
  useUpdateComment: () => update,
  useDeleteComment: () => remove,
}))

beforeEach(async () => {
  await i18n.changeLanguage('ru')
  vi.clearAllMocks()
  commentsQuery.data = []
  commentsQuery.isLoading = false
  commentsQuery.error = null
  for (const mutation of [create, update, remove]) {
    mutation.isPending = false
    mutation.mutateAsync.mockReset().mockResolvedValue(undefined)
  }
})

function Wrapper({ children }: { children: React.ReactNode }) {
  return <I18nextProvider i18n={i18n}>{children}</I18nextProvider>
}

const sampleComment: Comment = {
  id: 'c1',
  issueId: 'i1',
  authorId: 'u1',
  authorName: 'Demo User',
  body: 'Test comment',
  createdAt: '2026-07-30T10:00:00Z',
  updatedAt: '2026-07-30T10:00:00Z',
}

describe('CommentList', () => {
  it('renders empty state', () => {
    render(
      <Wrapper>
        <CommentList comments={[]} onEdit={() => {}} onDelete={() => {}} />
      </Wrapper>,
    )
    expect(screen.getByText(/пока нет комментариев/i)).toBeInTheDocument()
  })

  it('renders comment item', () => {
    render(
      <Wrapper>
        <CommentList
          comments={[sampleComment]}
          currentUserId="u1"
          onEdit={() => {}}
          onDelete={() => {}}
        />
      </Wrapper>,
    )
    expect(screen.getByText('Test comment')).toBeInTheDocument()
    expect(screen.getByText('Demo User')).toBeInTheDocument()
    expect(screen.getByRole('button', { name: /изменить комментарий/i })).toBeInTheDocument()
  })
})

describe('CommentItem', () => {
  it('does not show actions for non-author', () => {
    render(
      <Wrapper>
        <CommentItem comment={sampleComment} onEdit={() => {}} onDelete={() => {}} />
      </Wrapper>,
    )
    expect(screen.queryByRole('button', { name: /изменить комментарий/i })).not.toBeInTheDocument()
  })
})

describe('CommentForm', () => {
  it('does not submit the same comment twice while the mutation is pending', async () => {
    let resolveSubmit: (() => void) | undefined
    const onSubmit = vi.fn(
      () =>
        new Promise<void>((resolve) => {
          resolveSubmit = resolve
        }),
    )
    render(
      <Wrapper>
        <CommentForm onSubmit={onSubmit} submitLabel="Add" />
      </Wrapper>,
    )
    fireEvent.change(screen.getByPlaceholderText(/напишите/i), {
      target: { value: 'Only once' },
    })
    const submit = screen.getByRole('button', { name: /add/i })
    fireEvent.click(submit)
    await waitFor(() => expect(onSubmit).toHaveBeenCalledTimes(1))
    // Do not clear the text while the request is still in flight.
    expect(screen.getByPlaceholderText(/напишите/i)).toHaveValue('Only once')
    expect(screen.getByPlaceholderText(/напишите/i)).toBeDisabled()
    expect(submit).toBeDisabled()
    fireEvent.submit(submit.closest('form')!)
    expect(onSubmit).toHaveBeenCalledTimes(1)
    resolveSubmit?.()
    await waitFor(() => expect(screen.getByPlaceholderText(/напишите/i)).toHaveValue(''))
  })

  it('submits non-empty body', async () => {
    const onSubmit = vi.fn()
    render(
      <Wrapper>
        <CommentForm onSubmit={onSubmit} submitLabel="Add" />
      </Wrapper>,
    )
    fireEvent.change(screen.getByPlaceholderText(/напишите/i), {
      target: { value: 'New comment' },
    })
    fireEvent.click(screen.getByText(/add/i))
    await waitFor(() => expect(onSubmit).toHaveBeenCalledWith({ body: 'New comment' }))
  })

  it('retains the draft and shows an error when saving fails', async () => {
    const onSubmit = vi.fn().mockRejectedValue(new Error('Network failed'))
    render(
      <Wrapper>
        <CommentForm onSubmit={onSubmit} submitLabel="Add" />
      </Wrapper>,
    )
    const textarea = screen.getByPlaceholderText(/напишите/i)
    fireEvent.change(textarea, { target: { value: 'Keep this draft' } })
    fireEvent.click(screen.getByText(/add/i))
    expect(await screen.findByRole('alert')).toHaveTextContent('Не удалось сохранить комментарий')
    expect(screen.queryByText('Network failed')).not.toBeInTheDocument()
    expect(textarea).toHaveValue('Keep this draft')
    expect(screen.getByText(/add/i)).toBeEnabled()
  })

  it('rejects whitespace and oversized bodies before calling the API', async () => {
    const submit = vi.fn()
    render(
      <Wrapper>
        <CommentForm onSubmit={submit} />
      </Wrapper>,
    )
    const input = screen.getByRole('textbox', { name: 'Комментарий' })
    fireEvent.change(input, { target: { value: ' \n\t ' } })
    fireEvent.click(screen.getByRole('button', { name: 'Сохранить' }))
    expect(await screen.findByRole('alert')).toHaveTextContent('Введите текст комментария')
    expect(input).toHaveAttribute('aria-invalid', 'true')
    expect(submit).not.toHaveBeenCalled()
    fireEvent.change(input, { target: { value: '😀'.repeat(100001) } })
    fireEvent.click(screen.getByRole('button', { name: 'Сохранить' }))
    await waitFor(() => expect(screen.getByRole('alert')).toHaveTextContent('100000'))
    expect(submit).not.toHaveBeenCalled()
  })

  it('keeps edit cancel and the textarea disabled until the response completes', async () => {
    let finish: (() => void) | undefined
    const submit = vi.fn(
      () =>
        new Promise<void>((resolve) => {
          finish = resolve
        }),
    )
    const cancel = vi.fn()
    render(
      <Wrapper>
        <CommentForm initialBody="Original" onSubmit={submit} onCancel={cancel} />
      </Wrapper>,
    )
    fireEvent.click(screen.getByRole('button', { name: 'Сохранить' }))
    await waitFor(() => expect(submit).toHaveBeenCalledTimes(1))
    expect(screen.getByRole('textbox')).toBeDisabled()
    expect(screen.getByRole('button', { name: 'Отмена' })).toBeDisabled()
    fireEvent.click(screen.getByRole('button', { name: 'Отмена' }))
    expect(cancel).not.toHaveBeenCalled()
    await act(async () => {
      finish?.()
    })
    expect(screen.getByRole('textbox')).toBeEnabled()
    expect(screen.getByRole('textbox')).toHaveValue('Original')
  })
})

function panel() {
  const router = createMemoryRouter([
    {
      path: '/',
      element: (
        <>
          <CommentsPanel issueId="i1" currentUserId="u1" />
          <Link to="/next">Next page</Link>
        </>
      ),
    },
    { path: '/next', element: <h1>Next page</h1> },
  ])
  render(
    <Wrapper>
      <RouterProvider router={router} />
    </Wrapper>,
  )
  return router
}

describe('CommentsPanel', () => {
  it('blocks navigation and all row actions during save, then keeps the page after success', async () => {
    commentsQuery.data = [sampleComment]
    let finish: (() => void) | undefined
    create.mutateAsync.mockImplementationOnce(
      () =>
        new Promise<void>((resolve) => {
          finish = resolve
        }),
    )
    const router = panel()
    fireEvent.change(screen.getByRole('textbox'), { target: { value: 'Pending comment' } })
    fireEvent.click(screen.getByRole('button', { name: 'Добавить комментарий' }))
    await waitFor(() => expect(create.mutateAsync).toHaveBeenCalledTimes(1))
    expect(screen.getByRole('button', { name: 'Изменить комментарий' })).toBeDisabled()
    expect(screen.getByRole('button', { name: 'Удалить комментарий' })).toBeDisabled()
    expect(screen.getByRole('button', { name: 'Обновить комментарии' })).toBeDisabled()
    const unload = new Event('beforeunload', { cancelable: true })
    window.dispatchEvent(unload)
    expect(unload.defaultPrevented).toBe(true)
    fireEvent.click(screen.getByRole('link', { name: 'Next page' }))
    const dialog = await screen.findByRole('alertdialog')
    expect(within(dialog).getByRole('button', { name: 'Подтвердить' })).toBeDisabled()
    fireEvent.click(within(dialog).getByRole('button', { name: 'Подтвердить' }))
    expect(router.state.location.pathname).toBe('/')
    await act(async () => {
      finish?.()
    })
    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
    expect(screen.getByRole('textbox')).toHaveValue('')
    expect(screen.getByRole('status')).toHaveTextContent('Комментарий добавлен.')
    expect(router.state.location.pathname).toBe('/')
    fireEvent.click(screen.getByRole('link', { name: 'Next page' }))
    expect(await screen.findByRole('heading', { name: 'Next page' })).toBeInTheDocument()
    router.dispose()
  })

  it('requires confirmation before cancelling a dirty edit and clears it without saving', async () => {
    commentsQuery.data = [sampleComment]
    const router = panel()
    fireEvent.click(screen.getByRole('button', { name: 'Изменить комментарий' }))
    fireEvent.change(screen.getByRole('textbox'), { target: { value: 'Unsaved edit' } })
    fireEvent.click(screen.getByRole('button', { name: 'Отмена' }))
    fireEvent.click(
      within(await screen.findByRole('alertdialog')).getByRole('button', { name: 'Отмена' }),
    )
    expect(screen.getByRole('textbox')).toHaveValue('Unsaved edit')
    fireEvent.click(screen.getByRole('button', { name: 'Отмена' }))
    fireEvent.click(
      within(await screen.findByRole('alertdialog')).getByRole('button', { name: 'Подтвердить' }),
    )
    await waitFor(() => expect(screen.getByRole('textbox')).toHaveValue(''))
    expect(screen.getByRole('textbox')).toHaveFocus()
    expect(update.mutateAsync).not.toHaveBeenCalled()
    router.dispose()
  })

  it('clears the editor of a successfully deleted comment rather than offering an invalid PATCH', async () => {
    commentsQuery.data = [sampleComment]
    remove.mutateAsync.mockImplementationOnce(async () => {
      commentsQuery.data = []
    })
    const router = panel()
    fireEvent.click(screen.getByRole('button', { name: 'Изменить комментарий' }))
    fireEvent.click(screen.getByRole('button', { name: 'Удалить комментарий' }))
    fireEvent.click(
      within(screen.getByRole('alertdialog')).getByRole('button', { name: 'Подтвердить' }),
    )
    await waitFor(() => expect(screen.getByRole('textbox')).toHaveValue(''))
    expect(screen.getByRole('button', { name: 'Добавить комментарий' })).toBeInTheDocument()
    expect(screen.queryByRole('button', { name: 'Сохранить' })).not.toBeInTheDocument()
    expect(update.mutateAsync).not.toHaveBeenCalled()
    router.dispose()
  })
  it('switches editors with the actual selected body and protects a dirty draft', async () => {
    commentsQuery.data = [sampleComment, { ...sampleComment, id: 'c2', body: 'Second comment' }]
    const router = panel()
    const row = (id: string) =>
      within(document.querySelector(`[data-comment-id="${id}"]`) as HTMLElement)
    fireEvent.click(row('c1').getByRole('button', { name: 'Изменить комментарий' }))
    expect(screen.getByRole('textbox')).toHaveValue('Test comment')
    fireEvent.change(screen.getByRole('textbox'), { target: { value: 'Keep edited draft' } })
    fireEvent.click(row('c2').getByRole('button', { name: 'Изменить комментарий' }))
    const dialog = await screen.findByRole('alertdialog')
    fireEvent.click(within(dialog).getByRole('button', { name: 'Отмена' }))
    expect(screen.getByRole('textbox')).toHaveValue('Keep edited draft')
    expect(update.mutateAsync).not.toHaveBeenCalled()
    fireEvent.click(row('c2').getByRole('button', { name: 'Изменить комментарий' }))
    fireEvent.click(
      within(await screen.findByRole('alertdialog')).getByRole('button', { name: 'Подтвердить' }),
    )
    await waitFor(() => expect(screen.getByRole('textbox')).toHaveValue('Second comment'))
    expect(screen.getByRole('textbox')).toHaveFocus()
    expect(screen.queryByRole('alert')).not.toBeInTheDocument()
    router.dispose()
  })

  it('confirms abandoning a new comment before editing and permits staying on navigation', async () => {
    commentsQuery.data = [sampleComment]
    const router = panel()
    fireEvent.change(screen.getByRole('textbox'), { target: { value: 'New draft' } })
    fireEvent.click(screen.getByRole('link', { name: 'Next page' }))
    fireEvent.click(
      within(await screen.findByRole('alertdialog')).getByRole('button', { name: 'Отмена' }),
    )
    expect(router.state.location.pathname).toBe('/')
    expect(screen.getByRole('textbox')).toHaveValue('New draft')
    fireEvent.click(screen.getByRole('button', { name: 'Изменить комментарий' }))
    fireEvent.click(
      within(await screen.findByRole('alertdialog')).getByRole('button', { name: 'Подтвердить' }),
    )
    await waitFor(() => expect(screen.getByRole('textbox')).toHaveValue('Test comment'))
    expect(create.mutateAsync).not.toHaveBeenCalled()
    router.dispose()
  })

  it('keeps the selected editor on failure and returns to a clean composer only after success', async () => {
    commentsQuery.data = [sampleComment]
    update.mutateAsync
      .mockRejectedValueOnce(new Error('internal update detail'))
      .mockResolvedValueOnce(undefined)
    const router = panel()
    fireEvent.click(screen.getByRole('button', { name: 'Изменить комментарий' }))
    fireEvent.change(screen.getByRole('textbox'), { target: { value: 'Edited body' } })
    fireEvent.click(screen.getByRole('button', { name: 'Сохранить' }))
    expect(await screen.findByRole('alert')).toHaveTextContent('Не удалось сохранить комментарий')
    expect(screen.getByRole('textbox')).toHaveValue('Edited body')
    fireEvent.click(screen.getByRole('button', { name: 'Сохранить' }))
    await waitFor(() => expect(screen.getByRole('textbox')).toHaveValue(''))
    expect(screen.getByRole('status')).toHaveTextContent('Комментарий сохранён.')
    expect(update.mutateAsync).toHaveBeenLastCalledWith({
      id: 'c1',
      input: { body: 'Edited body' },
    })
    expect(screen.getByRole('textbox')).toHaveFocus()
    router.dispose()
  })

  it('retains loaded rows and the draft during a retryable refetch error', () => {
    commentsQuery.data = [sampleComment]
    commentsQuery.error = new Error('refetch failed')
    const router = panel()
    expect(screen.getByText('Test comment')).toBeInTheDocument()
    expect(screen.getByRole('alert')).toHaveTextContent('Не удалось загрузить комментарии')
    fireEvent.click(screen.getByRole('button', { name: 'Повторить' }))
    expect(commentsQuery.refetch).toHaveBeenCalledTimes(1)
    router.dispose()
  })

  it('keeps delete confirmation pending and on failure, cancels without mutation and retries safely', async () => {
    commentsQuery.data = [sampleComment]
    let reject: ((error: Error) => void) | undefined
    remove.mutateAsync.mockImplementationOnce(
      () =>
        new Promise((_, fail) => {
          reject = fail
        }),
    )
    const router = panel()
    fireEvent.click(screen.getByRole('button', { name: 'Удалить комментарий' }))
    fireEvent.click(within(screen.getByRole('alertdialog')).getByRole('button', { name: 'Отмена' }))
    expect(remove.mutateAsync).not.toHaveBeenCalled()
    fireEvent.click(screen.getByRole('button', { name: 'Удалить комментарий' }))
    const dialog = screen.getByRole('alertdialog')
    const confirm = within(dialog).getByRole('button', { name: 'Подтвердить' })
    fireEvent.click(confirm)
    await waitFor(() => expect(remove.mutateAsync).toHaveBeenCalledTimes(1))
    expect(confirm).toBeDisabled()
    expect(within(dialog).getByRole('button', { name: 'Отмена' })).toBeDisabled()
    fireEvent.click(confirm)
    expect(remove.mutateAsync).toHaveBeenCalledTimes(1)
    await act(async () => {
      reject?.(new Error('internal delete detail'))
    })
    expect(within(dialog).getByRole('alert')).toHaveTextContent('Не удалось удалить комментарий')
    commentsQuery.data = []
    remove.mutateAsync.mockResolvedValueOnce(undefined)
    fireEvent.click(confirm)
    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
    expect(screen.getByRole('region', { name: 'Комментарии' })).toHaveFocus()
    expect(screen.getByRole('status')).toHaveTextContent('Комментарий удалён.')
    router.dispose()
  })
})
