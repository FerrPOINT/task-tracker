import { describe, it, expect, vi, beforeAll } from 'vitest'
import { act, render, screen, fireEvent, waitFor, within } from '@testing-library/react'
import { MemoryRouter } from 'react-router'
import { ThemeProvider } from '@sdlc/ui/lib'
import i18n from '@/shared/i18n/config'
import { IssueDescriptionEditor } from './IssueDescriptionEditor'
import type { Issue } from '@/api/issue'

beforeAll(() => {
  i18n.changeLanguage('en')
})

function wrapper(children: React.ReactNode) {
  return (
    <ThemeProvider>
      <MemoryRouter>{children}</MemoryRouter>
    </ThemeProvider>
  )
}

const issue: Issue = {
  id: 'i1',
  key: 'TT-1',
  summary: 'Fix login bug',
  description: 'Login page crashes on submit',
  status: 'Open',
  status_id: 's1',
  priority: 'High',
  project_key: 'TT',
  project_name: 'Task Tracker',
  reporter_id: 'u1',
  issue_type: 'Bug',
  labels: [],
  time_spent_seconds: 0,
  created_at: '2026-01-01T00:00:00Z',
  updated_at: '2026-01-01T00:00:00Z',
  assignee_id: null,
  assignee_name: null,
  reporter_name: null,
  sprint_id: null,
}

describe('IssueDescriptionEditor', () => {
  it('renders summary and description in view mode', () => {
    render(
      wrapper(
        <IssueDescriptionEditor issue={issue} onSubmit={vi.fn()} onProtectionChange={vi.fn()} />,
      ),
    )
    expect(screen.getByText('Fix login bug')).toBeInTheDocument()
    expect(screen.getByText('Login page crashes on submit')).toBeInTheDocument()
    expect(screen.queryByRole('button', { name: /show full description/i })).not.toBeInTheDocument()
  })

  it('expands a long mobile description without entering edit mode', () => {
    const longIssue = { ...issue, description: `${'Long description '.repeat(35)}END_MARKER` }
    render(
      wrapper(
        <IssueDescriptionEditor
          issue={longIssue}
          onSubmit={vi.fn()}
          onProtectionChange={vi.fn()}
        />,
      ),
    )

    const expand = screen.getByRole('button', { name: /show full description/i })
    const mobileDescription = document.getElementById(expand.getAttribute('aria-controls') ?? '')
    expect(expand).toHaveAttribute('aria-expanded', 'false')
    expect(mobileDescription).not.toHaveTextContent('END_MARKER')

    fireEvent.click(expand)
    expect(screen.getByRole('button', { name: /collapse description/i })).toHaveAttribute(
      'aria-expanded',
      'true',
    )
    expect(mobileDescription).toHaveTextContent('END_MARKER')
    expect(screen.queryByDisplayValue(longIssue.summary)).not.toBeInTheDocument()
  })

  it('enters edit mode on click', () => {
    render(
      wrapper(
        <IssueDescriptionEditor issue={issue} onSubmit={vi.fn()} onProtectionChange={vi.fn()} />,
      ),
    )
    fireEvent.click(screen.getByText('Fix login bug'))
    expect(screen.getByDisplayValue('Fix login bug')).toBeInTheDocument()
    expect(screen.getByRole('button', { name: /save/i })).toBeInTheDocument()
  })

  it('retains the edited summary and description when saving fails', async () => {
    const onSubmit = vi.fn().mockRejectedValue(new Error('Save failed'))
    render(
      wrapper(
        <IssueDescriptionEditor issue={issue} onSubmit={onSubmit} onProtectionChange={vi.fn()} />,
      ),
    )
    fireEvent.click(screen.getByRole('button', { name: /edit/i }))
    const summary = screen.getByRole('textbox', { name: /summary/i })
    fireEvent.change(summary, { target: { value: 'Revised summary' } })
    fireEvent.click(screen.getByRole('button', { name: /save/i }))
    await waitFor(() => expect(onSubmit).toHaveBeenCalledOnce())
    expect(await screen.findByRole('alert')).toHaveTextContent('Could not save the issue')
    expect(summary).toHaveValue('Revised summary')
    expect(screen.getByRole('button', { name: /save/i })).toBeEnabled()
  })

  it('does not bypass disabled through the title or description wrapper', () => {
    render(
      wrapper(
        <IssueDescriptionEditor
          issue={issue}
          disabled
          onSubmit={vi.fn()}
          onProtectionChange={vi.fn()}
        />,
      ),
    )
    fireEvent.click(screen.getByText(issue.summary))
    fireEvent.click(screen.getByText(issue.description!))
    expect(screen.getByRole('button', { name: /edit/i })).toBeDisabled()
    expect(screen.queryByRole('textbox')).not.toBeInTheDocument()
  })

  it('retains a dirty draft on cancelled discard and restores focus; explicit discard resets it', async () => {
    const onSubmit = vi.fn()
    render(
      wrapper(
        <IssueDescriptionEditor issue={issue} onSubmit={onSubmit} onProtectionChange={vi.fn()} />,
      ),
    )
    fireEvent.click(screen.getByRole('button', { name: /edit/i }))
    const summary = screen.getByLabelText('Summary')
    fireEvent.change(summary, { target: { value: 'Draft' } })
    fireEvent.change(screen.getByRole('textbox', { name: 'Description' }), {
      target: { value: 'Description draft' },
    })
    fireEvent.click(screen.getByRole('button', { name: /cancel/i }))
    fireEvent.click(
      within(screen.getByRole('alertdialog')).getByRole('button', { name: /cancel/i }),
    )
    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
    expect(summary).toHaveValue('Draft')
    expect(screen.getByRole('textbox', { name: 'Description' })).toHaveValue('Description draft')
    await waitFor(() => expect(summary).toHaveFocus())
    fireEvent.click(screen.getByRole('button', { name: /cancel/i }))
    fireEvent.click(
      within(screen.getByRole('alertdialog')).getByRole('button', { name: /confirm/i }),
    )
    await waitFor(() => expect(screen.queryByRole('textbox')).not.toBeInTheDocument())
    await waitFor(() => expect(screen.getByRole('button', { name: /edit/i })).toHaveFocus())
    fireEvent.click(screen.getByRole('button', { name: /edit/i }))
    expect(screen.getByLabelText('Summary')).toHaveValue(issue.summary)
    expect(screen.getByRole('textbox', { name: 'Description' })).toHaveValue(issue.description)
    expect(onSubmit).not.toHaveBeenCalled()
  })

  it('allows clean cancellation without a confirmation', () => {
    render(
      wrapper(
        <IssueDescriptionEditor issue={issue} onSubmit={vi.fn()} onProtectionChange={vi.fn()} />,
      ),
    )
    fireEvent.click(screen.getByRole('button', { name: /edit/i }))
    fireEvent.click(screen.getByRole('button', { name: /cancel/i }))
    expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument()
    expect(screen.queryByRole('textbox')).not.toBeInTheDocument()
  })

  it('blocks handler and controls during an external issue mutation without losing the draft', async () => {
    const onSubmit = vi.fn()
    const protection = vi.fn()
    const page = render(
      wrapper(
        <IssueDescriptionEditor
          issue={issue}
          onSubmit={onSubmit}
          onProtectionChange={protection}
        />,
      ),
    )
    fireEvent.click(screen.getByRole('button', { name: /edit/i }))
    const summary = screen.getByLabelText('Summary')
    fireEvent.change(summary, { target: { value: 'Retained draft' } })
    page.rerender(
      wrapper(
        <IssueDescriptionEditor
          issue={issue}
          disabled
          onSubmit={onSubmit}
          onProtectionChange={protection}
        />,
      ),
    )
    fireEvent.submit(summary.closest('form')!)
    expect(onSubmit).not.toHaveBeenCalled()
    expect(summary).toBeDisabled()
    expect(screen.getByRole('button', { name: /cancel/i })).toBeDisabled()
    expect(protection).toHaveBeenLastCalledWith({ dirty: true, pending: true })
    page.rerender(
      wrapper(
        <IssueDescriptionEditor
          issue={issue}
          onSubmit={onSubmit}
          onProtectionChange={protection}
        />,
      ),
    )
    expect(summary).toBeEnabled()
    expect(summary).toHaveValue('Retained draft')
  })

  it('atomically blocks repeated submissions, reports pending and locks all fields until success', async () => {
    let finish!: () => void
    const onSubmit = vi.fn(
      () =>
        new Promise<void>((resolve) => {
          finish = resolve
        }),
    )
    const protection = vi.fn()
    const page = render(
      wrapper(
        <IssueDescriptionEditor
          issue={issue}
          onSubmit={onSubmit}
          onProtectionChange={protection}
        />,
      ),
    )
    fireEvent.click(screen.getByRole('button', { name: /edit/i }))
    const summary = screen.getByLabelText('Summary')
    fireEvent.change(summary, { target: { value: 'Saved summary' } })
    fireEvent.change(screen.getByRole('textbox', { name: 'Description' }), {
      target: { value: '  Saved description  ' },
    })
    const form = summary.closest('form')!
    fireEvent.submit(form)
    fireEvent.submit(form)
    await waitFor(() => expect(onSubmit).toHaveBeenCalledOnce())
    expect(summary).toBeDisabled()
    expect(screen.getByRole('textbox', { name: 'Description' })).toBeDisabled()
    expect(screen.getByRole('button', { name: /cancel/i })).toBeDisabled()
    expect(protection).toHaveBeenLastCalledWith({ dirty: true, pending: true })
    await act(async () => finish())
    await waitFor(() => expect(screen.queryByRole('textbox')).not.toBeInTheDocument())
    expect(onSubmit).toHaveBeenCalledWith({
      summary: 'Saved summary',
      description: 'Saved description',
    })
    expect(protection).toHaveBeenLastCalledWith({ dirty: false, pending: false })
    page.unmount()
    expect(protection).toHaveBeenLastCalledWith({ dirty: false, pending: false })
  })

  it('does not replace a dirty draft with refetched server data, and retry succeeds', async () => {
    const onSubmit = vi
      .fn()
      .mockRejectedValueOnce(new Error('private backend diagnostic'))
      .mockResolvedValue({})
    const protection = vi.fn()
    const page = render(
      wrapper(
        <IssueDescriptionEditor
          issue={issue}
          onSubmit={onSubmit}
          onProtectionChange={protection}
        />,
      ),
    )
    fireEvent.click(screen.getByRole('button', { name: /edit/i }))
    fireEvent.change(screen.getByLabelText('Summary'), { target: { value: 'Draft' } })
    page.rerender(
      wrapper(
        <IssueDescriptionEditor
          issue={{ ...issue, summary: 'Refetched title' }}
          onSubmit={onSubmit}
          onProtectionChange={protection}
        />,
      ),
    )
    expect(screen.getByLabelText('Summary')).toHaveValue('Draft')
    fireEvent.click(screen.getByRole('button', { name: /save/i }))
    expect(await screen.findByRole('alert')).not.toHaveTextContent('private backend')
    expect(screen.getByLabelText('Summary')).toHaveValue('Draft')
    fireEvent.click(screen.getByRole('button', { name: /save/i }))
    await waitFor(() => expect(screen.queryByRole('textbox')).not.toBeInTheDocument())
    expect(onSubmit).toHaveBeenCalledTimes(2)
  })

  it.each([
    ['summary', '   ', /summary is required/i],
    ['summary', 'x'.repeat(501), /500 characters/i],
    ['description', 'x'.repeat(100001), /100,000 characters/i],
  ])(
    'validates %s API bounds without a request and associates the error',
    async (field, value, message) => {
      const onSubmit = vi.fn()
      render(
        wrapper(
          <IssueDescriptionEditor issue={issue} onSubmit={onSubmit} onProtectionChange={vi.fn()} />,
        ),
      )
      fireEvent.click(screen.getByRole('button', { name: /edit/i }))
      const input = screen.getByRole('textbox', {
        name: field === 'summary' ? 'Summary' : 'Description',
      })
      fireEvent.change(input, { target: { value } })
      fireEvent.click(screen.getByRole('button', { name: /save/i }))
      expect(await screen.findByRole('alert')).toHaveTextContent(message)
      expect(input).toHaveAttribute('aria-invalid', 'true')
      expect(document.getElementById(input.getAttribute('aria-describedby')!)).toHaveTextContent(
        message,
      )
      expect(onSubmit).not.toHaveBeenCalled()
      expect(input).toHaveValue(value)
    },
  )

  it('counts Unicode code points like the API and sends an empty description as null', async () => {
    const onSubmit = vi.fn().mockResolvedValue({})
    render(
      wrapper(
        <IssueDescriptionEditor issue={issue} onSubmit={onSubmit} onProtectionChange={vi.fn()} />,
      ),
    )
    fireEvent.click(screen.getByRole('button', { name: /edit/i }))
    fireEvent.change(screen.getByLabelText('Summary'), { target: { value: '😀'.repeat(500) } })
    fireEvent.change(screen.getByRole('textbox', { name: 'Description' }), {
      target: { value: '   ' },
    })
    fireEvent.click(screen.getByRole('button', { name: /save/i }))
    await waitFor(() =>
      expect(onSubmit).toHaveBeenCalledWith({ summary: '😀'.repeat(500), description: null }),
    )
  })
})
