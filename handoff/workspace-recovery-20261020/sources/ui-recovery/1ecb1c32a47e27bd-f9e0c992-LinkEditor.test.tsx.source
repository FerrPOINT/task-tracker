import { describe, it, expect, vi, beforeAll, beforeEach } from 'vitest'
import { act, render, screen, fireEvent, waitFor, within } from '@testing-library/react'
import { MemoryRouter } from 'react-router'
import { ThemeProvider } from '@sdlc/ui/lib'
import i18n from '@/shared/i18n/config'
import { LinkEditor } from './LinkEditor'
import { IssueLinkMutationError, type IssueLink } from '@/api/link'

beforeAll(() => {
  i18n.changeLanguage('en')
})

const mocks = vi.hoisted(() => ({
  query: vi.fn(),
  create: vi.fn(),
  remove: vi.fn(),
  refetch: vi.fn(),
  protection: vi.fn(),
}))
vi.mock('@/shared/api/hooks', () => ({
  useIssueLinks: () => mocks.query(),
  useCreateIssueLink: () => ({ mutateAsync: mocks.create, isPending: false }),
  useDeleteIssueLink: () => ({ mutateAsync: mocks.remove, isPending: false }),
}))
const link: IssueLink = {
  id: 'lk1',
  link_type: 'blocks',
  source_id: 'i1',
  source_key: 'TT-1',
  target_id: 'i2',
  target_key: 'TT-2',
}
beforeEach(() => {
  vi.clearAllMocks()
  mocks.create.mockReset().mockResolvedValue(link)
  mocks.remove.mockReset().mockResolvedValue(undefined)
  mocks.refetch.mockReset().mockResolvedValue({ data: [link], error: null })
  mocks.query.mockReturnValue({
    data: [link],
    isLoading: false,
    error: null,
    refetch: mocks.refetch,
  })
})

function wrapper(children: React.ReactNode) {
  return (
    <ThemeProvider>
      <MemoryRouter>{children}</MemoryRouter>
    </ThemeProvider>
  )
}

describe('LinkEditor', () => {
  it('renders existing issue links', () => {
    renderEditor()
    expect(screen.getByTestId('link-editor')).toBeInTheDocument()
    expect(screen.getByText('TT-2')).toBeInTheDocument()
  })

  it('links to the related issue UUID, not its display key', () => {
    renderEditor()
    expect(screen.getByRole('link', { name: 'TT-2' })).toHaveAttribute('href', '/issues/i2')
  })

  it('shows add link form on button click', () => {
    renderEditor()
    fireEvent.click(screen.getByText(/add link/i))
    expect(screen.getByTestId('link-target-input')).toBeInTheDocument()
    expect(screen.getByTestId('link-submit')).toBeInTheDocument()
  })

  it('separates loading and failure from empty, retries and keeps stale links read-only', () => {
    mocks.query.mockReturnValue({
      data: undefined,
      isLoading: true,
      error: null,
      refetch: mocks.refetch,
    })
    const view = renderEditor()
    expect(screen.getByRole('status')).toBeInTheDocument()
    expect(screen.queryByText('No links')).not.toBeInTheDocument()
    expect(screen.getByRole('button', { name: 'Add link' })).toBeDisabled()
    mocks.query.mockReturnValue({
      data: [link],
      isLoading: false,
      error: new Error('private diagnostic'),
      refetch: mocks.refetch,
    })
    view.rerender(
      wrapper(<LinkEditor issueId="i1" currentKey="TT-1" onProtectionChange={mocks.protection} />),
    )
    expect(screen.getByRole('link', { name: 'TT-2' })).toBeInTheDocument()
    expect(screen.getByRole('alert')).not.toHaveTextContent('private diagnostic')
    expect(screen.queryByText('No links')).not.toBeInTheDocument()
    expect(screen.getByRole('button', { name: 'Remove link to TT-2' })).toBeDisabled()
    fireEvent.click(screen.getByRole('button', { name: 'Retry' }))
    expect(mocks.refetch).toHaveBeenCalledOnce()
  })

  it('validates blank and self-link without a request and associates the error', async () => {
    renderEditor()
    openForm()
    const input = screen.getByLabelText('Issue key')
    fireEvent.submit(input.closest('form')!)
    expect(await screen.findByRole('alert')).toHaveTextContent('Enter an issue key')
    expect(input).toHaveAttribute('aria-invalid', 'true')
    expect(input).toHaveAttribute('aria-describedby', screen.getByRole('alert').id)
    fireEvent.change(input, { target: { value: ' TT-0001 ' } })
    fireEvent.submit(input.closest('form')!)
    expect(await screen.findByRole('alert')).toHaveTextContent('cannot be linked to itself')
    expect(mocks.create).not.toHaveBeenCalled()
  })

  it('locks fields, cancel and repeated submit synchronously, reports pending, and closes only after success', async () => {
    let finish!: (value: IssueLink) => void
    mocks.create.mockImplementationOnce(
      () =>
        new Promise<IssueLink>((resolve) => {
          finish = resolve
        }),
    )
    renderEditor()
    openForm(' TT-3 ')
    const input = screen.getByLabelText('Issue key')
    const form = input.closest('form')!
    fireEvent.submit(form)
    fireEvent.submit(form)
    await waitFor(() => expect(mocks.create).toHaveBeenCalledOnce())
    expect(mocks.create).toHaveBeenCalledWith({ targetKey: 'TT-3', linkType: 'relates' })
    expect(input).toBeDisabled()
    expect(screen.getByLabelText('Link type')).toBeDisabled()
    expect(screen.getByRole('button', { name: 'Cancel' })).toBeDisabled()
    expect(mocks.protection).toHaveBeenLastCalledWith({ dirty: true, pending: true })
    expect(input).toHaveValue(' TT-3 ')
    await act(async () => finish(link))
    await waitFor(() => expect(screen.queryByLabelText('Issue key')).not.toBeInTheDocument())
    expect(mocks.protection).toHaveBeenLastCalledWith({ dirty: false, pending: false })
  })

  it.each([
    [404, 'source or linked issue was not found'],
    [409, 'already exists'],
    [400, 'Check the issue key and link type'],
    [403, 'Could not add the link'],
  ])('maps a rejected %s to an honest error and retains both fields', async (status, message) => {
    mocks.create.mockRejectedValueOnce(new IssueLinkMutationError(status as number))
    renderEditor()
    openForm('TT-3')
    fireEvent.change(screen.getByLabelText('Link type'), { target: { value: 'duplicates' } })
    fireEvent.click(screen.getByTestId('link-submit'))
    expect(await screen.findByRole('alert')).toHaveTextContent(message as string)
    expect(screen.getByLabelText('Issue key')).toHaveValue('TT-3')
    expect(screen.getByLabelText('Link type')).toHaveValue('duplicates')
    expect(screen.getByLabelText('Issue key')).not.toBeDisabled()
    fireEvent.click(screen.getByTestId('link-submit'))
    await waitFor(() => expect(mocks.create).toHaveBeenCalledTimes(2))
  })

  it('never repeats an unknown creation until GET proves absence, preserving draft on failed verification', async () => {
    mocks.create.mockRejectedValueOnce(new IssueLinkMutationError(500))
    mocks.refetch
      .mockResolvedValueOnce({ error: new Error('private'), data: [link] })
      .mockResolvedValueOnce({ data: [link], error: null })
    renderEditor()
    openForm('TT-3')
    fireEvent.click(screen.getByTestId('link-submit'))
    expect(await screen.findByRole('alert')).toHaveTextContent('server outcome is unknown')
    expect(screen.getByLabelText('Issue key')).toBeDisabled()
    fireEvent.click(screen.getByRole('button', { name: 'Check result' }))
    expect(await screen.findByRole('alert')).toHaveTextContent('No change was repeated')
    expect(mocks.create).toHaveBeenCalledOnce()
    fireEvent.click(screen.getByRole('button', { name: 'Check result' }))
    expect(await screen.findByRole('alert')).toHaveTextContent('not found on the server')
    expect(screen.getByLabelText('Issue key')).toHaveValue('TT-3')
    expect(screen.getByLabelText('Issue key')).not.toBeDisabled()
    expect(mocks.create).toHaveBeenCalledOnce()
    fireEvent.click(screen.getByTestId('link-submit'))
    await waitFor(() => expect(mocks.create).toHaveBeenCalledTimes(2))
  })

  it('reconciles an unknown symmetric relates creation without repeating POST', async () => {
    mocks.create.mockRejectedValueOnce(new TypeError('network private'))
    mocks.refetch.mockResolvedValueOnce({
      data: [
        {
          ...link,
          link_type: 'relates',
          source_id: 'i3',
          source_key: 'TT-3',
          target_id: 'i1',
          target_key: 'TT-1',
        },
      ],
      error: null,
    })
    renderEditor()
    openForm('TT-0003')
    fireEvent.click(screen.getByTestId('link-submit'))
    await screen.findByRole('button', { name: 'Check result' })
    fireEvent.click(screen.getByRole('button', { name: 'Check result' }))
    await waitFor(() => expect(screen.queryByLabelText('Issue key')).not.toBeInTheDocument())
    expect(mocks.create).toHaveBeenCalledOnce()
  })

  it('protects local cancel, returns focus when retaining the draft, and resets only on explicit discard', async () => {
    renderEditor()
    openForm('TT-3')
    fireEvent.click(screen.getByRole('button', { name: 'Cancel' }))
    const dialog = await screen.findByRole('alertdialog')
    fireEvent.click(within(dialog).getByRole('button', { name: 'Cancel' }))
    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
    expect(screen.getByLabelText('Issue key')).toHaveValue('TT-3')
    await waitFor(() => expect(screen.getByLabelText('Issue key')).toHaveFocus())
    fireEvent.click(screen.getByRole('button', { name: 'Cancel' }))
    fireEvent.click(
      within(await screen.findByRole('alertdialog')).getByRole('button', { name: 'Confirm' }),
    )
    await waitFor(() => expect(screen.queryByLabelText('Issue key')).not.toBeInTheDocument())
    expect(mocks.create).not.toHaveBeenCalled()
    openForm()
    expect(screen.getByLabelText('Issue key')).toHaveValue('')
  })

  it('cancels removal with zero DELETEs and keeps a rejected removal open for retry', async () => {
    mocks.remove.mockRejectedValueOnce(new IssueLinkMutationError(403))
    renderEditor()
    fireEvent.click(screen.getByRole('button', { name: 'Remove link to TT-2' }))
    fireEvent.click(
      within(await screen.findByRole('alertdialog')).getByRole('button', { name: 'Cancel' }),
    )
    expect(mocks.remove).not.toHaveBeenCalled()
    fireEvent.click(screen.getByRole('button', { name: 'Remove link to TT-2' }))
    fireEvent.click(
      within(await screen.findByRole('alertdialog')).getByRole('button', { name: 'Confirm' }),
    )
    const alert = await screen.findByRole('alert')
    expect(alert).toHaveTextContent('Could not remove')
    expect(screen.getByRole('alertdialog')).toBeInTheDocument()
    fireEvent.click(
      within(screen.getByRole('alertdialog')).getByRole('button', { name: 'Confirm' }),
    )
    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
    expect(mocks.remove).toHaveBeenCalledTimes(2)
  })

  it('blocks repeated delete and cancel while pending', async () => {
    let finish!: () => void
    mocks.remove.mockImplementationOnce(
      () =>
        new Promise<void>((resolve) => {
          finish = resolve
        }),
    )
    renderEditor()
    fireEvent.click(screen.getByRole('button', { name: 'Remove link to TT-2' }))
    const dialog = await screen.findByRole('alertdialog')
    fireEvent.click(within(dialog).getByRole('button', { name: 'Confirm' }))
    fireEvent.click(within(dialog).getByRole('button', { name: 'Confirm' }))
    expect(mocks.remove).toHaveBeenCalledOnce()
    expect(within(dialog).getByRole('button', { name: 'Cancel' })).toBeDisabled()
    expect(mocks.protection).toHaveBeenLastCalledWith({ dirty: false, pending: true })
    await act(async () => finish())
    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
  })

  it('reconciles unknown DELETE to absence without repeating it', async () => {
    mocks.remove.mockRejectedValueOnce(new IssueLinkMutationError(500))
    mocks.refetch.mockResolvedValueOnce({ data: [], error: null })
    renderEditor()
    fireEvent.click(screen.getByRole('button', { name: 'Remove link to TT-2' }))
    fireEvent.click(
      within(await screen.findByRole('alertdialog')).getByRole('button', { name: 'Confirm' }),
    )
    fireEvent.click(await screen.findByRole('button', { name: 'Check result' }))
    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
    expect(mocks.remove).toHaveBeenCalledOnce()
  })

  it('retains draft during query refresh and cleans up the owner protection on unmount', () => {
    const view = renderEditor()
    openForm('TT-3')
    mocks.query.mockReturnValue({ data: [], isLoading: false, error: null, refetch: mocks.refetch })
    view.rerender(
      wrapper(<LinkEditor issueId="i1" currentKey="TT-1" onProtectionChange={mocks.protection} />),
    )
    expect(screen.getByLabelText('Issue key')).toHaveValue('TT-3')
    view.unmount()
    expect(mocks.protection).toHaveBeenLastCalledWith({ dirty: false, pending: false })
  })

  it('keeps unknown removal open through failed GET and only enables explicit retry after presence is confirmed', async () => {
    mocks.remove.mockRejectedValueOnce(new IssueLinkMutationError(500))
    mocks.refetch
      .mockResolvedValueOnce({ error: new Error('private'), data: [link] })
      .mockResolvedValueOnce({ data: [link], error: null })
    renderEditor()
    fireEvent.click(screen.getByRole('button', { name: 'Remove link to TT-2' }))
    fireEvent.click(
      within(await screen.findByRole('alertdialog')).getByRole('button', { name: 'Confirm' }),
    )
    fireEvent.click(await screen.findByRole('button', { name: 'Check result' }))
    expect(await screen.findByRole('alert')).toHaveTextContent('No change was repeated')
    expect(mocks.remove).toHaveBeenCalledOnce()
    fireEvent.click(screen.getByRole('button', { name: 'Check result' }))
    expect(await screen.findByRole('alert')).toHaveTextContent('still on the server')
    expect(mocks.remove).toHaveBeenCalledOnce()
    fireEvent.click(
      within(screen.getByRole('alertdialog')).getByRole('button', { name: 'Confirm' }),
    )
    await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument())
    expect(mocks.remove).toHaveBeenCalledTimes(2)
  })

  it('never clears a different link direction when verifying an uncertain creation', async () => {
    mocks.create.mockRejectedValueOnce(new IssueLinkMutationError(500))
    mocks.refetch.mockResolvedValueOnce({
      data: [{ ...link, source_id: 'i3', source_key: 'TT-3', target_id: 'i1', target_key: 'TT-1' }],
      error: null,
    })
    renderEditor()
    openForm('TT-3')
    fireEvent.change(screen.getByLabelText('Link type'), { target: { value: 'blocks' } })
    fireEvent.click(screen.getByTestId('link-submit'))
    fireEvent.click(await screen.findByRole('button', { name: 'Check result' }))
    expect(await screen.findByRole('alert')).toHaveTextContent('not found on the server')
    expect(screen.getByLabelText('Issue key')).toHaveValue('TT-3')
    expect(mocks.create).toHaveBeenCalledOnce()
  })
})

function renderEditor() {
  return render(
    wrapper(<LinkEditor issueId="i1" currentKey="TT-1" onProtectionChange={mocks.protection} />),
  )
}
function openForm(key = '') {
  fireEvent.click(screen.getByRole('button', { name: 'Add link' }))
  if (key) fireEvent.change(screen.getByLabelText('Issue key'), { target: { value: key } })
}
