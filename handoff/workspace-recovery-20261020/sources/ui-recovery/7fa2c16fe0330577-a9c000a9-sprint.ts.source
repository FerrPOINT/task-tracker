import { api } from './client'
import { ApiError, InvalidResponseError } from '@sdlc/ui/lib'
import type { components } from './generated'

export type Sprint = components['schemas']['SprintResponse']
export type SprintList = components['schemas']['SprintListResponse']
export type CreateSprintRequest = components['schemas']['CreateSprintRequest']
export type UpdateSprintRequest = components['schemas']['UpdateSprintRequest']
export type MoveIssueToSprintRequest = components['schemas']['MoveIssueToSprintRequest']

function requireSprint(data: Sprint | undefined, status: number | undefined): Sprint {
  if (
    !data ||
    !['id', 'name', 'goal', 'state'].every(
      (field) => typeof data[field as keyof Sprint] === 'string',
    ) ||
    !data.id ||
    !Number.isFinite(data.velocity) ||
    !Array.isArray(data.issue_ids) ||
    !data.issue_ids.every((id) => typeof id === 'string') ||
    ![data.start_date, data.end_date].every(
      (date) => date == null || (typeof date === 'string' && Number.isFinite(Date.parse(date))),
    )
  )
    throw new InvalidResponseError(status ?? 0)
  return data
}

function requireIssue(
  data: components['schemas']['IssueResponse'] | undefined,
  status: number | undefined,
): components['schemas']['IssueResponse'] {
  if (
    !data ||
    !['id', 'key', 'project_key'].every(
      (field) => typeof data[field as keyof typeof data] === 'string',
    ) ||
    !data.id ||
    !(data.sprint_id == null || typeof data.sprint_id === 'string')
  )
    throw new InvalidResponseError(status ?? 0)
  return data
}

export async function listSprints(projectKey: string): Promise<Sprint[]> {
  const { data, error, response } = await api.GET('/api/v1/projects/{project_key}/sprints', {
    params: { path: { project_key: projectKey } },
  })
  const status = response?.status
  if (error || (status !== undefined && status >= 400))
    throw new ApiError(status, 'Failed to load sprints', error)
  if (!data || !Array.isArray(data.sprints)) throw new InvalidResponseError(status ?? 0)
  return data.sprints.map((sprint) => requireSprint(sprint, status))
}

export async function createSprint(projectKey: string, req: CreateSprintRequest): Promise<Sprint> {
  const { data, error, response } = await api.POST('/api/v1/projects/{project_key}/sprints', {
    params: { path: { project_key: projectKey } },
    body: req,
  })
  const status = response?.status
  if (error || (status !== undefined && status >= 400))
    throw new ApiError(status, 'Failed to create sprint', error)
  return requireSprint(data, status)
}

export async function updateSprint(
  projectKey: string,
  sprintId: string,
  req: UpdateSprintRequest,
): Promise<Sprint> {
  const { data, error, response } = await api.PATCH(
    '/api/v1/projects/{project_key}/sprints/{sprint_id}',
    {
      params: { path: { project_key: projectKey, sprint_id: sprintId } },
      body: req,
    },
  )
  const status = response?.status
  if (error || (status !== undefined && status >= 400))
    throw new ApiError(status, 'Failed to update sprint', error)
  return requireSprint(data, status)
}

export async function startSprint(projectKey: string, sprintId: string): Promise<Sprint> {
  const { data, error, response } = await api.POST(
    '/api/v1/projects/{project_key}/sprints/{sprint_id}/start',
    {
      params: { path: { project_key: projectKey, sprint_id: sprintId } },
    },
  )
  const status = response?.status
  if (error || (status !== undefined && status >= 400))
    throw new ApiError(status, 'Failed to start sprint', error)
  return requireSprint(data, status)
}

export async function closeSprint(projectKey: string, sprintId: string): Promise<Sprint> {
  const { data, error, response } = await api.POST(
    '/api/v1/projects/{project_key}/sprints/{sprint_id}/close',
    {
      params: { path: { project_key: projectKey, sprint_id: sprintId } },
    },
  )
  const status = response?.status
  if (error || (status !== undefined && status >= 400))
    throw new ApiError(status, 'Failed to close sprint', error)
  return requireSprint(data, status)
}

export async function moveIssueToSprint(
  projectKey: string,
  sprintId: string,
  issueId: string,
): Promise<components['schemas']['IssueResponse']> {
  const { data, error, response } = await api.POST(
    '/api/v1/projects/{project_key}/sprints/{sprint_id}/issues',
    {
      params: { path: { project_key: projectKey, sprint_id: sprintId } },
      body: { issue_id: issueId },
    },
  )
  const status = response?.status
  if (error || (status !== undefined && status >= 400))
    throw new ApiError(status, 'Failed to move issue to sprint', error)
  return requireIssue(data, status)
}

export async function removeIssueFromSprint(
  projectKey: string,
  sprintId: string,
  issueId: string,
): Promise<components['schemas']['IssueResponse']> {
  const { data, error, response } = await api.POST(
    '/api/v1/projects/{project_key}/sprints/{sprint_id}/remove-issue',
    {
      params: { path: { project_key: projectKey, sprint_id: sprintId } },
      body: { issue_id: issueId },
    },
  )
  const status = response?.status
  if (error || (status !== undefined && status >= 400))
    throw new ApiError(status, 'Failed to remove issue from sprint', error)
  return requireIssue(data, status)
}
