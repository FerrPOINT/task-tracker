import { Link, useLocation, useNavigate, useParams, useSearchParams } from 'react-router'
import { useQueryClient } from '@tanstack/react-query'
import { useEffect, useRef, useState, useSyncExternalStore, type ReactNode } from 'react'
import { useTranslation } from 'react-i18next'
import { Copy, UserPlus, MoreHorizontal, RotateCcw } from 'lucide-react'
import { toast } from 'sonner'
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@sdlc/ui/ui'
import { Card, CardContent, CardHeader, CardTitle } from '@sdlc/ui/ui'
import { Button } from '@sdlc/ui/ui'
import { ConfirmDialog, UnsavedChangesGuard } from '@sdlc/ui/ui'
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
  LoadingState,
  ErrorState,
} from '@sdlc/ui/ui'
import {
  useWorklogs,
  useCreateWorklog,
  useUpdateWorklog,
  useDeleteWorklog,
} from '@/features/time-tracking/model/use-worklogs'
import { TimeTrackingPanel } from '@/features/time-tracking/ui/TimeTrackingPanel'
import { WorklogTab } from '@/features/time-tracking/ui/WorklogTab'
import { LogWorkDialog } from '@/features/time-tracking/ui/LogWorkDialog'
import { CommentsPanel } from '@/features/comments/ui/CommentList'
import { useComments } from '@/features/comments/model/use-comments'
import { ActivityFeed } from '@/features/issue-detail/ui/ActivityFeed'
import { AttachmentPanel } from '@/features/issue-detail/ui/AttachmentPanel'
import { LabelEditor } from '@/features/issue-detail/ui/LabelEditor'
import { LinkEditor } from '@/features/issue-detail/ui/LinkEditor'
import { CustomFieldsPanel } from '@/features/issue-detail/ui/CustomFieldsPanel'
import { IssueEngagementPanel } from '@/features/issue-detail/ui/IssueEngagementPanel'
import type { Worklog, LogWorkInput } from '@/entities/worklog/model'
import { useAuthStore } from '@/shared/auth/store'
import { IssueMetaEditor } from '@/features/issue-detail/ui/IssueMetaEditor'
import { IssueDescriptionEditor } from '@/features/issue-detail/ui/IssueDescriptionEditor'
import {
  useBoard,
  useUpdateIssue,
  useDeleteIssue,
  useSprints,
  useIssue,
  invalidateIssueCaches,
} from '@/shared/api/hooks'
import { getIssue, IssueDeleteError, type Issue } from '@/api/issue'

const issueTabs = ['activity', 'comments', 'worklog', 'attachments'] as const
type IssueTab = (typeof issueTabs)[number]

function parseIssueTab(value: string | null): IssueTab {
  return issueTabs.find((tab) => tab === value) ?? 'activity'
}

export function IssueDetailPage() {
  const { id = '' } = useParams()
  const location = useLocation()
  const navigate = useNavigate()
  const queryClient = useQueryClient()
  const ownerKey = `${id}:${location.key}`
  const { t } = useTranslation()
  const [searchParams, setSearchParams] = useSearchParams()
  const tabParam = searchParams.get('tab')
  const activeTab = parseIssueTab(tabParam)
  const latestTab = useRef(activeTab)
  const commentInputRef = useRef<HTMLTextAreaElement>(null)
  const timeInputRef = useRef<HTMLInputElement>(null)
  const attachmentFocusRef = useRef<HTMLDivElement>(null)
  const descriptionInputRef = useRef<HTMLInputElement>(null)
  const linkInputRef = useRef<HTMLInputElement>(null)
  const labelInputRef = useRef<HTMLInputElement>(null)
  const customFieldInputRef = useRef<HTMLElement>(null)
  const issueFocusRef = useRef<HTMLDivElement>(null)
  const currentUserId = useAuthStore((s) => s.userId)
  const [worklogDialog, setWorklogDialog] = useState<{ owner: string; worklog?: Worklog } | null>(
    null,
  )
  const dialogOpen = worklogDialog?.owner === ownerKey
  const editingWorklog = dialogOpen ? worklogDialog?.worklog : undefined
  const [deleteConfirmOpen, setDeleteConfirmOpen] = useState(false)
  const [deleteOwner, setDeleteOwner] = useState<string | null>(null)
  const [deleteSnapshot, setDeleteSnapshot] = useState<Issue | null>(null)
  const [deleteOutcomeUnknown, setDeleteOutcomeUnknown] = useState(false)
  const [deleteCheckFailed, setDeleteCheckFailed] = useState(false)
  const [deleteBusy, setDeleteBusy] = useState(false)
  const deleteLock = useRef(false)
  const deleteTriggerRef = useRef<HTMLButtonElement>(null)
  const [issueDeleted, setIssueDeleted] = useState(false)
  const deleteUnknown = deleteOwner === ownerKey && deleteOutcomeUnknown
  const [commentProtection, setCommentProtection] = useState({ dirty: false, pending: false })
  const [timeProtection, setTimeProtection] = useState({ dirty: false, pending: false })
  const [attachmentProtection, setAttachmentProtection] = useState({ dirty: false, pending: false })
  const [descriptionProtection, setDescriptionProtection] = useState({
    dirty: false,
    pending: false,
  })
  const [linkProtection, setLinkProtection] = useState({ dirty: false, pending: false })
  const [labelProtection, setLabelProtection] = useState({ dirty: false, pending: false })
  const [customFieldProtection, setCustomFieldProtection] = useState({
    dirty: false,
    pending: false,
  })

  const issueQuery = useIssue(id)
  const boardQuery = useBoard(issueQuery.data?.project_key)
  const sprintsQuery = useSprints(issueQuery.data?.project_key)
  const updateIssue = useUpdateIssue(id)
  const deleteIssueMutation = useDeleteIssue()
  const worklogsQuery = useWorklogs(id)
  const commentsQuery = useComments(id)
  const create = useCreateWorklog(id)
  const update = useUpdateWorklog(id)
  const remove = useDeleteWorklog(id)
  const otherPending =
    commentProtection.pending ||
    timeProtection.pending ||
    attachmentProtection.pending ||
    descriptionProtection.pending ||
    linkProtection.pending ||
    labelProtection.pending ||
    customFieldProtection.pending ||
    create.isPending ||
    update.isPending ||
    remove.isPending
  const deletionPending = deleteBusy || deleteIssueMutation.isPending

  useEffect(() => {
    if (!issueDeleted) return
    queryClient.setQueryData(['issue', id], null)
    queryClient.removeQueries({ queryKey: ['issue', id], exact: true, type: 'inactive' })
    navigate('/')
  }, [issueDeleted, navigate, queryClient, id])

  useEffect(() => {
    latestTab.current = activeTab
  }, [activeTab])

  useEffect(() => {
    const isCanonical = tabParam === null || (activeTab !== 'activity' && tabParam === activeTab)
    if (isCanonical) return

    setSearchParams(
      (current) => {
        const next = new URLSearchParams(current)
        next.delete('tab')
        return next
      },
      { replace: true },
    )
  }, [activeTab, setSearchParams, tabParam])

  const visibleIssue =
    issueQuery.data ??
    (deleteOwner === ownerKey && deleteSnapshot?.id === id && (deletionPending || deleteUnknown)
      ? deleteSnapshot
      : null)
  if (issueQuery.isLoading && !visibleIssue) {
    return <LoadingState message={t('issue.loading')} />
  }

  if (issueQuery.error && !visibleIssue) {
    return <ErrorState message={t('issue.loadError')} onRetry={() => void issueQuery.refetch()} />
  }

  if (!visibleIssue) {
    return <ErrorState message={t('issue.notFound')} />
  }

  const issue = visibleIssue
  const worklogs = worklogsQuery.data ?? []
  const activityLoading = commentsQuery.isLoading || worklogsQuery.isLoading
  const activityError = commentsQuery.error || worklogsQuery.error
  const hasActivityData = Boolean(commentsQuery.data?.length || worklogs.length)

  const handleLogWork = () => {
    if (create.isPending || update.isPending) return
    create.reset()
    update.reset()
    setWorklogDialog({ owner: ownerKey })
  }

  const handleEdit = (worklog: Worklog) => {
    if (create.isPending || update.isPending) return
    create.reset()
    update.reset()
    setWorklogDialog({ owner: ownerKey, worklog })
  }

  const handleSubmit = async (input: LogWorkInput) => {
    if (create.isPending || update.isPending) return
    try {
      if (editingWorklog) await update.mutateAsync({ id: editingWorklog.id, input })
      else await create.mutateAsync(input)
      setWorklogDialog(null)
      toast.success(t('common.saved'))
    } catch (error) {
      toast.error(t('timeTracking.saveError'))
      throw error
    }
  }

  const handleDelete = (worklogId: string) => remove.mutateAsync(worklogId)

  const confirmIssueDelete = async () => {
    if (deleteLock.current || deletionPending || otherPending || issueDeleted) return
    deleteLock.current = true
    setDeleteBusy(true)
    setDeleteCheckFailed(false)
    try {
      if (deleteUnknown) {
        const checked = await getIssue(id)
        if (checked && checked.id !== id) throw new Error('Invalid issue verification response')
        if (checked === null) {
          invalidateIssueCaches(queryClient)
          void queryClient.invalidateQueries({ queryKey: ['trash'] })
          setIssueDeleted(true)
        } else {
          queryClient.setQueryData(['issue', id], checked)
          setDeleteOutcomeUnknown(false)
          deleteIssueMutation.reset()
        }
      } else {
        await deleteIssueMutation.mutateAsync(id)
        setIssueDeleted(true)
      }
    } catch (error) {
      if (deleteUnknown) setDeleteCheckFailed(true)
      else
        setDeleteOutcomeUnknown(
          !(error instanceof IssueDeleteError && error.outcome === 'rejected'),
        )
    } finally {
      deleteLock.current = false
      setDeleteBusy(false)
    }
  }

  const copyKey = async () => {
    try {
      await navigator.clipboard.writeText(issue.key)
      toast.success(t('issue.keyCopied'))
    } catch {
      toast.error(t('issue.copyFailed'))
    }
  }

  const updateActiveTab = (value: string) => {
    const nextTab = parseIssueTab(value)
    if (nextTab === latestTab.current) return
    const next = new URLSearchParams(searchParams)
    if (nextTab === 'activity') next.delete('tab')
    else next.set('tab', nextTab)
    setSearchParams(next)
  }

  return (
    <div
      ref={issueFocusRef}
      role="region"
      aria-label={issue.key}
      tabIndex={-1}
      className="min-w-0 bg-background"
    >
      <UnsavedChangesGuard
        when={
          !issueDeleted &&
          (commentProtection.dirty ||
            timeProtection.dirty ||
            attachmentProtection.dirty ||
            descriptionProtection.dirty ||
            linkProtection.dirty ||
            labelProtection.dirty ||
            customFieldProtection.dirty ||
            deleteUnknown)
        }
        isPending={!issueDeleted && (otherPending || deletionPending)}
        returnFocusRef={{
          // Resolve after DOM changes: focusing a TabsTrigger would reactivate the discarded transition.
          get current() {
            const ref = dialogOpen
              ? timeInputRef
              : descriptionProtection.dirty || descriptionProtection.pending
                ? descriptionInputRef
                : linkProtection.dirty || linkProtection.pending
                  ? linkInputRef
                  : labelProtection.dirty || labelProtection.pending
                    ? labelInputRef
                    : customFieldProtection.dirty || customFieldProtection.pending
                      ? customFieldInputRef
                      : activeTab === 'attachments'
                        ? attachmentFocusRef
                        : commentInputRef
            const target = ref.current
            return target?.isConnected &&
              !target.matches(':disabled,[hidden],[inert]') &&
              !target.closest('[hidden],[inert]')
              ? target
              : issueFocusRef.current
          },
        }}
      />
      {deleteUnknown && !deleteConfirmOpen && (
        <div className="mb-4 space-y-2">
          <p role="alert" className="text-sm text-danger">
            {t('issue.deleteUnknown')}
          </p>
          <Button onClick={() => setDeleteConfirmOpen(true)}>{t('issue.checkDelete')}</Button>
        </div>
      )}
      <fieldset disabled={deletionPending || deleteUnknown || issueDeleted} className="min-w-0">
        {issueQuery.error && (
          <ErrorState message={t('issue.refreshError')} onRetry={() => void issueQuery.refetch()} />
        )}
        <div className="mb-2 text-sm text-text-muted">
          <Link
            to={`/projects/${issue.project_key}/board`}
            className="inline-flex min-h-6 items-center rounded-sm hover:text-accent hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus"
          >
            {issue.project_name}
          </Link>{' '}
          / {issue.key}
        </div>

        <div className="mb-4 flex flex-wrap items-center justify-between gap-3">
          <span className="rounded bg-accent/20 px-2 py-0.5 text-xs font-medium text-text-primary">
            {t(`issueType.${issue.issue_type.toLowerCase()}`, { defaultValue: issue.issue_type })}
          </span>
          <div className="flex flex-wrap items-center gap-2">
            <Button
              variant="secondary"
              size="sm"
              className="h-10 xl:h-8"
              disabled={
                updateIssue.isPending || !currentUserId || currentUserId === issue.assignee_id
              }
              onClick={() =>
                currentUserId &&
                updateIssue.mutate(
                  { assignee_id: currentUserId },
                  { onError: () => toast.error(t('issue.assignError')) },
                )
              }
            >
              <UserPlus className="h-4 w-4" />
              {t('issue.assignToMe')}
            </Button>
            <DropdownMenu modal={false}>
              <DropdownMenuTrigger asChild>
                <Button
                  variant="secondary"
                  size="icon"
                  ref={deleteTriggerRef}
                  className="h-10 w-10 xl:h-9 xl:w-9"
                  aria-label={t('issue.actions')}
                >
                  <MoreHorizontal className="h-4 w-4" />
                </Button>
              </DropdownMenuTrigger>
              <DropdownMenuContent align="end">
                <DropdownMenuItem onClick={() => void copyKey()} className="gap-2">
                  <Copy className="h-4 w-4" />
                  {t('issue.copyKey')}
                </DropdownMenuItem>
                <DropdownMenuItem
                  disabled={otherPending || deletionPending}
                  onClick={() => {
                    if (otherPending || deletionPending) return
                    if (deleteOwner !== ownerKey) {
                      setDeleteOutcomeUnknown(false)
                      setDeleteCheckFailed(false)
                    }
                    setDeleteOwner(ownerKey)
                    setDeleteSnapshot(issue)
                    deleteIssueMutation.reset()
                    setDeleteConfirmOpen(true)
                  }}
                  className="gap-2 text-danger"
                >
                  {t('issue.delete')}
                </DropdownMenuItem>
              </DropdownMenuContent>
            </DropdownMenu>
          </div>
        </div>

        <IssueDetailLayout
          description={
            <section className="min-w-0 border-t border-border pt-5 lg:col-start-1 lg:row-start-1">
              <IssueDescriptionEditor
                // Confirmed same-issue tab navigation must also discard this persistent editor.
                key={`${id}:${location.key}`}
                issue={issue}
                inputRef={descriptionInputRef}
                onProtectionChange={setDescriptionProtection}
                disabled={updateIssue.isPending}
                onSubmit={async (patch) => {
                  await updateIssue.mutateAsync(patch)
                  toast.success(t('common.saved'))
                }}
              />
            </section>
          }
          details={
            <Card>
              <CardHeader>
                <CardTitle className="text-sm">{t('issue.details')}</CardTitle>
              </CardHeader>
              <CardContent className="text-sm">
                <IssueMetaEditor
                  issue={issue}
                  columns={boardQuery.data?.columns ?? []}
                  sprints={sprintsQuery.data ?? []}
                  disabled={updateIssue.isPending}
                  onChange={(patch) =>
                    updateIssue.mutate(patch, { onError: (error) => toast.error(error.message) })
                  }
                />
              </CardContent>
            </Card>
          }
          activity={
            <div className="min-w-0 space-y-6 lg:col-start-1 lg:row-start-2">
              <Tabs value={activeTab} onValueChange={updateActiveTab} activationMode="manual">
                <TabsList className="grid h-auto w-full grid-cols-2 gap-1 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4">
                  <TabsTrigger className="min-h-10" value="activity">
                    {t('issue.activity')}
                  </TabsTrigger>
                  <TabsTrigger className="min-h-10" value="comments">
                    {t('issue.comments')}
                  </TabsTrigger>
                  <TabsTrigger className="min-h-10" value="worklog">
                    {t('timeTracking.worklog.title')}
                  </TabsTrigger>
                  <TabsTrigger className="min-h-10" value="attachments">
                    {t('attachments.title')}
                  </TabsTrigger>
                </TabsList>
                <TabsContent value="activity">
                  {commentsQuery.error && (
                    <ErrorState
                      message={t('comments.loadError')}
                      onRetry={() => void commentsQuery.refetch()}
                    />
                  )}
                  {worklogsQuery.error && (
                    <ErrorState
                      message={t('timeTracking.worklog.loadError')}
                      onRetry={() => void worklogsQuery.refetch()}
                    />
                  )}
                  {activityLoading ? (
                    <p className="py-4 text-sm text-text-muted">{t('issue.loadingActivity')}</p>
                  ) : hasActivityData || !activityError ? (
                    <ActivityFeed comments={commentsQuery.data ?? []} worklogs={worklogs} />
                  ) : null}
                </TabsContent>
                <TabsContent value="comments">
                  <CommentsPanel
                    issueId={id}
                    currentUserId={currentUserId ?? undefined}
                    onProtectionChange={setCommentProtection}
                    inputRef={commentInputRef}
                  />
                </TabsContent>
                <TabsContent value="worklog">
                  {worklogsQuery.error && (
                    <ErrorState
                      message={t(
                        worklogsQuery.data !== undefined
                          ? 'timeTracking.worklog.refreshError'
                          : 'timeTracking.worklog.loadError',
                      )}
                      onRetry={() => void worklogsQuery.refetch()}
                    />
                  )}
                  {!worklogsQuery.error && (
                    <div className="flex justify-end">
                      <Button
                        variant="ghost"
                        size="icon"
                        className="min-h-11 min-w-11 sm:min-h-10 sm:min-w-10"
                        aria-label={t('timeTracking.worklog.refresh')}
                        title={t('timeTracking.worklog.refresh')}
                        disabled={
                          worklogsQuery.isFetching ||
                          create.isPending ||
                          update.isPending ||
                          remove.isPending
                        }
                        onClick={() => void worklogsQuery.refetch()}
                      >
                        <RotateCcw className="h-4 w-4" aria-hidden />
                      </Button>
                    </div>
                  )}
                  {worklogsQuery.isLoading ? (
                    <p className="py-4 text-sm text-text-muted">{t('common.loading')}</p>
                  ) : worklogsQuery.data !== undefined || !worklogsQuery.error ? (
                    <WorklogTab
                      worklogs={worklogs}
                      onEdit={handleEdit}
                      onDelete={handleDelete}
                      currentUserId={currentUserId ?? ''}
                    />
                  ) : null}
                </TabsContent>
                <TabsContent value="attachments">
                  <AttachmentPanel
                    issueId={id}
                    onProtectionChange={setAttachmentProtection}
                    focusRef={attachmentFocusRef}
                  />
                </TabsContent>
              </Tabs>

              <div className="grid gap-4 md:grid-cols-2">
                <Card>
                  <CardContent className="pt-5">
                    <LabelEditor
                      key={`${id}:${location.key}`}
                      issueId={id}
                      projectKey={issue.project_key}
                      onProtectionChange={setLabelProtection}
                      inputRef={labelInputRef}
                    />
                  </CardContent>
                </Card>
                <Card>
                  <CardHeader>
                    <CardTitle className="text-sm">{t('customFields.title')}</CardTitle>
                  </CardHeader>
                  <CardContent>
                    <CustomFieldsPanel
                      key={`${id}:${location.key}`}
                      issueId={id}
                      projectKey={issue.project_key}
                      onProtectionChange={setCustomFieldProtection}
                      inputRef={customFieldInputRef}
                    />
                  </CardContent>
                </Card>
                <Card className="md:col-span-2">
                  <CardContent className="pt-5">
                    <LinkEditor
                      key={`${id}:${location.key}`}
                      issueId={id}
                      currentKey={issue.key}
                      onProtectionChange={setLinkProtection}
                      inputRef={linkInputRef}
                    />
                  </CardContent>
                </Card>
              </div>
            </div>
          }
          supplemental={
            <>
              <Card>
                <CardHeader>
                  <CardTitle className="text-sm">{t('timeTracking.title')}</CardTitle>
                </CardHeader>
                <CardContent>
                  <TimeTrackingPanel
                    timeSpentSeconds={issue.time_spent_seconds}
                    originalEstimateSeconds={issue.original_estimate_seconds ?? null}
                    remainingEstimateSeconds={issue.remaining_estimate_seconds ?? null}
                    onLogWork={handleLogWork}
                  />
                </CardContent>
              </Card>

              <Card>
                <CardHeader>
                  <CardTitle className="text-sm">{t('engagement.title')}</CardTitle>
                </CardHeader>
                <CardContent>
                  <IssueEngagementPanel
                    issueId={id}
                    projectKey={issue.project_key}
                    currentUserId={currentUserId}
                    reporterId={issue.reporter_id}
                  />
                </CardContent>
              </Card>
            </>
          }
        />
      </fieldset>

      <LogWorkDialog
        key={ownerKey}
        open={dialogOpen}
        onOpenChange={(open) => {
          if (!open) setWorklogDialog(null)
        }}
        onSubmit={handleSubmit}
        worklog={editingWorklog}
        isPending={create.isPending || update.isPending}
        error={(create.error ?? update.error) as Error | null}
        onProtectionChange={setTimeProtection}
        inputRef={timeInputRef}
      />
      <ConfirmDialog
        open={deleteOwner === ownerKey && deleteConfirmOpen && !issueDeleted}
        onOpenChange={(open) => {
          if (deletionPending || deleteLock.current) return
          setDeleteConfirmOpen(open)
          if (!open) deleteIssueMutation.reset()
        }}
        returnFocusRef={deleteTriggerRef}
        fallbackFocusRef={issueFocusRef}
        isPending={deletionPending || otherPending}
        error={
          deleteUnknown
            ? t(deleteCheckFailed ? 'issue.deleteCheckError' : 'issue.deleteUnknown')
            : deleteIssueMutation.error
              ? t('issue.deleteError')
              : null
        }
        title={t('issue.delete')}
        description={t('issue.deleteConfirm')}
        confirmLabel={deleteUnknown ? t('issue.checkDelete') : undefined}
        onConfirm={() => void confirmIssueDelete()}
      />
    </div>
  )
}

const desktopLayoutQuery = '(min-width: 1024px)'

function getDesktopLayout() {
  return (
    typeof window !== 'undefined' &&
    typeof window.matchMedia === 'function' &&
    window.matchMedia(desktopLayoutQuery).matches
  )
}

function subscribeDesktopLayout(onChange: () => void) {
  if (typeof window.matchMedia !== 'function') return () => {}
  const query = window.matchMedia(desktopLayoutQuery)
  query.addEventListener('change', onChange)
  return () => query.removeEventListener('change', onChange)
}

function IssueDetailLayout({
  description,
  details,
  activity,
  supplemental,
}: {
  description: ReactNode
  details: ReactNode
  activity: ReactNode
  supplemental: ReactNode
}) {
  const desktop = useSyncExternalStore(subscribeDesktopLayout, getDesktopLayout, () => false)

  return (
    <div
      className={
        desktop
          ? 'grid min-w-0 grid-cols-[minmax(0,1fr)_320px] grid-rows-[min-content_minmax(0,1fr)] gap-6'
          : 'grid min-w-0 gap-4'
      }
    >
      {description}
      {desktop ? (
        <aside className="sticky top-16 col-start-2 row-start-1 row-span-2 self-start space-y-4">
          {details}
          {supplemental}
        </aside>
      ) : (
        details
      )}
      {activity}
      {!desktop && <aside className="space-y-4">{supplemental}</aside>}
    </div>
  )
}
