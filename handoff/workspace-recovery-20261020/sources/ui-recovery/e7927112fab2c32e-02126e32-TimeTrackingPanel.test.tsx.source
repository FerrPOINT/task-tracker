import { describe, it, expect, vi, beforeAll } from 'vitest'
import { render, screen, fireEvent, within } from '@testing-library/react'
import { MemoryRouter } from 'react-router'
import { ThemeProvider } from '@sdlc/ui/lib'
import i18n from '@/shared/i18n/config'
import { TimeTrackingPanel } from './TimeTrackingPanel'

beforeAll(() => {
  i18n.changeLanguage('en')
})

function wrapper(children: React.ReactNode) {
  return (
    <ThemeProvider>
      <MemoryRouter>{children}</MemoryRouter>
    </ThemeProvider>
  )
}

describe('TimeTrackingPanel', () => {
  it('renders time summary with spent and estimated', () => {
    render(
      wrapper(
        <TimeTrackingPanel
          timeSpentSeconds={3600}
          originalEstimateSeconds={7200}
          remainingEstimateSeconds={3600}
          onLogWork={vi.fn()}
        />,
      ),
    )
    const summary = screen.getByTestId('time-tracking-summary')
    expect(summary).toBeInTheDocument()
    expect(summary.textContent).toMatch(/1h/)
    expect(summary.textContent).toMatch(/2h/)
  })

  it('calls onLogWork when log work button is clicked', () => {
    const onLogWork = vi.fn()
    render(
      wrapper(
        <TimeTrackingPanel
          timeSpentSeconds={3600}
          originalEstimateSeconds={7200}
          remainingEstimateSeconds={3600}
          onLogWork={onLogWork}
        />,
      ),
    )
    fireEvent.click(screen.getByRole('button', { name: /log work/i }))
    expect(onLogWork).toHaveBeenCalledOnce()
  })

  it('does not invent an estimate or progress when the issue has none', () => {
    render(
      wrapper(
        <TimeTrackingPanel
          timeSpentSeconds={90}
          originalEstimateSeconds={null}
          remainingEstimateSeconds={null}
          onLogWork={vi.fn()}
        />,
      ),
    )
    const summary = within(screen.getByTestId('time-tracking-summary'))
    expect(summary.getAllByText('1m 30s')).toHaveLength(1)
    expect(summary.getByText('-')).toBeInTheDocument()
    expect(screen.queryByRole('progressbar')).not.toBeInTheDocument()
    expect(summary.queryByText(/over by/i)).not.toBeInTheDocument()
  })

  it('distinguishes an explicit zero estimate from a missing estimate', () => {
    render(
      wrapper(
        <TimeTrackingPanel
          timeSpentSeconds={60}
          originalEstimateSeconds={0}
          remainingEstimateSeconds={0}
          onLogWork={vi.fn()}
        />,
      ),
    )
    const summary = within(screen.getByTestId('time-tracking-summary'))
    expect(summary.queryByText('-')).not.toBeInTheDocument()
    expect(summary.getAllByText('0m')).toHaveLength(2)
    expect(summary.getByText(/over by/i)).toBeInTheDocument()
    expect(screen.queryByRole('progressbar')).not.toBeInTheDocument()
  })
})
