//! Read-time choices only. Status CAS, graph and WIP are rechecked on mutation.
use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use uuid::Uuid;
#[derive(Clone, Debug, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(deny_unknown_fields)]
pub struct IssueVerificationTransition {
    pub status_id: Uuid,
    pub name: String,
    pub is_closed: bool,
}
#[derive(Clone, Debug, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(deny_unknown_fields)]
pub struct IssueVerificationTransitions {
    pub project_id: Uuid,
    pub bug_id: Uuid,
    pub status_id: Uuid,
    pub status_name: String,
    pub updated_at: DateTime<Utc>,
    pub transitions: Vec<IssueVerificationTransition>,
}
