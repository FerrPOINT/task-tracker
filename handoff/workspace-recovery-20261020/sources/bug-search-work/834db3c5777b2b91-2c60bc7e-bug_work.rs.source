#[utoipa::path(get,path="/api/v1/projects/{project_id}/sdlc/bug-intake/work-operations/{idempotency_key}",tag="bug-search",params(("project_id"=Uuid,Path),("idempotency_key"=String,Path)),responses((status=200,body=BugWorkReceipt),(status=401),(status=403),(status=404),(status=503)),security(("bearer"=[])))]
pub async fn operation(
    State(ctx): State<Arc<app::AppContext>>,
    Extension(a): Extension<Principal>,
    Path((p, key)): Path<(Uuid, String)>,
) -> Result<(HeaderMap, Json<BugWorkReceipt>), AppError> {
    Ok((
        no_store(),
        Json(service(&ctx)?.operation(p, &key, &a).await?),
    ))
}
