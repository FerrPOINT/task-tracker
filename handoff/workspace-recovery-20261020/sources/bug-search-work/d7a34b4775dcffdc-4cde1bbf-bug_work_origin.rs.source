//! Real PG source origin, using the parent's fail-closed disposable DB fixture.
use super::work::{claim, consent, picked};
use super::*;
use app::bug_work::BugWorkRepository;
use domain::bug_search_source::{BugTargetSourceIdentity, BugTargetSourceProject};

fn source(f: &Fixture, commit: &str) -> BugTargetSourceIdentity {
    BugTargetSourceIdentity {
        contract_version: 1,
        schema: "forge/source-snapshot/v1".into(),
        producer_version: "synthetic-owner-v1".into(),
        project: BugTargetSourceProject {
            tracker_instance_id: f.config.tracker_instance_uuid,
            project_id: f.project,
        },
        configuration_id: Uuid::new_v4(),
        repository_id: Uuid::new_v4(),
        branch_ref: "refs/heads/main".into(),
        observed_head_sha: commit.into(),
        clone_url_sha256: "d".repeat(64),
    }
}

#[tokio::test]
#[ignore = "Base ComposeHelper v2 disposable PostgreSQL only; TT_BUG_SEARCH_DISPOSABLE_DB=1"]
async fn identical_report_and_commit_across_repositories_create_two_canonical_bugs() {
    let f = Fixture::new().await;
    let seed = f.execution(1, true, false).await;
    let row =
        f.db.query_one(Statement::from_sql_and_values(
            DatabaseBackend::Postgres,
            "SELECT snapshot FROM sdlc_bug_search_executions WHERE execution_id=$1",
            vec![seed.into()],
        ))
        .await
        .unwrap()
        .unwrap();
    let mut snapshot: serde_json::Value = row.try_get("", "snapshot").unwrap();
    let first = source(&f, &"a".repeat(40));
    let second = source(&f, &"a".repeat(40));
    snapshot["targets"][0]["source"] = serde_json::to_value(&first).unwrap();
    let mut t = snapshot["targets"][0].clone();
    t["repository_ref"] = json!("catalog:independent-repo");
    t["source"] = serde_json::to_value(&second).unwrap();
    snapshot["targets"].as_array_mut().unwrap().push(t);
    let execution = Uuid::new_v4();
    sql(&f.db,"INSERT INTO sdlc_bug_search_executions(execution_id,tracker_instance_id,tracker_instance_uuid,project_id,owner_subject,agent_id,purpose,snapshot_sha256,snapshot,policy_revision,fence,machine_subject,grant_ref,admission_state,workflow_receipt,expires_at,capacity_held) SELECT $2,tracker_instance_id,tracker_instance_uuid,project_id,owner_subject,agent_id,purpose,$3,$4,policy_revision,99,machine_subject,$5,admission_state,workflow_receipt,expires_at,false FROM sdlc_bug_search_executions WHERE execution_id=$1",vec![seed.into(),execution.into(),app::bug_search::canonical_hash(&snapshot).unwrap().into(),snapshot.into(),Uuid::new_v4().into()]).await;
    let a = machine(&f.config.fleet_subject);
    let mut original = command(execution, "multi-repository:first");
    original.expected_fence = 99;
    for repository_id in [None, Some(Uuid::nil()), Some(Uuid::new_v4())] {
        let mut bad = original.clone();
        bad.source_identity.repository_id = repository_id;
        assert!(matches!(
            f.repo.register(f.project, &a, bad).await,
            Err(AppError::Validation(_))
        ));
    }
    assert_eq!(f.count("sdlc_bug_occurrences").await, 0);
    let mut left = original.clone();
    left.source_identity.repository_id = Some(first.repository_id);
    let mut wrong = left.clone();
    wrong.report.checked_version = "b".repeat(40);
    assert!(matches!(
        f.repo.register(f.project, &a, wrong).await,
        Err(AppError::Validation(_))
    ));
    let first_receipt = f
        .repo
        .register(f.project, &a, left.clone())
        .await
        .unwrap()
        .0;
    let mut right = original;
    right.idempotency_key = "multi-repository:second".into();
    right.finding_id = Uuid::new_v4();
    right.source_identity.repository_id = Some(second.repository_id);
    let second_receipt = f.repo.register(f.project, &a, right).await.unwrap().0;
    assert_eq!(first_receipt.outcome, BugFindingOutcome::Created);
    assert_eq!(second_receipt.outcome, BugFindingOutcome::Created);
    assert_ne!(first_receipt.issue_id, second_receipt.issue_id);
    assert_ne!(
        first_receipt.source_identity,
        second_receipt.source_identity
    );
    assert_eq!(f.count("sdlc_bug_sources").await, 2);
    assert_eq!(f.count("sdlc_bug_occurrences").await, 2);
    assert_eq!(
        f.repo.register(f.project, &a, left).await.unwrap(),
        (first_receipt, true)
    );
    f.close().await;
}

#[tokio::test]
#[ignore = "Base ComposeHelper v2 disposable PostgreSQL only; TT_BUG_SEARCH_DISPOSABLE_DB=1"]
async fn canonical_bug_origin_is_bounded_exact_multirepo_and_freshly_authorized() {
    let f = Fixture::new().await;
    let seed = f.execution(1, true, false).await;
    let row =
        f.db.query_one(Statement::from_sql_and_values(
            DatabaseBackend::Postgres,
            "SELECT snapshot FROM sdlc_bug_search_executions WHERE execution_id=$1",
            vec![sea_orm::Value::from(seed)],
        ))
        .await
        .unwrap()
        .unwrap();
    let mut snapshot: serde_json::Value = row.try_get("", "snapshot").unwrap();
    snapshot["targets"][0]["source"] = serde_json::to_value(source(&f, &"a".repeat(40))).unwrap();
    let mut second = snapshot["targets"][0].clone();
    second["repository_ref"] = json!("catalog:second");
    second["commit_sha"] = json!("b".repeat(40));
    second["source"] = serde_json::to_value(source(&f, &"b".repeat(40))).unwrap();
    snapshot["targets"].as_array_mut().unwrap().push(second);
    let execution = Uuid::new_v4();
    let snapshot_hash = app::bug_search::canonical_hash(&snapshot).unwrap();
    sql(&f.db,"INSERT INTO sdlc_bug_search_executions(execution_id,tracker_instance_id,tracker_instance_uuid,project_id,owner_subject,agent_id,purpose,snapshot_sha256,snapshot,policy_revision,fence,machine_subject,grant_ref,admission_state,workflow_receipt,expires_at,capacity_held) SELECT $2,tracker_instance_id,tracker_instance_uuid,project_id,owner_subject,agent_id,purpose,$3,$4,policy_revision,99,machine_subject,$5,admission_state,workflow_receipt,expires_at,false FROM sdlc_bug_search_executions WHERE execution_id=$1",vec![seed.into(),execution.into(),snapshot_hash.clone().into(),snapshot.clone().into(),Uuid::new_v4().into()]).await;
    let mut registration = command(execution, "origin:canonical-bug");
    registration.expected_fence = 99;
    registration.source_identity.repository_id = Some(
        Uuid::parse_str(
            snapshot["targets"][0]["source"]["repository_id"]
                .as_str()
                .unwrap(),
        )
        .unwrap(),
    );
    assert_ne!(
        app::bug_search::canonical_hash(&registration.report).unwrap(),
        app::bug_search::canonical_hash(
            &json!({"source_identity":registration.source_identity,"report":registration.report})
        )
        .unwrap()
    );
    let finding = registration.finding_id;
    let a = machine(&f.config.fleet_subject);
    let ticket = f
        .repo
        .register(f.project, &a, registration)
        .await
        .unwrap()
        .0
        .issue_id;
    let fleet = Uuid::new_v4();
    let repo = f
        .reopened()
        .await
        .with_intake_fleet_instance(fleet)
        .unwrap();
    let c = claim(fleet, Uuid::new_v4(), "origin:claim", 7);
    consent(&repo, f.project, &a, &c, 0, true).await;
    let accepted = repo
        .claim_work(f.project, c.worker_runtime.agent_id, &a, c.clone())
        .await
        .unwrap()
        .0;
    let s = picked(&accepted).unwrap();
    assert_eq!(s.assignment.bug_id, ticket);
    let origin = s.assignment.origin.as_ref().unwrap();
    assert_eq!(origin.execution_id, execution);
    assert_eq!(origin.finding_id, finding);
    assert_eq!(origin.snapshot_sha256, snapshot_hash);
    let id = s.assignment.assignment_id;
    let read = repo.work_origin(f.project, id, &a).await.unwrap();
    assert_eq!(read.origin, *origin);
    assert_eq!(read.assignment_sha256, s.assignment_sha256);
    assert_eq!(
        serde_json::to_value(&read.source_context.targets).unwrap(),
        snapshot["targets"]
    );
    assert_eq!(read.source_context.targets.len(), 2);
    assert_eq!(
        read.source_context.targets[0]
            .source
            .as_ref()
            .unwrap()
            .project
            .tracker_instance_id,
        f.config.tracker_instance_uuid
    );
    assert_eq!(
        read.source_context.targets[1]
            .source
            .as_ref()
            .unwrap()
            .observed_head_sha,
        "b".repeat(40)
    );
    assert_ne!(
        read.source_context.targets[0]
            .source
            .as_ref()
            .unwrap()
            .repository_id,
        read.source_context.targets[1]
            .source
            .as_ref()
            .unwrap()
            .repository_id
    );
    assert!(
        serde_json::to_value(&read.source_context.targets[0].source)
            .unwrap()
            .get("clone_url")
            .is_none()
    );
    assert_eq!(
        app::bug_search::canonical_hash(&read.source_context).unwrap(),
        origin.source_context_sha256
    );
    let projection = serde_json::to_value(&read.source_context).unwrap();
    for private in [
        "owner_subject",
        "agent_id",
        "profession",
        "instruction_revision",
        "session_id",
        "credential",
    ] {
        assert!(projection.get(private).is_none());
    }
    let mut reader = machine(&f.config.workflow_reader_subject);
    reader.scopes.remove("task-tracker:write");
    let ci_repo = f
        .reopened()
        .await
        .with_intake_fleet_instance(fleet)
        .unwrap()
        .with_bug_work_ci_reader_subject("dedicated-ci-reader".into())
        .unwrap();
    let mut ci_reader = machine("dedicated-ci-reader");
    ci_reader.scopes.remove("task-tracker:write");
    assert!(matches!(
        repo.work_origin(f.project, id, &ci_reader).await,
        Err(AppError::Forbidden)
    ));
    assert_eq!(
        ci_repo
            .work_origin(f.project, id, &ci_reader)
            .await
            .unwrap(),
        read
    );
    assert_eq!(
        ci_repo
            .work_assignment(f.project, id, &ci_reader)
            .await
            .unwrap()
            .assignment,
        s.assignment
    );
    assert!(matches!(
        ci_repo
            .claim_work(f.project, c.worker_runtime.agent_id, &ci_reader, c.clone())
            .await,
        Err(AppError::Forbidden)
    ));
    assert!(matches!(
        ci_repo
            .current_work(f.project, "owner", c.worker_runtime.agent_id, &ci_reader)
            .await,
        Err(AppError::Forbidden)
    ));
    let mixed_ci = machine("dedicated-ci-reader");
    assert!(matches!(
        ci_repo.work_origin(f.project, id, &mixed_ci).await,
        Err(AppError::Forbidden)
    ));
    let mut human_ci = ci_reader.clone();
    human_ci.human_session = true;
    assert!(matches!(
        ci_repo.work_origin(f.project, id, &human_ci).await,
        Err(AppError::Forbidden)
    ));
    assert_eq!(
        repo.work_origin(f.project, id, &reader).await.unwrap(),
        read
    );
    assert!(matches!(
        repo.work_origin(f.project, id, &machine("unrelated-machine"))
            .await,
        Err(AppError::Forbidden)
    ));
    assert!(repo.work_origin(Uuid::new_v4(), id, &reader).await.is_err());
    assert!(
        repo.claim_work(f.project, c.worker_runtime.agent_id, &a, c)
            .await
            .unwrap()
            .1
    );
    // Missing optional origin preserves the exact old grant body/hash; it is not inferred.
    let mut old = serde_json::to_value(&s.assignment).unwrap();
    old.as_object_mut().unwrap().remove("origin");
    let legacy: domain::bug_work::BugWorkAssignment = serde_json::from_value(old.clone()).unwrap();
    assert!(legacy.origin.is_none());
    assert_eq!(serde_json::to_value(legacy).unwrap(), old);
    sql(
        &f.db,
        "UPDATE users SET is_active=false WHERE id=$1",
        vec![f.owner.into()],
    )
    .await;
    assert!(matches!(
        repo.work_origin(f.project, id, &a).await,
        Err(AppError::Forbidden)
    ));
    assert!(matches!(
        repo.work_origin(f.project, id, &reader).await,
        Err(AppError::Forbidden)
    ));
    assert!(matches!(
        ci_repo.work_origin(f.project, id, &ci_reader).await,
        Err(AppError::Forbidden)
    ));
    f.close().await;
}

#[tokio::test]
#[ignore = "Base ComposeHelper v2 disposable PostgreSQL only; TT_BUG_SEARCH_DISPOSABLE_DB=1"]
async fn original_source_registry_and_branch_are_admission_bound_not_legacy_hash_rewrites() {
    let f = Fixture::new().await;
    let a = machine(&f.config.fleet_subject);
    let mut snapshot = accepted_snapshot(&f, 1);
    let legacy = serde_json::to_value(&snapshot).unwrap();
    let legacy_hash = app::bug_search::canonical_hash(&snapshot).unwrap();
    let policy = accepted_policy(&snapshot);
    f.repo
        .apply_policy(
            f.project,
            &a,
            ApplyBugSearchPolicy {
                idempotency_key: "source-policy".into(),
                owner_subject: "owner".into(),
                expected_revision: 0,
                desired_revision: 1,
                policy,
            },
        )
        .await
        .unwrap();
    snapshot.targets[0].source = Some(source(&f, &snapshot.targets[0].commit_sha));
    let request = ReserveBugSearch {
        idempotency_key: "source-reserve".into(),
        owner_subject: "owner".into(),
        expected_policy_revision: 1,
        expected_due: None,
        agent_id: snapshot.agent_id,
        snapshot_sha256: app::bug_search::canonical_hash(&snapshot).unwrap(),
        snapshot,
    };
    let before = f.count("sdlc_bug_search_commands").await;
    for field in 0..3 {
        let mut bad = request.clone();
        let p = bad.snapshot.targets[0].source.as_mut().unwrap();
        match field {
            0 => p.project.tracker_instance_id = Uuid::new_v4(),
            1 => p.project.project_id = f.foreign,
            _ => p.branch_ref = "refs/heads/remapped".into(),
        }
        bad.snapshot_sha256 = app::bug_search::canonical_hash(&bad.snapshot).unwrap();
        assert!(f.repo.reserve(f.project, &a, bad).await.is_err());
        assert_eq!(f.count("sdlc_bug_search_commands").await, before);
        assert_eq!(f.count("sdlc_bug_search_executions").await, 0);
    }
    let accepted = f
        .repo
        .reserve(f.project, &a, request.clone())
        .await
        .unwrap()
        .0;
    assert_eq!(accepted.binding.snapshot_sha256, request.snapshot_sha256);
    assert!(
        f.repo
            .reserve(f.project, &a, request.clone())
            .await
            .unwrap()
            .1
    );
    let row =
        f.db.query_one(Statement::from_sql_and_values(
            DatabaseBackend::Postgres,
            "SELECT snapshot FROM sdlc_bug_search_executions WHERE execution_id=$1",
            vec![sea_orm::Value::from(accepted.binding.execution_id)],
        ))
        .await
        .unwrap()
        .unwrap();
    let retained: serde_json::Value = row.try_get("", "snapshot").unwrap();
    assert_eq!(retained, serde_json::to_value(&request.snapshot).unwrap());
    let mut old = request.snapshot;
    old.targets[0].source = None;
    assert_eq!(serde_json::to_value(&old).unwrap(), legacy);
    assert_eq!(app::bug_search::canonical_hash(&old).unwrap(), legacy_hash);
    f.close().await;
}
