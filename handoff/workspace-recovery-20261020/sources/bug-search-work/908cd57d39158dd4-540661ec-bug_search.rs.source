//! Only an external Base ComposeHelper v2 disposable DB may run this suite.
#[path = "support/bug_work_business.rs"]
mod business;
#[path = "support/bug_search_intake.rs"]
mod intake;
#[path = "support/issue_verification_transitions.rs"]
mod verification_transitions;
