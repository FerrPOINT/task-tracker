//! Exact optional Fleet repeat guidance; no target/permission authority in text.
use serde::{Deserialize, Serialize};
use shared::AppError;
use uuid::Uuid;
#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(deny_unknown_fields)]
pub struct BugSearchUserGuidance {
    pub parent_execution_id: Uuid,
    pub text: String,
}
impl BugSearchUserGuidance {
    pub fn validate(&self) -> Result<(), AppError> {
        if self.parent_execution_id.is_nil()
            || self.text.trim().is_empty()
            || self.text.len() > 4096
            || self.text.contains('\0')
        {
            return Err(AppError::validation("invalid bounded repeat guidance"));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn repeat_snapshot_is_closed_utf8_bounded_and_preserves_original_none_bytes() {
        let f: serde_json::Value =
            serde_json::from_str(include_str!("../../app/tests/fixtures/bug_search_v1.json"))
                .unwrap();
        let old = f["vectors"][1]["value"].clone();
        let mut s: crate::bug_search_control::BugSearchSnapshot =
            serde_json::from_value(old.clone()).unwrap();
        let original = serde_json::to_value(&s).unwrap();
        assert!(original.get("user_guidance").is_none());
        s.trigger = crate::bug_search_control::BugSearchTrigger::Manual;
        s.user_guidance = Some(BugSearchUserGuidance {
            parent_execution_id: Uuid::new_v4(),
            text: "я".repeat(2048),
        });
        s.validate().unwrap();
        let mut bad = s.user_guidance.clone().unwrap();
        bad.text.push('я');
        assert!(bad.validate().is_err());
        s.trigger = crate::bug_search_control::BugSearchTrigger::Periodic;
        assert!(s.validate().is_err());
        let mut unknown = serde_json::to_value(bad).unwrap();
        unknown["targets"] = serde_json::json!([]);
        assert!(serde_json::from_value::<BugSearchUserGuidance>(unknown).is_err());
        assert_eq!(
            serde_json::to_value(
                serde_json::from_value::<crate::bug_search_control::BugSearchSnapshot>(old)
                    .unwrap()
            )
            .unwrap(),
            original
        );
    }
}
