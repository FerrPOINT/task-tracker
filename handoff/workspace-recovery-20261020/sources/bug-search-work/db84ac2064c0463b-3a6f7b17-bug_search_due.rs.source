//! Existing-head/outbox due fairness and immutable occurrence fencing, synthetic DB only.
use super::*;
use domain::{bug_search_cancel::*, bug_search_due::*};

fn reserve(d: &BugSearchDue, key: &str, f: &Fixture) -> ReserveBugSearch {
    let mut snapshot = accepted_snapshot(f, d.policy.revision);
    snapshot.project.project_id = d.project_id;
    snapshot.trigger = BugSearchTrigger::Periodic;
    ReserveBugSearch {
        idempotency_key: key.into(),
        owner_subject: d.owner_subject.clone(),
        snapshot_sha256: app::bug_search::canonical_hash(&snapshot).unwrap(),
        expected_policy_revision: d.policy.revision,
        agent_id: snapshot.agent_id,
        snapshot,
        expected_due: Some(BugSearchExpectedDue {
            at: d.expected_due_at,
            key: d.due_key.clone(),
        }),
    }
}
fn preparation(g: &BugSearchGrantReadback, s: &BugSearchSnapshot, key: &str) -> AdmitBugSearch {
    let b = &g.binding;
    let receipt = json!({"contract_version":1,"execution_id":b.execution_id,"binding":b,"snapshot_sha256":b.snapshot_sha256,"profession":s.profession,"workflow_id":1,"mode_id":2,"mode_key":"search","state":"prepared","version":1,"fence":b.fence,"phase_index":0,"phase_contract":{"synthetic":"periodic"},"session_id":null,"session_run_id":null,"hermes_run_ref":null,"result":null,"runtime_terminal_confirmed":false,"target_observations":null});
    AdmitBugSearch {
        idempotency_key: key.into(),
        expected_fence: b.fence,
        workflow_receipt_sha256: app::bug_search::canonical_hash(&receipt).unwrap(),
        workflow_receipt: receipt,
    }
}
#[tokio::test]
#[ignore = "requires TT_BUG_SEARCH_DISPOSABLE_DB=1 and external Base finally teardown"]
async fn periodic_due_is_fair_exact_and_advances_only_after_admission() {
    let f = Fixture::new().await;
    let a = machine("bug-fleet");
    let mut policy = accepted_policy(&accepted_snapshot(&f, 1));
    policy.enabled = true;
    for (p, key) in [(f.project, "due-policy-a"), (f.foreign, "due-policy-b")] {
        let state = f
            .repo
            .apply_policy(
                p,
                &a,
                ApplyBugSearchPolicy {
                    idempotency_key: key.into(),
                    owner_subject: "owner".into(),
                    expected_revision: 0,
                    desired_revision: 1,
                    policy: policy.clone(),
                },
            )
            .await
            .unwrap()
            .0;
        assert!(state.next_due_at.unwrap() > chrono::Utc::now() + chrono::Duration::minutes(59));
    }
    assert!(f.repo.due(&a).await.unwrap().due.is_none());
    assert!(matches!(
        f.repo.due(&machine("bug-workflow-reader")).await,
        Err(AppError::Forbidden)
    ));
    sql(&f.db,"UPDATE sdlc_bug_search_policy_heads SET next_due_at=clock_timestamp()-interval '2 minutes' WHERE project_id=$1",vec![f.project.into()]).await;
    sql(&f.db,"UPDATE sdlc_bug_search_policy_heads SET next_due_at=clock_timestamp()-interval '1 minute' WHERE project_id=$1",vec![f.foreign.into()]).await;
    sql(
        &f.db,
        "UPDATE users SET is_active=false WHERE id=$1",
        vec![f.owner.into()],
    )
    .await;
    assert!(
        f.repo.due(&a).await.unwrap().due.is_none(),
        "fresh revoked owner cannot be offered"
    );
    sql(
        &f.db,
        "UPDATE users SET is_active=true WHERE id=$1",
        vec![f.owner.into()],
    )
    .await;
    let first = f.repo.due(&a).await.unwrap().due.unwrap();
    assert_eq!(first.project_id, f.project);
    let defer = DeferBugSearchDue {
        idempotency_key: "blocked-catalog".into(),
        owner_subject: "owner".into(),
        expected_policy_revision: 1,
        expected_due: BugSearchExpectedDue {
            at: first.expected_due_at,
            key: first.due_key.clone(),
        },
        reason: BugSearchDueDeferReason::CatalogUnavailable,
    };
    sql(&f.db,"CREATE FUNCTION reject_due_receipt() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic due journal rejection'; END $$",vec![]).await;
    sql(&f.db,"CREATE TRIGGER reject_due_receipt BEFORE INSERT ON sdlc_bug_search_commands FOR EACH ROW WHEN(NEW.kind='defer_due') EXECUTE FUNCTION reject_due_receipt()",vec![]).await;
    assert!(
        f.repo
            .defer_due(f.project, &a, defer.clone())
            .await
            .is_err()
    );
    assert_eq!(
        f.repo.policy(f.project, &a).await.unwrap().next_due_at,
        Some(first.expected_due_at),
        "journal failure rolls back due advancement"
    );
    sql(
        &f.db,
        "DROP TRIGGER reject_due_receipt ON sdlc_bug_search_commands",
        vec![],
    )
    .await;
    sql(&f.db, "DROP FUNCTION reject_due_receipt()", vec![]).await;
    let deferred = f
        .repo
        .defer_due(f.project, &a, defer.clone())
        .await
        .unwrap()
        .0;
    assert!(deferred.next_due_at > chrono::Utc::now() + chrono::Duration::minutes(4));
    let mut changed = policy.clone();
    changed.interval_minutes = 120;
    let newer = f
        .repo
        .apply_policy(
            f.project,
            &a,
            ApplyBugSearchPolicy {
                idempotency_key: "due-policy-a2".into(),
                owner_subject: "owner".into(),
                expected_revision: 1,
                desired_revision: 2,
                policy: changed,
            },
        )
        .await
        .unwrap()
        .0;
    assert_eq!(
        newer.next_due_at,
        Some(deferred.next_due_at),
        "enabled edit preserves current due time"
    );
    assert_eq!(
        f.repo
            .defer_due(f.project, &a, defer.clone())
            .await
            .unwrap(),
        (deferred.clone(), true)
    );
    assert_eq!(
        serde_json::to_value(
            f.repo
                .command(f.project, &a, &defer.idempotency_key)
                .await
                .unwrap()
        )
        .unwrap(),
        serde_json::to_value(BugSearchCommandReceipt::DeferDue(deferred)).unwrap()
    );
    assert!(matches!(
        f.repo
            .reserve(f.project, &a, reserve(&first, "old-a-occurrence", &f))
            .await,
        Err(AppError::Conflict(_))
    ));
    let due = f.repo.due(&a).await.unwrap().due.unwrap();
    assert_eq!(
        due.project_id, f.foreign,
        "blocked project cannot starve another head"
    );
    let command = reserve(&due, "periodic-b-left", &f);
    let mut right = command.clone();
    right.idempotency_key = "periodic-b-right".into();
    let mut absent = command.clone();
    absent.expected_due = None;
    assert!(absent.validate().is_err());
    let mut manual = command.clone();
    manual.snapshot.trigger = BugSearchTrigger::Manual;
    assert!(manual.validate().is_err());
    let (l, r) = tokio::join!(
        f.repo.reserve(f.foreign, &a, command.clone()),
        f.repo.reserve(f.foreign, &a, right.clone())
    );
    assert_eq!(usize::from(l.is_ok()) + usize::from(r.is_ok()), 1);
    let winner = if let Ok(v) = l { v.0 } else { r.unwrap().0 };
    assert_eq!(
        f.repo.policy(f.foreign, &a).await.unwrap().next_due_at,
        Some(due.expected_due_at),
        "reserve does not consume due"
    );
    let busy = f.repo.due(&a).await.unwrap();
    assert!(busy.due.is_none());
    assert_eq!(busy.blocked_reasons, ["capacity_busy"]);
    assert!(matches!(
        f.repo
            .defer_due(
                f.foreign,
                &a,
                DeferBugSearchDue {
                    idempotency_key: "defer-held".into(),
                    owner_subject: "owner".into(),
                    expected_policy_revision: 1,
                    expected_due: command.expected_due.clone().unwrap(),
                    reason: BugSearchDueDeferReason::RuntimeUnavailable
                }
            )
            .await,
        Err(AppError::Conflict(_))
    ));
    f.repo
        .apply_policy(
            f.foreign,
            &a,
            ApplyBugSearchPolicy {
                idempotency_key: "due-policy-b2".into(),
                owner_subject: "owner".into(),
                expected_revision: 1,
                desired_revision: 2,
                policy: policy.clone(),
            },
        )
        .await
        .unwrap();
    let invalidated = f
        .repo
        .execution_grant(f.foreign, winner.binding.execution_id, &a)
        .await
        .unwrap();
    assert!(!invalidated.authorization_valid);
    assert!(matches!(
        f.repo
            .admit(
                f.foreign,
                winner.binding.execution_id,
                &a,
                preparation(&winner, &command.snapshot, "old-periodic-admit")
            )
            .await,
        Err(AppError::Conflict(_))
    ));
    assert_eq!(
        f.repo.due(&a).await.unwrap().blocked_reasons,
        ["capacity_busy"],
        "revocation never releases unknown custody"
    );
    f.repo
        .cancel(
            f.foreign,
            winner.binding.execution_id,
            &a,
            CancelBugSearchBeforeStart {
                idempotency_key: "cancel-superseded-periodic".into(),
                expected_fence: winner.binding.fence,
                not_started_observation: BugNotStartedObservation {
                    contract_version: 1,
                    execution_id: winner.binding.execution_id,
                    agent_id: winner.binding.agent_id,
                    snapshot_sha256: winner.binding.snapshot_sha256.clone(),
                    journal_ref: "fleet:sealed-periodic-no-submit".into(),
                    disposition: BugNativeDispatchDisposition::NeverSubmitted,
                    observed_at: chrono::Utc::now(),
                    runtime_custody: BugPreRunRuntimeCustody {
                        contract_version: 1,
                        disposition: BugPreRunCustodyDisposition::NeverProvisioned,
                        context_id: None,
                        stop_proof: None,
                        stop_proof_sha256: None,
                    },
                },
            },
        )
        .await
        .unwrap();
    let latest = f.repo.due(&a).await.unwrap().due.unwrap();
    assert_eq!(latest.project_id, f.foreign);
    assert_ne!(latest.due_key, due.due_key);
    assert_eq!(latest.expected_due_at, due.expected_due_at);
    let current = reserve(&latest, "periodic-current", &f);
    let reserved = f
        .repo
        .reserve(f.foreign, &a, current.clone())
        .await
        .unwrap()
        .0;
    f.repo
        .admit(
            f.foreign,
            reserved.binding.execution_id,
            &a,
            preparation(&reserved, &current.snapshot, "periodic-current-admit"),
        )
        .await
        .unwrap();
    assert!(
        f.repo
            .policy(f.foreign, &a)
            .await
            .unwrap()
            .next_due_at
            .unwrap()
            > chrono::Utc::now() + chrono::Duration::minutes(59)
    );
    policy.enabled = false;
    f.repo
        .apply_policy(
            f.foreign,
            &a,
            ApplyBugSearchPolicy {
                idempotency_key: "disable-admitted-periodic".into(),
                owner_subject: "owner".into(),
                expected_revision: 2,
                desired_revision: 3,
                policy,
            },
        )
        .await
        .unwrap();
    assert_eq!(
        f.repo.policy(f.foreign, &a).await.unwrap().next_due_at,
        None
    );
    assert!(
        f.repo
            .execution_grant(f.foreign, reserved.binding.execution_id, &a)
            .await
            .unwrap()
            .dispatch_allowed,
        "already admitted run retains original snapshot despite policy disable"
    );
    f.close().await;
}
