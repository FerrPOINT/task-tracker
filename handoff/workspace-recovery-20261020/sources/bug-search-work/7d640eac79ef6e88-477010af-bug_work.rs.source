//! Real HTTP owner boundary; synthetic refs do not qualify runtime dispatch.
use super::*;
#[path = "issue_verification_transitions.rs"]
mod verification_transitions;
pub(super) async fn verify(
    client: &Client,
    base: &str,
    db: &DatabaseConnection,
    project: Uuid,
    owner: &str,
    bug: Uuid,
) {
    verification_transitions::verify(client, base, db, project, owner, bug).await;
    let fleet: Uuid = std::env::var("TASKTRACKER_BUG_INTAKE__FLEET_INSTANCE_ID")
        .unwrap()
        .parse()
        .unwrap();
    let worker = Uuid::new_v4();
    let prefix = format!("{base}/api/v1/projects/{project}/sdlc/bug-intake");
    let runtime = json!({"fleet_instance_id":fleet,"agent_id":worker,"agent_config_revision":3});
    let pref = json!({"contract_version":1,"idempotency_key":"http-work-consent","expected_revision":0,"desired_revision":3,"enabled":true,"worker_runtime":runtime});
    assert_eq!(
        client
            .put(format!("{prefix}/workers/{worker}/preferences/owner"))
            .bearer_auth("sdlc_pat_bugs_fleet")
            .json(&pref)
            .send()
            .await
            .unwrap()
            .status(),
        200
    );
    let claim = json!({"contract_version":1,"idempotency_key":"http-work-claim","owner_subject":"owner","expected_preference_revision":3,"worker_runtime":runtime,"fleet_journal_ref":"fleet:synthetic-http-work-original"});
    let url = format!("{prefix}/workers/{worker}/claim");
    for token in [owner, "sdlc_pat_bugs_workflow"] {
        post(client, &url, token, &claim, 403).await;
    }
    let accepted = post(client, &url, "sdlc_pat_bugs_fleet", &claim, 201).await;
    assert_eq!(accepted["outcome"]["kind"], "claimed");
    let s = &accepted["outcome"]["assignment"];
    assert_eq!(s["assignment"]["bug_id"], json!(bug));
    assert_eq!(s["can_take_bugs"], false);
    assert_eq!(s["assignment"]["purpose"], "bug_fix");
    assert_eq!(s["assignment"]["role"], "developer");
    let id = s["assignment"]["assignment_id"].as_str().unwrap();
    assert_eq!(s["assignment"]["origin"]["contract_version"], 1);
    let origin_url = format!("{prefix}/assignments/{id}/origin");
    for token in [owner, "sdlc_pat_bugs_wrong_scope"] {
        assert_eq!(
            client
                .get(&origin_url)
                .bearer_auth(token)
                .send()
                .await
                .unwrap()
                .status(),
            403
        );
    }
    let origin_response = client
        .get(&origin_url)
        .bearer_auth("sdlc_pat_bugs_workflow")
        .send()
        .await
        .unwrap();
    assert_eq!(origin_response.status(), 200);
    assert_eq!(origin_response.headers()["cache-control"], "no-store");
    let origin: Value = origin_response.json().await.unwrap();
    for resource in ["origin", "grant"] {
        let response = client
            .get(format!("{prefix}/assignments/{id}/{resource}"))
            .bearer_auth("sdlc_pat_bugs_ci")
            .send()
            .await
            .unwrap();
        assert_eq!(response.status(), 200);
        assert_eq!(response.headers()["cache-control"], "no-store");
        let value: Value = response.json().await.unwrap();
        if resource == "origin" {
            assert_eq!(value, origin);
        } else {
            assert_eq!(
                value["assignment"]["assignment_id"],
                s["assignment"]["assignment_id"]
            );
        }
    }
    assert_eq!(
        client
            .get(&origin_url)
            .bearer_auth("sdlc_pat_bugs_ci_mixed")
            .send()
            .await
            .unwrap()
            .status(),
        403
    );
    post(client, &url, "sdlc_pat_bugs_ci", &claim, 403).await;
    for path in [
        format!("{prefix}/workers/{worker}/current?owner_subject=owner"),
        format!("{base}/api/v1/issues"),
        format!("{base}/api/v1/sdlc/project-directory"),
    ] {
        assert_eq!(
            client
                .get(path)
                .bearer_auth("sdlc_pat_bugs_ci")
                .send()
                .await
                .unwrap()
                .status(),
            403
        );
    }
    assert_eq!(origin["origin"], s["assignment"]["origin"]);
    assert_eq!(origin["assignment_sha256"], s["assignment_sha256"]);
    assert_eq!(
        origin["origin"]["source_context_sha256"],
        app::bug_search::canonical_hash(&origin["source_context"]).unwrap()
    );
    assert!(origin["source_context"].get("owner_subject").is_none());
    assert_eq!(
        origin["source_context"]["targets"][0]["source"]["branch_ref"],
        "refs/heads/main"
    );
    assert!(
        origin["source_context"]["targets"][0]["source"]
            .get("clone_url")
            .is_none()
    );
    let fence = s["assignment"]["fence"].as_i64().unwrap();
    assert_eq!(
        post(client, &url, "sdlc_pat_bugs_fleet", &claim, 200).await,
        accepted
    );
    let mut changed = claim.clone();
    changed["worker_runtime"]["agent_config_revision"] = json!(9);
    post(client, &url, "sdlc_pat_bugs_fleet", &changed, 409).await;
    let current = client
        .get(format!(
            "{prefix}/workers/{worker}/current?owner_subject=owner"
        ))
        .bearer_auth("sdlc_pat_bugs_fleet")
        .send()
        .await
        .unwrap();
    assert_eq!(current.status(), 200);
    assert_eq!(current.headers()["cache-control"], "no-store");
    assert_eq!(current.json::<Value>().await.unwrap(), *s);
    let grant = format!("{prefix}/assignments/{id}/grant");
    assert_eq!(
        client
            .get(&grant)
            .bearer_auth("sdlc_pat_bugs_workflow")
            .send()
            .await
            .unwrap()
            .status(),
        200
    );
    let op = client
        .get(format!("{prefix}/work-operations/http-work-claim"))
        .bearer_auth("sdlc_pat_bugs_fleet")
        .send()
        .await
        .unwrap();
    assert_eq!(op.status(), 200);
    assert_eq!(op.json::<Value>().await.unwrap(), accepted);
    // A lost claim ACK must remain recoverable without restoring the revoked
    // owner's authority. The original receipt never grants a fresh dispatch.
    db.execute_unprepared("UPDATE users SET is_active=false WHERE central_sub='owner'")
        .await
        .unwrap();
    let original_url = format!("{prefix}/work-operations/http-work-claim");
    for token in [
        "sdlc_pat_bugs_fleet_read",
        "sdlc_pat_bugs_wrong_scope",
        owner,
    ] {
        assert_eq!(
            client
                .get(&original_url)
                .bearer_auth(token)
                .send()
                .await
                .unwrap()
                .status(),
            403
        );
    }
    let recovered = client
        .get(&original_url)
        .bearer_auth("sdlc_pat_bugs_fleet")
        .send()
        .await
        .unwrap();
    assert_eq!(recovered.status(), 200);
    assert_eq!(recovered.headers()["cache-control"], "no-store");
    assert_eq!(recovered.json::<Value>().await.unwrap(), accepted);
    assert_eq!(
        client
            .get(format!("{prefix}/work-operations/unknown-original-key"))
            .bearer_auth("sdlc_pat_bugs_fleet")
            .send()
            .await
            .unwrap()
            .status(),
        404
    );
    assert_eq!(
        client
            .get(&grant)
            .bearer_auth("sdlc_pat_bugs_fleet")
            .send()
            .await
            .unwrap()
            .status(),
        403
    );
    post(client, &url, "sdlc_pat_bugs_fleet", &claim, 403).await;
    db.execute_unprepared("UPDATE users SET is_active=true WHERE central_sub='owner'")
        .await
        .unwrap();
    let binding = json!({"runtime_context_id":Uuid::new_v4(),"runtime_generation":Uuid::new_v4(),"session_id":Uuid::new_v4(),"session_run_id":Uuid::new_v4(),"hermes_run_ref":"hermes:synthetic-http-work-run","workflow_task_id":41,"workflow_assignment_revision":1,"workflow_operation_key":"workflow:http-work:assignment","workflow_binding_ref":"workflow:synthetic-http-binding"});
    let bind = json!({"idempotency_key":"http-work-bind","expected_fence":fence,"binding":binding});
    let bind_url = format!("{prefix}/assignments/{id}/bind");
    post(client, &bind_url, "sdlc_pat_bugs_workflow", &bind, 403).await;
    let bound = post(client, &bind_url, "sdlc_pat_bugs_fleet", &bind, 201).await;
    assert_eq!(bound["outcome"]["assignment"]["binding"], binding);
    super::bug_business::verify(
        client,
        base,
        db,
        project,
        owner,
        id,
        &fence,
        &bound["outcome"]["assignment"]["assignment_sha256"],
        bug,
    )
    .await;
    let proof = json!({"contract_version":4,"operation_id":Uuid::new_v4(),"container_id":"c".repeat(64),"generation":binding["runtime_generation"],"resource_id":worker,"snapshot_sha256":"d".repeat(64),"state":"observed","observation":"namespace_exited"});
    let close = json!({"idempotency_key":"http-work-close","expected_fence":fence,"proof":{"kind":"actual_terminal","observation":{"runtime":{"contract_version":1,"execution_id":id,"agent_id":worker,"session_id":binding["session_id"],"session_run_id":binding["session_run_id"],"hermes_run_ref":binding["hermes_run_ref"],"terminal_status":"stopped","observed_at":shared::now()},"journal_ref":"fleet:synthetic-http-work-original","runtime_custody":{"contract_version":1,"disposition":"namespace_exited","context_id":binding["runtime_context_id"],"stop_proof":proof,"stop_proof_sha256":app::bug_search::canonical_hash(&proof).unwrap()}}}});
    let close_url = format!("{prefix}/assignments/{id}/close");
    post(client, &close_url, "sdlc_pat_bugs_workflow", &close, 403).await;
    let closed = post(client, &close_url, "sdlc_pat_bugs_fleet", &close, 201).await;
    assert_eq!(closed["outcome"]["kind"], "closed");
    assert_eq!(closed["outcome"]["assignment"]["capacity_held"], false);
    assert_eq!(
        post(client, &close_url, "sdlc_pat_bugs_fleet", &close, 200).await,
        closed
    );
    let mut no_retry = claim;
    no_retry["idempotency_key"] = json!("http-work-no-immediate-repick");
    let empty = post(client, &url, "sdlc_pat_bugs_fleet", &no_retry, 201).await;
    assert!(empty["outcome"]["assignment"].is_null());
    super::bug_business::apply(client, base, db, project, id, bug).await;
    println!(
        "BUG_WORK HTTP real Issue claim, original key/readback, exact service binding/custody close and no auto-repick passed; runtime unavailable"
    );
}
