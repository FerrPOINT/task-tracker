//! One bounded due occurrence in the existing owner policy; never an implicit reservation.
use crate::{bug_search::*, bug_search_control::*};
use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use shared::AppError;
use uuid::Uuid;

#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(deny_unknown_fields)]
pub struct BugSearchExpectedDue {
    pub at: DateTime<Utc>,
    pub key: String,
}
impl BugSearchExpectedDue {
    pub fn validate(&self) -> Result<(), AppError> {
        if !sha256(&self.key) {
            return Err(AppError::validation("invalid due occurrence key"));
        }
        Ok(())
    }
}
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(deny_unknown_fields)]
pub struct BugSearchDue {
    pub project_id: Uuid,
    pub owner_subject: String,
    pub policy: BugSearchPolicyState,
    pub expected_due_at: DateTime<Utc>,
    pub due_key: String,
}
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(deny_unknown_fields)]
pub struct BugSearchDueReadback {
    pub contract_version: u8,
    pub observed_at: DateTime<Utc>,
    pub due: Option<BugSearchDue>,
    pub blocked_reasons: Vec<String>,
}
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(rename_all = "snake_case")]
pub enum BugSearchDueDeferReason {
    CapacityBusy,
    TargetUnavailable,
    CatalogUnavailable,
    ConfigurationPending,
    RuntimeUnavailable,
}
#[derive(Debug, Clone, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(deny_unknown_fields)]
pub struct DeferBugSearchDue {
    pub idempotency_key: String,
    pub owner_subject: String,
    pub expected_policy_revision: i64,
    pub expected_due: BugSearchExpectedDue,
    pub reason: BugSearchDueDeferReason,
}
impl DeferBugSearchDue {
    pub fn validate(&self) -> Result<(), AppError> {
        validate_key(&self.idempotency_key)?;
        self.expected_due.validate()?;
        if !bounded_text(&self.owner_subject, 256)
            || self.owner_subject.chars().any(char::is_control)
            || !(1..=crate::sdlc::MAX_SAFE_VERSION).contains(&self.expected_policy_revision)
        {
            return Err(AppError::validation("invalid due deferral identity"));
        }
        Ok(())
    }
}
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(deny_unknown_fields)]
pub struct BugSearchDueDeferral {
    pub contract_version: u8,
    pub operation_id: Uuid,
    pub tracker_instance_id: String,
    pub project_id: Uuid,
    pub owner_subject: String,
    pub policy_revision: i64,
    pub previous_due: BugSearchExpectedDue,
    pub next_due_at: DateTime<Utc>,
    pub reason: BugSearchDueDeferReason,
    pub accepted_at: DateTime<Utc>,
}
