//! Synthetic producer proof; real Fleet journal and namespace evidence qualify separately.
use super::*;
use domain::{bug_search_cancel::*, bug_search_unbound::*};

async fn prepared(f: &Fixture, e: Uuid, key: &str) -> BugSearchGrantReadback {
    let a = machine("bug-fleet");
    let g = f.repo.execution_grant(f.project, e, &a).await.unwrap();
    let row =
        f.db.query_one(Statement::from_sql_and_values(
            DatabaseBackend::Postgres,
            "SELECT snapshot FROM sdlc_bug_search_executions WHERE execution_id=$1",
            [e.into()],
        ))
        .await
        .unwrap()
        .unwrap();
    let snapshot: serde_json::Value = row.try_get("", "snapshot").unwrap();
    let b = &g.binding;
    let r = json!({"contract_version":1,"execution_id":e,"binding":b,"snapshot_sha256":b.snapshot_sha256,
        "profession":snapshot["profession"],"workflow_id":1,"mode_id":2,"mode_key":"search",
        "state":"prepared","version":1,"fence":b.fence,"phase_index":0,"phase_contract":{"synthetic":true},
        "session_id":null,"session_run_id":null,"hermes_run_ref":null,"result":null,
        "runtime_terminal_confirmed":false,"target_observations":null});
    f.repo
        .admit(
            f.project,
            e,
            &a,
            AdmitBugSearch {
                idempotency_key: key.into(),
                expected_fence: b.fence,
                workflow_receipt_sha256: app::bug_search::canonical_hash(&r).unwrap(),
                workflow_receipt: r,
            },
        )
        .await
        .unwrap()
        .0
}
fn abort(g: &BugSearchGrantReadback, key: &str) -> AbortUnboundBugSearch {
    let now = chrono::Utc::now();
    let proof = json!({"contract_version":4,"operation_id":Uuid::new_v4(),"container_id":"a".repeat(64),
        "generation":Uuid::new_v4(),"resource_id":g.binding.agent_id,"snapshot_sha256":"b".repeat(64),
        "state":"observed","observation":"namespace_exited"});
    AbortUnboundBugSearch {
        idempotency_key: key.into(),
        expected_fence: g.binding.fence,
        unbound_observation: BugUnboundObservation {
            contract_version: 1,
            execution_id: g.binding.execution_id,
            agent_id: g.binding.agent_id,
            snapshot_sha256: g.binding.snapshot_sha256.clone(),
            journal_ref: "fleet:sealed-unknown-submit".into(),
            observed_at: now,
            native_submission: BugUnboundNativeSubmission {
                operation_key: "native:original-operation".into(),
                body_sha256: "c".repeat(64),
                submitted_at: now,
                acceptance: BugUnknownNativeAcceptance::Unknown,
                actual_run_ref: (),
            },
            workflow_handoff: BugUnboundWorkflowHandoff {
                disposition: BugUnboundHandoffDisposition::BindAndHandoffNeverSubmitted,
                bind_journal_ref: "fleet:bind-fence".into(),
                handoff_journal_ref: "fleet:credential-handoff-fence".into(),
                observed_at: now,
            },
            runtime_custody: BugPreRunRuntimeCustody {
                contract_version: 1,
                disposition: BugPreRunCustodyDisposition::NamespaceExited,
                context_id: Some(Uuid::new_v4()),
                stop_proof_sha256: Some(app::bug_search::canonical_hash(&proof).unwrap()),
                stop_proof: Some(proof),
            },
        },
    }
}
#[tokio::test]
#[ignore = "requires TT_BUG_SEARCH_DISPOSABLE_DB=1 and external Base finally teardown"]
async fn unknown_submission_requires_prepared_unbound_and_actual_namespace_exit() {
    let f = Fixture::new().await;
    let a = machine("bug-fleet");
    let e = f.execution(1011, false, true).await;
    let reserved = f.repo.execution_grant(f.project, e, &a).await.unwrap();
    assert!(matches!(
        f.repo
            .abort_unbound(f.project, e, &a, abort(&reserved, "abort-not-admitted"))
            .await,
        Err(AppError::Conflict(_))
    ));
    let grant = prepared(&f, e, "prepare-unknown").await;
    let c = abort(&grant, "unknown-native-abort");
    assert!(matches!(
        f.repo
            .abort_unbound(f.project, e, &machine("unrelated"), c.clone())
            .await,
        Err(AppError::Forbidden)
    ));
    assert!(
        f.repo
            .abort_unbound(f.foreign, e, &a, c.clone())
            .await
            .is_err()
    );
    let mut invalid = c.clone();
    invalid.unbound_observation.runtime_custody = BugPreRunRuntimeCustody {
        contract_version: 1,
        disposition: BugPreRunCustodyDisposition::NeverProvisioned,
        context_id: None,
        stop_proof: None,
        stop_proof_sha256: None,
    };
    assert!(matches!(
        f.repo.abort_unbound(f.project, e, &a, invalid).await,
        Err(AppError::Validation(_))
    ));
    let mut invalid = c.clone();
    invalid
        .unbound_observation
        .runtime_custody
        .stop_proof_sha256 = Some("0".repeat(64));
    assert!(matches!(
        f.repo.abort_unbound(f.project, e, &a, invalid).await,
        Err(AppError::Validation(_))
    ));
    assert!(
        f.repo
            .execution_grant(f.project, e, &a)
            .await
            .unwrap()
            .dispatch_allowed
    );
    sql(
        &f.db,
        "UPDATE users SET is_active=false WHERE id=$1",
        vec![f.owner.into()],
    )
    .await;
    sql(&f.db,"UPDATE sdlc_bug_search_executions SET expires_at=clock_timestamp()-interval '1 second' WHERE execution_id=$1",vec![e.into()]).await;
    let restarted = f.reopened().await;
    let (l, r) = tokio::join!(
        f.repo.abort_unbound(f.project, e, &a, c.clone()),
        restarted.abort_unbound(f.project, e, &a, c.clone())
    );
    let l = l.unwrap();
    let r = r.unwrap();
    assert_eq!(l.0, r.0);
    assert_ne!(l.1, r.1);
    assert_eq!(l.0.kind, BugUnboundEndKind::CancelledWithoutBoundRun);
    let encoded = serde_json::to_value(&l.0).unwrap();
    assert!(encoded.get("runtime_observation").is_none());
    assert!(encoded.get("session_id").is_none());
    assert_eq!(
        serde_json::to_value(
            restarted
                .command(f.project, &a, &c.idempotency_key)
                .await
                .unwrap()
        )
        .unwrap(),
        serde_json::to_value(BugSearchCommandReceipt::AbortUnbound(l.0.clone())).unwrap()
    );
    let mut changed = c.clone();
    changed.unbound_observation.native_submission.body_sha256 = "d".repeat(64);
    assert!(matches!(
        f.repo.abort_unbound(f.project, e, &a, changed).await,
        Err(AppError::Conflict(_))
    ));
    let actual = AcceptBugSearchTerminal {
        idempotency_key: "actual-after-unbound".into(),
        expected_fence: grant.binding.fence,
        workflow_receipt: None,
        workflow_receipt_sha256: None,
        runtime_observation: BugRuntimeObservation {
            contract_version: 1,
            execution_id: e,
            agent_id: grant.binding.agent_id,
            session_id: Uuid::new_v4(),
            session_run_id: Uuid::new_v4(),
            hermes_run_ref: "hermes:contradiction".into(),
            terminal_status: BugRuntimeTerminalStatus::Stopped,
            observed_at: chrono::Utc::now(),
            observation_source: None,
        },
    };
    assert!(matches!(
        f.repo.terminal(f.project, e, &a, actual).await,
        Err(AppError::Conflict(_))
    ));
    sql(
        &f.db,
        "UPDATE users SET is_active=true WHERE id=$1",
        vec![f.owner.into()],
    )
    .await;
    assert!(
        !f.repo
            .execution_grant(f.project, e, &a)
            .await
            .unwrap()
            .dispatch_allowed
    );
    let e2 = f.execution(1012, false, true).await;
    let g2 = prepared(&f, e2, "prepare-positive-finding").await;
    let mut finding = command(e2, "positive-before-unbound");
    finding.expected_fence = g2.binding.fence;
    f.repo.register(f.project, &a, finding).await.unwrap();
    let before = f.count("sdlc_bug_search_commands").await;
    assert!(matches!(
        f.repo
            .abort_unbound(f.project, e2, &a, abort(&g2, "contradictory-abort"))
            .await,
        Err(AppError::Conflict(_))
    ));
    assert_eq!(f.count("sdlc_bug_search_commands").await, before);
    assert!(
        f.repo
            .execution_grant(f.project, e2, &a)
            .await
            .unwrap()
            .dispatch_allowed
    );
    drop(restarted);
    f.close().await;
}
