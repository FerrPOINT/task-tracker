//! Exact retained service may close custody during owner revocation/outage.
//! This path never creates an issue, applies policy, admits or transitions a Bug.
use crate::bug_search::{PostgresBugSearchRepository, db_error, decode, exec, field, stmt};
use crate::bug_search_control::{command_hash, locks, save, saved};
use domain::{
    bug_search::*, bug_search_control::BugSearchCommandReceipt, bug_search_terminal::*,
    sdlc::Principal,
};
use sea_orm::{ConnectionTrait, DatabaseTransaction, TransactionTrait};
use serde_json::{Value, json};
use shared::AppError;
use uuid::Uuid;
fn runtime_identity(r: &BugRuntimeObservation) -> Result<Value, AppError> {
    let mut v = serde_json::to_value(r).map_err(AppError::internal)?;
    v.as_object_mut()
        .ok_or_else(|| AppError::internal("invalid runtime observation"))?
        .remove("observed_at");
    Ok(v)
}
fn technical_result(
    receipt: &Value,
    snapshot: &Value,
    b: &BugSearchExecutionBinding,
    runtime: &BugRuntimeObservation,
    prepared: &Value,
) -> Result<Option<BugSearchTechnicalResult>, AppError> {
    let state = receipt.get("state").and_then(Value::as_str);
    let allowed_fence = receipt.get("fence") == Some(&json!(b.fence))
        || (state == Some("stopped") && receipt.get("fence") == Some(&json!(b.fence + 1)));
    if receipt.get("contract_version") != Some(&json!(1))
        || receipt.get("execution_id") != Some(&json!(b.execution_id))
        || receipt.get("binding") != Some(&serde_json::to_value(b).map_err(AppError::internal)?)
        || receipt.get("snapshot_sha256") != Some(&json!(b.snapshot_sha256))
        || receipt.get("profession") != snapshot.get("profession")
        || !["workflow_id", "mode_id", "mode_key"]
            .iter()
            .all(|k| receipt.get(*k) == prepared.get(*k))
        || !allowed_fence
        || receipt.get("session_id") != Some(&json!(runtime.session_id))
        || receipt.get("session_run_id") != Some(&json!(runtime.session_run_id))
        || receipt.get("hermes_run_ref") != Some(&json!(runtime.hermes_run_ref))
        || receipt
            .get("version")
            .and_then(Value::as_i64)
            .is_none_or(|n| n < 2)
        || !matches!(state, Some("active" | "completed" | "stopped"))
    {
        return Err(AppError::conflict(
            "terminal Workflow receipt binding differs",
        ));
    }
    if state != Some("completed") {
        if !receipt.get("result").is_some_and(Value::is_null) {
            return Err(AppError::conflict(
                "noncompleted Workflow result is not accepted",
            ));
        }
        return Ok(None);
    }
    if receipt.get("phase_index") != Some(&json!(3)) {
        return Err(AppError::conflict("Workflow result has incomplete phases"));
    }
    let result: BugSearchTechnicalResult = serde_json::from_value(
        receipt
            .get("result")
            .cloned()
            .ok_or_else(|| AppError::validation("missing typed Workflow result"))?,
    )
    .map_err(|_| AppError::validation("invalid typed Workflow result"))?;
    result.validate()?;
    if b.purpose == BugSearchPurpose::Verification {
        let typed_snapshot: domain::bug_search_control::BugSearchSnapshot =
            serde_json::from_value(snapshot.clone()).map_err(|_| {
                AppError::conflict("retained verification snapshot is incompatible")
            })?;
        let verdict = app::bug_search_verification::require_result(&typed_snapshot, &result)?;
        if verdict.is_some_and(|v| v != app::bug_search_verification::Verdict::Inconclusive)
            && !qa_delivery_qualified(receipt, snapshot, b.tracker_instance_uuid, b.project_id)
        {
            return Err(AppError::validation(
                "conclusive verification requires the same delivered version before and after",
            ));
        }
    }
    if b.purpose == BugSearchPurpose::Search && result.verification.is_some() {
        return Err(AppError::validation("search result cannot verify a Bug"));
    }
    let targets = snapshot
        .get("targets")
        .and_then(Value::as_array)
        .ok_or_else(|| AppError::conflict("retained target snapshot missing"))?;
    let mut sources = std::collections::HashSet::new();
    for finding in &result.findings {
        finding
            .report
            .source
            .require_snapshot_version(snapshot, &finding.report.checked_version)?;
        if app::bug_search::canonical_hash(&finding.report.source)?
            != finding.report.source_identity
            || !sources.insert(&finding.report.source_identity)
            || !targets.iter().any(|t| {
                t.get("commit_sha").and_then(Value::as_str)
                    == Some(finding.report.checked_version.as_str())
                    || t.get("deployment_ref").and_then(Value::as_str)
                        == Some(finding.report.checked_version.as_str())
            })
        {
            return Err(AppError::validation(
                "terminal finding source/version differs from snapshot",
            ));
        }
    }
    Ok(Some(result))
}

pub(super) fn qa_delivery_qualified(
    receipt: &Value,
    snapshot: &Value,
    instance: Uuid,
    project: Uuid,
) -> bool {
    if snapshot.get("mode") == Some(&json!("source_only")) {
        return receipt.get("result_qualification") == Some(&json!("source_pinned"));
    }
    if receipt.get("result_qualification") != Some(&json!("qa_same_version")) {
        return false;
    }
    let Some(targets) = snapshot.get("targets").and_then(Value::as_array) else {
        return false;
    };
    let Some(before) = receipt
        .pointer("/target_observations/before")
        .and_then(Value::as_array)
    else {
        return false;
    };
    let Some(after) = receipt
        .pointer("/target_observations/after")
        .and_then(Value::as_array)
    else {
        return false;
    };
    if snapshot.get("mode") != Some(&json!("qa"))
        || targets.is_empty()
        || before.len() != targets.len()
        || after.len() != targets.len()
    {
        return false;
    }
    for ((expected, left), right) in targets.iter().zip(before).zip(after) {
        for observed in [left, right] {
            if observed.get("schema") != Some(&json!("forge/delivered-target/v1"))
                || observed.get("status") != Some(&json!("confirmed"))
                || observed.get("blockedReasons") != Some(&json!([]))
                || observed.pointer("/project/trackerInstanceId") != Some(&json!(instance))
                || observed.pointer("/project/projectId") != Some(&json!(project))
                || observed.get("targetRef") != expected.get("target_ref")
                || expected
                    .get("source")
                    .filter(|source| !source.is_null())
                    .is_some_and(|source| {
                        observed.get("configurationId") != source.get("configuration_id")
                            || observed.get("repositoryId") != source.get("repository_id")
                    })
            {
                return false;
            }
            let Some(target) = observed.get("target").filter(|v| v.is_object()) else {
                return false;
            };
            if target.get("deliveryRef") != expected.get("deployment_ref")
                || target.get("commitSha") != expected.get("commit_sha")
                || !target
                    .get("generation")
                    .and_then(Value::as_str)
                    .is_some_and(|v| {
                        !v.starts_with('0')
                            && v.len() <= 20
                            && v.bytes().all(|b| b.is_ascii_digit())
                            && v.parse::<u64>().is_ok_and(|n| n > 0)
                    })
                || !target
                    .get("manifestSha256")
                    .and_then(Value::as_str)
                    .is_some_and(sha256)
                || target.pointer("/servingIdentity/versionBodySha256")
                    != target.get("manifestSha256")
            {
                return false;
            }
            if !["configurationId", "repositoryId", "environmentId"]
                .iter()
                .all(|k| {
                    observed
                        .get(*k)
                        .and_then(Value::as_str)
                        .and_then(|v| Uuid::parse_str(v).ok())
                        .is_some_and(|id| !id.is_nil())
                })
            {
                return false;
            }
            if target
                .get("artifactId")
                .and_then(Value::as_str)
                .and_then(|v| Uuid::parse_str(v).ok())
                .is_none_or(|id| id.is_nil())
            {
                return false;
            }
            let Some(artifact) = target
                .get("artifactDigest")
                .and_then(Value::as_str)
                .and_then(|v| v.strip_prefix("sha256:"))
                .filter(|v| sha256(v))
            else {
                return false;
            };
            if target
                .pointer("/servingIdentity/artifactBodySha256")
                .and_then(Value::as_str)
                != Some(artifact)
            {
                return false;
            }
        }
        if ![
            "configurationId",
            "repositoryId",
            "environmentId",
            "targetRef",
            "project",
        ]
        .iter()
        .all(|k| left.get(*k) == right.get(*k))
        {
            return false;
        }
        let mut l = left["target"].clone();
        let mut r = right["target"].clone();
        for t in [&mut l, &mut r] {
            if let Some(o) = t.get_mut("servingIdentity").and_then(Value::as_object_mut) {
                o.remove("observedAt");
            }
        }
        if l != r {
            return false;
        }
    }
    true
}
impl PostgresBugSearchRepository {
    pub(super) async fn retained_finding_authorized(
        &self,
        tx: &DatabaseTransaction,
        p: Uuid,
        c: &RegisterBugFinding,
    ) -> Result<bool, AppError> {
        let row=tx.query_one(stmt("SELECT r.result,r.workflow_receipt,e.snapshot FROM sdlc_bug_search_results r JOIN sdlc_bug_search_executions e USING(execution_id,project_id) WHERE r.execution_id=$1 AND r.project_id=$2",vec![c.execution_id.into(),p.into()])).await.map_err(db_error)?;
        let Some(row) = row else {
            return Ok(false);
        };
        let result: BugSearchTechnicalResult = decode(&row, "result")?;
        result.validate()?;
        let receipt: Value = field(&row, "workflow_receipt")?;
        let snapshot: Value = field(&row, "snapshot")?;
        if !qa_delivery_qualified(&receipt, &snapshot, self.config.tracker_instance_uuid, p) {
            return Ok(false);
        }
        Ok(result.findings.iter().any(|f| {
            f.finding_id == c.finding_id
                && f.report.source == c.source_identity
                && f.report.report() == c.report
        }))
    }
    pub(super) async fn control_terminal(
        &self,
        p: Uuid,
        e: Uuid,
        a: &Principal,
        c: AcceptBugSearchTerminal,
    ) -> Result<(BugSearchTerminalReceipt, bool), AppError> {
        self.fleet(a, true)?;
        c.validate()?;
        app::bug_search_namespace_exit::validate_observation(&c.runtime_observation)?;
        let hash = command_hash(
            "terminal",
            p,
            &json!({"execution_id":e,"expected_fence":c.expected_fence,"workflow_receipt":c.workflow_receipt,"workflow_receipt_sha256":c.workflow_receipt_sha256,"runtime_observation":c.runtime_observation}),
        )?;
        let tx = self.db.begin().await.map_err(db_error)?;
        locks(&tx, a, &c.idempotency_key, p).await?;
        // This is protective reconciliation, not authority for any new user effect.
        // Capacity precedes execution locks, matching manual reserve/admit.
        exec(
            &tx,
            "SELECT singleton FROM sdlc_reservation_capacity WHERE singleton FOR UPDATE",
            vec![],
        )
        .await?;
        let row = self.retained_execution(&tx, p, e).await?;
        let b = self.binding(&row)?;
        b.require_machine(a)?;
        if b.fence != c.expected_fence
            || c.runtime_observation.execution_id != e
            || c.runtime_observation.agent_id != b.agent_id
        {
            return Err(AppError::conflict(
                "terminal immutable execution binding differs",
            ));
        }
        if let Some(BugSearchCommandReceipt::Terminal(r)) =
            saved(&tx, p, a, &c.idempotency_key, "terminal", &hash).await?
        {
            tx.commit().await.map_err(db_error)?;
            return Ok((r, true));
        }
        if c.runtime_observation.observation_source.is_some() {
            let prepared: Option<Value> = field(&row, "workflow_receipt")?;
            let expected_binding = serde_json::to_value(&b).map_err(AppError::internal)?;
            if field::<String>(&row, "admission_state")? != "admitted"
                || prepared.as_ref().is_none_or(|r| {
                    r["binding"] != expected_binding
                        || r["execution_id"] != json!(b.execution_id)
                        || r["snapshot_sha256"] != b.snapshot_sha256
                        || r["state"] != "prepared"
                        || r["version"] != 1
                        || r["fence"] != b.fence
                        || r["session_id"] != Value::Null
                        || r["session_run_id"] != Value::Null
                        || r["hermes_run_ref"] != Value::Null
                })
            {
                return Err(AppError::conflict(
                    "known-run namespace exit requires the original admitted Workflow binding",
                ));
            }
        }
        let now: chrono::DateTime<chrono::Utc> = field(&row, "observed_at")?;
        if c.runtime_observation.observed_at > now + chrono::Duration::seconds(5)
            || c.runtime_observation.observed_at
                < field::<chrono::DateTime<chrono::Utc>>(&row, "created_at")?
        {
            return Err(AppError::validation(
                "runtime observation time differs from execution",
            ));
        }
        let existing: Option<Value> = field(&row, "terminal_receipt")?;
        if let Some(existing) = &existing {
            let old: BugSearchTerminalReceipt = serde_json::from_value(existing.clone())
                .map_err(|_| AppError::conflict("retained terminal receipt incompatible"))?;
            if runtime_identity(&old.runtime_observation)?
                != runtime_identity(&c.runtime_observation)?
            {
                return Err(AppError::conflict("actual terminal run identity changed"));
            }
        }
        let mut result_sha = None;
        if let Some(receipt) = &c.workflow_receipt {
            let wf_hash = app::bug_search::canonical_hash(receipt)?;
            if c.workflow_receipt_sha256.as_deref() != Some(wf_hash.as_str()) {
                return Err(AppError::validation(
                    "terminal Workflow receipt digest differs",
                ));
            }
            let prepared: Option<Value> = field(&row, "workflow_receipt")?;
            let prepared = prepared
                .ok_or_else(|| AppError::conflict("execution has no prepared Workflow binding"))?;
            let snapshot: Value = field(&row, "snapshot")?;
            if let Some(_result) =
                technical_result(receipt, &snapshot, &b, &c.runtime_observation, &prepared)?
            {
                let exact_result = receipt
                    .get("result")
                    .cloned()
                    .ok_or_else(|| AppError::validation("missing exact technical result"))?;
                if !domain::bug_search_control::bounded_json(&exact_result) {
                    return Err(AppError::validation("typed result exceeds64KiB"));
                }
                let result_hash = app::bug_search::canonical_hash(&exact_result)?;
                let old = tx
                    .query_one(stmt(
                        "SELECT result_sha256 FROM sdlc_bug_search_results WHERE execution_id=$1",
                        vec![e.into()],
                    ))
                    .await
                    .map_err(db_error)?;
                if let Some(old) = old {
                    if field::<String>(&old, "result_sha256")? != result_hash {
                        return Err(AppError::conflict("retained technical result changed"));
                    }
                } else {
                    exec(&tx,"INSERT INTO sdlc_bug_search_results(execution_id,project_id,result_sha256,result,workflow_receipt_sha256,workflow_receipt) VALUES($1,$2,$3,$4,$5,$6)",vec![e.into(),p.into(),result_hash.clone().into(),exact_result.into(),wf_hash.into(),receipt.clone().into()]).await?;
                }
                result_sha = Some(result_hash);
            }
        }
        if result_sha.is_none() {
            if let Some(old) = tx
                .query_one(stmt(
                    "SELECT result_sha256 FROM sdlc_bug_search_results WHERE execution_id=$1",
                    vec![e.into()],
                ))
                .await
                .map_err(db_error)?
            {
                result_sha = Some(field(&old, "result_sha256")?);
            }
        }
        let result = BugSearchTerminalReceipt {
            contract_version: 1,
            operation_id: Uuid::now_v7(),
            tracker_instance_id: b.tracker_instance_id,
            project_id: p,
            execution_id: e,
            fence: b.fence,
            runtime_observation: c.runtime_observation,
            custody_released: true,
            result_available: result_sha.is_some(),
            result_sha256: result_sha,
            accepted_at: now,
        };
        if existing.is_none() {
            exec(&tx,"UPDATE sdlc_bug_search_executions SET terminal_receipt=$2,capacity_held=false WHERE execution_id=$1",vec![e.into(),serde_json::to_value(&result).map_err(AppError::internal)?.into()]).await?;
        }
        save(
            &tx,
            p,
            a,
            &c.idempotency_key,
            &b.owner_subject,
            &hash,
            &BugSearchCommandReceipt::Terminal(result.clone()),
        )
        .await?;
        tx.commit().await.map_err(db_error)?;
        Ok((result, false))
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn terminal_whitelist_requires_same_pinned_repository_and_commit_even_with_valid_source_hash() {
        let repository = Uuid::new_v4();
        let commit = "a".repeat(40);
        let b = BugSearchExecutionBinding {
            contract_version: 1,
            tracker_instance_id: "tracker".into(),
            tracker_instance_uuid: Uuid::new_v4(),
            project_id: Uuid::new_v4(),
            owner_subject: "owner".into(),
            execution_id: Uuid::new_v4(),
            agent_id: Uuid::new_v4(),
            purpose: BugSearchPurpose::Search,
            snapshot_sha256: "b".repeat(64),
            policy_revision: 1,
            fence: 1,
            machine_subject: "fleet".into(),
            grant_ref: Uuid::new_v4(),
            bug_id: None,
            expected_delivery_ref: None,
        };
        let runtime = BugRuntimeObservation {
            contract_version: 1,
            execution_id: b.execution_id,
            agent_id: b.agent_id,
            session_id: Uuid::new_v4(),
            session_run_id: Uuid::new_v4(),
            hermes_run_ref: "hermes:actual-terminal".into(),
            terminal_status: BugRuntimeTerminalStatus::Succeeded,
            observed_at: chrono::Utc::now(),
            observation_source: None,
        };
        let snapshot = json!({"profession":{"code":"BUG_SEARCHER"},"targets":[{"repository_ref":"catalog:app","commit_sha":commit,"target_ref":null,"deployment_ref":null,
            "source":{"contract_version":1,"schema":"forge/source-snapshot/v1","producer_version":"fixture","project":{"tracker_instance_id":b.tracker_instance_uuid,"project_id":b.project_id},"configuration_id":Uuid::new_v4(),"repository_id":repository,"branch_ref":"refs/heads/main","observed_head_sha":commit,"clone_url_sha256":"d".repeat(64)}}]});
        let source = json!({"schema_version":1,"producer":"BUG_SEARCHER","rule_key":"same-rule","stable_defect_key":"same-key","repository_id":repository});
        let report = json!({"title":"Defect","basis":"contract","expected":"allowed","actual":"fails","reproducer":"run test","checked_version":commit,"evidence_refs":[],"source":source,"source_identity":app::bug_search::canonical_hash(&source).unwrap()});
        let prepared = json!({"workflow_id":1,"mode_id":2,"mode_key":"search"});
        let receipt = json!({"contract_version":1,"execution_id":b.execution_id,"binding":b,"snapshot_sha256":b.snapshot_sha256,"profession":snapshot["profession"],"workflow_id":1,"mode_id":2,"mode_key":"search","state":"completed","version":5,"fence":1,"phase_index":3,"session_id":runtime.session_id,"session_run_id":runtime.session_run_id,"hermes_run_ref":runtime.hermes_run_ref,"result":{"coverage":"complete","findings":[{"finding_id":Uuid::new_v4(),"report":report}]}});
        assert!(
            technical_result(&receipt, &snapshot, &b, &runtime, &prepared)
                .unwrap()
                .is_some()
        );
        for wrong in [json!(null), json!(Uuid::new_v4())] {
            let mut bad = receipt.clone();
            bad["result"]["findings"][0]["report"]["source"]["repository_id"] = wrong;
            let source = bad["result"]["findings"][0]["report"]["source"].clone();
            bad["result"]["findings"][0]["report"]["source_identity"] = json!(
                app::bug_search::canonical_hash(
                    &serde_json::from_value::<BugSourceIdentity>(source).unwrap()
                )
                .unwrap()
            );
            assert!(technical_result(&bad, &snapshot, &b, &runtime, &prepared).is_err());
        }
        let mut bad = receipt.clone();
        bad["result"]["findings"][0]["report"]["checked_version"] = json!("c".repeat(40));
        assert!(technical_result(&bad, &snapshot, &b, &runtime, &prepared).is_err());
    }
    #[test]
    fn qa_delivery_requires_actual_confirmed_same_generation_both_sides() {
        let instance = Uuid::new_v4();
        let project = Uuid::new_v4();
        let snapshot = json!({"mode":"qa","targets":[{"target_ref":"qa:portal","deployment_ref":format!("forge:delivered:{}","a".repeat(64)),"commit_sha":"b".repeat(40)}]});
        let observed = json!({"schema":"forge/delivered-target/v1","project":{"trackerInstanceId":instance,"projectId":project},"configurationId":Uuid::new_v4(),"repositoryId":Uuid::new_v4(),"environmentId":Uuid::new_v4(),"targetRef":"qa:portal","status":"confirmed","blockedReasons":[],"target":{"deliveryRef":snapshot["targets"][0]["deployment_ref"],"operationKey":"publish:one","generation":"1","manifestSha256":"c".repeat(64),"commitSha":"b".repeat(40),"artifactId":Uuid::new_v4(),"artifactDigest":format!("sha256:{}","d".repeat(64)),"targetUrl":"https://qa.example.test/","servingIdentity":{"versionBodySha256":"c".repeat(64),"artifactBodySha256":"d".repeat(64),"observedAt":"2026-10-18T10:00:00Z"}}});
        let receipt = json!({"target_observations":{"before":[observed.clone()],"after":[observed]},"result":{"coverage":"partial"},"result_qualification":"qa_same_version"});
        assert!(
            qa_delivery_qualified(&receipt, &snapshot, instance, project),
            "stable partial coverage can retain valid individual findings"
        );
        let mut pinned = snapshot.clone();
        pinned["targets"][0]["source"] = json!({
            "configuration_id":receipt["target_observations"]["before"][0]["configurationId"],
            "repository_id":receipt["target_observations"]["before"][0]["repositoryId"]
        });
        assert!(qa_delivery_qualified(&receipt, &pinned, instance, project));
        for field in ["configurationId", "repositoryId"] {
            let mut other = receipt.clone();
            let foreign = json!(Uuid::new_v4());
            for side in ["before", "after"] {
                other["target_observations"][side][0][field] = foreign.clone();
            }
            assert!(
                !qa_delivery_qualified(&other, &pinned, instance, project),
                "stable but foreign owner locator cannot qualify the original source"
            );
            assert!(
                qa_delivery_qualified(&other, &snapshot, instance, project),
                "historical source-omitted snapshots retain their original behavior"
            );
        }
        for n in 0..5 {
            let mut changed = receipt.clone();
            match n {
                0 => {
                    changed["target_observations"]["after"][0]["target"]["generation"] = json!("2")
                }
                1 => changed["target_observations"]["after"][0]["status"] = json!("unavailable"),
                2 => changed["target_observations"]["after"] = json!(null),
                3 => {
                    changed["target_observations"]["after"][0]["project"]["projectId"] =
                        json!(Uuid::new_v4())
                }
                _ => {
                    changed["target_observations"]["after"][0]["target"]["servingIdentity"]["artifactBodySha256"] =
                        json!("0".repeat(64))
                }
            };
            assert!(!qa_delivery_qualified(
                &changed, &snapshot, instance, project
            ));
        }
    }
}
