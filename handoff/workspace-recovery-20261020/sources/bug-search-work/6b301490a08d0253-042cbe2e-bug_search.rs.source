use domain::{bug_search::*, bug_search_control::*, sdlc::Principal};
use shared::AppError;
use std::sync::Arc;
use uuid::Uuid;

#[derive(Clone)]
pub struct BugSearchService {
    pub repository: Arc<dyn BugSearchRepository>,
}
impl BugSearchService {
    pub async fn verification_basis(
        &self,
        project: Uuid,
        bug: Uuid,
        actor: &Principal,
        owner_subject: &str,
    ) -> Result<domain::bug_search_verification::BugVerificationBasis, AppError> {
        if project.is_nil()
            || bug.is_nil()
            || !bounded_text(owner_subject, 256)
            || owner_subject.chars().any(char::is_control)
        {
            return Err(AppError::validation(
                "invalid Bug verification discovery scope",
            ));
        }
        self.repository
            .verification_basis(project, bug, actor, owner_subject)
            .await
    }
    pub async fn due(
        &self,
        a: &Principal,
    ) -> Result<domain::bug_search_due::BugSearchDueReadback, AppError> {
        self.repository.due(a).await
    }
    pub async fn defer_due(
        &self,
        p: Uuid,
        a: &Principal,
        c: domain::bug_search_due::DeferBugSearchDue,
    ) -> Result<(domain::bug_search_due::BugSearchDueDeferral, bool), AppError> {
        c.validate()?;
        self.repository.defer_due(p, a, c).await
    }

    pub async fn abort_unbound(
        &self,
        p: Uuid,
        e: Uuid,
        a: &Principal,
        c: domain::bug_search_unbound::AbortUnboundBugSearch,
    ) -> Result<
        (
            domain::bug_search_unbound::BugUnboundCancellationReceipt,
            bool,
        ),
        AppError,
    > {
        c.validate()?;
        self.repository.abort_unbound(p, e, a, c).await
    }

    pub async fn cancel(
        &self,
        p: Uuid,
        e: Uuid,
        a: &Principal,
        c: domain::bug_search_cancel::CancelBugSearchBeforeStart,
    ) -> Result<
        (
            domain::bug_search_cancel::BugSearchCancellationReceipt,
            bool,
        ),
        AppError,
    > {
        c.validate()?;
        self.repository.cancel(p, e, a, c).await
    }

    pub async fn terminal(
        &self,
        p: Uuid,
        e: Uuid,
        a: &Principal,
        c: domain::bug_search_terminal::AcceptBugSearchTerminal,
    ) -> Result<(domain::bug_search_terminal::BugSearchTerminalReceipt, bool), AppError> {
        c.validate()?;
        crate::bug_search_namespace_exit::validate_observation(&c.runtime_observation)?;
        self.repository.terminal(p, e, a, c).await
    }
    pub async fn apply_policy(
        &self,
        p: Uuid,
        a: &Principal,
        c: ApplyBugSearchPolicy,
    ) -> Result<(BugSearchPolicyState, bool), AppError> {
        c.validate()?;
        self.repository.apply_policy(p, a, c).await
    }
    pub async fn policy(&self, p: Uuid, a: &Principal) -> Result<BugSearchPolicyState, AppError> {
        self.repository.policy(p, a).await
    }
    pub async fn reserve(
        &self,
        p: Uuid,
        a: &Principal,
        c: ReserveBugSearch,
    ) -> Result<(BugSearchGrantReadback, bool), AppError> {
        c.validate()?;
        self.repository.reserve(p, a, c).await
    }
    pub async fn admit(
        &self,
        p: Uuid,
        e: Uuid,
        a: &Principal,
        c: AdmitBugSearch,
    ) -> Result<(BugSearchGrantReadback, bool), AppError> {
        c.validate()?;
        self.repository.admit(p, e, a, c).await
    }
    pub async fn command(
        &self,
        p: Uuid,
        a: &Principal,
        key: &str,
    ) -> Result<BugSearchCommandReceipt, AppError> {
        validate_key(key)?;
        self.repository.command(p, a, key).await
    }
    pub async fn capabilities(
        &self,
        p: Uuid,
        a: &Principal,
    ) -> Result<BugSearchProjectCapabilities, AppError> {
        self.repository.capabilities(p, a).await
    }
    pub async fn execution_grant(
        &self,
        p: Uuid,
        e: Uuid,
        a: &Principal,
    ) -> Result<BugSearchGrantReadback, AppError> {
        self.repository.execution_grant(p, e, a).await
    }
    pub async fn register(
        &self,
        p: Uuid,
        a: &Principal,
        c: RegisterBugFinding,
    ) -> Result<(BugFindingReceipt, bool), AppError> {
        c.validate()?;
        self.repository.register(p, a, c).await
    }
    pub async fn registration_operation(
        &self,
        p: Uuid,
        a: &Principal,
        key: &str,
    ) -> Result<BugFindingReceipt, AppError> {
        crate::sdlc::validate_key(key)?;
        self.repository.registration_operation(p, a, key).await
    }
}
pub fn request_hash(project: Uuid, command: &RegisterBugFinding) -> Result<String, AppError> {
    let mut body = serde_json::to_value(command).map_err(AppError::internal)?;
    body.as_object_mut()
        .ok_or_else(|| AppError::internal("invalid bug registration body"))?
        .remove("idempotency_key");
    canonical_hash(
        &serde_json::json!({"kind":"register_bug_finding","project_id":project,"body":body}),
    )
}
pub fn basis_hash(report: &BugFindingReport) -> Result<String, AppError> {
    canonical_hash(
        &serde_json::json!({"basis":report.basis,"expected":report.expected,"actual":report.actual,"reproducer":report.reproducer}),
    )
}

pub fn canonical_hash<T: serde::Serialize>(value: &T) -> Result<String, AppError> {
    fn check(v: &serde_json::Value) -> bool {
        match v {
            serde_json::Value::Number(n) => n.is_i64() || n.is_u64(),
            serde_json::Value::Array(a) => a.iter().all(check),
            serde_json::Value::Object(o) => o.values().all(check),
            _ => true,
        }
    }
    let v = serde_json::to_value(value).map_err(AppError::internal)?;
    if !check(&v) {
        return Err(AppError::validation(
            "floating point is not a Bug Search identity",
        ));
    }
    crate::sdlc::canonical_hash(&v)
}

#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn canonical_bug_search_target_source_matches_crossservice_golden_without_legacy_hash_drift() {
        use domain::bug_search_control::{BugResolvedTarget, BugSearchMode, BugSearchSnapshot};
        let raw: serde_json::Value =
            serde_json::from_str(include_str!("../tests/fixtures/bug-target-source-v1.json"))
                .unwrap();
        let target: BugResolvedTarget = serde_json::from_value(raw.clone()).unwrap();
        target.validate(BugSearchMode::Qa).unwrap();
        assert!(target.validate(BugSearchMode::SourceOnly).is_err());
        assert_eq!(serde_json::to_value(&target).unwrap(), raw);
        assert_eq!(
            canonical_hash(&target).unwrap(),
            "da98baaa72f26675f6bdd74a05c08d5b2a1de70fe06bc0ac8548a78a2e13af01"
        );
        let mut remapped = target;
        remapped.source.as_mut().unwrap().branch_ref = "refs/heads/other".into();
        assert_ne!(
            canonical_hash(&remapped).unwrap(),
            canonical_hash(&raw).unwrap()
        );
        let old: serde_json::Value =
            serde_json::from_str(include_str!("../tests/fixtures/bug_search_v1.json")).unwrap();
        let snapshot: BugSearchSnapshot =
            serde_json::from_value(old["vectors"][1]["value"].clone()).unwrap();
        snapshot.validate().unwrap();
        assert_eq!(
            canonical_hash(&snapshot).unwrap(),
            old["vectors"][1]["sha256"].as_str().unwrap()
        );
        assert_eq!(
            serde_json::to_value(snapshot).unwrap(),
            old["vectors"][1]["value"]
        );
    }
    #[test]
    fn canonical_bug_search_hash_matches_shared_utf8_snapshot_vectors() {
        let fixture: serde_json::Value =
            serde_json::from_str(include_str!("../tests/fixtures/bug_search_v1.json")).unwrap();
        for vector in fixture["vectors"].as_array().unwrap() {
            assert_eq!(
                canonical_hash(&vector["value"]).unwrap(),
                vector["sha256"].as_str().unwrap()
            );
        }
        assert!(canonical_hash(&serde_json::json!({"unsafe":1.5})).is_err());
        let repository_source: serde_json::Value = serde_json::from_str(include_str!(
            "../tests/fixtures/bug-finding-source-repository-v1.json"
        ))
        .unwrap();
        let typed: domain::bug_search::BugSourceIdentity =
            serde_json::from_value(repository_source.clone()).unwrap();
        typed.validate().unwrap();
        assert_eq!(serde_json::to_value(&typed).unwrap(), repository_source);
        assert_eq!(
            canonical_hash(&typed).unwrap(),
            "fd25e608cb20dc5313f57d0cd83866ec7f77723f4322783065c5170ebc9cf02a"
        );
    }
}
