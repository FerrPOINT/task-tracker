}

#[utoipa::path(post,path="/api/v1/projects/{project_id}/sdlc/bugs/register-or-link",tag="bug-search",params(("project_id"=Uuid,Path)),request_body=RegisterBugFinding,responses((status=201,body=BugFindingReceipt),(status=200,body=BugFindingReceipt),(status=401),(status=403),(status=404),(status=409),(status=422),(status=503)),security(("bearer"=[])))]
pub async fn register(
    State(ctx): State<Arc<app::AppContext>>,
    Extension(actor): Extension<Principal>,
    Path(p): Path<Uuid>,
    Json(c): Json<RegisterBugFinding>,
) -> Result<(StatusCode, HeaderMap, Json<BugFindingReceipt>), AppError> {
    let (r, replay) = service(&ctx)?.register(p, &actor, c).await?;
    Ok((
        if replay {
            StatusCode::OK
        } else {
            StatusCode::CREATED
        },
        no_store(),
        Json(r),
    ))
}

#[utoipa::path(get,path="/api/v1/projects/{project_id}/sdlc/bugs/registration-operations/{idempotency_key}",tag="bug-search",params(("project_id"=Uuid,Path),("idempotency_key"=String,Path)),responses((status=200,body=BugFindingReceipt),(status=401),(status=403),(status=404),(status=503)),security(("bearer"=[])))]
pub async fn registration_operation(
    State(ctx): State<Arc<app::AppContext>>,
    Extension(actor): Extension<Principal>,
    Path((p, key)): Path<(Uuid, String)>,
) -> Result<(HeaderMap, Json<BugFindingReceipt>), AppError> {
    Ok((
        no_store(),
        Json(
            service(&ctx)?
                .registration_operation(p, &actor, &key)
                .await?,
        ),
    ))
}

