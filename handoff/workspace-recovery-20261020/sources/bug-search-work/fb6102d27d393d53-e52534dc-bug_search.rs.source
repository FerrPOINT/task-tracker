//! Narrow project-only Bug Search owner operations; no legacy issue-create fallback.
use app::bug_search::BugSearchService;
use axum::{
    Extension, Json, Router,
    extract::{Path, Query, State},
    http::{HeaderMap, HeaderValue, StatusCode, header},
    routing::{get, post},
};
use domain::{
    bug_search::*, bug_search_cancel::*, bug_search_control::*, bug_search_terminal::*,
    bug_search_unbound::*, sdlc::Principal,
};
use shared::AppError;
use std::sync::Arc;
use uuid::Uuid;

pub(super) fn router() -> Router<Arc<app::AppContext>> {
    Router::new()
        .merge(super::bug_search_due::router())
        .route(
            "/projects/{project_id}/sdlc/bugs/{bug_id}/verification-basis",
            get(verification_basis),
        )
        .route(
            "/projects/{project_id}/sdlc/bug-search/executions/{execution_id}/abort-unbound",
            post(abort_unbound),
        )
        .route(
            "/projects/{project_id}/sdlc/bug-search/executions/{execution_id}/cancel",
            post(cancel),
        )
        .route(
            "/projects/{project_id}/sdlc/bug-search/executions/{execution_id}/terminal",
            post(terminal).layer(axum::extract::DefaultBodyLimit::max(278528)),
        )
        .route(
            "/projects/{project_id}/sdlc/bug-search/policy",
            get(policy).put(apply_policy),
        )
        .route(
            "/projects/{project_id}/sdlc/bug-search/operations/{idempotency_key}",
            get(command),
        )
        .route(
            "/projects/{project_id}/sdlc/bug-search/executions",
            post(reserve),
        )
        .route(
            "/projects/{project_id}/sdlc/bug-search/executions/{execution_id}/admit",
            post(admit),
        )
        .route(
            "/projects/{project_id}/sdlc/bug-search/capabilities",
            get(capabilities),
        )
        .route(
            "/projects/{project_id}/sdlc/bug-search/executions/{execution_id}/grant",
            get(execution_grant),
        )
        .route(
            "/projects/{project_id}/sdlc/bugs/register-or-link",
            post(register),
        )
        .route(
            "/projects/{project_id}/sdlc/bugs/registration-operations/{idempotency_key}",
            get(registration_operation),
        )
        .layer(axum::extract::DefaultBodyLimit::max(
            MAX_REPORT_BYTES + 8192,
        ))
}

#[derive(serde::Deserialize, utoipa::IntoParams)]
#[serde(deny_unknown_fields)]
pub struct VerificationBasisQuery {
    pub owner_subject: String,
}

#[utoipa::path(get,path="/api/v1/projects/{project_id}/sdlc/bugs/{bug_id}/verification-basis",tag="bug-search",params(("project_id"=Uuid,Path),("bug_id"=Uuid,Path),VerificationBasisQuery),responses((status=200,body=domain::bug_search_verification::BugVerificationBasis),(status=401),(status=403),(status=404),(status=422),(status=503)),security(("bearer"=[])))]
pub async fn verification_basis(
    State(ctx): State<Arc<app::AppContext>>,
    Extension(actor): Extension<Principal>,
    Path((project, bug)): Path<(Uuid, Uuid)>,
    Query(query): Query<VerificationBasisQuery>,
) -> Result<
    (
        HeaderMap,
        Json<domain::bug_search_verification::BugVerificationBasis>,
    ),
    AppError,
> {
    Ok((
        no_store(),
        Json(
            service(&ctx)?
                .verification_basis(project, bug, &actor, &query.owner_subject)
                .await?,
        ),
    ))
}
fn service(ctx: &app::AppContext) -> Result<&BugSearchService, AppError> {
    ctx.bug_search
        .as_ref()
        .ok_or_else(|| AppError::Unavailable("Tracker Bug Search is not configured".into()))
}
fn no_store() -> HeaderMap {
    let mut h = HeaderMap::new();
    h.insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
    h
}

#[utoipa::path(get,path="/api/v1/projects/{project_id}/sdlc/bug-search/capabilities",tag="bug-search",params(("project_id"=Uuid,Path)),responses((status=200,body=BugSearchProjectCapabilities),(status=401),(status=403),(status=404),(status=503)),security(("bearer"=[])))]
pub async fn capabilities(
    State(ctx): State<Arc<app::AppContext>>,
    Extension(actor): Extension<Principal>,
    Path(p): Path<Uuid>,
) -> Result<(HeaderMap, Json<BugSearchProjectCapabilities>), AppError> {
    Ok((
        no_store(),
        Json(service(&ctx)?.capabilities(p, &actor).await?),
    ))
}

#[utoipa::path(get,path="/api/v1/projects/{project_id}/sdlc/bug-search/executions/{execution_id}/grant",tag="bug-search",params(("project_id"=Uuid,Path),("execution_id"=Uuid,Path)),responses((status=200,body=BugSearchGrantReadback),(status=401),(status=403),(status=404),(status=409),(status=503)),security(("bearer"=[])))]
pub async fn execution_grant(
    State(ctx): State<Arc<app::AppContext>>,
    Extension(actor): Extension<Principal>,
    Path((p, e)): Path<(Uuid, Uuid)>,
) -> Result<(HeaderMap, Json<BugSearchGrantReadback>), AppError> {
