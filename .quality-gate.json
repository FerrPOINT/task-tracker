{
  "schema": "base-quality-product/v1",
  "product": "task-tracker",
  "components": {
    "maintenance": [
      "scripts/tests/test_base_maintenance.py"
    ],
    "tooling": [
      "scripts/verify_readme.py",
      "scripts/tests/test_build_pin.py",
      "scripts/tests/test_verify_readme.py",
      "scripts/tests/test_ci_change_classifier.py",
      "scripts/tests/test_tooling_ownership.py",
      ".github/workflows/ci.yml",
      "scripts/tests/test_ci_contract_checks.py",
      "backend/Dockerfile",
      "backend/Dockerfile.umbrella"
    ],
    "docs": [
      "scripts/verify_readme.py",
      "docs/**",
      "*.md",
      "LICENSE"
    ],
    "frontend": [
      "frontend/**",
      "openapi/**",
      ".base-ui-revision",
      ".github/**",
      ".base-revision",
      ".namespace-base-revision"
    ],
    "backend": [
      "backend/**",
      "crates/**",
      "Cargo.*",
      "rust-toolchain*",
      ".base-revision",
      ".namespace-base-revision",
      ".github/**",
      "openapi/**"
    ]
  },
  "gates": [
    {
      "id": "maintenance:wrapper-unit",
      "component": "maintenance",
      "profiles": [
        "fast",
        "unit",
        "build",
        "integrated",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "scripts.tests.test_base_maintenance",
        "-q"
      ],
      "cwd": ".",
      "inputs": [
        "scripts/tests/test_base_maintenance.py",
        "scripts/backup.sh",
        "scripts/restore.sh",
        ".quality-gate.json",
        ".github/workflows/ci.yml"
      ],
      "platforms": [
        "linux"
      ],
      "cacheable": false,
      "execution_slot": "none",
      "test_tier": "unit"
    },
    {
      "id": "tooling:python-helpers",
      "component": "tooling",
      "profiles": [
        "fast",
        "unit",
        "build",
        "integrated",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "scripts.tests.test_build_pin",
        "scripts.tests.test_verify_readme",
        "scripts.tests.test_ci_change_classifier",
        "scripts.tests.test_tooling_ownership",
        "-q"
      ],
      "cwd": ".",
      "inputs": [
        "scripts/tests/test_build_pin.py",
        "scripts/tests/test_verify_readme.py",
        "scripts/tests/test_ci_change_classifier.py",
        "scripts/tests/test_tooling_ownership.py",
        "scripts/build.py",
        "scripts/verify_readme.py",
        "scripts/classify_ci_changes.py",
        "scripts/vendor/base_quality_selection.py",
        ".quality-gate.json",
        ".github/workflows/ci.yml"
      ],
      "cacheable": true,
      "execution_slot": "none",
      "test_tier": "unit"
    },
    {
      "id": "tooling:build-contracts",
      "component": "tooling",
      "profiles": [
        "fast",
        "unit",
        "build",
        "integrated",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "scripts.tests.test_ci_contract_checks"
      ],
      "cwd": ".",
      "inputs": [
        ".quality-gate.json",
        ".quality-tooling-revision",
        "scripts/tests/test_ci_contract_checks.py",
        "scripts/vendor/base_quality_selection.py",
        "scripts/vendor/base-quality-tooling.json",
        ".github/workflows/ci.yml",
        ".github/workflows/release.yml",
        "backend/Dockerfile",
        "backend/Dockerfile.umbrella",
        "backend/domain/**"
      ],
      "cacheable": true,
      "test_tier": "static"
    },
    {
      "id": "docs:readme",
      "component": "docs",
      "profiles": [
        "fast",
        "integrated",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "scripts/verify_readme.py"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": true,
      "test_tier": "static"
    },
    {
      "id": "frontend:types",
      "component": "frontend",
      "profiles": [
        "fast",
        "integrated",
        "build",
        "release"
      ],
      "argv": [
        "pnpm",
        "exec",
        "tsc",
        "--noEmit"
      ],
      "cwd": "frontend",
      "inputs": [
        "frontend/**",
        "openapi/**",
        ".base-ui-revision",
        ".gitattributes"
      ],
      "cacheable": true,
      "tools": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "pattern": "^v22\\.20\\.0\\s*$"
        },
        {
          "argv": [
            "pnpm",
            "--version"
          ],
          "pattern": "^10\\.28\\.1\\s*$"
        }
      ],
      "prepare_frontend": "22.20.0",
      "environment_input_contract": "frontend-agent-presence-v1",
      "test_tier": "static",
      "descriptor_input_contract": "prepared-frontend-generation-context-v1"
    },
    {
      "id": "frontend:tests",
      "component": "frontend",
      "profiles": [
        "fast",
        "integrated",
        "release",
        "unit",
        "build"
      ],
      "argv": [
        "pnpm",
        "test:unit"
      ],
      "cwd": "frontend",
      "inputs": [
        "frontend/**",
        "openapi/**",
        ".base-ui-revision",
        ".gitattributes"
      ],
      "cacheable": true,
      "tools": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "pattern": "^v22\\.20\\.0\\s*$"
        },
        {
          "argv": [
            "pnpm",
            "--version"
          ],
          "pattern": "^10\\.28\\.1\\s*$"
        }
      ],
      "prepare_frontend": "22.20.0",
      "environment_input_contract": "frontend-agent-presence-v1",
      "test_tier": "unit",
      "descriptor_input_contract": "prepared-frontend-generation-context-v1"
    },
    {
      "id": "frontend:lint",
      "component": "frontend",
      "profiles": [
        "integrated",
        "release"
      ],
      "argv": [
        "pnpm",
        "lint"
      ],
      "cwd": "frontend",
      "inputs": [
        "frontend/**",
        "openapi/**",
        ".base-ui-revision",
        ".gitattributes"
      ],
      "cacheable": true,
      "tools": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "pattern": "^v22\\.20\\.0\\s*$"
        },
        {
          "argv": [
            "pnpm",
            "--version"
          ],
          "pattern": "^10\\.28\\.1\\s*$"
        }
      ],
      "prepare_frontend": "22.20.0",
      "test_tier": "static",
      "descriptor_input_contract": "prepared-frontend-generation-context-v1"
    },
    {
      "id": "frontend:build",
      "component": "frontend",
      "profiles": [
        "build"
      ],
      "argv": [
        "pnpm",
        "exec",
        "vite",
        "build"
      ],
      "cwd": "frontend",
      "inputs": [
        "frontend/**",
        "openapi/**",
        ".base-ui-revision",
        ".gitattributes"
      ],
      "cacheable": true,
      "tools": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "pattern": "^v22\\.20\\.0\\s*$"
        },
        {
          "argv": [
            "pnpm",
            "--version"
          ],
          "pattern": "^10\\.28\\.1\\s*$"
        }
      ],
      "prepare_frontend": "22.20.0",
      "outputs": [
        "frontend/dist"
      ],
      "environment_inputs": [
        "VITE_*",
        "NODE_*",
        "BROWSERSLIST*",
        "npm_*",
        "NPM_*",
        "PNPM_*",
        "SOURCE_DATE_EPOCH",
        "HOME",
        "USERPROFILE",
        "TMPDIR",
        "TEMP",
        "TMP"
      ],
      "kind": "artifact",
      "exclude_inputs": [
        "frontend/src/**/*.test.ts",
        "frontend/src/**/*.test.tsx",
        "frontend/src/**/*.spec.ts",
        "frontend/src/**/*.spec.tsx",
        "frontend/src/**/*.test.mjs",
        "frontend/src/**/*.test.cjs",
        "frontend/src/*.test.ts",
        "frontend/src/*.test.tsx",
        "frontend/src/*.spec.ts",
        "frontend/src/*.spec.tsx",
        "frontend/src/*.test.mjs",
        "frontend/src/*.test.cjs",
        "frontend/e2e/**",
        "frontend/src/test/setup.ts",
        "frontend/vitest.config.ts",
        "frontend/scripts/tailwind-source-inputs.test.mjs"
      ],
      "test_tier": "artifact",
      "artifact_input_contract": "git-source-v1",
      "descriptor_input_contract": "prepared-frontend-generation-context-v1"
    },
    {
      "id": "backend:unit",
      "component": "backend",
      "profiles": [
        "fast",
        "release",
        "unit",
        "build"
      ],
      "argv": [
        "bash",
        "{base}/scripts/run_rust_gate.sh",
        "--",
        "bash",
        "-euo",
        "pipefail",
        "-c",
        "cargo fmt --all -- --check; cargo test --locked -p domain --lib"
      ],
      "cwd": "backend",
      "inputs": [
        "**"
      ],
      "cacheable": true,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "rustc",
            "--version"
          ],
          "pattern": "^rustc 1\\.88\\.0\\b"
        }
      ],
      "sdk_revision": ".namespace-base-revision",
      "test_tier": "unit"
    },
    {
      "id": "backend:quality",
      "component": "backend",
      "profiles": [
        "integration",
        "integrated",
        "release"
      ],
      "argv": [
        "bash",
        "{base}/scripts/run_rust_gate.sh",
        "--",
        "bash",
        "-euo",
        "pipefail",
        "-c",
        "cargo fmt --all -- --check; cargo clippy --locked --workspace --all-targets -- -D warnings; cargo test --locked --workspace"
      ],
      "cwd": "backend",
      "inputs": [
        "**"
      ],
      "cacheable": false,
      "platforms": [
        "linux"
      ],
      "external_state": true,
      "requires_env": [
        "TT_TEST_DATABASE_URL"
      ],
      "tools": [
        {
          "argv": [
            "rustc",
            "--version"
          ],
          "pattern": "^rustc 1\\.88\\.0\\b"
        }
      ],
      "sdk_revision": ".namespace-base-revision",
      "test_tier": "integration"
    },
    {
      "id": "backend:build",
      "component": "backend",
      "profiles": [
        "build"
      ],
      "argv": [
        "bash",
        "{base}/scripts/run_rust_gate.sh",
        "--",
        "bash",
        "-euo",
        "pipefail",
        "-c",
        "cargo build --locked --release -p server --bin server\nfor binary in server; do\n    test -s \"$CARGO_TARGET_DIR/release/$binary\"\n    test -x \"$CARGO_TARGET_DIR/release/$binary\"\n    cp -- \"$CARGO_TARGET_DIR/release/$binary\" \"$BASE_QUALITY_ARTIFACTS/$binary\"\ndone"
      ],
      "cwd": "backend",
      "inputs": [
        "backend/**",
        ".base-revision",
        ".namespace-base-revision",
        ".cargo/**",
        "rust-toolchain*",
        ".gitattributes"
      ],
      "cacheable": true,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "rustc",
            "--version"
          ],
          "pattern": "^rustc 1\\.88\\.0\\b"
        }
      ],
      "sdk_revision": ".namespace-base-revision",
      "kind": "artifact",
      "exclude_inputs": [
        "backend/tests/**",
        "backend/**/tests/**",
        "backend/domain/src/entities/tests.rs",
        "backend/domain/src/repositories/tests.rs",
        "backend/domain/src/stubs/memory/tests.rs",
        "backend/domain/src/value_objects/tests.rs"
      ],
      "artifact_outputs": [
        "server"
      ],
      "artifact_toolchain": "pinned-image",
      "environment_inputs": [
        "CARGO_*",
        "RUST*",
        "CC",
        "CC_*",
        "CFLAGS",
        "CFLAGS_*",
        "CXX",
        "CXX_*",
        "CXXFLAGS",
        "AR",
        "AR_*",
        "RANLIB",
        "LD",
        "LD_*",
        "LDFLAGS",
        "PKG_CONFIG*",
        "OPENSSL*",
        "LIBSSL*",
        "SQLX_*",
        "SQLITE*",
        "LIBSQLITE*",
        "VCPKG*",
        "BINDGEN*",
        "LIBCLANG*",
        "ZSTD*",
        "CMAKE*",
        "SOURCE_DATE_EPOCH",
        "HOME",
        "LIBRARY_PATH",
        "LD_LIBRARY_PATH",
        "CPATH",
        "C_INCLUDE_PATH",
        "CPLUS_INCLUDE_PATH"
      ],
      "test_tier": "artifact"
    }
  ],
  "affected_checks": {
    "tooling": [
      {
        "paths": [
          "scripts/verify_readme.py",
          "scripts/tests/test_build_pin.py",
          "scripts/tests/test_verify_readme.py",
          "scripts/tests/test_ci_change_classifier.py",
          "scripts/tests/test_tooling_ownership.py"
        ],
        "gates": [
          "tooling:python-helpers"
        ]
      },
      {
        "paths": [
          "scripts/tests/test_ci_contract_checks.py"
        ],
        "gates": [
          "tooling:build-contracts"
        ]
      }
    ]
  },
  "additional_acceptance": "Existing product CI/CONTRIBUTING: MSRV/features, ignored DB, OpenAPI/packed consumer/themes, security and live acceptance remain separate mandatory gates where applicable.",
  "frontend_generated": [
    "src/api/generated.ts"
  ],
  "frontend_unit_inputs": [
    "frontend/src/**/*.test.ts",
    "frontend/src/**/*.test.tsx",
    "frontend/src/**/*.spec.ts",
    "frontend/src/**/*.spec.tsx",
    "frontend/src/**/*.test.mjs",
    "frontend/src/**/*.test.cjs",
    "frontend/src/*.test.ts",
    "frontend/src/*.test.tsx",
    "frontend/src/*.spec.ts",
    "frontend/src/*.spec.tsx",
    "frontend/src/*.test.mjs",
    "frontend/src/*.test.cjs",
    "frontend/src/test/setup.ts",
    "frontend/vitest.config.ts",
    "frontend/scripts/tailwind-source-inputs.test.mjs"
  ],
  "test_policy": {
    "automatic": [
      "unit",
      "static",
      "artifact"
    ],
    "manual_release": [
      "integration",
      "slow",
      "live"
    ],
    "release_required": true
  },
  "backend_unit_inputs": [
    "backend/tests/**",
    "backend/**/tests/**",
    "backend/domain/src/entities/tests.rs",
    "backend/domain/src/repositories/tests.rs",
    "backend/domain/src/stubs/memory/tests.rs",
    "backend/domain/src/value_objects/tests.rs"
  ],
  "frontend_generation": {
    "schema": "base-frontend-generation/v1",
    "inputs": [
      "frontend/scripts/base-generate-openapi.mjs",
      "openapi/**",
      "frontend/redocly.yaml",
      "frontend/redocly.yml",
      "frontend/.redocly.yaml",
      "frontend/.redocly.yml"
    ],
    "scripts": [
      "postinstall"
    ],
    "commands_sha256": "9e4fcc50c190137927126c3d8de6281dc0f1bfb6961e32dbe662d7cf576a8cee",
    "environment_input_contract": "frontend-agent-presence-v1"
  }
}
